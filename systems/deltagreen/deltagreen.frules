#include "/systems/common.frules"
#include "/systems/names/settings.frules"

dgValue (units, tens) =
    if mod (tens, 10) == 0 and mod (units, 10) == 0 then 100
    else mod (tens, 10) * 10 + mod (units, 10)

isDouble (roll) = roll < 100 and mod (roll, 10) == roll / 10

dgLevel (target, roll) =
    if roll == 1 then "Critical success"
    else if roll == 100 then "Fumble"
    else if roll <= target and isDouble (roll) then "Critical success"
    else if roll <= target then "Success"
    else if isDouble (roll) then "Fumble"
    else "Failure"

dgResult (target, roll) =
{
    Text = toString (roll) + " vs " + toString (target) + ": " + dgLevel (target, roll)
    Value = roll
    Outcome = dgLevel (target, roll)
}

modifierOf (char) =
    switch char.Agent.Modifier
        case "Minus 40" then -40
        case "Minus 20" then -20
        case "Plus 20" then 20
        case "Plus 40" then 40
        else 0

dgRoll (modifier) = ([dice { number = 1  sides = 10  label = "Units" }, dice { number = 1  sides = 10  label = "Tens" }],
    ((baseline, throws)->dgResult (min (99, max (0, baseline + modifier)), dgValue (first (first (throws).rolls), first (item (1, throws).rolls)))))

dgDice (char) = dgRoll (modifierOf (char))

plainD100 = dgRoll (0)

statistic (base) = custom
{
    Score = integer { description = "Statistic score, usually 3 to 18." default = base }
    'x5' = integer { description = "Five times the score, the percentage to roll under for a statistic test." value = Score * 5  valuedice = dgDice (characterTable)  editable = none }
    Feature = string { description = "A word or two for a very high or low score, such as quick or frail." }
}

skill (base) = custom
{
    Value = integer { description = "Skill percentage. Roll d100 at or under it to succeed." default = base  valuedice = dgDice (characterTable) }
    Failed = bool { description = "Tick after a failed roll. Failed skills may improve at the end of the operation." default = false  editable = live }
}

noSkill = { Value = 0 }

skillValue (char, name) = valueOr (valueOr (char.Skills, name, noSkill), "Value", 0)

lethalDamage (tens, units) = (if mod (tens, 10) == 0 then 10 else mod (tens, 10)) + (if mod (units, 10) == 0 then 10 else mod (units, 10))

lethalityResult (target, tens, units) =
{
    Text = if dgValue (units, tens) <= target then toString (dgValue (units, tens)) + " vs " + toString (target) + ": Lethal, the target dies" else toString (dgValue (units, tens)) + " vs " + toString (target) + ": not lethal, " + toString (lethalDamage (tens, units)) + " damage"
    Value = dgValue (units, tens)
    Outcome = if dgValue (units, tens) <= target then "Lethal hit" else "Damage"
}

lethalityRoll = ([dice { number = 1  sides = 10  label = "Units" }, dice { number = 1  sides = 10  label = "Tens" }],
    ((baseline, throws)->lethalityResult (baseline, first (item (1, throws).rolls), first (first (throws).rolls))))

weaponAttack (name, target, damage, kind, distance, ap, lethal) = custom
{
    Name = name
    Skill = integer { value = target  valuedice = dgDice (characterTable)  action = kind  reach = 2  range = distance }
    Damage = string { value = damage }
    'Armor Piercing' = string { value = ap }
    Lethality = integer { description = "Lethality rating. Roll d100 under it to kill outright; a miss deals the two dice added together." value = lethal  valuedice = lethalityRoll }
}

firstNumber (text) = bonusWithValue ([[text]], "^[^0-9]*([0-9]+)")

weaponAp (weapon) = valueOr (weapon.data.weaponStats.Stats, "Armor Piercing", "")

weaponLethality (weapon) = firstNumber (valueOr (weapon.data.weaponStats.Stats, "Lethality", ""))

attackFor (char, weapon) =
    if firstNumber (valueOr (weapon.data.weaponStats.Stats, "Base Range", "")) > 0 then
        weaponAttack (weapon.Name, skillValue (char, valueOr (weapon.data.weaponStats.Stats, "Skill", "Firearms")), valueOr (weapon.data.weaponStats.Stats, "Damage", ""), "ranged", firstNumber (valueOr (weapon.data.weaponStats.Stats, "Base Range", "")) * 3, weaponAp (weapon), weaponLethality (weapon))
    else
        weaponAttack (weapon.Name, skillValue (char, valueOr (weapon.data.weaponStats.Stats, "Skill", "Melee Weapons")), valueOr (weapon.data.weaponStats.Stats, "Damage", ""), "melee", 0, weaponAp (weapon), weaponLethality (weapon))

characterTable = ruleset
{
    rulesetConfiguration = { important = ['Derived Attributes', Agent.Initiative, Skills.Dodge, Attacks] }
    Agent = table
    {
        tableLayout = layout { columns = 3  size = wide }
        Profession = string {}
        Employer = string {}
        Nationality = string {}
        Age = integer { default = 30 }
        Education = string {}
        Modifier = selector
        {
            description = "Bonus or penalty to the next percentile roll, from 20 down to minus 20 and up."
            options = ["Minus 40", "Minus 20", "Normal", "Plus 20", "Plus 40"]
            labels = ["-40", "-20", "Normal", "+20", "+40"]
            colors = ["red", "red", "white", "green", "green"]
            hold = ["", "Ctrl", "", "Shift", ""]
            default = "Normal"
            editable = live
            save = nosave
        }
        Initiative = integer { description = "Acting order in combat: highest DEX acts first." value = Statistics.Dexterity.Score  valuedice = ([1d1], ((baseline, throws)->baseline))  editable = none }
    }

    Statistics = table
    {
        description = "The six statistics. Tests roll d100 under five times the score."
        tableLayout = layout { }
        Strength = statistic (10)
        Constitution = statistic (10)
        Dexterity = statistic (10)
        Intelligence = statistic (10)
        Power = statistic (10)
        Charisma = statistic (10)
    }

    'Derived Attributes' = table
    {
        tableLayout = layout { columns = 2 }
        'Hit Points' = table
        {
            description = "Hit points from STR and CON. At 2 or less you are unconscious or dying."
            Maximum = integer { value = (Statistics.Strength.Score + Statistics.Constitution.Score + 1) / 2  editable = none }
            Current = integer { description = "Current hit points." default = Maximum  editable = live }
            Wounded = string { value = if Current < 3 then "Unconscious or dying" else ""  visible = none  indicator = "#d64545" }
            'Fully healed' = button { description = "Hit points back to the maximum, once rest and medical care have healed them. Enter partial healing by hand."  editable = live  onClick = updates { (root.'Derived Attributes'.'Hit Points'.Current) = Maximum } }
        }
        'Willpower Points' = table
        {
            description = "Willpower, from POW. Spend it to push yourself or project a bond."
            Maximum = integer { value = Statistics.Power.Score  editable = none }
            Current = integer { description = "Current willpower points. At 0 the agent collapses." default = Maximum  editable = live }
            'Fully rested' = button { description = "Willpower back to the maximum, once rest has restored it. Enter partial recovery by hand."  editable = live  onClick = updates { (root.'Derived Attributes'.'Willpower Points'.Current) = Maximum } }
        }
        Sanity = table
        {
            description = "Sanity points. Losing them to the unnatural, violence or helplessness breaks the mind."
            Maximum = integer { description = "Highest Sanity you can have: 99 minus Unnatural." value = 99 - skillValue (characterTable, "Unnatural")  editable = none }
            Current = integer { description = "Current Sanity. Roll under it when facing horror." default = Statistics.Power.Score * 5  editable = live  valuedice = dgDice (characterTable) }
            'Breaking Point' = integer { description = "When Sanity falls to this, the agent gains a disorder and a new breaking point." default = Statistics.Power.Score * 4  editable = live }
            'Temporary Insanity' = bool { default = false  editable = live  indicator = "#8e5cc4" }
        }
        Adapted = table
        {
            Violence = slots { description = "Marks of violence suffered. Three and the agent is adapted to it." number = 3  editable = live  labels = ["1", "2", "3"] }
            Helplessness = slots { description = "Marks of helplessness suffered. Three and the agent is adapted to it." number = 3  editable = live  labels = ["1", "2", "3"] }
        }
    }

    Psychology = table
    {
        tableLayout = layout { }
        Motivations = string { description = "What keeps the agent going, and the disorders that haunt them." multiline = true }
        Disorders = string { multiline = true }
    }

    Bonds = list
    {
        description = "The people who matter most to the agent. Spend bond points to soak sanity loss."
        singular = "Bond"
        editable = character
        valueType = custom
        {
            Name = string {}
            Score = integer { description = "Strength of the bond. It starts at the agent's CHA and falls when the bond is used or neglected." default = Statistics.Charisma.Score  editable = live }
            Damaged = bool { description = "Tick when the bond has been damaged this operation." default = false  editable = live }
        }
    }

    Skills = table
    {
        description = "Skills with starting values. Roll d100 at or under the value."
        tableLayout = layout { columns = 3  size = wide }
        Accounting = skill (10)
        Alertness = skill (20)
        Anthropology = skill (0)
        Archeology = skill (0)
        Art = skill (0)
        Artillery = skill (0)
        Athletics = skill (30)
        Bureaucracy = skill (10)
        'Computer Science' = skill (0)
        Craft = skill (0)
        Criminology = skill (10)
        Demolitions = skill (0)
        Disguise = skill (10)
        Dodge = skill (30)
        Drive = skill (20)
        Firearms = skill (20)
        'First Aid' = skill (10)
        Forensics = skill (0)
        'Heavy Machinery' = skill (10)
        'Heavy Weapons' = skill (0)
        History = skill (10)
        HUMINT = skill (10)
        Law = skill (0)
        Medicine = skill (0)
        'Melee Weapons' = skill (30)
        'Military Science' = skill (0)
        Navigate = skill (10)
        Occult = skill (10)
        Persuade = skill (20)
        Pharmacy = skill (0)
        Pilot = skill (0)
        Psychotherapy = skill (10)
        Ride = skill (10)
        Science = skill (0)
        Search = skill (20)
        SIGINT = skill (0)
        Stealth = skill (10)
        Surgery = skill (0)
        Survival = skill (10)
        Swim = skill (20)
        'Unarmed Combat' = skill (40)
        Unnatural = skill (0)
    }

    'Other Skills' = keyvalues
    {
        description = "Extra skills such as foreign languages, crafts and sciences."
        singular = "Skill"
        editablekeys = character
        keys = ["Foreign Language"]
        tableLayout = layout { size = wide }
        valueType = custom
        {
            Value = integer { default = 0  valuedice = dgDice (characterTable) }
            Failed = bool { description = "Tick after a failed roll. Failed skills may improve at the end of the operation." default = false  editable = live }
        }
    }

    Weapons = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        source = concat ([weaponAttack ("Unarmed", skillValue (characterTable, "Unarmed Combat"), "1d4-1", "melee", 0, "", 0)], map ((weapon)->attackFor (characterTable, weapon), characterTable.Weapons))
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }

    Gear = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Gear
        singular = "Item"
        editable = character
    }

    Notes = table
    {
        tableLayout = layout { columns = 2  size = wide }
        'Physical Description' = string { multiline = true }
        'Wounds and Ailments' = string { multiline = true }
        'Personal Details and Notes' = string { multiline = true }
        'Special Training' = string { multiline = true }
    }
}

creatureTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg"  important = [Stats, Attacks] }
    Statistics = table
    {
        tableLayout = layout { columns = 3  size = wide }
        STR = integer { default = 10 }
        CON = integer { default = 10 }
        DEX = integer { default = 10 }
        INT = integer { default = 10 }
        POW = integer { default = 10 }
        CHA = integer { default = 10 }
    }
    Stats = table
    {
        tableLayout = layout { columns = 3  size = wide }
        'Hit Points' = integer { description = "Hit points when unhurt." default = 10 }
        'Current HP' = integer { description = "Current hit points." default = 10  editable = live }
        'Willpower Points' = integer { default = 10 }
        Armor = integer { description = "Reduces damage from each hit." default = 0 }
        Alertness = integer { description = "Skill for noticing agents and danger." default = 40  valuedice = plainD100 }
        Dodge = integer { description = "Skill for dodging attacks." default = 30  valuedice = plainD100 }
        'Sanity Loss' = string { description = "Sanity lost on seeing the creature: on a success, and on a failure." }
        Initiative = integer { value = Statistics.DEX  valuedice = ([1d1], ((baseline, throws)->baseline))  editable = none }
    }
    Attacks = list
    {
        tableLayout = layout { size = wide }
        singular = "Attack"
        editable = character
        valueType = custom
        {
            Name = string {}
            Skill = integer { default = 40  valuedice = plainD100  action = melee  reach = 2 }
            Damage = string {}
        }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        'Special Abilities' = string { multiline = true }
        Description = string { multiline = true }
    }
}

weaponStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Skill = string { keys = ["Firearms", "Melee Weapons", "Unarmed Combat", "Heavy Weapons", "Artillery", "Athletics", "Demolitions"] }
        'Base Range' = string {}
        Damage = string {}
        'Armor Piercing' = string {}
        'Lethality' = string {}
        'Kill Radius' = string {}
        Ammo = string {}
        Expense = string {}
    }
}

gearStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Expense = string {}
        Armor = string {}
    }
}

ritualStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Complexity = string {}
        'Study Time' = string {}
        'Activation Cost' = string {}
        'Activation Time' = string {}
        'Sanity Loss' = string {}
    }
}

DeltaGreen = system
{
    lowRollsAreLucky = [100]
    hints = [
        hint
        {
            title = "The operation"
            topic = "Getting started"
            text = ["Start with a briefing: who sends the agents, what they are told, and what they must keep hidden."]
        },
        hint
        {
            title = "Rolling"
            topic = "Play"
            text = ["Roll d100 at or under a skill or a statistic times five. Doubles under the target are criticals, doubles over are fumbles.", "Use the Modifier slider for easy or hard situations."]
        },
        hint
        {
            title = "Bonds and sanity"
            topic = "Characters"
            text = ["Bonds are the people the agent cares about. Spending Bond points softens Sanity loss but harms the relationship."]
        },
        hint
        {
            title = "DEX order"
            topic = "Initiative"
            text = ["Act in DEX order. Players roll the Initiative field to put their DEX in the list."]
        }
    ]
    distanceUnit = "m"
    characters = characterTable
    creatures = creatureTable
    entityTypeNames = [entityTypeName ("Character", "Agent", "Agents")]
    Weapons = weaponStats
    Gear = gearStats
    Rituals = ritualStats
    secondaryTypes = ["Weapons", "Gear", "Rituals"]
    description = "Delta Green: agents of a secret war against the unnatural"
    initiativeCompare (item1, item2) = compare (toInt (item1), toInt (item2))
    quickdice = [1d100, 1d20, 1d10, 1d6]
    cssFiles = ["/systems/deltagreen/deltagreen.css"]
    libraries = ["/systems/names/spies.json", "/systems/names/cosmic.json", "/systems/names/norwegian.json", "/systems/tables/scifi.json", "/systems/tables/modern.json"]
    nameSettings = [spyThrillerNameSetting, cosmicHorrorNameSetting, modernNorwayNameSetting]
}
