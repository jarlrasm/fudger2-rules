#include "/systems/common.frules"

characteristicDM (score) =
    if score < 1 then -3
    else if score < 3 then -2
    else if score < 6 then -1
    else if score < 9 then 0
    else if score < 12 then 1
    else if score < 15 then 2
    else 3

dmFor (char, name) =
    switch name
    case "STR" then char.Characteristics.'STR'.DM
    case "DEX" then char.Characteristics.'DEX'.DM
    case "END" then char.Characteristics.'END'.DM
    case "INT" then char.Characteristics.'INT'.DM
    case "EDU" then char.Characteristics.'EDU'.DM
    case "CHA" then char.Characteristics.'CHA'.DM
    case "EMP" then char.Characteristics.'EMP'.DM
    else 0

effectText (effect) = if effect < 0 then toString (effect) else "+" + toString (effect)

checkLevel (effect) =
    if effect >= 6 then "Great success"
    else if effect >= 0 then "Success"
    else if effect <= -6 then "Disaster"
    else "Failure"

checkResult (total) =
{
    Text = toString (total) + ": " + checkLevel (total - 8) + ", Effect " + effectText (total - 8)
    Value = total
    Outcome = checkLevel (total - 8)
}

plainRoll = ([2d6], ((baseline, throws)->
    checkResult (baseline + asked + first (throws).bonus + sum (first (throws).rolls))))

boonRoll = ([3d6], ((baseline, throws)->
    checkResult (baseline + asked + first (throws).bonus + sum (first (throws).rolls) - min (first (throws).rolls))))

baneRoll = ([3d6], ((baseline, throws)->
    checkResult (baseline + asked + first (throws).bonus + sum (first (throws).rolls) - max (first (throws).rolls))))

initiativeRoll (char) =
    if char.Checks.Roll == "Boon" then ([3d6], ((baseline, throws)->baseline + first (throws).bonus + sum (first (throws).rolls) - min (first (throws).rolls)))
    else if char.Checks.Roll == "Bane" then ([3d6], ((baseline, throws)->baseline + first (throws).bonus + sum (first (throws).rolls) - max (first (throws).rolls)))
    else 2d6

checkRoll (char) = ask ("Difficulty DM", 0, modeRoll (char))

modeRoll (char) =
    if char.Checks.Roll == "Boon" then boonRoll
    else if char.Checks.Roll == "Bane" then baneRoll
    else plainRoll

plainAsked = ask ("Difficulty DM", 0, plainRoll)

untrainedDM (char) = -3 + min (3, max (0, char.Checks.'Jack of All Trades'))

levelDM (char, trained, level) = if trained then level else untrainedDM (char)

skillDM (char, trained, level, characteristic) =
    levelDM (char, trained, level) + dmFor (char, characteristic)

damageText (damage) = replace ("d6", "d", replace (" ", "", toLower (damage)))

damageDiceCount (damage) = toInt (first (split ("d", damageText (damage))))

damageBonus (damage) =
    if count (split ("d", damageText (damage))) > 1 then toInt (replace ("+", "", item (1, split ("d", damageText (damage)))))
    else 0

noDamage = ([1d6], ((baseline, throws)-> baseline))

damageDice (n) =
    switch n
    case 1 then 1d6
    case 2 then 2d6
    case 3 then 3d6
    case 4 then 4d6
    case 5 then 5d6
    case 6 then 6d6
    case 7 then 7d6
    case 8 then 8d6
    case 9 then 9d6
    case 10 then 10d6
    else noDamage

noSkill = { Level = 0  Trained = false }

skillEntry (char, fullSkill) =
    valueOr (char.Skills, fullSkill, valueOr (char.Skills, first (split (" (", fullSkill)), noSkill))

skillLevelDM (char, fullSkill) =
    levelDM (char, valueOr (skillEntry (char, fullSkill), "Trained", true), valueOr (skillEntry (char, fullSkill), "Level", 0))

weaponSkill (weapon) = valueOr (weapon.data.weaponStats.Stats, "Skill", "Melee (blade)")

weaponRange (weapon) = valueOr (weapon.data.weaponStats.Stats, "Range", "Melee")

weaponDamage (weapon) = valueOr (weapon.data.weaponStats.Stats, "Damage dice", "1D")

isMelee (weapon) =
    if contains (toLower (weaponRange (weapon)), "melee") then true
    else if weaponRange (weapon) == "" then contains (toLower (weaponSkill (weapon)), "melee")
    else false

attackCharacteristic (weapon) =
    if contains (toLower (valueOr (weapon.data.weaponStats.Stats, "Skill", "")), "bludgeon") then "STR"
    else if contains (toLower (valueOr (weapon.data.weaponStats.Stats, "Skill", "")), "unarmed") then "STR"
    else "DEX"

metresIn (text) = toInt (replace ("m", "", replace (" ", "", toLower (text))))

metres (text) = if metresIn (text) > 0 then metresIn (text) else 10000

attackKind (weapon) = if isMelee (weapon) then "melee" else "ranged"

attackDistance (weapon) = if isMelee (weapon) then 2 else metres (weaponRange (weapon))

weaponAttack (name, dm, dice, damage, kind, distance) = custom
{
    Name = name
    Attack = modifier
    {
        value = dm
        valuedice = dice
        action = kind
        reach = distance
        range = distance
    }
    Damage = integer
    {
        value = damageBonus (damage)
        render = damage
        valuedice = damageDice (damageDiceCount (damage))
    }
}

characterAttack (char, weapon) =
    weaponAttack (weapon.Name, skillLevelDM (char, weaponSkill (weapon)) + dmFor (char, attackCharacteristic (weapon)), checkRoll (char), weaponDamage (weapon), attackKind (weapon), attackDistance (weapon))

attacksFor (char) =
    concat (
        [weaponAttack ("Unarmed", skillLevelDM (char, "Melee (unarmed)") + dmFor (char, "STR"), checkRoll (char), "1D", "melee", 2)],
        map ((weapon)->characterAttack (char, weapon), char.Weapons))

minionAttacksFor (minion) =
    map ((weapon)->weaponAttack (weapon.Name, minion.Stats.'Attack DM', plainAsked, weaponDamage (weapon), attackKind (weapon), attackDistance (weapon)), minion.Weapons)

talentUse (name, dm, dice, cost, distance) = custom
{
    Name = name
    Check = modifier
    {
        value = dm
        valuedice = dice
        action = "ranged"
        range = distance
    }
    'EMP Cost' = cost
}

talentCost (talent) = valueOr (talent.data.talentStats.Stats, "EMP Cost", "")

talentRange (talent) = metres (valueOr (talent.data.talentStats.Stats, "Reach", ""))

talentUsesFor (char) =
    map ((talent)->talentUse (talent.Name, skillLevelDM (char, "Empathy Use") + dmFor (char, "EMP"), checkRoll (char), talentCost (talent), talentRange (talent)), char.'Empathic Talents')

minionTalentUsesFor (minion) =
    map ((talent)->talentUse (talent.Name, minion.Stats.Check, plainAsked, talentCost (talent), talentRange (talent)), minion.'Empathic Talents')

condition (str, dex, end) =
    if str + dex + end < 1 then "Dead"
    else if str < 1 then "Unconscious"
    else if dex < 1 then "Unconscious"
    else if end < 1 then "Wounded"
    else "Fit"

mapCondition (text) = if text == "Fit" then "" else text

hitsCondition (current, hits) = if hits > 0 then if current < 1 then "Down" else "" else ""

darkInfluenceEffect (di) =
    if di < 4 then "None"
    else if di < 6 then "STR or END +1"
    else if di < 11 then "Other of STR or END +D3"
    else if di < 16 then "Dark toll on natural 2 or 12"
    else if di < 26 then "Gains EMP and Empathy Use"
    else if di < 36 then "Physical aspect of a Dark Minion"
    else if di < 51 then "Craving, lose END monthly"
    else if di < 76 then "INT or CHA -D3, EMP +1"
    else if di < 86 then "Insatiable hunger"
    else if di < 101 then "Dark Minions recognise them"
    else "Subject to Instability"

skillNames = [
    "Advocate", "Animals", "Art", "Athletics", "Business", "Carouse", "Computers",
    "Deception", "Diplomat", "Drive", "Electronics", "Empathy Use", "Engineer", "Explosives",
    "Gambler", "Gun Combat", "Heavy Weapons", "Investigate", "Language", "Leadership",
    "Mechanic", "Medic", "Melee", "Navigation", "Persuade", "Pilot", "Profession", "Recon",
    "Science", "Seafarer", "Stealth", "Streetwise", "Survival", "Tactics"]

characterTable = ruleset
{
    rulesetConfiguration = { important = [Characteristics, Operative.Condition, Checks, Attacks] }
    Operative = table
    {
        tableLayout = layout { columns = 2 }
        Hometown = string {}
        Age = integer { default = 18 }
        Career = string {}
        Assignment = string {}
        Rank = string {}
        Condition = string { description = "Health from STR, DEX and END: wounded, unconscious or dead when they drop to 0." value = condition (Characteristics.'STR'.Current, Characteristics.'DEX'.Current, Characteristics.'END'.Current)  editable = none }
        'Map condition' = string
        {
            value = mapCondition (condition (Characteristics.'STR'.Current, Characteristics.'DEX'.Current, Characteristics.'END'.Current))
            visible = none
            indicator = "#d64545"
        }
    }

    Checks = table
    {
        tableLayout = layout { columns = 2 }
        Roll = selector
        {
            description = "Boon rolls 3d6 and keeps the best two; bane keeps the worst two."
            options = ["Bane", "Normal", "Boon"]
            labels = ["Bane", "Normal", "Boon"]
            colors = ["red", "white", "green"]
            hold = ["Ctrl", "", "Shift"]
            default = "Normal"
            editable = live
            save = nosave
        }
        Initiative = modifier
        {
            description = "Bonus to the initiative roll: the better of the DEX and INT modifiers."
            value = max (Characteristics.'DEX'.DM, Characteristics.'INT'.DM)
            valuedice = initiativeRoll (characterTable)
        }
        Unskilled = modifier
        {
            description = "Modifier for a skill you have no level in, softened by Jack of All Trades."
            value = untrainedDM (characterTable)
            valuedice = checkRoll (characterTable)
        }
        'Jack of All Trades' = integer { description = "Reduces the penalty for using skills you are not trained in." default = 0  minvalue = 0  maxvalue = 3 }
        'Night of rest' = button
        {
            description = "A night's rest brings lost END back. STR and DEX need days of rest and a Medic check."
            editable = live
            onClick = updates { (root.Characteristics.'END'.Current) = Characteristics.'END'.Max }
        }
    }

    Characteristics = keyvalues
    {
        description = "The seven characteristics. Damage is taken from STR, DEX and END."
        singular = "Characteristic"
        keys = ["STR", "DEX", "END", "INT", "EDU", "CHA", "EMP"]
        valueType = custom
        {
            Max = integer { description = "Characteristic score when unhurt, usually 2 to 12." default = 7  minvalue = 0  maxvalue = 15 }
            Current = integer { description = "Current score, lowered by damage, fatigue or EMP use." default = Max  minvalue = 0  editable = live }
            DM = modifier
            {
                description = "Modifier from the current score, added to 2d6 checks against 8."
                value = characteristicDM (Current)
                valuedice = checkRoll (characterTable)
            }
        }
    }

    Skills = keyvalues
    {
        description = "Skills. Roll 2d6 plus skill level plus characteristic DM; 8 or more succeeds."
        singular = "Skill"
        editablekeys = character
        keys = skillNames
        valueType = custom
        {
            Trained = bool { default = true }
            Level = integer { description = "Skill level, added to the check." default = 0  minvalue = 0 }
            Characteristic = string { description = "The characteristic used for this check, picked to suit the task." keys = ["", "STR", "DEX", "END", "INT", "EDU", "CHA", "EMP"]  default = ""  editable = live }
            Check = modifier
            {
                description = "Total modifier for a 2d6 check with this skill."
                value = skillDM (characterTable, Trained, Level, Characteristic)
                valuedice = checkRoll (characterTable)
            }
        }
    }

    Company = table
    {
        tableLayout = layout { columns = 2 }
        Trust = integer { description = "How much the cell's patrons trust the operative." default = 0  editable = live }
        'Dark Influence' = integer { description = "How far the operative has been touched by the darkness. It brings gifts and costs." default = 0  minvalue = 0  editable = live }
        'Missions Completed' = integer { default = 0  minvalue = 0  editable = live }
        'Dark Influence effect' = string { description = "What the current dark influence does to the operative." value = darkInfluenceEffect ('Dark Influence')  editable = none }
        Training = string { multiline = true }
    }

    'HQ Information' = table
    {
        tableLayout = layout { columns = 2 }
        'HQ Location' = string {}
        'Improvement Level' = integer { default = 0 }
        'Cell Resources' = string { editable = live }
    }

    'Enemies Rivals Allies Contacts' = list
    {
        singular = "Connection"
        editable = character
        tableLayout = layout { size = wide }
        valueType = custom
        {
            Type = string { keys = ["Ally", "Contact", "Rival", "Enemy"]  default = "Contact" }
            Name = string {}
            Notes = string {}
        }
    }

    Weapons = list
    {
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
        tableLayout = layout { size = wide }
    }

    Attacks = list
    {
        source = attacksFor (characterTable)
        singular = "Attack"
        editable = none
        valueType = weaponAttack
        tableLayout = layout { size = wide }
    }

    Armour = list
    {
        source = secondary.Armour
        singular = "Armour"
        editable = character
        tableLayout = layout { size = wide }
    }

    Equipment = list
    {
        source = secondary.Equipment
        singular = "Equipment"
        editable = character
        tableLayout = layout { size = wide }
    }

    'Empathic Talents' = list
    {
        source = secondary.'Empathic Talents'
        singular = "Empathic talent"
        editable = character
        tableLayout = layout { size = wide }
    }

    'Talent Uses' = list
    {
        source = talentUsesFor (characterTable)
        singular = "Talent use"
        editable = none
        valueType = talentUse
        tableLayout = layout { size = wide }
    }

    'Career History' = list
    {
        singular = "Term"
        editable = character
        tableLayout = layout { size = wide }
        valueType = custom
        {
            Term = string {}
            'Career and Assignment' = string {}
            'Event or Mishap' = string {}
        }
    }

    Notes = table
    {
        tableLayout = layout { rowTitle = hidden  size = wide }
        Notes = string { multiline = true }
    }
}

minionTable = ruleset
{
    rulesetConfiguration = { important = [Stats, Attacks] }
    Stats = table
    {
        tableLayout = layout { columns = 2 }
        Hits = integer { description = "Hits the minion can take." default = 10 }
        'Current Hits' = integer { description = "Hits left. At 0 the minion is down." default = Hits  minvalue = 0  editable = live }
        'Map condition' = string { value = hitsCondition ('Current Hits', Hits)  visible = none  indicator = "#d64545" }
        EMP = integer { description = "Empathic energy for powers." default = 0 }
        'Current EMP' = integer { description = "Empathic energy left." default = EMP  minvalue = 0  editable = live }
        Instability = string {}
        Speed = string { default = "6m" }
        Protection = integer { description = "Armour that reduces damage from each hit." default = 0 }
        Initiative = modifier { description = "Modifier to the minion's initiative roll." default = 0  valuedice = 2d6 }
        Check = modifier { description = "Modifier for the minion's general checks." default = 0  valuedice = plainAsked }
        'Attack DM' = modifier { description = "Modifier for the minion's attack roll." default = 0  valuedice = plainAsked  action = melee  reach = 2 }
        'Attack damage' = string { default = "1D"  visible = editor }
        Damage = integer
        {
            description = "Damage dealt by a hit."
            value = damageBonus ('Attack damage')
            render = 'Attack damage'
            valuedice = damageDice (damageDiceCount ('Attack damage'))
        }
    }
    Abilities = table
    {
        Skills = string { multiline = true }
        Esoterica = string {}
        Attacks = string { multiline = true }
        Traits = string { multiline = true }
        Behaviour = string {}
    }
    Weapons = list
    {
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
        tableLayout = layout { size = wide }
    }
    Attacks = list
    {
        source = minionAttacksFor (minionTable)
        singular = "Attack"
        editable = none
        valueType = weaponAttack
        tableLayout = layout { size = wide }
    }
    'Empathic Talents' = list
    {
        source = secondary.'Empathic Talents'
        singular = "Empathic talent"
        editable = character
        tableLayout = layout { size = wide }
    }
    'Talent Uses' = list
    {
        source = minionTalentUsesFor (minionTable)
        singular = "Talent use"
        editable = none
        valueType = talentUse
        tableLayout = layout { size = wide }
    }
}

weaponStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/armour.svg"
    }
    Stats = table
    {
        Skill = string { keys = ["Melee (blade)", "Melee (bludgeon)", "Melee (unarmed)", "Gun Combat (pistol)", "Gun Combat (rifle)", "Gun Combat (archaic)", "Heavy Weapons (portable)", "Athletics (dexterity)", "Explosives"] }
        Range = string {}
        'Damage dice' = string { default = "3D"  visible = editor }
        Damage = integer
        {
            value = damageBonus ('Damage dice')
            render = 'Damage dice'
            valuedice = damageDice (damageDiceCount ('Damage dice'))
        }
        Kg = string {}
        Requisition = string {}
        Magazine = string {}
        'Magazine Requisition' = string {}
        Traits = string {}
        Ammo = integer { editable = live }
    }
}

armourStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/armour.svg"
    }
    Stats = table
    {
        Protection = integer { default = 0 }
        Rad = string {}
        Kg = string {}
        Requisition = string {}
    }
}

equipmentStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/armour.svg"
    }
    Stats = table
    {
        Category = string {}
        Kg = string {}
        Requisition = string {}
        Quantity = integer { default = 1  editable = live }
    }
}

talentStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
    }
    Stats = table
    {
        Speciality = string { keys = ["Computers", "Drain", "Foreboding", "Healing", "Project Mind", "Sense Mind"] }
        'EMP Cost' = string {}
        Reach = string {}
        Difficulty = string {}
        Duration = string {}
    }
}

darkConspiracyNameSetting = nameSetting
{
    name = "Dark Conspiracy"
    characters = [generator { library = "Spy thriller" variant = "Agent" }, generator { library = "Spy thriller" variant = "Codename" }]
    creatures = [generator { library = "Cosmic horror" variant = "Entity" }, generator { library = "Spy thriller" variant = "Agent" }]
    Location = [generator { library = "Spy thriller" variant = "Safehouse" }, generator { library = "Spy thriller" variant = "Operation" }, generator { library = "Spy thriller" variant = "Agency" }, generator { library = "Cosmic horror" variant = "Cult" }]
}

DarkConspiracy = system
{
    hints = [
        hint
        {
            title = "The cell"
            topic = "Getting started"
            text = ["The characters are a cell working against the Dark Minions. Decide who employs them, and set their Trust under Company."]
        },
        hint
        {
            title = "Careers"
            topic = "Characters"
            text = ["Build characters through their careers. Untick Trained on any skill they lack so it rolls unskilled."]
        },
        hint
        {
            title = "Initiative"
            topic = "Initiative"
            text = ["Call initiative and everyone rolls 2D6 plus the better of the DEX and INT DMs. Highest acts first."]
        },
        hint
        {
            title = "Boons and Banes"
            topic = "Play"
            text = ["Set Roll under Checks to Boon or Bane when the situation helps or hinders. Several do not stack, and one of each cancels."]
        },
        hint
        {
            title = "Endurance first"
            topic = "Combat"
            text = ["Damage comes off END first, then STR or DEX. Condition shows Wounded, Unconscious or Dead."]
        },
        hint
        {
            title = "Keep the darkness unseen"
            topic = "Style"
            text = ["Raise Dark Influence when the cell faces the Dark Minions, and let most of the conspiracy stay hidden."]
        }
    ]
    libraries = ["/systems/darkconspiracy/basics.json", "/systems/names/spies.json", "/systems/names/cosmic.json", "/systems/tables/scifi.json", "/systems/tables/modern.json"]
    nameSettings = [darkConspiracyNameSetting]
    characters = characterTable
    creatures = minionTable
    Weapons = weaponStats
    Armour = armourStats
    Equipment = equipmentStats
    'Empathic Talents' = talentStats
    description = "Dark Conspiracy, The Unseen War"
    secondaryTypes = ["Weapons", "Armour", "Equipment", "Empathic Talents"]
    initiativeCompare (item1, item2) = compare (item1, item2)
    quickdice = [2d6, 1d6, 3d6]
    distanceUnit = "m"
    squareSize = 2
    cssFiles = ["/systems/darkconspiracy/darkconspiracy.css"]
}
