#include "/systems/common.frules"
#include "/systems/names/settings.frules"

statModifier (score) =
    if score < 4 then -4
    else if score < 6 then -3
    else if score < 8 then -2
    else if score < 10 then -1
    else if score < 12 then 0
    else if score < 14 then 1
    else if score < 16 then 2
    else if score < 18 then 3
    else 4

d20Total (mode, rolls) =
    if mode == "Advantage" then max (rolls)
    else if mode == "Disadvantage" then min (rolls)
    else first (rolls)

checkResult (bonus, natural, dc) = luckyResult (bonus, natural, dc, 0)

luckyResult (bonus, natural, dc, reroll) =
{
    Text = toString (natural + bonus) + (if dc > 0 then " vs DC " + toString (dc) + ": " + (if natural == 20 then "Critical success" else if natural == 1 then "Critical failure" else if natural + bonus >= dc then "Success" else "Failure") else if natural == 20 then " (natural 20)" else if natural == 1 then " (natural 1)" else "")
    Value = natural + bonus
    Outcome = if natural == 20 then "Critical" else if natural == 1 then "Fumble" else if dc > 0 then (if natural + bonus >= dc then "Success" else "Failure") else ""
    Push = reroll
    PushLabel = "Spend luck"
    PushSets = [{ Field = "characterTable.Combat.Luck"  Value = false }]
}

sdRoll (mode, dc) = ([dice { number = if mode == "Normal" then 1 else 2  sides = 20  color = if mode == "Advantage" then "green" else if mode == "Disadvantage" then "red" else "" }],
    ((baseline, throws)->checkResult (baseline, d20Total (mode, first (throws).rolls), dc)))

sdAskedRoll (mode) = ([dice { number = if mode == "Normal" then 1 else 2  sides = 20  color = if mode == "Advantage" then "green" else if mode == "Disadvantage" then "red" else "" }],
    ((baseline, throws)->checkResult (baseline, d20Total (mode, first (throws).rolls), asked)))

sdLuckyRoll (mode, luck) = ([dice { number = if mode == "Normal" then 1 else 2  sides = 20  color = if mode == "Advantage" then "green" else if mode == "Disadvantage" then "red" else "" }],
    ((baseline, throws)->luckyResult (baseline, d20Total (mode, first (throws).rolls), asked, if luck then sdLuckReroll (mode, baseline) else 0)))

sdLuckReroll (mode, bonus) = ([dice { number = if mode == "Normal" then 1 else 2  sides = 20  color = if mode == "Advantage" then "green" else if mode == "Disadvantage" then "red" else "" }],
    ((baseline, throws)->checkResult (bonus, d20Total (mode, first (throws).rolls), asked)))

sdDice (char) = ask ("DC", sdLuckyRoll (char.Character.Roll, char.Combat.Luck))

sdAttackDice (char) = ask ("Target AC", sdLuckyRoll (char.Character.Roll, char.Combat.Luck))

monsterAttackDice = ask ("Target AC", sdAskedRoll ("Normal"))

plainD20 = sdRoll ("Normal", 0)

stat = custom
{
    Score = integer { description = "Stat score from 3 to 18." default = 10  minvalue = 3  maxvalue = 18 }
    Modifier = modifier { description = "Modifier from the score, added to d20 checks with this stat." value = statModifier (Score)  valuedice = sdDice (characterTable)  editable = none }
}

weaponStat (weapon, field) = valueOr (weapon.data.weaponStats.Stats, field, "")

rangeFeet (text) =
    if text == "Close" then 5
    else if text == "Near" then 30
    else if text == "Far" then 120
    else 5

usesDex (char, weapon) =
    contains (weaponStat (weapon, "Properties"), "Finesse") and char.Stats.DEX.Modifier > char.Stats.STR.Modifier

weaponAttack (name, bonus, damage, kind, distance) = custom
{
    Name = name
    Attack = modifier { value = bonus  valuedice = sdAttackDice (characterTable)  action = kind  reach = 5  range = distance }
    Damage = damage
}

attackFor (char, weapon) =
    if weaponStat (weapon, "Type") == "Ranged" then
        weaponAttack (weapon.Name, char.Stats.DEX.Modifier + char.Character.'Attack Bonus', weaponStat (weapon, "Damage"), "ranged", rangeFeet (weaponStat (weapon, "Range")))
    else
        weaponAttack (weapon.Name, (if usesDex (char, weapon) then char.Stats.DEX.Modifier else char.Stats.STR.Modifier) + char.Character.'Attack Bonus', weaponStat (weapon, "Damage"), "melee", 5)

isThrown (weapon) = weaponStat (weapon, "Type") == "Melee and Ranged" or (contains (weaponStat (weapon, "Properties"), "Thrown") and weaponStat (weapon, "Type") != "Ranged")

thrownFor (char, weapon) =
    weaponAttack (weapon.Name + " (thrown)", max (char.Stats.STR.Modifier, char.Stats.DEX.Modifier) + char.Character.'Attack Bonus', weaponStat (weapon, "Damage"), "ranged", rangeFeet (if weaponStat (weapon, "Range") == "" or weaponStat (weapon, "Range") == "Close" then "Near" else weaponStat (weapon, "Range")))

characterTable = ruleset
{
    rulesetConfiguration = { important = [Combat, Stats, Attacks] }
    Character = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Ancestry = string { keys = ["Dwarf", "Elf", "Goblin", "Halfling", "Half-Orc", "Human"] }
        Class = string { keys = ["Fighter", "Priest", "Thief", "Wizard"] }
        Level = integer { description = "Character level. Level 0 characters are untrained villagers." default = 1  minvalue = 0  maxvalue = 10 }
        XP = integer { description = "Experience points, earned mostly from treasure." default = 0  editable = live }
        Title = string {}
        Alignment = string { keys = ["Lawful", "Neutral", "Chaotic"] }
        Background = string {}
        Deity = string {}
        'Attack Bonus' = integer { description = "Bonus to attack rolls from class and level." default = 0 }
        Roll = selector
        {
            description = "Advantage rolls two d20s and keeps the better, disadvantage the worse."
            options = ["Disadvantage", "Normal", "Advantage"]
            labels = ["Dis", "Normal", "Adv"]
            colors = ["red", "white", "green"]
            hold = ["Ctrl", "", "Shift"]
            default = "Normal"
            editable = live
            save = nosave
        }
    }

    Stats = table
    {
        description = "The six stats and their modifiers."
        tableLayout = layout { columns = 3  size = wide }
        STR = stat { description = "Strength: melee attacks, climbing and lifting." }
        DEX = stat { description = "Dexterity: ranged attacks, AC, initiative and sneaking." }
        CON = stat { description = "Constitution: hit points and resisting poison or exhaustion." }
        INT = stat { description = "Intelligence: wizard spells and knowledge." }
        WIS = stat { description = "Wisdom: priest spells and perception." }
        CHA = stat { description = "Charisma: persuasion and leadership." }
    }

    Combat = table
    {
        tableLayout = layout { columns = 4  size = wide }
        AC = integer { description = "Armor Class: 10 plus DEX, or the armor's value." default = 10 + Stats.DEX.Modifier }
        'Max HP' = integer { description = "Hit points when unhurt." default = 4 }
        HP = integer { description = "Current hit points. At 0 you are dying." default = 'Max HP'  editable = live }
        Dying = string { value = if HP < 1 then "Dying" else ""  visible = none  indicator = "#d64545" }
        Initiative = modifier { description = "Initiative: d20 plus DEX modifier." value = Stats.DEX.Modifier  valuedice = 1d20  editable = none }
        Luck = bool { description = "A luck token lets you reroll any roll once." default = false  editable = live  indicator = "#d4b106"  indicatorLabel = "Luck token" }
        Torch = clock { description = "Torch time. A torch burns for an hour of real time." segments = 6  editable = live }
        Rest = button { description = "Eight hours of rest and a ration: all hit points come back, and lost spells can be cast again. Untick Lost on your spells."  editable = live  onClick = updates { (root.Combat.HP) = 'Max HP' } }
    }

    Talents = list
    {
        description = "Talents rolled at levels with odd numbers, and from your class."
        tableLayout = layout { size = wide }
        singular = "Talent"
        editable = character
        valueType = nameAndDescription
    }

    Weapons = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        source = concat (map ((weapon)->attackFor (characterTable, weapon), characterTable.Weapons), map ((weapon)->thrownFor (characterTable, weapon), filter ((weapon)->isThrown (weapon), characterTable.Weapons)))
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }

    Spells = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Spells
        singular = "Spell"
        editable = character
    }

    'Spellcasting Check' = table
    {
        description = "Spellcasting checks: d20 plus the stat against 10 plus the spell tier."
        visible = if Character.Class == "Priest" or Character.Class == "Wizard" then visible else none
        'Priest uses WIS' = modifier { value = Stats.WIS.Modifier  valuedice = sdDice (characterTable)  editable = none }
        'Wizard uses INT' = modifier { value = Stats.INT.Modifier  valuedice = sdDice (characterTable)  editable = none }
    }

    Gear = table
    {
        tableLayout = layout { columns = 3  size = wide }
        'Gear Slots' = integer { description = "Item slots you can fill: your STR score, at least 10." value = max (10, Stats.STR.Score)  editable = none }
        GP = integer { description = "Gold pieces." default = 0  editable = live }
        SP = integer { description = "Silver pieces, ten to a gold." default = 0  editable = live }
        CP = integer { description = "Copper pieces, ten to a silver." default = 0  editable = live }
    }

    Items = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Gear
        singular = "Item"
        editable = character
    }
}

creatureTable = ruleset
{
    rulesetConfiguration =
    {
        important = [Stats, Attacks]
        defaultImage = "/images/armour.svg"
        sortedBy = sort { prefix = "LV" sort = Stats.Level }
    }
    Stats = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Level = integer { description = "Monster level, which sets its XP and toughness." default = 1 }
        AC = integer { description = "Armor Class." default = 12 }
        'Max HP' = integer { default = 5 }
        HP = integer { description = "Current hit points." default = 'Max HP'  editable = live }
        Movement = string { description = "How far the monster moves each turn." default = "Near" }
        Alignment = string { keys = ["Lawful", "Neutral", "Chaotic"] }
        STR = modifier { default = 0  valuedice = plainD20 }
        DEX = modifier { default = 0  valuedice = plainD20 }
        CON = modifier { default = 0  valuedice = plainD20 }
        INT = modifier { default = 0  valuedice = plainD20 }
        WIS = modifier { default = 0  valuedice = plainD20 }
        CHA = modifier { default = 0  valuedice = plainD20 }
        Initiative = modifier { value = DEX  valuedice = 1d20  editable = none }
        Dead = string { value = if HP < 1 then "Dead" else ""  visible = none  indicator = "#d64545" }
    }
    Attacks = list
    {
        tableLayout = layout { size = wide }
        singular = "Attack"
        editable = character
        valueType = custom
        {
            Name = string {}
            Range = string { description = "Close for melee; Near or Far for ranged and thrown attacks." default = "Close"  keys = ["Close", "Near", "Far"] }
            Attack = modifier { default = 1  valuedice = monsterAttackDice  action = if Range == "Near" or Range == "Far" then "ranged" else "melee"  reach = 5  range = rangeFeet (Range) }
            Damage = string {}
        }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        Abilities = string { multiline = true }
    }
}

weaponStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Type = string { keys = ["Melee", "Ranged", "Melee and Ranged"] }
        Range = string { keys = ["Close", "Near", "Far"] }
        Damage = string {}
        Properties = string {}
        Cost = string {}
    }
}

gearStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Slots = integer { default = 1 }
        Cost = string {}
    }
}

spellStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        sortedBy = sort { prefix = "Tier" sort = Stats.Tier }
    }
    Stats = table
    {
        Class = string { keys = ["Priest", "Wizard"] }
        Tier = integer { default = 1 }
        Duration = string {}
        Range = string { keys = ["Self", "Close", "Near", "Far"] }
        Lost = bool { default = false  editable = live }
    }
}

Shadowdark = system
{
    hints = [
        hint
        {
            title = "Real-time torches"
            topic = "Getting started"
            text = ["A torch lasts an hour of real time. Use the Torch clock on the sheet to count it down."]
        },
        hint
        {
            title = "Checks"
            topic = "Play"
            text = ["d20 + modifier against a DC. Each roll asks for the DC; use the slider for advantage and disadvantage. Leave it blank when only the GM knows it."]
        },
        hint
        {
            title = "Clockwise"
            topic = "Initiative"
            text = ["Everyone rolls Initiative (d20 + DEX); the highest goes first, then play goes clockwise round the table. Drag tokens into that order."]
        },
        hint
        {
            title = "Spellcasting"
            topic = "Play"
            text = ["Casters roll against 10 + the spell's tier. A failed spell is lost until rest."]
        }
    ]
    distanceUnit = "ft"
    squareSize = 5
    characters = characterTable
    creatures = creatureTable
    Weapons = weaponStats
    Gear = gearStats
    Spells = spellStats
    secondaryTypes = ["Weapons", "Gear", "Spells"]
    description = "Shadowdark: dungeon crawling by torchlight, in real time"
    initiativeCompare (item1, item2) = compare (toInt (item1), toInt (item2))
    quickdice = [1d20, 1d4, 1d6, 1d8, 1d10, 1d12]
    cssFiles = ["/systems/shadowdark/shadowdark.css"]
    libraries = ["/systems/names/fantasy.json", "/systems/names/barbarian.json", "/systems/names/gothic.json"]
    nameSettings = [fantasyNameSetting, swordAndSorceryNameSetting, gothicHorrorNameSetting]
}
