#include "/systems/common.frules"
#include "/systems/names/settings.frules"

successesIn (rolls) = count (filter ((x)->x >= 7, rolls)) + count (filter ((x)->x == 10, rolls))

exOutcome (rolls) =
    if successesIn (rolls) == 0 and count (filter ((x)->x == 1, rolls)) > 0 then "Botch"
    else if successesIn (rolls) == 0 then "Failure"
    else "Success"

exResult (rolls) =
{
    Text = toString (successesIn (rolls)) + (if successesIn (rolls) == 1 then " success" else " successes") + (if exOutcome (rolls) == "Botch" then ": botch" else "")
    Value = successesIn (rolls)
    Outcome = exOutcome (rolls)
}

exRoll (pool) = ([dice { number = max (0, pool)  sides = 10 }], ((baseline, throws)->exResult (first (throws).rolls)))

exAsked (pool) = ask ("Extra dice", 0, (n)->exRoll (pool + n))

attackResult (rolls, defense) =
{
    Text = toString (successesIn (rolls)) + (if successesIn (rolls) == 1 then " success" else " successes") + (if defense > 0 then (if successesIn (rolls) >= defense then " vs Defense " + toString (defense) + ": hit, " + toString (successesIn (rolls) - defense) + " extra" else " vs Defense " + toString (defense) + ": miss") else "") + (if exOutcome (rolls) == "Botch" then ": botch" else "")
    Value = successesIn (rolls) - defense
    Outcome = if exOutcome (rolls) == "Botch" then "Botch" else if defense > 0 then (if successesIn (rolls) >= defense then "Hit" else "Miss") else ""
}

attackRoll (pool) = ask ("Target's Defense", ([dice { number = max (0, pool)  sides = 10 }], ((baseline, throws)->attackResult (first (throws).rolls, asked))))

joinBattle (pool) = ([dice { number = max (0, pool)  sides = 10 }], ((baseline, throws)->{ Text = "Initiative " + toString (successesIn (first (throws).rolls) + 3)  Value = successesIn (first (throws).rolls) + 3 }))

damageRoll (pool) = ([dice { number = max (1, pool)  sides = 10 }], ((baseline, throws)->{ Text = toString (successesIn (first (throws).rolls)) + " damage"  Value = successesIn (first (throws).rolls) }))

woundPenalty (char) =
    switch char.Health.Bashing + char.Health.Lethal + char.Health.Aggravated - (char.Health.'Health levels' - 7)
        case 1 then 0
        case 2 then 1
        case 3 then 1
        case 4 then 2
        case 5 then 2
        case 6 then 4
        else if char.Health.Bashing + char.Health.Lethal + char.Health.Aggravated - (char.Health.'Health levels' - 7) <= 1 then 0 else 4

healthState (char) =
    if char.Health.Bashing + char.Health.Lethal + char.Health.Aggravated >= char.Health.'Health levels' then "Incapacitated"
    else if woundPenalty (char) > 0 then "Wounded -" + toString (woundPenalty (char))
    else ""

attributeValue (char, name) =
    switch name
        case "Strength" then char.Attributes.Strength
        case "Dexterity" then char.Attributes.Dexterity
        case "Stamina" then char.Attributes.Stamina
        case "Charisma" then char.Attributes.Charisma
        case "Manipulation" then char.Attributes.Manipulation
        case "Appearance" then char.Attributes.Appearance
        case "Perception" then char.Attributes.Perception
        case "Intelligence" then char.Attributes.Intelligence
        else char.Attributes.Wits

attributeNames = ["Strength", "Dexterity", "Stamina", "Charisma", "Manipulation", "Appearance", "Perception", "Intelligence", "Wits"]

noAbility = { Dots = 0 }

dotsOf (char, name) = valueOr (valueOr (char.Abilities, name, noAbility), "Dots", 0)

ability (usual) = custom
{
    Dots = integer { description = "Ability dots from 0 to 5." default = 0  minvalue = 0  maxvalue = 5 }
    Favored = bool { description = "Caste or favored ability: cheaper to raise, and Charms for it are easier." default = false }
    With = string { description = "The attribute it rolls with, picked to suit the action." default = usual  keys = attributeNames  editable = live }
    Pool = integer { description = "Attribute plus ability, less the wound penalty. Each 7+ is a success, 10s count twice." value = attributeValue (characterTable, With) + Dots - woundPenalty (characterTable)  valuedice = exAsked (attributeValue (characterTable, With) + Dots - woundPenalty (characterTable))  editable = none }
}

noStats = { Stats = { Accuracy = "0" } }

weaponStat (weapon, field) = valueOr (valueOr (valueOr (weapon.data, "exWeapon", noStats), "Stats", noStats.Stats), field, "")

firstNumber (text) = bonusWithValue ([[text]], "^[^0-9]*([0-9]+)")

attack (name, pool, damage, kind, distance) = custom
{
    Name = name
    Attack = integer { value = pool  valuedice = attackRoll (pool)  action = kind  reach = 2  range = distance  editable = none }
    Damage = integer { description = "Withering damage dice: Strength plus the weapon's damage, before soak." value = damage  valuedice = damageRoll (damage)  editable = none }
}

isRanged (weapon) = weaponStat (weapon, "Ability") == "Archery" or weaponStat (weapon, "Ability") == "Thrown"

attackFor (char, weapon) =
    attack (weapon.Name, char.Attributes.Dexterity + dotsOf (char, weaponStat (weapon, "Ability")) + toInt (weaponStat (weapon, "Accuracy")) - woundPenalty (char), char.Attributes.Strength + toInt (weaponStat (weapon, "Damage")), if isRanged (weapon) then "ranged" else "melee", if isRanged (weapon) then firstNumber (weaponStat (weapon, "Range")) else 2)

characterTable = ruleset
{
    rulesetConfiguration = { important = [Health, Combat, Essence, Attacks] }
    Character = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Exalt = string { default = "Solar"  keys = ["Solar", "Lunar", "Dragon-Blooded", "Sidereal", "Abyssal", "Infernal", "Alchemical", "Liminal", "Getimian", "Exigent", "Mortal"] }
        Caste = string { description = "Solars: Dawn, Zenith, Twilight, Night or Eclipse." keys = ["Dawn", "Zenith", "Twilight", "Night", "Eclipse", "Other"] }
        'Supernal ability' = string {}
        Concept = string {}
        Anima = string { description = "The anima banner grows as peripheral motes are spent." default = "Dim"  keys = ["Dim", "Glowing", "Burning", "Bonfire"]  editable = live  indicator = "#d4b106" }
        'Limit trigger' = string {}
        Experience = integer { default = 0  editable = live }
        'Solar experience' = integer { default = 0  editable = live }
    }

    Attributes = table
    {
        description = "Physical, Social and Mental attributes, 1 to 5."
        tableLayout = layout { columns = 3  size = wide }
        Strength = integer { default = 1  minvalue = 1  maxvalue = 5 }
        Charisma = integer { default = 1  minvalue = 1  maxvalue = 5 }
        Perception = integer { default = 1  minvalue = 1  maxvalue = 5 }
        Dexterity = integer { default = 1  minvalue = 1  maxvalue = 5 }
        Manipulation = integer { default = 1  minvalue = 1  maxvalue = 5 }
        Intelligence = integer { default = 1  minvalue = 1  maxvalue = 5 }
        Stamina = integer { default = 1  minvalue = 1  maxvalue = 5 }
        Appearance = integer { default = 1  minvalue = 1  maxvalue = 5 }
        Wits = integer { default = 1  minvalue = 1  maxvalue = 5 }
    }

    Abilities = table
    {
        description = "Twenty-five abilities. A roll is attribute plus ability d10s; the roll asks for extra dice from stunts and Excellencies."
        tableLayout = layout { columns = 3  size = wide }
        Archery = ability ("Dexterity")
        Athletics = ability ("Dexterity")
        Awareness = ability ("Perception")
        Brawl = ability ("Dexterity")
        Bureaucracy = ability ("Intelligence")
        Craft = ability ("Intelligence")
        Dodge = ability ("Dexterity")
        Integrity = ability ("Wits")
        Investigation = ability ("Perception")
        Larceny = ability ("Dexterity")
        Linguistics = ability ("Intelligence")
        Lore = ability ("Intelligence")
        'Martial Arts' = ability ("Dexterity")
        Medicine = ability ("Intelligence")
        Melee = ability ("Dexterity")
        Occult = ability ("Intelligence")
        Performance = ability ("Charisma")
        Presence = ability ("Charisma")
        Resistance = ability ("Stamina")
        Ride = ability ("Dexterity")
        Sail = ability ("Dexterity")
        Socialize = ability ("Manipulation")
        Stealth = ability ("Dexterity")
        Survival = ability ("Wits")
        Thrown = ability ("Dexterity")
        War = ability ("Intelligence")
    }

    Essence = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Essence = integer { description = "The Exalt's power, 1 to 5." default = 1  minvalue = 1  maxvalue = 5 }
        'Max personal' = integer { description = "Solars: Essence x3 + 10." value = Essence * 3 + 10  editable = none }
        Personal = integer { description = "Personal motes, spent quietly." default = 'Max personal'  minvalue = 0  editable = live }
        'Max peripheral' = integer { description = "Solars: Essence x7 + 26." value = Essence * 7 + 26  editable = none }
        Peripheral = integer { description = "Peripheral motes; spending them flares the anima." default = 'Max peripheral'  minvalue = 0  editable = live }
        'Committed motes' = integer { default = 0  minvalue = 0  editable = live }
        'Permanent willpower' = integer { default = 5  minvalue = 1  maxvalue = 10 }
        Willpower = integer { description = "Spend one for an automatic success." default = 'Permanent willpower'  minvalue = 0  editable = live }
        Limit = integer { description = "The Great Curse: at 10, a Limit Break." default = 0  minvalue = 0  maxvalue = 10  editable = live  indicator = "#8e5cc4" }
    }

    Health = table
    {
        tableLayout = layout { columns = 4  size = wide }
        'Health levels' = integer { description = "-0, -1, -1, -2, -2, -4 and Incapacitated; Ox-Body adds more, which the sheet counts as extra -0 levels." default = 7 }
        Bashing = integer { default = 0  minvalue = 0  editable = live  indicator = "#e8913a" }
        Lethal = integer { default = 0  minvalue = 0  editable = live  indicator = "#d64545" }
        Aggravated = integer { default = 0  minvalue = 0  editable = live  indicator = "#555555" }
        'Wound penalty' = integer { description = "Taken off every dice pool and defense." value = woundPenalty (characterTable)  editable = none }
        State = string { value = healthState (characterTable)  visible = none  indicator = "#d64545" }
        'Night of rest' = button
        {
            description = "A night's sleep: bashing damage heals, Willpower +1, and motes come back. Lethal and aggravated heal over days and weeks; mark them off by hand."
            editable = live
            onClick = updates
            {
                (root.Health.Bashing) = 0
                (root.Essence.Willpower) = min (Essence.'Permanent willpower', Essence.Willpower + 1)
                (root.Essence.Personal) = max (0, Essence.'Max personal' - Essence.'Committed motes')
                (root.Essence.Peripheral) = Essence.'Max peripheral'
                (root.Character.Anima) = "Dim"
            }
        }
    }

    Combat = table
    {
        tableLayout = layout { columns = 4  size = wide }
        'Join battle' = integer { description = "Wits plus Awareness; successes plus 3 are the starting initiative." value = Attributes.Wits + dotsOf (characterTable, "Awareness")  valuedice = joinBattle (Attributes.Wits + dotsOf (characterTable, "Awareness") - woundPenalty (characterTable))  editable = none }
        Initiative = integer { description = "The current initiative. Withering attacks steal it; decisive attacks roll it as damage and reset it to 3." default = 3  editable = live  indicator = "#3a7bd5" }
        Parry = integer { description = "Half of Dexterity plus Melee (or Brawl), rounded up, plus the weapon's defense." value = (Attributes.Dexterity + max (dotsOf (characterTable, "Melee"), dotsOf (characterTable, "Brawl")) + 1) / 2 + 'Weapon defense' - woundPenalty (characterTable)  editable = none }
        'Weapon defense' = integer { default = 0 }
        Evasion = integer { description = "Half of Dexterity plus Dodge, rounded up, less mobility penalty." value = (Attributes.Dexterity + dotsOf (characterTable, "Dodge") + 1) / 2 - 'Mobility penalty' - woundPenalty (characterTable)  editable = none }
        'Mobility penalty' = integer { default = 0 }
        Resolve = integer { description = "Half of Wits plus Integrity, rounded up: defense against persuasion." value = (Attributes.Wits + dotsOf (characterTable, "Integrity") + 1) / 2  editable = none }
        Guile = integer { description = "Half of Manipulation plus Socialize, rounded up: defense against reading intentions." value = (Attributes.Manipulation + dotsOf (characterTable, "Socialize") + 1) / 2  editable = none }
        Soak = integer { description = "Stamina plus armor." value = Attributes.Stamina + 'Armor soak'  editable = none }
        'Armor soak' = integer { default = 0 }
        Hardness = integer { description = "Decisive attacks with less initiative than this do nothing." default = 0 }
        'Rush or disengage' = integer { value = Attributes.Dexterity + dotsOf (characterTable, "Athletics")  valuedice = exAsked (Attributes.Dexterity + dotsOf (characterTable, "Athletics") - woundPenalty (characterTable))  editable = none }
    }

    Weapons = list
    {
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        source = concat ([attack ("Unarmed", Attributes.Dexterity + dotsOf (characterTable, "Brawl") + 4 - woundPenalty (characterTable), Attributes.Strength + 7, "melee", 2)], map ((weapon)->attackFor (characterTable, weapon), characterTable.Weapons))
        singular = "Attack"
        editable = none
        valueType = attack
    }

    Charms = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Charms
        singular = "Charm"
        editable = character
    }

    Merits = list
    {
        singular = "Merit"
        editable = character
        valueType = custom
        {
            Name = string {}
            Dots = integer { default = 1  minvalue = 0  maxvalue = 5 }
        }
    }

    Intimacies = list
    {
        description = "Ties and principles that drive the character, Defining, Major or Minor."
        singular = "Intimacy"
        editable = character
        valueType = custom
        {
            Intimacy = string {}
            Intensity = string { default = "Minor"  keys = ["Minor", "Major", "Defining"] }
        }
    }

    Armor = list
    {
        source = secondary.Armor
        singular = "Armor"
        editable = character
    }

    Notes = table
    {
        tableLayout = layout { columns = 2  size = wide }
        Specialties = string { description = "Specialties add a die when they apply." multiline = true }
        History = string { multiline = true }
    }
}

creatureTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg"  important = [Stats, Attacks] }
    Stats = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Kind = string { keys = ["Mortal", "Exalt", "God", "Elemental", "Demon", "Fair Folk", "Undead", "Beast", "Other"] }
        Essence = integer { default = 1 }
        'Join battle' = integer { default = 4  valuedice = joinBattle ('Join battle') }
        Initiative = integer { default = 3  editable = live  indicator = "#3a7bd5" }
        'Health levels' = integer { default = 7 }
        Damage = integer { default = 0  minvalue = 0  editable = live  indicator = "#d64545" }
        Parry = integer { default = 2 }
        Evasion = integer { default = 2 }
        Soak = integer { default = 3 }
        Hardness = integer { default = 0 }
        Resolve = integer { default = 2 }
        Guile = integer { default = 1 }
        Willpower = integer { default = 5  editable = live }
        Motes = integer { default = 0  editable = live }
        Down = string { value = if Damage >= 'Health levels' then "Incapacitated" else ""  visible = none  indicator = "#555555" }
    }
    Attacks = keyvalues
    {
        singular = "Attack"
        editablekeys = character
        keys = ["Strike"]
        valueType = custom
        {
            Pool = integer { default = 6  valuedice = attackRoll (Pool)  action = if Ranged then "ranged" else "melee"  reach = 2  range = 50 }
            Damage = integer { default = 10  valuedice = damageRoll (Damage) }
            Ranged = bool { default = false }
        }
    }
    'Dice pools' = keyvalues
    {
        singular = "Pool"
        editablekeys = character
        keys = ["Senses", "Resist poison"]
        valueType = custom
        {
            Pool = integer { default = 4  valuedice = exAsked (Pool) }
        }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        Charms = string { multiline = true }
        Description = string { multiline = true }
    }
}

exWeapon = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/armour.svg"
        filters = [filter { name = "Ability" prefix = "" filter = Stats.Ability }]
    }
    Stats = table
    {
        tableLayout = layout { columns = 3 }
        Ability = string { default = "Melee"  keys = ["Melee", "Brawl", "Martial Arts", "Archery", "Thrown"] }
        Accuracy = string { description = "Dice added to the attack." default = "2" }
        Damage = string { description = "Added to Strength for withering damage dice." default = "9" }
        Defense = string { description = "Added to Parry." default = "1" }
        Overwhelming = string { default = "1" }
        Range = string { description = "Metres, for archery and thrown weapons." }
        Tags = string {}
    }
}

exArmor = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        tableLayout = layout { columns = 3 }
        Soak = string { default = "3" }
        Hardness = string { default = "0" }
        'Mobility penalty' = string { default = "0" }
        Tags = string {}
    }
}

exCharm = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        filters = [filter { name = "Ability" prefix = "" filter = Stats.Ability }, filter { name = "Type" prefix = "" filter = Stats.Type }]
        sortedBy = sort { prefix = "Ability" sort = Stats.Ability }
    }
    Stats = table
    {
        tableLayout = layout { columns = 3 }
        Ability = string {}
        Cost = string { description = "Motes, willpower, health or anima, such as 3m, 1wp." }
        Type = string { keys = ["Simple", "Supplemental", "Reflexive", "Permanent"] }
        Keywords = string {}
        Duration = string {}
        Prerequisites = string { description = "Minimum ability and Essence, and earlier Charms." }
    }
}

Exalted = system
{
    hints = [
        hint
        {
            title = "The Chosen of the Sun"
            topic = "Getting started"
            text = ["Pick a caste and the caste and favored abilities, spread dots over the nine attributes and twenty-five abilities, then Charms, merits and intimacies. Motes come from Essence."]
        },
        hint
        {
            title = "Rolling"
            topic = "Play"
            text = ["Roll attribute + ability d10s. Each 7 or more is a success, a 10 counts twice. The roll asks for extra dice: stunts (+1 or +2), Excellencies, specialties. No successes and any 1 is a botch. Wound penalties come off the pool already."]
        },
        hint
        {
            title = "Combat"
            topic = "Combat"
            text = ["Join battle: Wits + Awareness, successes + 3 is the starting initiative. Withering attacks steal initiative; decisive attacks roll initiative as damage. An attack asks for the target's Defense (Parry or Evasion) and shows the extra successes."]
        },
        hint
        {
            title = "Initiative"
            topic = "Initiative"
            text = ["Roll Join Battle; the highest initiative acts first each round, and the number changes as attacks land."]
        }
    ]
    distanceUnit = "m"
    characters = characterTable
    creatures = creatureTable
    Weapons = exWeapon
    Armor = exArmor
    Charms = exCharm
    secondaryTypes = ["Weapons", "Armor", "Charms"]
    description = "Exalted 3rd edition: demigods in a world of Essence and fate, d10 pools with double 10s, Charms, motes and the initiative of battle"
    initiativeCompare (item1, item2) = compare (item1, item2)
    quickdice = [1d10, 5d10, 10d10]
    cssFiles = ["/systems/exalted/exalted.css"]
    libraries = ["/systems/names/chinese.json", "/systems/names/fantasy.json", "/systems/names/desert.json"]
    nameSettings = [easternNameSetting, fantasyNameSetting, desertRealmsNameSetting]
}
