#include "/systems/common.frules"
#include "/systems/names/settings.frules"


edgeDice (rolls, mode) = if mode == "Bonus" then sum (rolls) - min (rolls) else if mode == "Penalty" then sum (rolls) - max (rolls) else sum (rolls)

edgeDropped (rolls, mode) = if mode == "Bonus" then " (dropped " + toString (min (rolls)) + ")" else if mode == "Penalty" then " (dropped " + toString (max (rolls)) + ")" else ""

edgeResult (rolls, mode) =
{
    Text = toString (edgeDice (rolls, mode)) + edgeDropped (rolls, mode)
    Value = edgeDice (rolls, mode)
}

edgeModeRoll (mode) = ([dice { number = 2  sides = 6 }, dice { number = if mode == "Bonus" or mode == "Penalty" then 1 else 0  sides = 6  color = if mode == "Bonus" then "green" else "red"  label = if mode == "Bonus" then "Bonus die" else if mode == "Penalty" then "Penalty die" else "" }],
    ((baseline, throws)-> edgeResult (concat (first (throws).rolls, item (1, throws).rolls), mode)))

edgeRoll (char) = edgeModeRoll (char.Basics.Roll)

characterTable = ruleset
{
  rulesetConfiguration = { important = [Basics] }
  Traits = table
  {
    tableLayout = layout
    {
      columns = 1
      rowTitle = hidden
    }

    'Main trait' = keyvalues
    {
      singular = "Main"
      editablekeys = character
      keys = ["Describe the main trait"]
      valueType = custom
      {
        Score = integer
        {
          default = 0
          valuedice = edgeRoll (characterTable)
        }
      }
    }
    'Side trait' = keyvalues
    {
      singular = "Side"
      editablekeys = character
      keys = ["Describe a side trait"]
      valueType = custom
      {
        Score = integer
        {
          default = 0
          valuedice = edgeRoll (characterTable)
        }
      }
    }

    'Trouble' = table
    {
      tableLayout = layout
      {
        columns = 1
        rowTitle = hidden
      }

        'Name' = string
        {
          multiline = true
        }
    }
  }


  Basics = table
  {
    Fight = integer
    {
      default=0
      valuedice = edgeRoll (characterTable)
      action = ranged
    }
    Sway = integer
    {
      default=0
      valuedice = edgeRoll (characterTable)
    }
    Weird = integer
    {
      default=0
      valuedice = edgeRoll (characterTable)
    }
    Roll = selector
    {
      options = ["Penalty", "Normal", "Bonus"]
      labels = ["Penalty die", "Normal", "Bonus die"]
      colors = ["red", "white", "green"]
      hold = ["Ctrl", "", "Shift"]
      default = "Normal"
      editable = live
      save = nosave
    }
    Strikes = slots
    {
      number = 3
      allowedchange = increaseAndClear
      editable = live
      indicator = "#d64545"
    }
  }
}




boolToVisible (flag)=
  if flag
    then visible
   else
      none


edge = system


{
    hints = [
        hint
        {
            title = "Welcome to Al Amarja"
            topic = "Getting started"
            text = ["Tell the players the island is strange, dangerous and full of overlapping conspiracies. Ask each one why their character came here."]
        },
        hint
        {
            title = "Free-form traits"
            topic = "Characters"
            text = ["Ask each player for a main trait, side traits and a trouble in plain words. Let the trouble cause problems now and then."]
        },
        hint
        {
            title = "No initiative roll"
            topic = "Initiative"
            text = ["Over the Edge has no initiative. Let the scene decide who acts first, and use a Fight roll when it matters."]
        },
        hint
        {
            title = "Strikes"
            topic = "Combat"
            text = ["Mark Strikes when a character is hurt. Three strikes take a character out of the action."]
        },
        hint
        {
            title = "Name suggestions"
            topic = "Settings"
            text = ["Pick a name setting such as Night world or Spy thriller, so new NPCs get names that fit the island."]
        }
    ]
    distanceUnit = "m"
    squareSize = 1
    libraries = ["/systems/edge/edge.json", "/systems/names/norwegian.json", "/systems/names/chinese.json", "/systems/names/nightworld.json", "/systems/names/spies.json", "/systems/names/cosmic.json", "/systems/names/cyberpunk.json"]
    nameSettings = [nightWorldNameSetting, spyThrillerNameSetting, cosmicHorrorNameSetting, neonStreetsNameSetting]
    characters = characterTable
    creatures = characterTable
    cssFiles = ["/systems/edge/edge.css"]
    description="Over The Edge"
    secondaryTypes = []
    quickdice =[2d6, 1d6]
}

