#include "/systems/common.frules"
#include "/systems/names/settings.frules"


edgeDice (rolls, mode) = if mode == "Bonus" then sum (rolls) - min (rolls) else if mode == "Penalty" then sum (rolls) - max (rolls) else sum (rolls)

edgeDropped (rolls, mode) = if mode == "Bonus" then " (dropped " + toString (min (rolls)) + ")" else if mode == "Penalty" then " (dropped " + toString (max (rolls)) + ")" else ""

edgeVerdict (total, difficulty) = if total >= difficulty then "Success" else "Failure"

edgeResult (rolls, mode, difficulty) =
{
    Text = toString (edgeDice (rolls, mode)) + edgeDropped (rolls, mode) + (if difficulty > 0 then " vs " + toString (difficulty) + ": " + edgeVerdict (edgeDice (rolls, mode), difficulty) else "")
    Value = edgeDice (rolls, mode)
    Outcome = if difficulty > 0 then edgeVerdict (edgeDice (rolls, mode), difficulty) else ""
}

edgeModeRoll (mode) = edgePool (mode, 2)

edgePool (mode, n) = ([dice { number = max (1, n)  sides = 6 }, dice { number = if mode == "Bonus" or mode == "Penalty" then 1 else 0  sides = 6  color = if mode == "Bonus" then "green" else "red"  label = if mode == "Bonus" then "Bonus die" else if mode == "Penalty" then "Penalty die" else "" }],
    ((baseline, throws)-> edgeResult (concat (first (throws).rolls, item (1, throws).rolls), mode, asked)))

edgeRoll (char) = edgeTraitRoll (char, 2)

edgeTraitRoll (char, n) = ask ("Difficulty", edgePool (char.Basics.Roll, n))

characterTable = ruleset
{
  rulesetConfiguration = { important = [Basics] }
  Traits = table
  {
    tableLayout = layout
    {
      columns = 1
      rowTitle = hidden
    }

    'Main trait' = keyvalues
    {
      description = "Your defining trait, the thing the character is best at, in your own words."
      singular = "Main"
      editablekeys = character
      keys = ["Describe the main trait"]
      valueType = custom
      {
        Score = integer
        {
          description = "Dice rolled when this trait applies: 2 is ordinary, 3 good, 4 exceptional."
          default = 2
          minvalue = 1
          valuedice = edgeTraitRoll (characterTable, Score)
        }
      }
    }
    'Side trait' = keyvalues
    {
      description = "Lesser traits that round out the character, each in a few words."
      singular = "Side"
      editablekeys = character
      keys = ["Describe a side trait"]
      valueType = custom
      {
        Score = integer
        {
          description = "Dice rolled when this trait applies: 2 is ordinary, 3 good, 4 exceptional."
          default = 2
          minvalue = 1
          valuedice = edgeTraitRoll (characterTable, Score)
        }
      }
    }

    'Trouble' = table
    {
      description = "A weakness or problem that keeps getting the character into trouble."
      tableLayout = layout
      {
        columns = 1
        rowTitle = hidden
      }

        'Name' = string
        {
          multiline = true
        }
    }
  }


  Basics = table
  {
    Fight = integer
    {
      description = "Your knack for violence: brawling, shooting and surviving a fight, in dice."
      default=2
      minvalue=1
      valuedice = edgeTraitRoll (characterTable, Fight)
      action = ranged
    }
    Sway = integer
    {
      description = "Your knack for persuading, charming, bluffing or bullying people, in dice."
      default=2
      minvalue=1
      valuedice = edgeTraitRoll (characterTable, Sway)
    }
    Weird = integer
    {
      description = "Your knack for the strange: odd powers, uncanny luck or hidden lore, in dice."
      default=2
      minvalue=1
      valuedice = edgeTraitRoll (characterTable, Weird)
    }
    Roll = selector
    {
      options = ["Penalty", "Normal", "Bonus"]
      labels = ["Penalty die", "Normal", "Bonus die"]
      colors = ["red", "white", "green"]
      hold = ["Ctrl", "", "Shift"]
      default = "Normal"
      editable = live
      save = nosave
    }
    Strikes = slots
    {
      description = "Harm taken. Three strikes and the character is out of the action."
      number = 3
      allowedchange = increaseAndClear
      editable = live
      indicator = "#d64545"
    }
    Heal = button
    {
      description = "Removes one strike, as when a wound heals or is treated."
      editable = live
      onClick = updates { (root.Basics.Strikes.realvalue) = max (0, Strikes.realvalue - 1) }
    }
  }
}




boolToVisible (flag)=
  if flag
    then visible
   else
      none


edge = system


{
    hints = [
        hint
        {
            title = "Welcome to Al Amarja"
            topic = "Getting started"
            text = ["Tell the players the island is strange, dangerous and full of overlapping conspiracies. Ask each one why their character came here."]
        },
        hint
        {
            title = "Free-form traits"
            topic = "Characters"
            text = ["Ask each player for a main trait, side traits and a trouble in plain words. Let the trouble cause problems now and then."]
        },
        hint
        {
            title = "No initiative roll"
            topic = "Initiative"
            text = ["Over the Edge has no initiative. Let the scene decide who acts first, and use a Fight roll when it matters."]
        },
        hint
        {
            title = "Strikes"
            topic = "Combat"
            text = ["Mark Strikes when a character is hurt. Three strikes take a character out of the action."]
        },
        hint
        {
            title = "Name suggestions"
            topic = "Settings"
            text = ["Pick a name setting such as Night world or Spy thriller, so new NPCs get names that fit the island."]
        }
    ]
    distanceUnit = "m"
    squareSize = 1
    libraries = ["/systems/edge/edge.json", "/systems/names/norwegian.json", "/systems/names/chinese.json", "/systems/names/nightworld.json", "/systems/names/spies.json", "/systems/names/cosmic.json", "/systems/names/cyberpunk.json"]
    nameSettings = [nightWorldNameSetting, spyThrillerNameSetting, cosmicHorrorNameSetting, neonStreetsNameSetting]
    characters = characterTable
    creatures = characterTable
    cssFiles = ["/systems/edge/edge.css"]
    description="Over The Edge"
    secondaryTypes = []
    quickdice =[2d6, 1d6]
}

