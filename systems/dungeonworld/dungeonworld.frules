#include "/systems/common.frules"
#include "/systems/names/settings.frules"

statModifier (score) =
    if score < 4 then -3
    else if score < 6 then -2
    else if score < 9 then -1
    else if score < 13 then 0
    else if score < 16 then 1
    else if score < 18 then 2
    else 3

moveOutcome (total) =
    if total > 9 then "Strong hit"
    else if total > 6 then "Weak hit"
    else "Miss"

moveText (total) =
    if total > 9 then "10+: you do it"
    else if total > 6 then "7-9: you do it, with a cost or a hard choice"
    else "6-: miss, mark XP, and the GM makes a move"

moveResult (total) =
{
    Text = toString (total) + ", " + moveText (total)
    Value = total
    Outcome = moveOutcome (total)
}

dwRoll (extra) = ([2d6], ((baseline, throws)->moveResult (baseline + extra + sum (first (throws).rolls))))

dwDice (char) = dwRoll (char.Status.Forward + char.Status.Ongoing)

stat (debility) = custom
{
    Score = integer { description = "Ability score from 3 to 18." default = 10  minvalue = 1  maxvalue = 18 }
    Debility = bool { description = "A debility gives -1 to this stat until healed." default = false  editable = live  indicator = "#d4b106"  indicatorLabel = debility }
    Modifier = modifier { description = "Modifier from the score, added to 2d6 for moves with this stat." value = statModifier (Score) - (if Debility then 1 else 0)  valuedice = dwDice (characterTable)  editable = none }
}

weaponStat (weapon, field) = valueOr (weapon.data.equipmentStats.Stats, field, "")

rangeOf (tags) =
    if contains (tags, "far") then 60
    else if contains (tags, "near") then 30
    else 0

weaponMove (name, statMod, damage, kind, distance) = custom
{
    Name = name
    Roll = modifier { value = statMod  valuedice = dwDice (characterTable)  action = kind  reach = 5  range = distance }
    Damage = damage
}

moveFor (char, weapon) =
    if rangeOf (toLower (weaponStat (weapon, "Tags"))) > 0 then
        weaponMove (weapon.Name + " (Volley)", char.Stats.DEX.Modifier, char.Status.Damage, "ranged", rangeOf (toLower (weaponStat (weapon, "Tags"))))
    else
        weaponMove (weapon.Name + " (Hack and Slash)", char.Stats.STR.Modifier, char.Status.Damage, "melee", if contains (toLower (weaponStat (weapon, "Tags")), "reach") then 10 else 5)

characterTable = ruleset
{
    rulesetConfiguration = { important = [Stats, Status, Attacks] }
    Character = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Class = string { keys = ["Bard", "Cleric", "Druid", "Fighter", "Paladin", "Ranger", "Thief", "Wizard"] }
        Race = string {}
        Alignment = string { keys = ["Good", "Lawful", "Neutral", "Chaotic", "Evil"] }
        Level = integer { description = "Character level from 1 to 10." default = 1  minvalue = 1  maxvalue = 10 }
        XP = slots { description = "Experience, marked on misses and at the end of a session. Full means level up." number = Level + 7  editable = live  allowedchange = increaseAndClear }
        Look = string { multiline = true }
        'Alignment Goal' = string { description = "How to act on your alignment and earn extra experience." }
    }

    Stats = table
    {
        description = "The six stats. Each has a debility that lowers its modifier by one."
        tableLayout = layout { columns = 3  size = wide }
        STR = stat ("Weak")
        DEX = stat ("Shaky")
        CON = stat ("Sick")
        INT = stat ("Stunned")
        WIS = stat ("Confused")
        CHA = stat ("Scarred")
    }

    Status = table
    {
        tableLayout = layout { columns = 4  size = wide }
        'Base HP' = integer { default = 8 }
        'Max HP' = integer { description = "Hit points when unhurt: class base plus CON score." value = 'Base HP' + Stats.CON.Score  editable = none }
        HP = integer { description = "Current hit points. At 0 you take your Last Breath." default = 'Max HP'  editable = live }
        Down = string { value = if HP < 1 then "Last Breath" else ""  visible = none  indicator = "#d64545" }
        'Make camp' = button { description = "Make Camp: after a few hours of sleep, heal damage equal to half your max HP."  editable = live  onClick = updates { (root.Status.HP) = min ('Max HP', HP + 'Max HP' / 2) } }
        Recover = button { description = "Recover: a few days of bed rest heals all damage."  editable = live  onClick = updates { (root.Status.HP) = 'Max HP' } }
        Damage = string { description = "Your class damage die, rolled when you deal damage." default = "d8" }
        'Damage Roll' = integer { default = 0  valuedice = 1d8 }
        Armor = integer { description = "Armor reduces the damage of each hit." default = 0 }
        Forward = modifier { description = "Bonus for your next roll only." default = 0  editable = live  indicator = "#3a7bd5"  indicatorLabel = "Forward" }
        Ongoing = modifier { description = "Bonus to every roll until the situation changes." default = 0  editable = live }
        'Last Breath' = integer { description = "Roll 2d6 when dying: 10+ you live, 7-9 Death offers a bargain, 6- you die." default = 0  valuedice = ([2d6], ((baseline, throws)->if sum (first (throws).rolls) > 9 then { Text = toString (sum (first (throws).rolls)) + ": you cheat death"  Outcome = "Strong hit" } else if sum (first (throws).rolls) > 6 then { Text = toString (sum (first (throws).rolls)) + ": Death offers a bargain"  Outcome = "Weak hit" } else { Text = toString (sum (first (throws).rolls)) + ": your time has come"  Outcome = "Miss" }))  editable = none }
    }

    'Basic Moves' = table
    {
        description = "The moves every character has, with the stat they roll. 10+ strong hit, 7-9 weak hit."
        tableLayout = layout { columns = 3  size = wide }
        'Hack and Slash' = modifier { description = "Attack in melee. Roll +STR." value = Stats.STR.Modifier  valuedice = dwDice (characterTable)  editable = none  action = melee  reach = 5 }
        Volley = modifier { description = "Shoot at range. Roll +DEX." value = Stats.DEX.Modifier  valuedice = dwDice (characterTable)  editable = none  action = ranged  range = 60 }
        'Defy Danger STR' = modifier { value = Stats.STR.Modifier  valuedice = dwDice (characterTable)  editable = none }
        'Defy Danger DEX' = modifier { value = Stats.DEX.Modifier  valuedice = dwDice (characterTable)  editable = none }
        'Defy Danger CON' = modifier { value = Stats.CON.Modifier  valuedice = dwDice (characterTable)  editable = none }
        'Defy Danger INT' = modifier { value = Stats.INT.Modifier  valuedice = dwDice (characterTable)  editable = none }
        'Defy Danger WIS' = modifier { value = Stats.WIS.Modifier  valuedice = dwDice (characterTable)  editable = none }
        'Defy Danger CHA' = modifier { value = Stats.CHA.Modifier  valuedice = dwDice (characterTable)  editable = none }
        Defend = modifier { description = "Protect someone or something. Roll +CON." value = Stats.CON.Modifier  valuedice = dwDice (characterTable)  editable = none }
        'Spout Lore' = modifier { description = "Recall useful knowledge. Roll +INT." value = Stats.INT.Modifier  valuedice = dwDice (characterTable)  editable = none }
        'Discern Realities' = modifier { description = "Study a situation closely to learn what is true. Roll +WIS." value = Stats.WIS.Modifier  valuedice = dwDice (characterTable)  editable = none }
        Parley = modifier { description = "Bargain with leverage. Roll +CHA." value = Stats.CHA.Modifier  valuedice = dwDice (characterTable)  editable = none }
        'Aid or Interfere' = modifier { description = "Help or hinder someone. Roll plus your bond with them." default = 0  valuedice = dwDice (characterTable) }
    }

    Moves = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Moves
        singular = "Move"
        editable = character
    }

    Bonds = list
    {
        description = "Bonds with other characters. Resolving one earns experience."
        tableLayout = layout { size = wide }
        singular = "Bond"
        editable = character
        valueType = string
    }

    Weapons = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Equipment
        filter = equipmentStats.Stats.Kind == "Weapon"
        singular = "Weapon"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        source = map ((weapon)->moveFor (characterTable, weapon), characterTable.Weapons)
        singular = "Attack"
        editable = none
        valueType = weaponMove
    }

    Gear = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Equipment
        filter = equipmentStats.Stats.Kind != "Weapon"
        singular = "Item"
        editable = character
    }

    Load = table
    {
        tableLayout = layout { columns = 3 }
        'Base Load' = integer { description = "Class base load before STR." default = 9 }
        'Max Load' = integer { description = "How much weight you can carry without slowing down." value = 'Base Load' + Stats.STR.Modifier  editable = none }
        Coin = integer { default = 0  editable = live }
        Spells = string { multiline = true }
    }
}

creatureTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg"  important = [Monster] }
    Monster = table
    {
        tableLayout = layout { columns = 3  size = wide }
        Tags = string { description = "Monster tags such as solitary, group, horde, large or magical." default = "Solitary, Large" }
        'Max HP' = integer { default = 10 }
        HP = integer { default = 'Max HP'  editable = live }
        Armor = integer { description = "Armor reduces the damage of each hit." default = 1 }
        Damage = string { description = "The monster's damage die." default = "d8" }
        'Damage Roll' = integer { default = 0  valuedice = 1d8  action = melee  reach = 5 }
        Instinct = string { description = "What the monster wants most, which guides how it acts." }
        Dead = string { value = if HP < 1 then "Defeated" else ""  visible = none  indicator = "#d64545" }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        Moves = string { multiline = true }
        Qualities = string { multiline = true }
        Description = string { multiline = true }
    }
}

moveStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        filters = [filter { name = "Class" prefix = "" filter = Stats.Class }]
    }
    Stats = table
    {
        Class = string {}
        Level = string { keys = ["Starting", "2-5", "6-10", "Basic", "Special"] }
        Stat = string { keys = ["STR", "DEX", "CON", "INT", "WIS", "CHA", ""] }
        Requires = string {}
    }
}

equipmentStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Kind = string { keys = ["Weapon", "Armor", "Gear", "Potion", "Poison", "Service"] }
        Tags = string {}
        Weight = string {}
        Cost = string {}
    }
}

classStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        'Base HP' = string {}
        Damage = string {}
        'Base Load' = string {}
        Races = string { multiline = true }
        Alignments = string { multiline = true }
        Bonds = string { multiline = true }
    }
}

DungeonWorld = system
{
    hints = [
        hint
        {
            title = "Fiction first"
            topic = "Getting started"
            text = ["Ask lots of questions and use the answers. Draw maps, leave blanks, and play to find out what happens."]
        },
        hint
        {
            title = "Moves"
            topic = "Play"
            text = ["When the fiction triggers a move, roll 2d6 + stat: 10+ strong hit, 7-9 weak hit, 6- miss and mark XP."]
        },
        hint
        {
            title = "No initiative"
            topic = "Initiative"
            text = ["There is no initiative. The spotlight moves between players as the fiction asks."]
        },
        hint
        {
            title = "Damage"
            topic = "Combat"
            text = ["Damage rolls the class's damage die minus armor. At 0 HP make the Last Breath move."]
        }
    ]
    distanceUnit = "ft"
    squareSize = 5
    characters = characterTable
    creatures = creatureTable
    entityTypeNames = [entityTypeName ("Creature", "Monster", "Monsters")]
    Moves = moveStats
    Equipment = equipmentStats
    Classes = classStats
    secondaryTypes = ["Moves", "Equipment"]
    otherLibararyTypes = ["Classes"]
    description = "Dungeon World: Powered by the Apocalypse fantasy, 2d6 moves and the fiction first"
    quickdice = [2d6, 1d4, 1d6, 1d8, 1d10, 1d12]
    cssFiles = ["/systems/dungeonworld/dungeonworld.css"]
    libraries = ["/systems/dungeonworld/dungeonworld.json", "/systems/names/fantasy.json", "/systems/names/barbarian.json", "/systems/names/faerie.json"]
    nameSettings = [fantasyNameSetting, swordAndSorceryNameSetting, faerieCourtsNameSetting]
}
