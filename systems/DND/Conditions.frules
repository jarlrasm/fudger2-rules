effectLine (flag, text) = if flag then [text] else []

joinEffects (lines) = fold ("", (acc, x)->if acc == "" then x else acc + ". " + x, lines)

exhaustionEffect (level) =
    if level > 5 then
        ["Exhaustion 6: dead"]
    else
        if level > 0 then
            ["Exhaustion " + toString (level) + ": " + toString (0 - 2 * level) + " to d20 Tests, Speed -" + toString (5 * level) + " ft"]
        else
            []

exhaustionLevel (char) = char.Conditions.Exhaustion

effectsVisible (exhaustion, flags) =
    if exhaustion > 0 then visible else if count (filter ((flag)->flag, flags)) > 0 then visible else none

downState (current, max) =
    if max > 0 then
        if current < 1 then "Down" else ""
    else
        ""

conditionEffects (blinded, charmed, deafened, frightened, grappled, incapacitated, invisible, paralyzed, petrified, poisoned, prone, restrained, stunned, unconscious, exhaustion) =
    joinEffects (flatten ([
        effectLine (blinded, "Blinded: can't see, attacks against it have advantage and its attacks have disadvantage"),
        effectLine (charmed, "Charmed: can't attack the charmer, who has advantage on social checks against it"),
        effectLine (deafened, "Deafened: can't hear"),
        effectLine (frightened, "Frightened: disadvantage on checks and attacks while it can see the source, and can't move closer to it"),
        effectLine (grappled, "Grappled: Speed 0, disadvantage on attacks against anyone but the grappler"),
        effectLine (incapacitated, "Incapacitated: no actions, bonus actions or reactions, and concentration ends"),
        effectLine (invisible, "Invisible: attacks against it have disadvantage and its attacks have advantage"),
        effectLine (paralyzed, "Paralyzed: incapacitated, Speed 0, fails Str and Dex saves, attacks against it have advantage and hits from within 5 ft are critical"),
        effectLine (petrified, "Petrified: turned to stone, incapacitated, Speed 0, resistant to all damage"),
        effectLine (poisoned, "Poisoned: disadvantage on attacks and ability checks"),
        effectLine (prone, "Prone: disadvantage on attacks, melee attacks against it have advantage and ranged ones disadvantage"),
        effectLine (restrained, "Restrained: Speed 0, disadvantage on attacks and Dex saves, attacks against it have advantage"),
        effectLine (stunned, "Stunned: incapacitated, fails Str and Dex saves, attacks against it have advantage"),
        effectLine (unconscious, "Unconscious: incapacitated and prone, fails Str and Dex saves, hits from within 5 ft are critical"),
        exhaustionEffect (exhaustion)]))

conditionsTable = table
{
    description = "Conditions on the character, and what they do."  reference = ["srd", 179]
    tableLayout = layout
    {
        columns = 3
    }
    Blinded = bool { description = "Can't see. Attacks against it have Advantage, and its attacks have Disadvantage."  reference = ["srd", 177]  default = false  editable = live  indicator = "#555555" }
    Charmed = bool { description = "Can't attack the charmer, who has Advantage on social checks against it."  reference = ["srd", 178]  default = false  editable = live  indicator = "#8e5cc4" }
    Deafened = bool { description = "Can't hear, and fails checks that need hearing."  reference = ["srd", 181]  default = false  editable = live  indicator = "#555555" }
    Frightened = bool { description = "Disadvantage on checks and attacks while it sees the source, and can't move closer to it."  reference = ["srd", 182]  default = false  editable = live  indicator = "#8e5cc4" }
    Grappled = bool { description = "Speed 0, and Disadvantage on attacks against anyone but the grappler."  reference = ["srd", 182]  default = false  editable = live  indicator = "#e8913a" }
    Incapacitated = bool { description = "Can't take actions, bonus actions or reactions, and loses Concentration."  reference = ["srd", 184]  default = false  editable = live  indicator = "#d4b106" }
    Invisible = bool { description = "Can't be seen. Attacks against it have Disadvantage, and its attacks have Advantage."  reference = ["srd", 184]  default = false  editable = live  indicator = "#3a7bd5" }
    Paralyzed = bool { description = "Incapacitated and can't move. Fails Str and Dex saves, and close hits are critical."  reference = ["srd", 186]  default = false  editable = live  indicator = "#8e5cc4" }
    Petrified = bool { description = "Turned to stone. Incapacitated, resists all damage, and fails Str and Dex saves."  reference = ["srd", 186]  default = false  editable = live  indicator = "#555555" }
    Poisoned = bool { description = "Disadvantage on attack rolls and ability checks."  reference = ["srd", 186]  default = false  editable = live  indicator = "#3fa34d" }
    Prone = bool { description = "Lying down. Can only crawl, and its attacks have Disadvantage."  reference = ["srd", 186]  default = false  editable = live  indicator = "#e8913a" }
    Restrained = bool { description = "Speed 0. Disadvantage on attacks and Dex saves, and attacks against it have Advantage."  reference = ["srd", 187]  default = false  editable = live  indicator = "#e8913a" }
    Stunned = bool { description = "Incapacitated, fails Str and Dex saves, and attacks against it have Advantage."  reference = ["srd", 189]  default = false  editable = live  indicator = "#d4b106" }
    Unconscious = bool { description = "Incapacitated and Prone, drops what it holds, and close hits are critical."  reference = ["srd", 191]  default = false  editable = live  indicator = "#555555" }
    Exhaustion = integer { description = "Each level is -2 to D20 Tests and -5 ft of Speed. Level 6 is death."  reference = ["srd", 181]  default = 0  minvalue = 0  maxvalue = 6  editable = live  indicator = "#d64545" }
    Concentration = string { description = "The spell being kept up. Damage calls for a Con save, and a new such spell ends it."  reference = ["srd", 179]  editable = live  indicator = "#3a7bd5"  indicatorLabel = "Concentrating" }
    Effects = string
    {
        value = conditionEffects (Blinded, Charmed, Deafened, Frightened, Grappled, Incapacitated, Invisible, Paralyzed, Petrified, Poisoned, Prone, Restrained, Stunned, Unconscious, Exhaustion)
        multiline = true
        editable = none
        visible = effectsVisible (Exhaustion, [Blinded, Charmed, Deafened, Frightened, Grappled, Incapacitated, Invisible, Paralyzed, Petrified, Poisoned, Prone, Restrained, Stunned, Unconscious])
    }
}
