subrace(name,features) = {
    Name=name
    Features=features
}
raceFeature(name, description)=ruleset
{
    Name=name
    Description=description
}
race(name,features,subraces) = {
    Name=name
    Features=features
    Subraces=subraces
}
libraryRaces =
    map (
        (x)->race (
            x.name,
            map ((f)->raceFeature (f.Name, f.Description), x.data.raceStats.Stats.Features),
            map (
                (s)->subrace (s.Name, map ((f)->raceFeature (f.Name, f.Description), s.Features)),
                x.data.raceStats.Stats.Subraces)),
        library.'Races')

getRace(racename)=first (filter ((race)->race.Name == racename, libraryRaces))
subraceNames(race)=concat (map ((x)->x.Name, race.Subraces),["Standard"])
getSubrace(racename,subraceName)=first (filter ((race)->race.Name == subraceName, getRace(racename).Subraces))
