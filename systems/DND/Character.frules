

#include "/systems/DND/Classes.frules"
#include "/systems/DND/Features.frules"
#include "/systems/DND/Hitpoints.frules"
#include "/systems/DND/Basics.frules"
#include "/systems/DND/Races.frules"
#include "/systems/DND/Backgrounds.frules"
#include "/systems/DND/Resources.frules"
#include "/systems/DND/SavingThrows.frules"
#include "/systems/DND/Equipment.frules"
#include "/systems/DND/Skills.frules"
#include "/systems/DND/Spells.frules"
#include "/systems/DND/Attacks.frules"
#include "/systems/DND/Leveling.frules"

characterTable = ruleset
{
  rulesetConfiguration = configuration
  {
    important = [Basics, Hitpoints, Conditions, Attacks]
    initative=characterTable.Basics.'Initiative'
  }
  Basics = basicsTable{}
  Class = classTable{}
  Leveling = levelingTable{}
  
  'Ability scores' = keyvalues
      {
          singular = "Ability score"
          keys = ["Str","Dex","Con","Int","Wis","Cha" ]
          description = "The six abilities. The modifier, half the score minus 5, is added to rolls that use it."
          reference = ["srd", 5]
          descriptions =
          {
              Str = "Strength: physical might."
              Dex = "Dexterity: agility, reflexes and balance."
              Con = "Constitution: health and stamina."
              Int = "Intelligence: reasoning and memory."
              Wis = "Wisdom: perceptiveness and mental fortitude."
              Cha = "Charisma: confidence, poise and charm."
          }
          valueType = custom
          {
              Score=integer
              {
                default=10
                minvalue=3
                maxvalue=25
              }
              Modifier=modifier
              {
                value=Score/2-5
                valuedice= D20Roll (characterTable)
              }

          }
      }
  'Saving throws' = savingThrowsTable {}
  Skills=skillTable{}
  Hitpoints = hitpoints{}
  Conditions = conditionsTable{}
  'Class resources' = classResourcesTable{}
  Rest = restTable{}
  Attacks=attackTable{}

  'Features and Traits' = features{}
  Equipment = equipmentTable{}
  Spells=spellTable{}
}