classSave (char, attr) = count (filter ((s)->s == attr, currentClass (char).SavingThrows)) > 0

auraOfProtection (char) =
  if hasClassFeature (char, "Aura of Protection") then max(1, char.'Ability scores'.'Cha'.Modifier) else 0

saveBonus (char) =
  bonusWithValue (allSources (char), "\+([0-9]+) bonus to (?:AC and |Armou?r Class and |your )?(?:all )?saving throws") +
  auraOfProtection (char)

saveModifier (char, attr, abilityMod, proficient) =
  abilityMod + saveBonus (char) +
    (if classSave (char, attr) then
      char.Basics.'Proficiency bonus'
    else
      if proficient then
        char.Basics.'Proficiency bonus'
      else
        0)

savingThrowsTable = table
      {
          description = "Rolls to resist spells, traps and other dangers, one per ability."  reference = ["srd", 7]
          'Aura of Protection' = integer
          {
              description = "How far the Paladin's Aura of Protection reaches: 10 feet, and 30 feet from level 18."
              value = if hasClassFeature (characterTable, "Aura of Protection") then (if Class.Main.Levels >= 18 then 30 else 10) else 0
              editable = none
              visible = none
              aura = "#d4b106"
          }
          Str=custom
          {
              description = "Strength saving throw: the Strength modifier, plus the Proficiency Bonus if proficient."
              Modifier=modifier
              {
                value=saveModifier (characterTable, "Str", 'Ability scores'.'Str'.Modifier, Proficient)
                valuedice= D20Roll (characterTable)
              }
              'Class proficiency' = classSave (characterTable, "Str")
              Proficient = bool
              {
              }
            }
          Dex=custom
          {
              description = "Dexterity saving throw: the Dexterity modifier, plus the Proficiency Bonus if proficient."
              Modifier=modifier
              {
                value=saveModifier (characterTable, "Dex", 'Ability scores'.'Dex'.Modifier, Proficient)
                valuedice= D20Roll (characterTable)
              }
              'Class proficiency' = classSave (characterTable, "Dex")
              Proficient = bool
              {
              }
            }
          Con=custom
          {
              description = "Constitution saving throw: the Constitution modifier, plus the Proficiency Bonus if proficient."
              Modifier=modifier
              {
                value=saveModifier (characterTable, "Con", 'Ability scores'.'Con'.Modifier, Proficient)
                valuedice= D20Roll (characterTable)
              }
              'Class proficiency' = classSave (characterTable, "Con")
              Proficient = bool
              {
              }
            }
          Int=custom
          {
              description = "Intelligence saving throw: the Intelligence modifier, plus the Proficiency Bonus if proficient."
              Modifier=modifier
              {
                value=saveModifier (characterTable, "Int", 'Ability scores'.'Int'.Modifier, Proficient)
                valuedice= D20Roll (characterTable)
              }
              'Class proficiency' = classSave (characterTable, "Int")
              Proficient = bool
              {
              }
            }
          Wis=custom
          {
              description = "Wisdom saving throw: the Wisdom modifier, plus the Proficiency Bonus if proficient."
              Modifier=modifier
              {
                value=saveModifier (characterTable, "Wis", 'Ability scores'.'Wis'.Modifier, Proficient)
                valuedice= D20Roll (characterTable)
              }
              'Class proficiency' = classSave (characterTable, "Wis")
              Proficient = bool
              {
              }
            }
          Cha=custom
          {
              description = "Charisma saving throw: the Charisma modifier, plus the Proficiency Bonus if proficient."
              Modifier=modifier
              {
                value=saveModifier (characterTable, "Cha", 'Ability scores'.'Cha'.Modifier, Proficient)
                valuedice= D20Roll (characterTable)
              }
              'Class proficiency' = classSave (characterTable, "Cha")
              Proficient = bool
              {
              }
            }
      }