experienceLevelAndProficiencyBonus(xp,lvl,bonus) =
    {
        XP=xp
        Level=lvl
        ProficiencyBonus=bonus
    }
levelTable =
    [
        experienceLevelAndProficiencyBonus(355000, 20, 6)
        , experienceLevelAndProficiencyBonus(305000, 19, 6)
        , experienceLevelAndProficiencyBonus(265000, 18, 6)
        , experienceLevelAndProficiencyBonus(225000, 17, 6)
        , experienceLevelAndProficiencyBonus(195000, 16, 5)
        , experienceLevelAndProficiencyBonus(165000, 15, 5)
        , experienceLevelAndProficiencyBonus(140000, 14, 5)
        , experienceLevelAndProficiencyBonus(120000, 13, 5)
        , experienceLevelAndProficiencyBonus(100000, 12, 4)
        , experienceLevelAndProficiencyBonus(85000, 11, 4)
        , experienceLevelAndProficiencyBonus(64000, 10, 4)
        , experienceLevelAndProficiencyBonus(48000, 9, 4)
        , experienceLevelAndProficiencyBonus(34000, 8, 3)
        , experienceLevelAndProficiencyBonus(23000, 7, 3)
        , experienceLevelAndProficiencyBonus(14000, 6, 3)
        , experienceLevelAndProficiencyBonus(6500, 5, 3)
        , experienceLevelAndProficiencyBonus(2700, 4, 2)
        , experienceLevelAndProficiencyBonus(900, 3, 2)
        , experienceLevelAndProficiencyBonus(300, 2, 2)
        , experienceLevelAndProficiencyBonus(0, 1, 2)
    ]
allSources(char) = [
                      map ((x)->x.Description ,allClassFeatures (char)),
                      map ((x)->x.Description ,char.'Features and Traits'.'Feats'),
                      map ((x)->x.Description ,char.'Features and Traits'.'Other features'),
                      
                      map ((x)->x.Description ,equipped (char.'Equipment'.'Melee weapons', "weaponStats")),
                      map ((x)->x.Description ,equipped (char.'Equipment'.'Ranged weapons', "weaponStats")),
                      map ((x)->x.Description ,equipped (char.'Equipment'.'Armour', "armourStats")),
                      map ((x)->x.Description ,equipped (char.'Equipment'.'Other items', "itemStats")),
                      map ((x)->x.Description ,safeRaceFeatures (char))
                    ]

hasClassFeature(char, name) =
  count (filter ((f)->f.Name == name, allClassFeatures (char))) > 0

acBonus(char) =
  bonusWithValue (allSources(char), "\+([0-9]+)\s*(?:bonus to (?:your )?)?(?:AC|Armou?r Class)\b") +
  bonusWithValue (allSources(char), "\b(?:AC|Armou?r Class)\s*\+([0-9]+)")

initiativeBonus(char) =
  bonusWithValue (allSources(char), "\bInitiative\s*\+([0-9]+)") +
  bonusWithValue (allSources(char), "\+([0-9]+)\s*(?:bonus to (?:your )?)?Initiative\b")

monkMovement(level) =
  if level > 17 then 30 else if level > 13 then 25 else if level > 9 then 20 else if level > 5 then 15 else 10

speedBonus(char) =
  bonusWithValue (allSources(char), "\bYour [Ss]peed increases by ([0-9]+) feet") +
  (if hasClassFeature (char, "Unarmored Movement") then monkMovement (char.Class.Main.Levels) - 10 else 0)
acForArmour(char, armour)=
  armour.data.armourStats.Stats.AC +
    min(
      valueOr (armour.data.armourStats.Stats, "Max dex modifier", 10),
      char.'Ability scores'.'Dex'.Modifier
    )

unarmouredAC(char) =
  10 + char.'Ability scores'.'Dex'.Modifier +
    (if contains (char.Class.Main.Name, "Barbarian") then
      char.'Ability scores'.'Con'.Modifier
    else
      if contains (char.Class.Main.Name, "Monk") then
        char.'Ability scores'.'Wis'.Modifier
      else
        if hasClassFeature (char, "Draconic Resilience") then
          char.'Ability scores'.'Cha'.Modifier
        else
          0)

ac(char) =
  if count (equipped (char.'Equipment'.'Armour', "armourStats")) > 0 then
    first (reverse (sort (map ((x)->acForArmour (char, x), equipped (char.'Equipment'.'Armour', "armourStats")))))
  else
    unarmouredAC (char)

basicsTable =table
  {
    XP  = integer
        {
            default=0
            minvalue=0
        }
    'Armour Class'=integer
              {
                value =
                        ac(characterTable) + acBonus(characterTable)

                default=10
              }
    'Initiative'=modifier
              {
                value='Ability scores'.'Dex'.Modifier +
                  jackBonus(characterTable) + alertBonus(characterTable) + initiativeBonus(characterTable)
                valuedice= InitiativeRoll (characterTable)
                editable=none
              }
    'Passive Perception' = integer
        {
          value = 10 + Skills.Perception.Modifier
          editable=none
        }
    Speed = integer
        {
          value = max (0, raceSpeed (Class.Race) + speedBonus (characterTable) - 5 * Conditions.Exhaustion)
          render = distance (max (0, raceSpeed (Class.Race) + speedBonus (characterTable) - 5 * Conditions.Exhaustion))
          editable=none
        }
    Size = raceSize (Class.Race)
    Darkvision = integer
        {
          value = raceDarkvision (Class.Race)
          editable=none
        }
    'Proficiency bonus'= integer
        {value= (first
         (filter
          ((x)->x.Level < characterTable.Class.Main.Levels + 1,levelTable)
          )).ProficiencyBonus
          editable=none
        }
    'Heroic Inspiration' = bool
        {
          default = false
          editable = live
        }
    Roll = selector
        {
                options = ["Disadvantage", "Normal", "Advantage"]
                labels = ["Dis", "Normal", "Adv"]
                colors = ["red", "white", "green"]
                hold = ["Ctrl", "", "Shift"]
                default = "Normal"
                editable=live
                save = nosave
        }
  }


plainD20Roll (char) = if char.Basics.Roll == "Advantage" then ([1d20,1d20],((baseline,throws)->
      baseline +
      max(
        first (throws).bonus + fold (0, (x1,x2)->x1+x2, first (throws).rolls),
        item (1,throws).bonus + fold (0, (x1,x2)->x1+x2, item (1,throws).rolls)
      )
       )) else
        if char.Basics.Roll == "Disadvantage" then ([1d20,1d20],((baseline,throws)->
         baseline +
          min(
            first (throws).bonus + fold (0, (x1,x2)->x1+x2, first (throws).rolls),
            item (1,throws).bonus + fold (0, (x1,x2)->x1+x2, item (1,throws).rolls)
          )
          )) else
        1d20

exhaustedD20Roll (mode, penalty) =
    if mode == "Advantage" then ([1d20,1d20],((baseline,throws)->
        baseline - penalty +
        max(
          first (throws).bonus + fold (0, (x1,x2)->x1+x2, first (throws).rolls),
          item (1,throws).bonus + fold (0, (x1,x2)->x1+x2, item (1,throws).rolls)
        ))) else
    if mode == "Disadvantage" then ([1d20,1d20],((baseline,throws)->
        baseline - penalty +
        min(
          first (throws).bonus + fold (0, (x1,x2)->x1+x2, first (throws).rolls),
          item (1,throws).bonus + fold (0, (x1,x2)->x1+x2, item (1,throws).rolls)
        ))) else
    ([1d20],((baseline,throws)->
        baseline - penalty + first (throws).bonus + fold (0, (x1,x2)->x1+x2, first (throws).rolls)))

InitiativeRoll (char) =
    if exhaustionLevel (char) > 0 then
        exhaustedD20Roll (char.Basics.Roll, 2 * exhaustionLevel (char))
    else
        plainD20Roll (char)

keptD20 (mode, throws) =
    if mode == "Advantage" then max (first (first (throws).rolls), first (item (1, throws).rolls))
    else if mode == "Disadvantage" then min (first (first (throws).rolls), first (item (1, throws).rolls))
    else first (first (throws).rolls)

naturalNote (natural) = if natural == 20 then " (natural 20)" else if natural == 1 then " (natural 1)" else ""

checkResult (total, natural, dc) =
{
    Text = toString (total) + (if dc > 0 then " vs DC " + toString (dc) + ": " + (if total >= dc then "Success" else "Failure") else naturalNote (natural))
    Value = total
    Outcome = if dc > 0 then (if total >= dc then "Success" else "Failure") else ""
}

attackOutcome (total, natural, ac) =
    if natural == 20 then "Critical hit"
    else if natural == 1 then "Miss"
    else if total >= ac then "Hit"
    else "Miss"

attackResult (total, natural, ac) =
{
    Text = toString (total) + (if ac > 0 then " vs AC " + toString (ac) + ": " + attackOutcome (total, natural, ac) else if natural == 20 then " (natural 20, critical hit)" else if natural == 1 then " (natural 1, miss)" else "")
    Value = total
    Outcome = if natural == 20 then "Critical" else if natural == 1 then "Failure" else if ac > 0 then (if total >= ac then "Success" else "Failure") else ""
}

rollPenalty (char) = 2 * exhaustionLevel (char)

askedCheck (mode, penalty) = ([dice { number = 1  sides = 20 }, dice { number = if mode == "Advantage" or mode == "Disadvantage" then 1 else 0  sides = 20  color = if mode == "Advantage" then "green" else "red"  label = if mode == "Advantage" then "Advantage" else if mode == "Disadvantage" then "Disadvantage" else "" }],
    ((baseline, throws)->checkResult (baseline - penalty + keptD20 (mode, throws), keptD20 (mode, throws), asked)))

askedAttack (mode, penalty) = ([dice { number = 1  sides = 20 }, dice { number = if mode == "Advantage" or mode == "Disadvantage" then 1 else 0  sides = 20  color = if mode == "Advantage" then "green" else "red"  label = if mode == "Advantage" then "Advantage" else if mode == "Disadvantage" then "Disadvantage" else "" }],
    ((baseline, throws)->attackResult (baseline - penalty + keptD20 (mode, throws), keptD20 (mode, throws), asked)))

D20Roll (char) = ask ("DC", askedCheck (char.Basics.Roll, rollPenalty (char)))

AttackRoll (char) = ask ("Target AC", askedAttack (char.Basics.Roll, rollPenalty (char)))
