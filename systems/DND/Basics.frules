experienceLevelAndProficiencyBonus(xp,lvl,bonus) =
    {
        XP=xp
        Level=lvl
        ProficiencyBonus=bonus
    }
levelTable =
    [
        experienceLevelAndProficiencyBonus(355000, 20, 6)
        , experienceLevelAndProficiencyBonus(305000, 19, 6)
        , experienceLevelAndProficiencyBonus(265000, 18, 6)
        , experienceLevelAndProficiencyBonus(225000, 17, 6)
        , experienceLevelAndProficiencyBonus(195000, 16, 5)
        , experienceLevelAndProficiencyBonus(165000, 15, 5)
        , experienceLevelAndProficiencyBonus(140000, 14, 5)
        , experienceLevelAndProficiencyBonus(120000, 13, 5)
        , experienceLevelAndProficiencyBonus(100000, 12, 4)
        , experienceLevelAndProficiencyBonus(85000, 11, 4)
        , experienceLevelAndProficiencyBonus(64000, 10, 4)
        , experienceLevelAndProficiencyBonus(48000, 9, 4)
        , experienceLevelAndProficiencyBonus(34000, 8, 3)
        , experienceLevelAndProficiencyBonus(23000, 7, 3)
        , experienceLevelAndProficiencyBonus(14000, 6, 3)
        , experienceLevelAndProficiencyBonus(6500, 5, 3)
        , experienceLevelAndProficiencyBonus(2700, 4, 2)
        , experienceLevelAndProficiencyBonus(900, 3, 2)
        , experienceLevelAndProficiencyBonus(300, 2, 2)
        , experienceLevelAndProficiencyBonus(0, 1, 2)
    ]
allSources(char) = [
                      map ((x)->x.Description ,classFeatures (char.Class.Main.Name, char.Class.Main.Levels)),
                      map ((x)->x.Description ,char.'Features and Traits'.'Feats'),
                      map ((x)->x.Description ,char.'Features and Traits'.'Other features'),
                      
                      map ((x)->x.Description ,char.'Equipment'.'Melee weapons'),
                      map ((x)->x.Description ,char.'Equipment'.'Ranged weapons'),
                      map ((x)->x.Description ,char.'Equipment'.'Armour'),
                      map ((x)->x.Description ,char.'Equipment'.'Other items'),
                      map ((x)->x.Description ,safeRaceFeatures (char))
                    ]

hasClassFeature(char, name) =
  count (filter ((f)->f.Name == name, classFeatures (char.Class.Main.Name, char.Class.Main.Levels))) > 0

acBonus(char) =
  bonusWithValue (allSources(char), "\+([0-9]+)\s*(?:bonus to (?:your )?)?(?:AC|Armou?r Class)\b") +
  bonusWithValue (allSources(char), "\b(?:AC|Armou?r Class)\s*\+([0-9]+)")

initiativeBonus(char) =
  bonusWithValue (allSources(char), "\bInitiative\s*\+([0-9]+)") +
  bonusWithValue (allSources(char), "\+([0-9]+)\s*(?:bonus to (?:your )?)?Initiative\b")

monkMovement(level) =
  if level > 17 then 30 else if level > 13 then 25 else if level > 9 then 20 else if level > 5 then 15 else 10

speedBonus(char) =
  bonusWithValue (allSources(char), "\bYour [Ss]peed increases by ([0-9]+) feet") +
  (if hasClassFeature (char, "Unarmoed Movement") then monkMovement (char.Class.Main.Levels) - 10 else 0)
acForArmour(char, armour)=
  armour.data.armourStats.Stats.AC +
    min(
      valueOr (armour.data.armourStats.Stats, "Max dex modifier", 10),
      char.'Ability scores'.'Dex'.Modifier
    )

unarmouredAC(char) =
  10 + char.'Ability scores'.'Dex'.Modifier +
    (if contains (char.Class.Main.Name, "Barbarian") then
      char.'Ability scores'.'Con'.Modifier
    else
      if contains (char.Class.Main.Name, "Monk") then
        char.'Ability scores'.'Wis'.Modifier
      else
        if hasClassFeature (char, "Draconic Resilience") then
          char.'Ability scores'.'Cha'.Modifier
        else
          0)

ac(char) =
  if count (char.'Equipment'.'Armour') > 0 then
    first (reverse (sort (map ((x)->acForArmour (char, x), char.'Equipment'.'Armour'))))
  else
    unarmouredAC (char)

basicsTable =table
  {
    XP  = integer
        {
            default=0
            minvalue=0
        }
    'Armour Class'=integer
              {
                value =
                        ac(characterTable) + acBonus(characterTable)

                default=10
              }
    'Initiative'=modifier
              {
                value='Ability scores'.'Dex'.Modifier +
                  jackBonus(characterTable) + alertBonus(characterTable) + initiativeBonus(characterTable)
                valuedice= D20Roll (characterTable)
                editable=none
              }
    'Passive Perception' = integer
        {
          value = 10 + Skills.Perception.Modifier
          editable=none
        }
    Speed = integer
        {
          value = raceSpeed (Class.Race) + speedBonus (characterTable)
          editable=none
        }
    Size = raceSize (Class.Race)
    Darkvision = integer
        {
          value = raceDarkvision (Class.Race)
          editable=none
        }
    'Proficiency bonus'= integer
        {value= (first
         (filter
          ((x)->x.Level < characterTable.Class.Main.Levels + 1,levelTable)
          )).ProficiencyBonus
          editable=none
        }
    Roll = selector
        {
                options = ["Disadvantage", "Normal", "Advantage"]
                labels = ["Dis", "Normal", "Adv"]
                colors = ["red", "white", "green"]
                hold = ["Ctrl", "", "Shift"]
                default = "Normal"
                editable=live
                save = nosave
        }
  }


D20Roll (char) = if char.Basics.Roll == "Advantage" then ([1d20,1d20],((baseline,throws)->
      baseline +
      max(
        first (throws).bonus + fold (0, (x1,x2)->x1+x2, first (throws).rolls),
        item (1,throws).bonus + fold (0, (x1,x2)->x1+x2, item (1,throws).rolls)
      )
       )) else
        if char.Basics.Roll == "Disadvantage" then ([1d20,1d20],((baseline,throws)->
         baseline +
          min(
            first (throws).bonus + fold (0, (x1,x2)->x1+x2, first (throws).rolls),
            item (1,throws).bonus + fold (0, (x1,x2)->x1+x2, item (1,throws).rolls)
          )
          )) else
        1d20