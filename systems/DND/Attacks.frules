toHitBonus (description) =
    bonusWithValue ([[description]], "\+\s*([0-9]+)\s*(?:to hit\b|bonus to attack)")

damageBonus (description) =
    bonusWithValue ([[description]], "\+\s*([0-9]+)\s*(?:to damage\b|bonus to (?:attack and )?damage)")

rangedAttackBonus (char) =
    bonusWithValue (allSources (char), "\+([0-9]+) bonus to attack rolls (?:you make )?with Ranged weapons")

abiltyBonusForMeleeWeapon (weapon, char) =
    if contains(toLower(weapon.data.weaponStats.Stats.Properties), "finesse") then
        max(char.'Ability scores'.'Dex'.Modifier, char.'Ability scores'.'Str'.Modifier)
    else
     char.'Ability scores'.'Str'.Modifier

abiltyBonusForRangedWeapon (weapon, char) =
    if contains(toLower(weapon.data.weaponStats.Stats.Properties), "thrown") then
         char.'Ability scores'.'Str'.Modifier
    else
     char.'Ability scores'.'Dex'.Modifier

attack (name, tohit, damage, damagebonus) = custom
{
    Name= name
    Tohit = modifier {
        value=tohit
        valuedice= D20Roll (characterTable)
    }
    Damage= string {
        value=damage
        bonus=damagebonus
    }
}

attacksFor (char) =
  concat (
    map
     ((weapon)->
      attack(weapon.Name,
       
        toHitBonus(weapon.Description) +
           abiltyBonusForMeleeWeapon (weapon, char)
         + characterTable.Basics.'Proficiency bonus',
        weapon.data.weaponStats.Stats.Damage,abiltyBonusForMeleeWeapon (weapon, char) + damageBonus (weapon.Description)), char.'Equipment'.'Melee weapons'),
    map
     ((weapon)->
      attack(weapon.Name,
       
        toHitBonus(weapon.Description) +
           abiltyBonusForRangedWeapon (weapon, char)
         + characterTable.Basics.'Proficiency bonus'
         + rangedAttackBonus (char),
        weapon.data.weaponStats.Stats.Damage,abiltyBonusForRangedWeapon (weapon, char) + damageBonus (weapon.Description)), char.'Equipment'.'Ranged weapons')
    )

attackTable = list
  {
        source = attacksFor(characterTable)
        singular = "Attack"
        editable = none
        valueType = attack
  }
