toHitBonus (description) =
    bonusWithValue ([[description]], "\+\s*([0-9]+)\s*(?:to hit\b|bonus to attack)")

damageBonus (description) =
    bonusWithValue ([[description]], "\+\s*([0-9]+)\s*(?:to damage\b|bonus to (?:attack and )?damage)")

rangedAttackBonus (char) =
    bonusWithValue (allSources (char), "\+([0-9]+) bonus to attack rolls (?:you make )?with Ranged weapons")

abiltyBonusForMeleeWeapon (weapon, char) =
    if contains(toLower(weapon.data.weaponStats.Stats.Properties), "finesse") then
        max(char.'Ability scores'.'Dex'.Modifier, char.'Ability scores'.'Str'.Modifier)
    else
     char.'Ability scores'.'Str'.Modifier

abiltyBonusForRangedWeapon (weapon, char) =
    if contains(toLower(weapon.data.weaponStats.Stats.Properties), "thrown") then
         char.'Ability scores'.'Str'.Modifier
    else
     char.'Ability scores'.'Dex'.Modifier

meleeReach (weapon) =
    if contains(toLower(weapon.data.weaponStats.Stats.Properties), "reach") then
        10
    else
        5

weaponRange (weapon) =
    bonusWithValue ([[weapon.data.weaponStats.Stats.Properties]], "Range\s*([0-9]+)")

attackRollBonus (text) =
    bonusWithValue ([[text]], "Attack Roll:\s*\+([0-9]+)") - bonusWithValue ([[text]], "Attack Roll:\s*-([0-9]+)")

attackKind (text) =
    if contains (toLower (text), "range") then
        "ranged"
    else
        "melee"

attackReach (text) =
    bonusWithValue ([[text]], "[Rr]each\s*([0-9]+)")

attackRange (text) =
    bonusWithValue ([[text]], "[Rr]ange\s*([0-9]+)")

creatureAttack (name, text) = custom
{
    Name = name
    'To hit' = modifier {
        value = attackRollBonus (text)
        valuedice = D20Roll (creatureTable)
        action = attackKind (text)
        reach = attackReach (text)
        range = attackRange (text)
    }
}

hasAttackNamed (creature, name) =
    count (filter ((a)->a.Name == name, creature.Attacks)) > 0

creatureAttacksFromActions (creature) =
    map ((a)->creatureAttack (a.Name, a.Description),
        filter ((a)->
            if hasAttackNamed (creature, a.Name) then
                false
            else
                contains (a.Description, "Attack Roll"),
            concat (creature.Actions, creature.'Bonus Actions')))

attack (name, tohit, damage, damagebonus, kind, distance) = custom
{
    Name= name
    Tohit = modifier {
        value=tohit
        valuedice= D20Roll (characterTable)
        action=kind
        reach=distance
        range=distance
    }
    Damage= string {
        value=damage
        bonus=damagebonus
    }
}

attacksFor (char) =
  concat (
    map
     ((weapon)->
      attack(weapon.Name,
       
        toHitBonus(weapon.Description) +
           abiltyBonusForMeleeWeapon (weapon, char)
         + characterTable.Basics.'Proficiency bonus',
        weapon.data.weaponStats.Stats.Damage,abiltyBonusForMeleeWeapon (weapon, char) + damageBonus (weapon.Description), "melee", meleeReach (weapon)), equipped (char.'Equipment'.'Melee weapons', "weaponStats")),
    map
     ((weapon)->
      attack(weapon.Name,
       
        toHitBonus(weapon.Description) +
           abiltyBonusForRangedWeapon (weapon, char)
         + characterTable.Basics.'Proficiency bonus'
         + rangedAttackBonus (char),
        weapon.data.weaponStats.Stats.Damage,abiltyBonusForRangedWeapon (weapon, char) + damageBonus (weapon.Description), "ranged", weaponRange (weapon)), equipped (char.'Equipment'.'Ranged weapons', "weaponStats"))
    )

attackTable = list
  {
        source = attacksFor(characterTable)
        singular = "Attack"
        editable = none
        valueType = attack
  }
