equipmentTable= table
{
    tableLayout = layout
    {
        rowTitle = hidden
        size = wide
        }
    'Melee weapons' = list
    {
        tableLayout = layout
        {
        size = wide
        }
        source=secondary.'Melee weapons'
        singular = "Melee weapon"
        editable = character
        autocomplete = weaponAutoCompletes
    }
    'Ranged weapons' = list
    {
        tableLayout = layout
        {
        size = wide
        }
        source=secondary.'Ranged weapons'
        singular = "Ranged weapon"
        editable = character
        autocomplete = weaponAutoCompletes
    }
    'Armour' = list
    {
        tableLayout = layout
        {
        size = wide
        }
        source=secondary.Armour
        singular = "Armour"
        editable = character
    }
    'Other items' = list
    {
        tableLayout = layout
        {
        size = wide
        }
        source=secondary.'Other items'
        singular = "Item"
        editable = character
        autocomplete = autoCompletes
    }
}
equippedFallback = { Stats = { Equipped = true } }

isEquipped(item, statsName) =
    valueOr (valueOr (valueOr (item.data, statsName, equippedFallback), "Stats", equippedFallback.Stats), "Equipped", true)

equipped(items, statsName) = filter ((x)->isEquipped (x, statsName), items)

weaponAutoCompletes=[
   "+1 to hit"
    , "+2 to hit"
    , "+3 to hit"
    , "+4 to hit"
    , "+5 to hit"
    , "+1 to damage"
    , "+2 to damage"
    , "+3 to damage"
]