
creatureTable = ruleset
{
  rulesetConfiguration = configuration
  {
    initative=Basics.'Initiative'
    sortedBy = sort
    {
        prefix="Challenge rating "
        sort=Basics.Challenge
        }
                filters= [
                    filter {
                        name="Challenge"
                        prefix=""
                        filter=Basics.Challenge}]
  }
  Basics = table
  {
    'Armor Class'=integer
              {
                default=10
                minvalue=10
              }
    'Initiative'=modifier
              {
                default=0
                valuedice= D20Roll (creatureTable)
              }
    Speed = string {}
    Immunities = string {}
    Resistances = string {}
    Gear = string {}
    Senses = string {}
    'Passive Perception' = integer {}
    Languages = string {}
    Challenge = string {}
    Roll = selector
        {
                options = ["Disadvantage", "Normal", "Advantage"]
                labels = ["Dis", "Normal", "Adv"]
                colors = ["red", "white", "green"]
                hold = ["Ctrl", "", "Shift"]
                default = "Normal"
                editable=live
                save = nosave
        }
  }
  'Hitpoints' = table
  {
    Current=integer
              {
                editable=live
              }
    Max=integer
              {
              }
  }
  'Ability scores' = keyvalues
      {
          singular = "Ability score"
          keys = ["Str","Dex","Con","Int","Wis","Cha" ]
          valueType = custom
          {
              Score=integer
              {
                default=10
                minvalue=3
                maxvalue=25
              }
              Modifier=modifier
              {
                value=Score/2-5
                valuedice= D20Roll (creatureTable)
              }

          }
      }
  'Saving throws' = table
      {
          Str=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Dex=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Con=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Int=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Wis=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Cha=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
      }
  Skills = table
      {
        tableLayout = layout
        {
          columns = 2
        }
          Acrobatics = custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          'Animal Handling' =custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Arcana =custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Athletics = custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Deception =custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          History=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Insight=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Intimidation=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Investigation=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Medicine=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Nature=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Perception=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Performance=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Persuasion=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Religion=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          'Sleight of Hand'=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Stealth=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
          Survival=custom
          {
              Modifier=modifier
              {
                valuedice= D20Roll (creatureTable)
              }
            }
      }
  Attacks =
  list
    {
        tableLayout = layout
        {
          size = wide
        }
        singular = "Attack"
        editable = character
        valueType = custom
        {
            Name = string {}
            'To hit' = modifier
            {
                valuedice = D20Roll (creatureTable)
            }
            Reach = string {}
            Damage = string {}
        }
    }
  'Traits' =
  list
    {
        tableLayout = layout
        {
          size = wide
        }
        singular = "Feature"
        editable = character
        valueType = nameAndDescription
    }
  Actions =
  list
    {
        tableLayout = layout
        {
          size = wide
        }
        singular = "Feature"
        editable = character
        valueType = nameAndDescription
    }
  'Bonus Actions' =
  list
    {
        tableLayout = layout
        {
          size = wide
        }
        singular = "Feature"
        editable = character
        valueType = nameAndDescription
    }
  Reactions =
  list
    {
        tableLayout = layout
        {
          size = wide
        }
        singular = "Feature"
        editable = character
        valueType = nameAndDescription
    }
  'Legendary Actions' =
  list
    {
        tableLayout = layout
        {
          size = wide
        }
        singular = "Feature"
        editable = character
        valueType = nameAndDescription
    }
}