backgroundSkill (char, skillName) = contains (backgroundSkills (char), skillName)

skillModifier (char, abilityMod, proficient, expertise, skillName) =
  abilityMod +
    (if expertise then
      2 * char.Basics.'Proficiency bonus'
    else
      if proficient then
        char.Basics.'Proficiency bonus'
      else
        if backgroundSkill (char, skillName) then
          char.Basics.'Proficiency bonus'
        else
          jackBonus (char))

skillTable = table
      {
        tableLayout = layout
        {
          columns = 2
        }
          Acrobatics = custom
          {
              Modifier=modifier
              {
                value=skillModifier (characterTable, 'Ability scores'.'Dex'.Modifier, Proficient, Expertise, "Acrobatics")
                valuedice= D20Roll (characterTable)
              }
              Proficient = bool
              {
              }
              Expertise = bool
              {
              }
            }
          'Animal Handling' = custom
          {
              Modifier=modifier
              {
                value=skillModifier (characterTable, 'Ability scores'.'Wis'.Modifier, Proficient, Expertise, "Animal Handling")
