hitDie(classname,level)=classNamed (classname).HitDie

maxHitpoints(classname,level,conModifier) =
    (hitDie(classname,level)/2+1)*(level-1)+hitDie(classname,level)+conModifier*level
      + bonusWithValue (allSources(characterTable), "\b(?:HitPoints|Hit Points)\s*\+([0-9]+)")
      + bonusWithValue (allSources(characterTable), "Hit Point maximum increases by ([0-9]+)(?![0-9]|, and it increases)")
      + level * bonusWithValue (allSources(characterTable), "Hit Point maximum increases by [0-9]+, and it increases by ([0-9]+)[^.]*whenever you gain")

hitpoints = table
  {
    Current=integer
              {
                editable=live
                default=Max
              }
    Max=integer
              {
                  value=maxHitpoints (Class.Main.Name, Class.Main.Levels, 'Ability scores'.'Con'.Modifier)
                  editable=none
              }
    Temporary=integer
              {
                editable=live
                default=0
                minvalue=0
              }
    HitDie=hitDie(Class.Main.Name, Class.Main.Levels)
    'Hit dice' = slots
              {
                number = Class.Main.Levels
                allowedchange = increaseAndClear
              }
    'Death save successes' = slots
              {
                number = 3
                allowedchange = increaseAndClear
              }
    'Death save failures' = slots
              {
                number = 3
                allowedchange = increaseAndClear
              }
  }