classFeatures(classname,level) =
    (map
        (
            (feature)->nameAndDescription(feature.Name,feature.Description),
              filter((f)->f.Level<level+1,
                classNamed (classname).Features)
                )
        )

raceFeatures(main, subrace)=
   map (
     (feature)->nameAndDescription (feature.Name, feature.Description),
     if subrace=="Standard" then
       getRace(main).Features
     else
       concat (getRace(main).Features, getSubrace(main,subrace).Features))

jackBonus(char) = bonusFrom (
                    [
                      map ((x)->x.Name ,classFeatures (char.Class.Main.Name, char.Class.Main.Levels)),
                      map ((x)->x.Name ,char.'Features and Traits'.'Feats'),
                      map ((x)->x.Name ,char.'Features and Traits'.'Other features')
                    ],"Jack of All Trades", char.Basics.'Proficiency bonus' / 2)

featNames(char) = map ((x)->x.Name ,char.'Features and Traits'.'Feats')

alertBonus(char) = bonusFrom ([featNames (char)], "^Alert$", char.Basics.'Proficiency bonus')

autoCompletes=[
   "AC +1"
    , "AC +2"
    , "AC +3"
    , "AC +4"
    , "AC +5"
    , "+1 AC"
    , "+2 AC"
    , "+3 AC"
    , "+4 AC"
    , "HitPoints +1"
    , "HitPoints +2"
    , "HitPoints +3"
    , "HitPoints +4"
    , "HitPoints +5"
    , "Initiative +1"
    , "Initiative +2"
    , "Initiative +3"
    , "Initiative +4"
    , "Initiative +5"
    , "Spell save DC increase by +1"
    , "Spell save DC increase by +2"
    , "Spell save DC increase by +3"
    , "Spell attack increase by +1"
    , "Spell attack increase by +2"
    , "Spell attack increase by +3"
    , "Spell casting ability increase by +1"
    , "Spell casting ability increase by +2"
    , "Spell casting ability increase by +3"
]
features= table
{
    tableLayout = layout
    {
        size = wide
        rowTitle = hidden
    }
    'Class features'=list
    {
        tableLayout = layout
        {
            size = wide
            rowTitle = hidden
        }
          source=classFeatures (Class.Main.Name, Class.Main.Levels)
          singular = "Feature"
          editable = none
    }
    'Race features'=list
    {
        tableLayout = layout
        {
            size = wide
            rowTitle = hidden
        }
          source=raceFeatures (Class.Race, Class.Subrace)
          singular = "Feature"
          editable = none
    }

    'Background features'=list
    {
        tableLayout = layout
        {
            size = wide
            rowTitle = hidden
        }
          source=backgroundFeatures (Class.Background)
          singular = "Feature"
          editable = none
    }

    'Feats'=list
    {
        tableLayout = layout
        {
          size = wide
        }
        singular = "Feat"
        editable = character
        autocomplete = autoCompletes
        source=secondary.Feats
    }

    'Other features'=list
    {
        tableLayout = layout
        {
          size = wide
        }
        singular = "Feature"
        editable = character
        autocomplete = autoCompletes
        source=secondary.'Other features'
    }

}