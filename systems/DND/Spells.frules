
getSpellLevelForClass (classname) =
  classNamed (classname).SpellLevels

getClassLevlesForSpellLevels (spelllevels, spellevel)=
  first (filter ((spl)->spl.SpellLevel == spellevel, spelllevels)).SpellsForLevelList

getSpellsAtLevelForClassAndLevel(classname, level, spellevel)=
  first(filter ((x)->x.CharacterLevel == level,
    getClassLevlesForSpellLevels (getSpellLevelForClass (classname),spellevel)
  )).Spells

getSpellVisibility (classname, level, spellevel) =
  if getSpellsAtLevelForClassAndLevel(classname, level, spellevel) > 0
     then visible
   else
      none

spellCastingAbilty(class, char) =

  (switch class.SpellcastingAbilityModifier
    case "Charisma" then char.'Ability scores'.'Cha'.Modifier
    case "Intelligence" then char.'Ability scores'.'Int'.Modifier
    case "Wisdom" then char.'Ability scores'.'Wis'.Modifier
    case "Constitution" then char.'Ability scores'.'Con'.Modifier
    case "Dexterity" then char.'Ability scores'.'Dex'.Modifier
    case "Strength" then char.'Ability scores'.'Str'.Modifier
    else 0
  )
  +bonusWithValue (allSources(char),"[Ss]pell ?casting ability (?:increases? by \+?|\+)([0-9]+)")
  

spellCastingDC (class, char) =
  8+spellCastingAbilty(class, char)+char.Basics.'Proficiency bonus'
  +bonusWithValue (allSources(char),"[Ss]pell save DCs? (?:increases? by \+?|\+)([0-9]+)")
  +bonusWithValue (allSources(char),"\+([0-9]+) bonus to (?:your )?spell save DCs?")
  +bonusWithValue (allSources(char),"\+([0-9]+) bonus to spell attack rolls and (?:to )?the saving throw DCs of your spells")
spellAttackModifier (class, char) =
  spellCastingAbilty(class, char)+char.Basics.'Proficiency bonus'
  +bonusWithValue (allSources(char),"[Ss]pell attacks?(?: rolls?| bonus)? (?:increases? by \+?|\+)([0-9]+)")
  +bonusWithValue (allSources(char),"\+([0-9]+) bonus to (?:your )?spell attack rolls")

flatten (lists) = fold ([], (acc, x)->concat (acc, x), lists)

spellRangeText (spell) = valueOr (spell.data.spellStats.Stats, "Range", "")

isTouchSpell (spell) = toLower (spellRangeText (spell)) == "touch"

spellFeet (spell) =
  if contains (toLower (spellRangeText (spell)), "mile") then
    toInt (first (split (" ", spellRangeText (spell)))) * 5280
  else
    toInt (first (split (" ", spellRangeText (spell))))

spellKind (spell) = if isTouchSpell (spell) then "melee" else "ranged"

spellDistance (spell) = if isTouchSpell (spell) then 5 else spellFeet (spell)

characterSpells (char) = char.Spells.'All spells'

isAttackSpell (spell) = contains (toLower (spell.Description), "spell attack")

saveAbilities (spell) =
  filter ((a)->contains (spell.Description, a + " saving throw"),
    ["Strength", "Dexterity", "Constitution", "Intelligence", "Wisdom", "Charisma"])

saveAbility (spell) =
  if count (saveAbilities (spell)) > 1 then
    "Several"
  else
    first (saveAbilities (spell))

spellAttack (name, tohit, kind, distance, rangeText) = custom
{
    Name = name
    'To hit' = modifier
    {
        value = tohit
        valuedice = D20Roll (characterTable)
        action = kind
        reach = distance
        range = distance
    }
    Range = rangeText
}

spellSave (name, dc, ability, kind, distance, rangeText) = custom
{
    Name = name
    Save = ability
    DC = integer
    {
        value = dc
        action = kind
        reach = distance
        range = distance
    }
    Range = rangeText
}

attackSpells (char) = filter ((spell)->isAttackSpell (spell), characterSpells (char))

saveSpells (char) = filter ((spell)->count (saveAbilities (spell)) > 0, characterSpells (char))

spellAttacksWith (spells, tohit) =
  map ((spell)->spellAttack (spell.Name, tohit, spellKind (spell), spellDistance (spell), spellRangeText (spell)), spells)

spellSavesWith (spells, dc) =
  map ((spell)->spellSave (spell.Name, dc, saveAbility (spell), spellKind (spell), spellDistance (spell), spellRangeText (spell)), spells)

spellAttacksFor (char) = spellAttacksWith (attackSpells (char), spellAttackModifier (currentClass (char), char))

spellSavesFor (char) = spellSavesWith (saveSpells (char), spellCastingDC (currentClass (char), char))

listVisible (items) = if count (items) > 0 then visible else none

spellTable= table
{
      visible=getSpellVisibility(Class.Main.Name, Class.Main.Levels, 1)
        tableLayout = layout
        {
        rowTitle = hidden
          size = wide
        }
        Ability = table
        {
          'Spellcasting ability' = modifier
                {
                  value=spellCastingAbilty (currentClass (characterTable), characterTable)

                  valuedice= D20Roll (characterTable)
                  editable=none
                }
                'Spell save DC' = integer
                {
                  value=spellCastingDC (currentClass (characterTable), characterTable)

                  editable=none
                }
                'Spell attack bonus' = modifier
                {
                  value=spellAttackModifier (currentClass (characterTable), characterTable)

                  valuedice= D20Roll (characterTable)
                  editable=none
                }
        }
        'All spells' = list
        {
          visible = none
          source = secondary.Spells
          editable = none
        }
        'Spell attacks' = list
        {
          visible = listVisible (attackSpells (characterTable))
          tableLayout = layout
          {
            size = wide
          }
          source = spellAttacksFor (characterTable)
          singular = "Spell attack"
          editable = none
          valueType = spellAttack
        }
        'Spell saves' = list
        {
          visible = listVisible (saveSpells (characterTable))
          tableLayout = layout
          {
            size = wide
          }
          source = spellSavesFor (characterTable)
          singular = "Spell save"
          editable = none
          valueType = spellSave
        }
        'Cantrips' = table
      {
        tableLayout = layout
        {
        rowTitle = hidden
          size = wide
        }
        Spells = list
        {
          tableLayout = layout
          {
            size = wide
          }
          source=secondary.Spells
          singular = "Spell"
          editable = character
          filter = spellStats.Stats.level == 0
        }
    }
    '1st Level Spells' = table
    {
      visible=getSpellVisibility(Class.Main.Name, Class.Main.Levels, 1)
        tableLayout = layout
        {
        rowTitle = hidden
          size = wide
        }
        Slots = slots
        {
            number = getSpellsAtLevelForClassAndLevel(Class.Main.Name, Class.Main.Levels, 1)
