class(name,hitdie,savingThrows,spellcastingAbilityModifier,features, spellevels, resources, featLevels)=ruleset
{
    FeatLevels=featLevels
    Resources=resources
    Name=name
    HitDie=hitdie
    SavingThrows=savingThrows
    SpellcastingAbilityModifier=spellcastingAbilityModifier
    Features=features
    SpellLevels=spellevels
}
classFeature(level, name, description)=ruleset
{
    Level=level
    Name=name
    Description=description
}
classResource(name, uses, shortRest, shortRestLevel)=ruleset
{
    Name=name
    Uses=uses
    ShortRest=shortRest
    ShortRestLevel=shortRestLevel
}
classSpellevel(spellLevel,spellsForLevelList)=ruleset
{
    SpellLevel=spellLevel
    SpellsForLevelList=spellsForLevelList
}
spellsForLevel(characterLevel,spells)=
{
    CharacterLevel=characterLevel
    Spells=spells
}

mapSpellevels(spellevels)=
    map (
        (x)->classSpellevel (
            toInt (x.Key),
            map ((y)->spellsForLevel (toInt (y.Key), valueOr (y.Value, "Number of spells", 0)), toList (x.Value.levels))),
        toList (spellevels))

libraryClasses =
    map (
        (x)->class (
            x.name,
            valueOr (x.data.classStats.Stats, "HitDie", 6),
            map ((sav)->valueOr (sav, "Attr", ""), valueOr (x.data.classStats.Stats, "SavingThrows", [])),
            valueOr (x.data.classStats.Stats, "SpellcastingAbilityModifier", "None"),
            map (
                (feat)->classFeature (valueOr (feat, "Level", 1), valueOr (feat, "Name", ""), valueOr (feat, "Description", "")),
                valueOr (x.data.classStats.Stats, "Features", [])),
            mapSpellevels (x.data.classStats.Stats.Spellevels),
            map (
                (res)->classResource (valueOr (res, "Name", ""), valueOr (res, "Uses", ""), valueOr (res, "Short rest", "None"), valueOr (res, "Short rest level", 1)),
                valueOr (x.data.classStats.Stats, "Resources", [])),
            valueOr (x.data.classStats.Stats, "Feat levels", "")),
        library.'Classes')

baseClassName (name) = if contains (name, " (") then first (split (" (", name)) else name

legacySubclass (name) = if contains (name, " (") then replace (")", "", item (1, split (" (", name))) else "None"

classesNamed (classname) = filter ((class)->class.Name == classname, libraryClasses)

classNamed (classname) =
    first (concat (
        classesNamed (classname),
        filter ((class)->class.Name == baseClassName (classname), libraryClasses)))

subclass(name, className, features, featLevels)=
{
    Name=name
    Class=className
    Features=features
    FeatLevels=featLevels
}

librarySubclasses =
    map (
        (x)->subclass (
            x.name,
            valueOr (x.data.subclassStats.Stats, "Class", ""),
            map (
                (feat)->classFeature (valueOr (feat, "Level", 1), valueOr (feat, "Name", ""), valueOr (feat, "Description", "")),
                valueOr (x.data.subclassStats.Stats, "Features", [])),
            valueOr (x.data.subclassStats.Stats, "Feat levels", "")),
        library.'Subclasses')

subclassesOf (classname) = filter ((s)->s.Class == baseClassName (classname), librarySubclasses)

subclassNames (classname) = map ((s)->s.Name, subclassesOf (classname))

subclassesNamed (classname, name) = filter ((s)->s.Name == name, subclassesOf (classname))

subclassName (char) =
    if char.Class.Subclass == "None" then
        if count (classesNamed (char.Class.Main.Name)) > 0 then "None" else legacySubclass (char.Class.Main.Name)
    else
        char.Class.Subclass

customVisible (subclass) = if subclass == "Custom" then visible else none

currentClass (char) = classNamed (char.Class.Main.Name)

classTable=table
    {
      Main = custom
      {
          Name = string
          {
            keys = map ((x)->x.Name, libraryClasses)
            default="Unknown"
          }
          Levels = integer
          {
                minvalue=1
                default=1
          }
      }
      Subclass = string
      {
        keys = concat (["None", "Custom"], subclassNames (Main.Name))
        default="None"
      }
      'Custom subclass' = string
      {
        visible = customVisible (Subclass)
      }
      Race = string
      {
        keys = map ((x)->x.Name, libraryRaces)
        default="Unknown"
      }
      Subrace = string
      {
        keys = subraceNames (getRace (Race))
        default="Standard"
      }
      Background = string
      {
        keys = concat (["None"], map ((x)->x.Name, libraryBackgrounds))
        default="None"
      }
    }
