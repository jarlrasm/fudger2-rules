class(name,hitdie,savingThrows,spellcastingAbilityModifier,features, spellevels)=ruleset
{
    Name=name
    HitDie=hitdie
    SavingThrows=savingThrows
    SpellcastingAbilityModifier=spellcastingAbilityModifier
    Features=features
    SpellLevels=spellevels
}
classFeature(level, name, description)=ruleset
{
    Level=level
    Name=name
    Description=description
}
classSpellevel(spellLevel,spellsForLevelList)=ruleset
{
    SpellLevel=spellLevel
    SpellsForLevelList=spellsForLevelList
}
spellsForLevel(characterLevel,spells)=
{
    CharacterLevel=characterLevel
    Spells=spells
}

mapSpellevels(spellevels)=
    map (
        (x)->classSpellevel (
            toInt (x.Key),
            map ((y)->spellsForLevel (toInt (y.Key), y.Value.'Number of spells'), toList (x.Value.levels))),
        toList (spellevels))

libraryClasses =
    map (
        (x)->class (
            x.name,
            x.data.classStats.Stats.HitDie,
            map ((sav)->sav.Attr, x.data.classStats.Stats.SavingThrows),
            x.data.classStats.Stats.SpellcastingAbilityModifier,
            map ((feat)->classFeature (feat.Level, feat.Name, feat.Description), x.data.classStats.Stats.Features),
            mapSpellevels (x.data.classStats.Stats.Spellevels)),
        library.'Classes')

classTable=table
    {
      Main = custom
      {
          Name = string
          {
            keys = map ((x)->x.Name, libraryClasses)
            default="Unknown"
          }
          Levels = integer
          {
                minvalue=1
                default=1
          }
      }
      Race = string
      {
        keys = map ((x)->x.Name, libraryRaces)
        default="Unknown"
      }
      Subrace = string
      {
        keys = subraceNames (getRace (Race))
        default="Standard"
      }
    }
