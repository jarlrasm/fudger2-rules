class(name,hitdie,savingThrows,spellcastingAbilityModifier,features, spellevels, resources)=ruleset
{
    Resources=resources
    Name=name
    HitDie=hitdie
    SavingThrows=savingThrows
    SpellcastingAbilityModifier=spellcastingAbilityModifier
    Features=features
    SpellLevels=spellevels
}
classFeature(level, name, description)=ruleset
{
    Level=level
    Name=name
    Description=description
}
classResource(name, uses, shortRest, shortRestLevel)=ruleset
{
    Name=name
    Uses=uses
    ShortRest=shortRest
    ShortRestLevel=shortRestLevel
}
classSpellevel(spellLevel,spellsForLevelList)=ruleset
{
    SpellLevel=spellLevel
    SpellsForLevelList=spellsForLevelList
}
spellsForLevel(characterLevel,spells)=
{
    CharacterLevel=characterLevel
    Spells=spells
}

mapSpellevels(spellevels)=
    map (
        (x)->classSpellevel (
            toInt (x.Key),
            map ((y)->spellsForLevel (toInt (y.Key), valueOr (y.Value, "Number of spells", 0)), toList (x.Value.levels))),
        toList (spellevels))

libraryClasses =
    map (
        (x)->class (
            x.name,
            valueOr (x.data.classStats.Stats, "HitDie", 6),
            map ((sav)->valueOr (sav, "Attr", ""), valueOr (x.data.classStats.Stats, "SavingThrows", [])),
            valueOr (x.data.classStats.Stats, "SpellcastingAbilityModifier", "None"),
            map (
                (feat)->classFeature (valueOr (feat, "Level", 1), valueOr (feat, "Name", ""), valueOr (feat, "Description", "")),
                valueOr (x.data.classStats.Stats, "Features", [])),
            mapSpellevels (x.data.classStats.Stats.Spellevels),
            map (
                (res)->classResource (valueOr (res, "Name", ""), valueOr (res, "Uses", ""), valueOr (res, "Short rest", "None"), valueOr (res, "Short rest level", 1)),
                valueOr (x.data.classStats.Stats, "Resources", []))),
        library.'Classes')

classNamed (classname) = first (filter ((class)->class.Name == classname, libraryClasses))

currentClass (char) = classNamed (char.Class.Main.Name)

classTable=table
    {
      Main = custom
      {
          Name = string
          {
            keys = map ((x)->x.Name, libraryClasses)
            default="Unknown"
          }
          Levels = integer
          {
                minvalue=1
                default=1
          }
      }
      Race = string
      {
        keys = map ((x)->x.Name, libraryRaces)
        default="Unknown"
      }
      Subrace = string
      {
        keys = subraceNames (getRace (Race))
        default="Standard"
      }
      Background = string
      {
        keys = concat (["None"], map ((x)->x.Name, libraryBackgrounds))
        default="None"
      }
    }
