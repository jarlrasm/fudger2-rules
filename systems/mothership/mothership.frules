creatureTable = ruleset
{
  rulesetConfiguration =
  {
      defaultImage = "/images/armour.svg"
  }
  Stats = table
  {
    Combat = integer
    {
      valuedice = hundred
      action = melee
    }
    Attack = string {}
    Instinct = integer {}
    AP = integer {}
    Wounds = integer {}
    'Current Wounds' = integer { editable=live }
    Health = integer {}
    'Current Health' = integer { editable=live }
    Special = string {}
  }
}

