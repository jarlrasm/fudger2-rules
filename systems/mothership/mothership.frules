      {
        description = "Leading a crew and keeping order under pressure."
        Proficient = bool
        {}
      }
    }
  
  Traits = list
  {
    description = "Traits that adjust stats, saves and skills."
    tableLayout = layout
    {
        size = wide
    }
          source=secondary.Traits
          singular = "Trait"
          editable = character
  }

  'Weapons' = list
    {
        tableLayout = layout
        {
          size = wide
        }
        source=secondary.Weapons
        singular = "Weapon"
        editable = character
    }

  Attacks = list
    {
        tableLayout = layout
        {
          size = wide
        }
        source = map ((weapon)->attackFor (characterTable, weapon), characterTable.Weapons)
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }

  'Armor' = list
    {
