boolToVisible (flag)=
  if flag
    then visible
   else
      none


mothership = system


{
    libraries = ["/systems/mothership/mothership.json", "/systems/names/scifi.json", "/systems/names/bluecollar.json", "/systems/names/grimdark.json", "/systems/names/cosmic.json"]
    nameSettings = [blueCollarSpaceNameSetting, grimdarkNameSetting, cosmicHorrorNameSetting]
    characters = characterTable
    creatures = creatureTable
    Weapons = weaponStats
    Armor = armorStats
    Equipment = equipmentStats
    Traits = traitStats
    description="Mothership"
    secondaryTypes = ["Weapons", "Armor", "Equipment", "Traits"]
    quickdice =[1d100, 1d20, 1d10]
    cssFiles = ["/systems/mothership/mothership.css"]
}

