creatureTable = ruleset
{
  rulesetConfiguration =
  {
      important = [Stats]
      defaultImage = "/images/armour.svg"
  }
  Stats = table
  {
    Combat = integer
    {
      description = "Combat skill for the creature's attacks."
      valuedice = hundred
      action = melee
    }
    Attack = string {}
    Instinct = integer { description = "Roll under this to see if the creature acts on instinct." }
    AP = integer { description = "Armor points: damage stopped from each hit." }
    Wounds = integer { description = "Wounds the creature can take before it dies." }
    'Current Wounds' = integer { description = "Wounds taken." editable=live  indicator = "#d64545"  indicatorLabel = "Wounds" }
    Health = integer { description = "Health points per wound." }
    'Current Health' = integer { description = "Health left before the next wound." editable=live }
    Special = string {}
  }
}

weaponStats =ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/armour.svg"
    }
    Stats= table
    {
        Cost=string
        {}
        Range=string
        {}
        Damage=string
        {}
        Shots=string
        {}
        Wound=string
        {}
        Special=string
        {}
    }
}

