equipmentStats = ruleset
{
  rulesetConfiguration =
  {
    defaultImage = "/images/armour.svg"
  }
  Stats = table
  {
    Cost=string {}
  }
}

traitStats = ruleset
{
  rulesetConfiguration =
  {
    defaultImage = "/images/armour.svg"
  }
  Stats = table
  {
    Adjust = string {}
    'Trauma response' = string {}
    Skills = string {}
  }
}

boolToVisible (flag)=
  if flag
    then visible
   else
      none


mothership = system


{
    hints = [
        hint
        {
            title = "Ship and crew"
            topic = "Getting started"
            text = ["Decide what the crew does for a living and who owns the ship. A debt or a contract gives the first session a reason to start."]
        },
        hint
        {
            title = "Classes"
            topic = "Characters"
            text = ["Each player picks Marine, Android, Scientist or Teamster. Their class decides how they handle Stress and what skills they start with."]
        },
        hint
        {
            title = "No initiative roll"
            topic = "Initiative"
            text = ["There is no initiative roll. Players usually act first. When an enemy could act sooner, a Speed check decides.", "Drag tokens into order in the initiative list."]
        },
        hint
        {
            title = "Stress and panic"
            topic = "Play"
            text = ["Failed rolls usually give 1 Stress. When nerves break, click Panic check under Stress: 1d20 over the current Stress holds, at or under it panics."]
        },
        hint
        {
            title = "Skills and advantage"
            topic = "Play"
            text = ["Stat and save rolls ask for a skill bonus: enter 10, 15 or 20 when a trained, expert or master skill applies. The Roll slider under Basics gives advantage or disadvantage."]
        },
        hint
        {
            title = "Health and wounds"
            topic = "Combat"
            text = ["When Health reaches 0 the character takes a Wound and Health resets. Keep fights short and deadly."]
        }
    ]
    distanceUnit = "m"
    squareSize = 1
    libraries = ["/systems/mothership/mothership.json", "/systems/names/scifi.json", "/systems/names/bluecollar.json", "/systems/names/grimdark.json", "/systems/names/cosmic.json"]
    nameSettings = [blueCollarSpaceNameSetting, grimdarkNameSetting, cosmicHorrorNameSetting]
    characters = characterTable
    creatures = creatureTable
    Weapons = weaponStats
    Armor = armorStats
    Equipment = equipmentStats
    Traits = traitStats
    description="Mothership"
    secondaryTypes = ["Weapons", "Armor", "Equipment", "Traits"]
    quickdice =[1d100, 1d20, 1d10]
    cssFiles = ["/systems/mothership/mothership.css"]
}

