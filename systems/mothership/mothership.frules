#include "/systems/common.frules"
#include "/systems/names/settings.frules"


isDouble (roll) = mod (roll, 11) == 0

msOutcome (target, roll) =
    if roll >= 90 and isDouble (roll) then "Critical failure"
    else if roll >= 90 then "Failure"
    else if roll < target and isDouble (roll) then "Critical success"
    else if roll < target then "Success"
    else if isDouble (roll) then "Critical failure"
    else "Failure"

msResult (target, roll) =
{
    Text = toString (roll) + " vs " + toString (target) + ": " + msOutcome (target, roll) + (if contains (msOutcome (target, roll), "uccess") then "" else ", +1 Stress")
    Value = roll
    Outcome = switch msOutcome (target, roll) case "Critical success" then "Critical" case "Critical failure" then "Fumble" else msOutcome (target, roll)
}

msPick (mode, a, b) = if mode == "Advantage" then min (a, b) else if mode == "Disadvantage" then max (a, b) else a

msSecond (rolls) = if count (rolls) == 0 then 0 else mod (first (rolls), 100)

msRoll (mode) = ([dice { number = 1  sides = 100 }, dice { number = if mode == "Advantage" or mode == "Disadvantage" then 1 else 0  sides = 100  color = if mode == "Advantage" then "green" else "red"  label = if mode == "Advantage" then "Advantage" else if mode == "Disadvantage" then "Disadvantage" else "" }],
    ((baseline, throws)->msResult (baseline + asked, msPick (mode, mod (first (first (throws).rolls), 100), msSecond (item (1, throws).rolls)))))

hundred = ([1d100], ((baseline, throws)->msResult (baseline, mod (first (first (throws).rolls), 100))))

checkRoll (char) = ask ("Skill bonus", 0, msRoll (char.Basics.Roll))

panicResult (stress, roll) =
{
    Text = toString (roll) + " vs Stress " + toString (stress) + ": " + (if roll > stress then "Success" else "Failure: panic")
    Value = roll
    Outcome = if roll > stress then "Success" else "Failure"
}

panicRoll = ([1d20], ((baseline, throws)->panicResult (baseline, first (first (throws).rolls))))




notProficient = { Proficient = false }

hasSkill (char, level, skill) =
    valueOr (valueOr (valueOr (char, level, notProficient), skill, notProficient), "Proficient", false)

skillBonus (char, expertSkill) =
    if hasSkill (char, "Expert 15", expertSkill) then
        15
    else
        if hasSkill (char, "Trained 10", "Military Training") then
            10
        else
            0

isMelee (weapon) = valueOr (weapon.data.weaponStats.Stats, "Range", "") == "Adjacent"

rangeMetres (text) =
    if text == "Close" then
        20
    else
        if text == "Long" then
            100
        else
            0

weaponAttack (name, target, damage, kind, distance) = custom
{
    Name = name
    Attack = integer
    {
        value = target
        valuedice = msRoll (characterTable.Basics.Roll)
        action = kind
        range = distance
    }
    Damage = string
    {
        value = damage
    }
}

attackFor (char, weapon) =
    if isMelee (weapon) then
        weaponAttack (weapon.Name, char.Stats.Combat + skillBonus (char, "Hand to hand Combat"), valueOr (weapon.data.weaponStats.Stats, "Damage", ""), "melee", 0)
    else
        weaponAttack (weapon.Name, char.Stats.Combat + skillBonus (char, "Firearms"), valueOr (weapon.data.weaponStats.Stats, "Damage", ""), "ranged", rangeMetres (valueOr (weapon.data.weaponStats.Stats, "Range", "")))

characterTable = ruleset
{
  rulesetConfiguration = { important = [Stats, Saves, Health, Attacks] }
  Basics = table
  {
    tableLayout = layout
      {
        columns = 1
        rowTitle = hidden
      }
    
    Roll = selector
    {
      description = "Advantage rolls twice and keeps the better result, disadvantage the worse."
      options = ["Disadvantage", "Normal", "Advantage"]
      labels = ["Disadvantage", "Normal", "Advantage"]
      colors = ["red", "white", "green"]
      hold = ["Ctrl", "", "Shift"]
      default = "Normal"
      editable = live
      save = nosave
    }

    'High Score' = table
    {
      tableLayout = layout
      {
        columns = 1
        rowTitle = hidden
      }

      'High Score' = integer
      {
        description = "Your best result so far, kept as a record across characters."
        default=0
        editable=live
      }
    }

    Class = table
    {
      description = "The character's class, which adjusts stats, saves and how stress is handled."
      tableLayout = layout
      {
        columns = 1
      }
      
      Marine = bool
      {
        description = "Tough and trained for combat. Their fear spreads to the crew when they panic."
        editable=live
        radiogroup="class"
      }
      Android = bool
      {
        description = "Synthetic crew member. Unnerves others but keeps cool itself."
        editable=live
        radiogroup="class"
      }
      Scientist = bool
      {
        description = "Expert in a field of study. Their failed sanity saves stress the crew."
        editable=live
        radiogroup="class"
      }
      Teamster = bool
      {
        description = "Spacer and worker, the backbone of any crew. Gets to reroll a skill."
        editable=live
        radiogroup="class"
      }
    }
  }
  
  Stats = table
  {
    description = "Stats. Roll d100 under the stat to succeed; doubles are criticals."
    Strength = integer
    {
      description = "Lifting, pushing and hitting hard."
      default = 0
      valuedice = checkRoll (characterTable)
    }
    Speed = integer
    {
      description = "Quickness, reflexes and acting first."
      default=0
      valuedice = checkRoll (characterTable)
    }
    Intellect = integer
    {
      description = "Knowledge, reasoning and recall."
      default=0
      valuedice = checkRoll (characterTable)
    }
    Combat = integer
    {
      description = "Fighting skill, rolled to hit in combat."
      default=0
      valuedice = checkRoll (characterTable)
    }
  }

  Saves = table
  {
    description = "Saves resist harm. Roll d100 under the save."
    Sanity = integer
    {
      description = "Resisting hallucinations, delusions and mental strain."
      default=0
      valuedice = checkRoll (characterTable)
    }
    Fear = integer
    {
      description = "Resisting panic and terror."
      default=0
      valuedice = checkRoll (characterTable)
    }
    Body = integer
    {
      description = "Resisting hunger, disease and toxins."
      default=0
      valuedice = checkRoll (characterTable)
    }
  }

  Health = table
  {
    tableLayout = layout
    {
      columns = 1
      rowTitle = hidden
    }
    Health = table
    {
      description = "Health points. When they run out, you take a wound and reset."
      Current = integer
      {
        default = 0
        editable = live
      }
      Maximum = integer
      {
        default = 0
      }
      Recover = button
      {
        description = "Health back to its maximum once there is time to rest. Wounds stay until treated."
        editable = live
        onClick = updates { (root.Health.Health.Current) = Maximum }
      }
    }
    Wounds = table
    {
      description = "Wounds taken. Reach the maximum and you die."
      Current = integer
      {
        default = 0
        editable = live
        indicator = "#d64545"
        indicatorLabel = "Wounds"
      }
      Maximum = integer
      {
        default = 2
      }
    }
    Stress = table
    {
      description = "Stress builds up from failures. Higher stress makes panic checks harder."
      Current = integer
      {
        default = 2
        editable = live
      }
      Minimum = integer
      {
        description = "Stress never goes below this."
        default = 2
      }
      'Panic check' = integer
      {
        description = "Roll 1d20: over your Stress you hold it together, at or under it you panic."
        value = Current
        valuedice = panicRoll
        editable = none
      }
      'Shore leave' = button
      {
        description = "Shore leave relieves stress down to the minimum. It costs credits."
        editable = live
        onClick = updates { (root.Health.Stress.Current) = Minimum }
      }
    }
  }

  'Trained 10' = table
    {
      description = "Trained skills add +10 to rolls."
      Linguistics = custom
      {
        description = "Languages and communication, including alien ones."
        Proficient = bool
        {}
      }
      Zoology = custom
      {
        description = "Animal life and behaviour."
        Proficient = bool
        {}
      }
      Botany = custom
      {
        description = "Plants and fungi."
        Proficient = bool
        {}
      }
      Geology = custom
      {
        description = "Rocks, minerals and the ground."
        Proficient = bool
        {}
      }
      'Industrial Equipment' = custom
      {
        description = "Running heavy machines like loaders and cranes."
        Proficient = bool
        {}
      }
      'Jury Rigging' = custom
      {
        description = "Quick fixes with whatever is at hand."
        Proficient = bool
        {}
      }
      Chemistry = custom
      {
        description = "Chemicals, reactions and compounds."
        Proficient = bool
        {}
      }
      Computers = custom
      {
        description = "Using and programming computers."
        Proficient = bool
        {}
      }
      'Zero G' = custom
      {
        description = "Working and moving in zero gravity."
        Proficient = bool
        {}
      }
      Mathematics = custom
      {
        description = "Numbers, calculation and statistics."
        Proficient = bool
        {}
      }
      Art = custom
      {
        description = "Making and judging art."
        Proficient = bool
        {}
      }
      Archaeology = custom
      {
        description = "Ancient cultures and their remains."
        Proficient = bool
        {}
      }
      Theology = custom
      {
        description = "Religions and belief systems."
        Proficient = bool
        {}
      }
      'Military Training' = custom
      {
        description = "Combat tactics, weapons and discipline."
        Proficient = bool
        {}
      }
      Rimwise = custom
      {
        description = "Street smarts in the stations and colonies of the rim."
        Proficient = bool
        {}
      }
      Athletics = custom
      {
        description = "Running, climbing, swimming and endurance."
        Proficient = bool
        {}
      }
    }

    'Expert 15' = table
    {
      description = "Expert skills add +15 to rolls."
      Psychology = custom
      {
        description = "Understanding minds and behaviour."
        Proficient = bool
        {}
      }
      Pathology = custom
      {
        description = "Disease and its causes."
        Proficient = bool
        {}
      }
      'Field Medicine' = custom
      {
        description = "Treating wounds in the field."
        Proficient = bool
        {}
      }
      Ecology = custom
      {
        description = "Ecosystems and how they fit together."
        Proficient = bool
        {}
      }
      'Asteroid Mining' = custom
      {
        description = "Finding and extracting ore in space."
        Proficient = bool
        {}
      }
      'Mechanical Repair' = custom
      {
        description = "Fixing machines and engines."
        Proficient = bool
        {}
      }
      Explosives = custom
      {
        description = "Making and defusing explosives."
        Proficient = bool
        {}
      }
      Pharmacology = custom
      {
        description = "Drugs and their effects."
        Proficient = bool
        {}
      }
      Hacking = custom
      {
        description = "Breaking into computer systems."
        Proficient = bool
        {}
      }
      Piloting = custom
      {
        description = "Flying ships and vehicles."
        Proficient = bool
        {}
      }
      Physics = custom
      {
        description = "Matter, energy and how they behave."
        Proficient = bool
        {}
      }
      Mysticism = custom
      {
        description = "Spiritual and occult knowledge."
        Proficient = bool
        {}
      }
      'Wilderness Survival' = custom
      {
        description = "Staying alive outdoors on hostile worlds."
        Proficient = bool
        {}
      }
      Firearms = custom
      {
        description = "Shooting guns of all kinds."
        Proficient = bool
        {}
      }
      'Hand to hand Combat' = custom
      {
        description = "Fighting up close with fists and blades."
        Proficient = bool
        {}
      }
    }

    'Master 20' = table
    {
      description = "Master skills add +20 to rolls."
      Sophontology = custom
      {
        description = "Understanding alien minds and cultures."
        Proficient = bool
        {}
      }
      Exobiology = custom
      {
        description = "Life beyond Earth."
        Proficient = bool
        {}
      }
      Surgery = custom
      {
        description = "Operating on the body."
        Proficient = bool
        {}
      }
      Planetology = custom
      {
        description = "How planets form and work."
        Proficient = bool
        {}
      }
      Robotics = custom
      {
        description = "Building and programming robots."
        Proficient = bool
        {}
      }
      Engineering = custom
      {
        description = "Designing and building large systems."
        Proficient = bool
        {}
      }
      Cybernetics = custom
      {
        description = "Implants and machine-body interfaces."
        Proficient = bool
        {}
      }
      'Artificial Intelligence' = custom
      {
        description = "Machine minds and how they think."
