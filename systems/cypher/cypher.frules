#include "/systems/common.frules"
#include "/systems/names/settings.frules"

effectiveLevel (level, eases) = max (0, level - eases)

specialRoll (natural) =
    if natural == 20 then ", major effect (or +4 damage), no pool cost"
    else if natural == 19 then ", minor effect (or +3 damage)"
    else if natural > 16 then ", +" + toString (natural - 16) + " damage in combat"
    else if natural == 1 then ", GM intrusion"
    else ""

specialFor (natural, impaired) = if impaired and natural > 16 then "" else specialRoll (natural)

cypherOutcome (natural, target) =
    if natural == 1 then "Fumble"
    else if natural > 18 and natural >= target then "Critical"
    else if natural >= target then "Success"
    else "Failure"

cypherFull (level, eases, natural, known, xp, impaired) =
{
    Text = if not (known) then toString (natural) + specialFor (natural, impaired) else toString (natural) + " vs " + toString (effectiveLevel (level, eases) * 3) + " (level " + toString (effectiveLevel (level, eases)) + "): " + (if natural >= effectiveLevel (level, eases) * 3 then "Success" else "Failure") + specialFor (natural, impaired)
    Value = natural
    Outcome = if known then cypherOutcome (natural, effectiveLevel (level, eases) * 3) else if natural == 1 then "Fumble" else if natural > 18 then "Critical" else ""
    Push = if xp > 0 then cypherReroll (level, eases, natural, known, xp - 1, impaired) else 0
    PushLabel = "Spend 1 XP to reroll"
    PushSets = [{ Field = "characterTable.Character.XP"  Value = xp - 1 }]
}

cypherReroll (level, eases, natural, known, left, impaired) = ([1d20], ((baseline, throws)->cypherFull (level, eases, max (natural, first (first (throws).rolls)), known, left, impaired)))

cypherResult (level, eases, natural, known) = cypherFull (level, eases, natural, known, 0, false)

cypherRoll (level, effort) = ([1d20], ((baseline, throws)->cypherResult (level, baseline + effort, first (first (throws).rolls), true)))

cypherCharRoll (effort, xp, impaired) = ([1d20], ((baseline, throws)->cypherFull (asked, baseline + effort, first (first (throws).rolls), answered, xp, impaired)))

cypherAskedRoll (effort) = cypherCharRoll (effort, 0, false)

cypherDice (char) = ask ("Task level", cypherCharRoll (char.Character.Effort, char.Character.XP, char.'Damage Track'.Impaired))

plainTask = cypherRoll (0, 0)

trainingEases (training) =
    switch training
        case "Inability" then -1
        case "Trained" then 1
        case "Specialized" then 2
        else 0

pool (start) = custom
{
    Pool = integer { description = "Pool size when fully rested." reference = ["csrd", 6] default = start  minvalue = 0 }
    Current = integer { description = "Points left in the pool. Spend them on Effort and lose them to damage." reference = ["csrd", 6] default = Pool  minvalue = 0  editable = live }
    Edge = integer { description = "Edge cuts the cost of spending from this pool, one point per point of Edge." reference = ["csrd", 6] default = 0  minvalue = 0 }
}

characterTable = ruleset
{
    rulesetConfiguration = { important = [Pools, 'Damage Track', Character.Armor, Character.Effort, Attacks] }
    Character = table
    {
        tableLayout = layout { columns = 3  size = wide }
        Descriptor = string { description = "The adjective in your sentence: how the character goes about things." reference = ["csrd", 8] }
        Type = string { description = "The noun in your sentence: the character's basic role." reference = ["csrd", 8] keys = ["Warrior", "Adept", "Explorer", "Speaker"] }
        Focus = string { description = "The verb in your sentence: what makes the character unique." reference = ["csrd", 8] }
        Flavor = string {}
        Tier = integer { description = "How far the character has advanced, from 1 to 6." reference = ["csrd", 8] default = 1  minvalue = 1  maxvalue = 6 }
        XP = integer { description = "Experience points. Spend 4 to advance, or 1 to reroll and keep the better roll." reference = ["csrd", 4] default = 0  minvalue = 0  editable = live }
        Effort = integer { description = "Levels of Effort to apply to the next roll. Each eases the task one step." reference = ["csrd", 6] default = 0  minvalue = 0  maxvalue = 'Max Effort'  editable = live }
        'Max Effort' = integer { description = "The most Effort you can apply to one task: 1, plus 1 for each Extra Effort advancement." reference = ["csrd", 8] default = 1  minvalue = 1  maxvalue = 6 }
        Armor = integer { description = "Reduces damage from each hit." reference = ["csrd", 249] default = 0 }
        Cypher = integer { description = "How many cyphers you can carry at once." reference = ["csrd", 4] default = 2 }
        Shins = integer { description = "Money." default = 0  editable = live }
    }

    Pools = table
    {
        description = "Might, Speed and Intellect pools: health, stamina and the points you spend." reference = ["csrd", 5]
        tableLayout = layout { columns = 3  size = wide }
        Might = pool (10)
        Speed = pool (10)
        Intellect = pool (10)
    }

    'Damage Track' = table
    {
        description = "When a pool hits 0 you move one step down the track." reference = ["csrd", 252]
        tableLayout = layout { columns = 4  size = wide }
        Impaired = bool { description = "Impaired: Effort costs 1 more point and rolls do not give special effects." reference = ["csrd", 252] default = false  editable = live  indicator = "#d4b106" }
        Debilitated = bool { description = "Debilitated: you can only move a short distance." reference = ["csrd", 252] default = false  editable = live  indicator = "#d64545" }
        Dead = bool { default = false  editable = live  indicator = "#555555" }
        State = string { value = if Dead then "Dead" else if Debilitated then "Debilitated" else if Impaired then "Impaired" else "Hale" }
    }

    'Recovery Rolls' = table
    {
        tableLayout = layout { columns = 3  size = wide }
        'Recovery Bonus' = integer { description = "Points regained per recovery roll: 1d6 plus your tier." reference = ["csrd", 252] value = Character.Tier  valuedice = 1d6  editable = none }
        Used = slots { description = "Recovery rolls used today. Each takes longer than the last." reference = ["csrd", 253] number = 4  editable = live  labels = ["1 action", "10 min", "1 hour", "10 hours"] }
        'New day' = button { description = "After the ten-hour rest it is a new day, and every recovery roll is free again."  reference = ["csrd", 253]  editable = live  onClick = updates { (root.'Recovery Rolls'.Used.realvalue) = 0 } }
    }

    Tasks = table
    {
        description = "Steps by which each kind of task is eased, from training and assets." reference = ["csrd", 242]
        tableLayout = layout { columns = 3  size = wide }
        Might = integer { description = "Steps by which tasks of strength and endurance are eased." reference = ["csrd", 242] default = 0  valuedice = cypherDice (characterTable) }
        Speed = integer { description = "Steps by which tasks of quickness and agility are eased." reference = ["csrd", 242] default = 0  valuedice = cypherDice (characterTable) }
        Intellect = integer { description = "Steps by which tasks of thought and will are eased." reference = ["csrd", 242] default = 0  valuedice = cypherDice (characterTable) }
        Initiative = integer { description = "Roll at the start of combat. Beat the foes' target number to act first." reference = ["csrd", 247] default = 0  valuedice = 1d20 }
        'Speed Defense' = integer { description = "Steps by which dodging attacks is eased." reference = ["csrd", 11] default = 0  valuedice = cypherDice (characterTable) }
        'Might Defense' = integer { description = "Steps by which resisting poison, disease and force is eased." reference = ["csrd", 11] default = 0  valuedice = cypherDice (characterTable) }
        'Intellect Defense' = integer { description = "Steps by which resisting mental attacks is eased." reference = ["csrd", 11] default = 0  valuedice = cypherDice (characterTable) }
    }

    Skills = keyvalues
    {
        description = "Skills. Training eases a task one step, specialization two; inability hinders it." reference = ["csrd", 9]
        singular = "Skill"
        editablekeys = character
        keys = []
        tableLayout = layout { size = wide }
        valueType = custom
        {
            Training = string { description = "Inability hinders the task, trained eases it one step, specialized two." reference = ["csrd", 242] default = "Trained"  keys = ["Inability", "Practiced", "Trained", "Specialized"] }
            Assets = integer { description = "Assets ease the task one step each, at most two." reference = ["csrd", 242] default = 0  minvalue = 0  maxvalue = 2 }
            Roll = integer { description = "Total steps by which the task is eased." reference = ["csrd", 242] value = trainingEases (Training) + Assets  valuedice = cypherDice (characterTable)  editable = none }
        }
    }

    Abilities = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Abilities
        singular = "Ability"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        singular = "Attack"
        editable = character
        valueType = custom
        {
            Name = string {}
            Eases = integer { default = 0  valuedice = cypherDice (characterTable)  action = Kind  reach = 5  range = Range }
            Damage = integer { default = 4 }
            Kind = string { description = "Melee attacks reach the next square; ranged ones reach out to Range." default = "melee"  keys = ["melee", "ranged"] }
            Range = integer { description = "How far a ranged attack reaches, in feet: 10 immediate, 50 short, 100 long." default = 50  minvalue = 0 }
        }
    }

    Cyphers = list
    {
        description = "One-use devices with strange powers. Carrying too many is dangerous." reference = ["csrd", 239]
        tableLayout = layout { size = wide }
        source = secondary.Cyphers
        singular = "Cypher"
        editable = character
    }

    Equipment = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Equipment
        singular = "Item"
        editable = character
    }

    Advancement = table
    {
        tableLayout = layout { columns = 5  size = wide }
        'Increase Capabilities' = bool { default = false }
        'Move Toward Perfection' = bool { default = false }
        'Extra Effort' = bool { default = false }
        'Skill Training' = bool { default = false }
        Other = bool { default = false }
    }

    Background = table
    {
        tableLayout = layout { columns = 2  size = wide }
        'Connection' = string { multiline = true }
        Notes = string { multiline = true }
    }
}

creatureTable = ruleset
{
    rulesetConfiguration =
    {
        important = [Stats]
        defaultImage = "/images/armour.svg"
        sortedBy = sort { prefix = "Level" sort = Stats.Level }
    }
    Stats = table
    {
        tableLayout = layout { columns = 3  size = wide }
        Level = integer { description = "The creature's level from 1 to 10. Everything about it uses this number." reference = ["csrd", 2] default = 3  minvalue = 1  maxvalue = 10 }
        'Target Number' = integer { description = "What players must roll to affect the creature: three times its level." reference = ["csrd", 2] value = Level * 3  editable = none }
        Health = integer { description = "Health when unhurt." default = 9 }
        'Current Health' = integer { description = "Current health. At 0 the creature is defeated." default = Health  editable = live }
        Damage = integer { description = "Damage dealt by a hit." default = 3 }
        Armor = integer { description = "Reduces damage from each hit." reference = ["csrd", 249] default = 0 }
        Movement = string { default = "Short" }
        Down = string { value = if 'Current Health' < 1 then "Defeated" else ""  visible = none  indicator = "#d64545" }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        Modifications = string { multiline = true }
        Combat = string { multiline = true }
        Interaction = string { multiline = true }
        Use = string { multiline = true }
        Loot = string { multiline = true }
        'GM Intrusion' = string { multiline = true }
    }
}

abilityStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        filters = [filter { name = "Tier" prefix = "Tier" filter = Stats.Tier }]
    }
    Stats = table
    {
        Cost = string {}
        Pool = string { keys = ["Might", "Speed", "Intellect", ""] }
        Tier = string {}
        Action = bool { default = true }
        Enabler = bool { default = false }
    }
}

cypherStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Level = string {}
        Form = string {}
        Kind = string { keys = ["Subtle", "Manifest", "Fantastic"] }
    }
}

equipmentStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Kind = string { keys = ["Light weapon", "Medium weapon", "Heavy weapon", "Light armor", "Medium armor", "Heavy armor", "Gear", "Artifact"] }
        Damage = string {}
        Armor = string {}
        Range = string {}
        Price = string {}
    }
}

typeStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Kind = string { keys = ["Type", "Descriptor", "Focus", "Flavor"] }
        Pools = string {}
        Edges = string {}
        Benefits = string { multiline = true }
    }
}

CypherSystem = system
{
    hints = [
        hint
        {
            title = "I am a..."
            topic = "Getting started"
            text = ["Each character is a sentence: an adjective descriptor, a type, and a focus that does something."]
        },
        hint
        {
            title = "Task levels"
            topic = "Play"
            text = ["Every roll asks for the task's level. Skills, assets and Effort ease it, and the target is level times 3. Leave it blank when only the GM knows it.", "The GM never rolls: players roll to attack and to defend.", "After a roll, a player can spend 1 XP to reroll and keep the better result."]
        },
        hint
        {
            title = "Initiative"
            topic = "Initiative"
            text = ["Roll the Initiative field (a Speed task) to join the list."]
        },
        hint
        {
            title = "Intrusions"
            topic = "Play"
            text = ["Offer GM intrusions with 2 XP to complicate things; a natural 1 is a free intrusion."]
        }
    ]
    distanceUnit = "ft"
    squareSize = 5
    characters = characterTable
    creatures = creatureTable
    Abilities = abilityStats
    Cyphers = cypherStats
    Equipment = equipmentStats
    'Character Options' = typeStats
    secondaryTypes = ["Abilities", "Cyphers", "Equipment"]
    otherLibararyTypes = ["Character Options"]
    description = "Cypher System: d20 against task level, with stat pools and Effort"
    initiativeCompare (item1, item2) = compare (toInt (item1), toInt (item2))
    quickdice = [1d20, 1d6, 1d100]
    cssFiles = ["/systems/cypher/cypher.css"]
    libraries = ["/systems/cypher/cypher.json", "/systems/names/fantasy.json", "/systems/names/scifi.json", "/systems/names/cyberpunk.json", "/systems/names/heroes.json", "/systems/names/cosmic.json", "/systems/names/wasteland.json", "/systems/tables/fantasy.json", "/systems/tables/scifi.json"]
    nameSettings = [fantasyNameSetting, spaceNameSetting, neonStreetsNameSetting, superheroesNameSetting, cosmicHorrorNameSetting, wastelandNameSetting]
}
