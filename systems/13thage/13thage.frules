#include "/systems/common.frules"
#include "/systems/names/settings.frules"

abilityModifier (score) = score / 2 - 5

middle (a, b, c) = a + b + c - max (a, b, c) - min (a, b, c)

levelMultiplier (level) =
    switch level
        case 1 then 3
        case 2 then 4
        case 3 then 5
        case 4 then 6
        case 5 then 8
        case 6 then 10
        case 7 then 12
        case 8 then 16
        case 9 then 20
        else 24

naturalNote (natural) =
    if natural == 20 then ", natural 20: critical hit"
    else if natural == 1 then ", natural 1: fumble"
    else if mod (natural, 2) == 0 then ", natural even"
    else ", natural odd"

attackText (total, natural, defense, escalation) =
    toString (total)
    + (if escalation > 0 then " (escalation +" + toString (escalation) + ")" else "")
    + (if defense > 0 then " vs " + toString (defense) + ": " + (if natural == 20 then "critical hit" else if natural == 1 then "miss" else if total >= defense then "hit" else "miss") else "")
    + naturalNote (natural)

attackOutcome (total, natural, defense) =
    if natural == 20 then "Critical hit"
    else if natural == 1 then "Fumble"
    else if defense == 0 then ""
    else if total >= defense then "Hit"
    else "Miss"

attackResult (bonus, natural, defense, escalation) =
{
    Text = attackText (bonus + natural + escalation, natural, defense, escalation)
    Value = bonus + natural + escalation
    Outcome = attackOutcome (bonus + natural + escalation, natural, defense)
}

attackRoll (defense, escalation) = ([1d20],
    ((baseline, throws)->attackResult (baseline, first (first (throws).rolls), defense, escalation)))

askedAttack = ask ("Escalation die", 0, ([1d20], ((baseline, throws)->attackResult (baseline, first (first (throws).rolls), 0, asked))))

checkResult (total, natural, dc) =
{
    Text = toString (total) + (if dc > 0 then " vs DC " + toString (dc) + ": " + (if total >= dc then "success" else "failure") else "") + (if natural == 20 then ", natural 20" else if natural == 1 then ", natural 1" else "")
    Value = total
    Outcome = if dc == 0 then "" else if total >= dc then "Success" else "Failure"
}

checkRoll (dc) = ([1d20], ((baseline, throws)->checkResult (baseline + first (first (throws).rolls), first (first (throws).rolls), if dc < 0 then asked else dc)))

skillCheck = ask ("DC", checkRoll (-1))

iconResult (rolls) =
{
    Text = toString (count (filter ((x)->x == 6, rolls))) + " full benefit, " + toString (count (filter ((x)->x == 5, rolls))) + " with a complication"
    Value = count (filter ((x)->x >= 5, rolls))
    Outcome = if count (filter ((x)->x == 6, rolls)) > 0 then "Success" else if count (filter ((x)->x == 5, rolls)) > 0 then "Complication" else ""
}

iconRoll (diceCount) = ([dice { number = diceCount  sides = 6 }], ((baseline, throws)->iconResult (first (throws).rolls)))

ability = custom
{
    Score = integer { description = "The raw ability score, usually from 8 to 20." reference = ["srd", 11] default = 10  minvalue = 3  maxvalue = 30 }
    Modifier = modifier { description = "Bonus from the score: (score - 10) / 2, rounded down." value = abilityModifier (Score)  editable = none }
    'Mod plus level' = modifier { description = "Ability modifier plus level, the usual bonus for checks with this ability." reference = ["srd", 16] value = abilityModifier (Score) + Character.Level  valuedice = skillCheck  editable = none }
}

abilityMod (char, name) =
    switch name
        case "Str" then char.Abilities.Str.Modifier
        case "Con" then char.Abilities.Con.Modifier
        case "Dex" then char.Abilities.Dex.Modifier
        case "Int" then char.Abilities.Int.Modifier
        case "Wis" then char.Abilities.Wis.Modifier
        else char.Abilities.Cha.Modifier

conMultiplier (level) = if level >= 8 then 3 else if level >= 5 then 2 else 1

deathSaveResult (natural) =
{
    Text = toString (natural) + " vs 16: " + (if natural >= 16 then "success, spend a recovery and get up" else "failure")
    Value = natural
    Outcome = if natural >= 16 then "Success" else "Failure"
}

deathSave = ([1d20], ((baseline, throws)->deathSaveResult (first (first (throws).rolls))))

hpState (hp, maxHp) =
    if hp <= 0 - maxHp / 2 then "Dead"
    else if hp <= 0 then "Unconscious"
    else if hp <= maxHp / 2 then "Staggered"
    else ""

characterTable = ruleset
{
    rulesetConfiguration = { important = [Defenses, Health, Attacks] }
    Character = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Race = string { keys = ["Dwarf", "Dark Elf", "High Elf", "Wood Elf", "Gnome", "Half-Elf", "Half-Orc", "Halfling", "Human", "Dragonic", "Holy One", "Forgeborn", "Tiefling"] }
        Class = string { keys = ["Barbarian", "Bard", "Cleric", "Fighter", "Paladin", "Ranger", "Rogue", "Sorcerer", "Wizard"] }
        Level = integer { description = "Character level from 1 to 10. Added to attacks, defenses and checks." reference = ["srd", 346] default = 1  minvalue = 1  maxvalue = 10 }
        'One unique thing' = string { description = "Something no one else in the world has, written by the player." reference = ["srd", 13] }
        Incremental = integer { description = "Small advances taken between levels, such as an extra power or more HP." reference = ["srd", 346] default = 0  minvalue = 0  maxvalue = 4  editable = live }
        Gold = integer { default = 25 }
    }

    Abilities = table
    {
        description = "The six abilities. Defenses use the middle modifier of three of them." reference = ["srd", 11]
        tableLayout = layout { columns = 3  size = wide }
        Str = ability {}
        Con = ability {}
        Dex = ability {}
        Int = ability {}
        Wis = ability {}
        Cha = ability {}
    }

    Defenses = table
    {
        tableLayout = layout { columns = 3 }
        AC = integer { description = "Armor Class: how hard you are to hit with weapons and physical attacks." reference = ["srd", 12] value = 'AC base' + middle (Abilities.Con.Modifier, Abilities.Dex.Modifier, Abilities.Wis.Modifier) + Character.Level  editable = none }
        PD = integer { description = "Physical Defense: resists poison, breath weapons and being shoved." reference = ["srd", 12] value = 'PD base' + middle (Abilities.Str.Modifier, Abilities.Con.Modifier, Abilities.Dex.Modifier) + Character.Level  editable = none }
        MD = integer { description = "Mental Defense: resists charms, illusions and fear." reference = ["srd", 12] value = 'MD base' + middle (Abilities.Int.Modifier, Abilities.Wis.Modifier, Abilities.Cha.Modifier) + Character.Level  editable = none }
        'AC base' = integer { default = 12 }
        'PD base' = integer { default = 10 }
        'MD base' = integer { default = 10 }
        Initiative = modifier { description = "Dex modifier plus level. Higher acts earlier in the round." reference = ["srd", 13] value = Abilities.Dex.Modifier + Character.Level + 'Initiative bonus'  valuedice = 1d20  editable = none }
        'Initiative bonus' = integer { default = 0 }
    }

    Health = table
    {
        tableLayout = layout { columns = 3 }
        'HP base' = integer { default = 7 }
        'Max HP' = integer { description = "Hit points when unhurt: class base plus Con, times a multiplier for level." reference = ["srd", 329] value = ('HP base' + Abilities.Con.Modifier) * levelMultiplier (Character.Level)  editable = none }
        HP = integer { description = "Current hit points. At half you are staggered, at 0 you go down." reference = ["srd", 337] default = 'Max HP'  editable = live  indicator = "#d64545" }
        State = string { value = hpState (HP, 'Max HP')  editable = none  indicator = "#d64545" }
        'Max recoveries' = integer { description = "Recoveries you have after a full heal-up, usually 8." reference = ["srd", 13] default = 8  minvalue = 0 }
        Recoveries = integer { description = "How many times a day you can heal by rolling recovery dice." reference = ["srd", 13] default = 'Max recoveries'  minvalue = 0  editable = live }
        'Recovery die' = string { default = "d8"  keys = ["d6", "d8", "d10", "d12"] }
        Recovery = string { description = "What one recovery heals: level times the recovery die, plus Con (twice Con from 5th level, three times from 8th)." reference = ["srd", 13] value = toString (Character.Level) + 'Recovery die' + (if Abilities.Con.Modifier >= 0 then "+" else "") + toString (Abilities.Con.Modifier * conMultiplier (Character.Level))  editable = none }
        'Death save' = integer { description = "At 0 HP or below, roll a d20 at the start of each turn: 16 or more spends a recovery and gets you up." value = 0  valuedice = deathSave  editable = none }
        'Failed death saves' = slots { description = "The fourth failed death save in a battle kills you. Clear it after the battle." number = 4  editable = live  indicator = "#d64545" }
        'Full heal up' = button { description = "After about four battles: hit points back to full and every recovery regained. Untick your used powers too."  reference = ["srd", 338]  editable = live  onClick = updates
            {
                (root.Health.HP) = 'Max HP'
                (root.Health.Recoveries) = 'Max recoveries'
                (root.Health.'Failed death saves'.realvalue) = 0
            }
        }
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        singular = "Attack"
        editable = character
        valueType = custom
        {
            Name = string { default = "Melee basic attack" }
            Ability = string { default = "Str"  keys = ["Str", "Con", "Dex", "Int", "Wis", "Cha"] }
            Bonus = integer { default = 0 }
            Defense = string { default = "AC"  keys = ["AC", "PD", "MD"] }
            Attack = modifier { description = "Total attack bonus: ability modifier plus level plus any bonus." reference = ["srd", 328] value = abilityMod (characterTable, Ability) + characterTable.Character.Level + Bonus  valuedice = askedAttack  action = if contains (toLower (Name), "ranged") then "ranged" else "melee"  reach = 1  editable = none }
            Hit = string {}
            Miss = string {}
        }
    }

    Backgrounds = keyvalues
    {
        description = "Your history, as points that add to skill checks where the background fits." reference = ["srd", 16]
        singular = "Background"
        editablekeys = character
        keys = []
        tableLayout = layout { columns = 2 }
        valueType = custom
        {
            Points = integer { description = "Points in this background, added to checks where it applies." reference = ["srd", 16] default = 2  minvalue = 1  maxvalue = 5 }
            Ability = string { default = "Int"  keys = ["Str", "Con", "Dex", "Int", "Wis", "Cha"] }
            Check = modifier { description = "Points plus ability modifier plus level for a check with this background." reference = ["srd", 16] value = Points + abilityMod (characterTable, Ability) + characterTable.Character.Level  valuedice = skillCheck  editable = none }
        }
    }

    Icons = keyvalues
    {
        description = "Your ties to the Icons, the great powers of the Dragon Empire." reference = ["srd", 13]
        singular = "Icon relationship"
        editablekeys = character
        keys = []
        tableLayout = layout { columns = 2 }
        valueType = custom
        {
            Relationship = string { default = "Positive"  keys = ["Positive", "Conflicted", "Negative"] }
            Dice = integer { description = "Icon relationship dice. A 6 gives a benefit, a 5 a benefit with a cost." reference = ["srd", 14] default = 1  minvalue = 1  maxvalue = 3  valuedice = iconRoll (Dice) }
        }
    }

    Powers = list
    {
        description = "Class and race powers, with how often each can be used."
        tableLayout = layout { size = wide }
        singular = "Power or spell"
        editable = character
        valueType = custom
        {
            Name = string {}
            Usage = string { default = "At-will"  keys = ["At-will", "Recharge", "Battle", "Daily", "Cyclic"] }
            Used = bool { default = false  editable = live }
            Effect = string { multiline = true }
        }
    }

    Spells = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Spells
        singular = "Spell"
        editable = character
    }

    'Class Powers' = list
    {
        tableLayout = layout { size = wide }
        source = secondary.'Class Powers'
        singular = "Class power"
        editable = character
    }

    'Talents and Feats' = list
    {
        tableLayout = layout { size = wide }
        source = secondary.'Talents and Feats'
        singular = "Talent or feat"
        editable = character
    }

    Talents = list
    {
        singular = "Talent or feat"
        editable = character
        valueType = nameAndDescription
    }

    Gear = table
    {
        tableLayout = layout { columns = 2 }
        Armor = string {}
        Weapons = string {}
        'Magic items' = string { multiline = true }
        Notes = string { multiline = true }
    }

    'Magic Items' = list
    {
        tableLayout = layout { size = wide }
        source = secondary.'Magic Items'
        singular = "Magic item"
        editable = character
    }
}

monsterTable = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/systems/adnd2e/monster.svg"
        important = [Monster, Attacks]
        sortedBy = sort { prefix = "Level" sort = Monster.Level }
    }
    Monster = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Level = integer { default = 1 }
        Size = string { default = "Normal"  keys = ["Normal", "Large", "Huge"] }
        Role = string { default = "Troop"  keys = ["Archer", "Blocker", "Caster", "Leader", "Mook", "Spoiler", "Troop", "Wrecker"] }
        Type = string {}
        Initiative = modifier { description = "Bonus to the monster's initiative roll." reference = ["srd", 328] default = 3  valuedice = 1d20 }
        AC = integer { description = "Armor Class: the target number for weapon attacks." reference = ["srd", 329] default = 17 }
        PD = integer { description = "Physical Defense: the target number for physical effects." reference = ["srd", 329] default = 14 }
        MD = integer { description = "Mental Defense: the target number for mental effects." reference = ["srd", 329] default = 12 }
        'Max HP' = integer { default = 27 }
        HP = integer { description = "Current hit points. The monster is staggered at half." reference = ["srd", 337] default = 'Max HP'  editable = live  indicator = "#d64545" }
        State = string { value = if HP <= 0 then "Dead" else if HP <= 'Max HP' / 2 then "Staggered" else ""  editable = none  indicator = "#d64545" }
    }
    Attacks = list
    {
        tableLayout = layout { size = wide }
        singular = "Attack"
        editable = character
        valueType = custom
        {
            Name = string {}
            Attack = modifier { default = 6  valuedice = attackRoll (0, 0)  action = melee  reach = 1 }
            Defense = string { default = "AC"  keys = ["AC", "PD", "MD"] }
            Hit = string {}
            Triggers = string {}
        }
    }
    Abilities = list
    {
        tableLayout = layout { size = wide }
        singular = "Ability"
        editable = character
        valueType = nameAndDescription
    }
}

spellStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        sortedBy = sort { prefix = "Level" sort = Stats.Level }
        filters = [filter { name = "Class" prefix = "" filter = Stats.Class }, filter { name = "Level" prefix = "Level" filter = Stats.Level }]
    }
    Stats = table
    {
        Class = string {}
        Level = integer { default = 1 }
        Type = string {}
        Usage = string {}
        Action = string {}
        Target = string {}
        Attack = string {}
    }
}

classPowerStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        sortedBy = sort { prefix = "Level" sort = Stats.Level }
        filters = [filter { name = "Class" prefix = "" filter = Stats.Class }, filter { name = "Level" prefix = "Level" filter = Stats.Level }]
    }
    Stats = table
    {
        Class = string {}
        Kind = string {}
        Level = integer { default = 1 }
        Type = string {}
        Usage = string {}
        Trigger = string {}
        Attack = string {}
    }
}

talentStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        filters = [filter { name = "Kind" prefix = "" filter = Stats.Kind }, filter { name = "Class" prefix = "" filter = Stats.Class }]
    }
    Stats = table
    {
        Kind = string { keys = ["Talent", "Class feature", "Racial power", "General feat"] }
        Class = string {}
    }
}

magicItemStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/armour.svg"
        filters = [filter { name = "Slot" prefix = "" filter = Stats.Slot }, filter { name = "Tier" prefix = "" filter = Stats.Tier }]
    }
    Stats = table
    {
        Slot = string {}
        Tier = string { keys = ["", "Adventurer", "Champion", "Epic"] }
        'Default bonus' = string {}
        Usage = string {}
        Quirk = string {}
    }
}

ThirteenthAge = system
{
    hints = [
        hint
        {
            title = "One unique thing"
            topic = "Getting started"
            text = ["Each hero has a one unique thing, backgrounds instead of skills, and relationships with the icons. Set the base AC, PD, MD and HP from the class; the sheet adds the middle modifiers and level."]
        },
        hint
        {
            title = "Escalation die"
            topic = "Combat"
            text = ["From the second round the escalation die goes up by 1 each round, to 6. Heroes add it to attack rolls: Fudger asks for it when you attack. Natural even and odd rolls trigger many powers."]
        },
        hint
        {
            title = "Checks and icons"
            topic = "Play"
            text = ["Skill checks are d20 + ability + level + background points against a DC. At the start of a session roll each icon relationship's dice: a 6 is a full benefit, a 5 a benefit with a complication."]
        },
        hint
        {
            title = "Initiative"
            topic = "Initiative"
            text = ["Roll Initiative once per battle: d20 + Dex + level. Monsters roll d20 + their initiative bonus."]
        }
    ]
    distanceUnit = "m"
    characters = characterTable
    creatures = monsterTable
    Spells = spellStats
    'Magic Items' = magicItemStats
    'Class Powers' = classPowerStats
    'Talents and Feats' = talentStats
    secondaryTypes = ["Spells", "Class Powers", "Talents and Feats", "Magic Items"]
    entityTypeNames = [entityTypeName ("Creature", "Monster", "Monsters")]
    description = "13th Age: d20 heroics with the escalation die, icons and one unique thing"
    initiativeCompare (item1, item2) = compare (item1, item2)
    quickdice = [1d20, 1d6, 1d8, 1d10, 1d12]
    cssFiles = ["/systems/13thage/13thage.css"]
    libraries = ["/systems/13thage/13thage.json", "/systems/names/fantasy.json", "/systems/names/barbarian.json", "/systems/names/desert.json", "/systems/tables/fantasy.json"]
    nameSettings = [fantasyNameSetting, swordAndSorceryNameSetting, desertRealmsNameSetting]
}
