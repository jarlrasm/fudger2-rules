#include "/systems/common.frules"
#include "/systems/names/settings.frules"

shownIf (flag) = if flag then visible else none

abilityModifier (score) =
    if score < 4 then -3
    else if score < 6 then -2
    else if score < 9 then -1
    else if score < 13 then 0
    else if score < 16 then 1
    else if score < 18 then 2
    else 3

hitsAC (thac0, natural, total) =
    if natural == 20 then "Hits any AC"
    else if natural == 1 then "Misses"
    else "Hits AC " + toString (thac0 - total) + " or worse"

attackResult (thac0, natural, total) =
{
    Text = toString (total) + ": " + hitsAC (thac0, natural, total)
    Value = total
    Outcome = if natural == 20 then "Critical" else if natural == 1 then "Miss" else ""
}

oseAttack (thac0) = ([1d20], ((baseline, throws)->attackResult (thac0, first (first (throws).rolls), baseline + first (first (throws).rolls))))

saveResult (target, natural) =
{
    Text = toString (natural) + " vs " + toString (target) + ": " + (if natural >= target then "Saved" else "Failed")
    Value = natural
    Outcome = if natural >= target then "Success" else "Failure"
}

oseSave = ([1d20], ((baseline, throws)->saveResult (baseline, first (first (throws).rolls))))

checkResult (score, natural) =
{
    Text = toString (natural) + " vs " + toString (score) + ": " + (if natural <= score and natural < 20 then "Success" else "Failure")
    Value = natural
    Outcome = if natural <= score and natural < 20 then "Success" else "Failure"
}

percentResult (score, natural) =
{
    Text = toString (natural) + " vs " + toString (score) + ": " + (if natural <= score then "Success" else "Failure")
    Value = natural
    Outcome = if natural <= score then "Success" else "Failure"
}

percentCheck = ([1d100], ((baseline, throws)->percentResult (baseline, first (first (throws).rolls))))

abilityCheck = ([1d20], ((baseline, throws)->checkResult (baseline, first (first (throws).rolls))))

xInSix = ([1d6], ((baseline, throws)->if first (first (throws).rolls) <= baseline then { Text = toString (first (first (throws).rolls)) + " in " + toString (baseline) + ": Success"  Outcome = "Success" } else { Text = toString (first (first (throws).rolls)) + " in " + toString (baseline) + ": Failure"  Outcome = "Failure" }))

ability = custom
{
    Score = integer { description = "Ability score from 3 to 18. Roll d20 at or under it for an ability check." reference = ["bfrpg", 8] default = 10  minvalue = 3  maxvalue = 18  valuedice = abilityCheck }
    Modifier = modifier { description = "Modifier from the score: from -3 at 3 to +3 at 18." reference = ["bfrpg", 8] value = abilityModifier (Score)  editable = none }
}

weaponStat (weapon, field) = valueOr (weapon.data.weaponStats.Stats, field, "")

weaponAttack (name, thac0, bonus, damage, kind, distance) = custom
{
    Name = name
    Attack = modifier { value = bonus  valuedice = oseAttack (thac0)  action = kind  reach = 5  range = distance }
    Damage = damage
}

firstNumber (text) = bonusWithValue ([[text]], "^[^0-9]*([0-9]+)")

isLauncher (weapon) = contains (toLower (weapon.Name), "bow") or contains (toLower (weapon.Name), "sling")

hasRange (weapon) = firstNumber (weaponStat (weapon, "Long Range")) > 0

dexInitiative (score) = if score < 4 then -2 else if score < 9 then -1 else if score < 13 then 0 else if score < 18 then 1 else 2

thrownAttack (char, weapon) =
    weaponAttack (weapon.Name + " (thrown)", char.Combat.THAC0, char.Abilities.DEX.Modifier + toInt (weaponStat (weapon, "Attack Bonus")), weaponStat (weapon, "Damage"), "ranged", firstNumber (weaponStat (weapon, "Long Range")))

attackFor (char, weapon) =
    if isLauncher (weapon) and hasRange (weapon) then
        weaponAttack (weapon.Name, char.Combat.THAC0, char.Abilities.DEX.Modifier + toInt (weaponStat (weapon, "Attack Bonus")), weaponStat (weapon, "Damage"), "ranged", firstNumber (weaponStat (weapon, "Long Range")))
    else
        weaponAttack (weapon.Name, char.Combat.THAC0, char.Abilities.STR.Modifier + toInt (weaponStat (weapon, "Attack Bonus")), weaponStat (weapon, "Damage") + (if char.Abilities.STR.Modifier > 0 then "+" + toString (char.Abilities.STR.Modifier) else if char.Abilities.STR.Modifier < 0 then toString (char.Abilities.STR.Modifier) else ""), "melee", 5)

spellSlots (level) = custom
{
    Slots = integer { description = "Spells of this level the character can memorise each day." reference = [["bfrpg", 11], ["bfrpg", 12]] default = 0 }
    Used = integer { description = "Slots used since the last rest." default = 0  editable = live }
}

characterTable = ruleset
{
    rulesetConfiguration = { important = [Combat, 'Saving Throws', Attacks] }
    Character = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Class = string { keys = ["Cleric", "Dwarf", "Elf", "Fighter", "Halfling", "Magic-User", "Thief"] }
        Level = integer { description = "Character level. Higher levels bring more HP, better saves and attacks." default = 1  minvalue = 1  maxvalue = 14 }
        Alignment = string { keys = ["Lawful", "Neutral", "Chaotic"] }
        Title = string {}
        XP = integer { description = "Experience points earned from treasure and defeated foes." reference = ["bfrpg", 53] default = 0  editable = live }
        'XP for Next Level' = integer { description = "Experience needed for the next level." reference = [["bfrpg", 11], ["bfrpg", 12]] default = 2000 }
        'Prime Requisite Bonus' = string { description = "Bonus or penalty to experience from the class's prime requisite." reference = ["bfrpg", 8] keys = ["-20%", "-10%", "None", "+5%", "+10%"] }
    }

    Abilities = table
    {
        description = "The six ability scores and their modifiers." reference = ["bfrpg", 8]
        tableLayout = layout { columns = 3  size = wide }
        STR = ability {}
        INT = ability {}
        WIS = ability {}
        DEX = ability {}
        CON = ability {}
        CHA = ability {}
    }

    Combat = table
    {
        tableLayout = layout { columns = 4  size = wide }
        'Armour Class' = integer { description = "Descending armour class: lower is better, 9 is unarmoured." default = 9 }
        'Ascending AC' = integer { description = "Ascending armour class: 19 minus descending AC. Higher is better." value = 19 - 'Armour Class'  editable = none }
        THAC0 = integer { description = "To hit armour class 0, roll this or higher on d20. Lower is better." default = 19 }
        'Attack Bonus' = integer { description = "Attack bonus for ascending AC: 19 minus THAC0." reference = ["bfrpg", 57] value = 19 - THAC0  editable = none }
        'Max HP' = integer { description = "Hit points when unhurt." reference = ["bfrpg", 8] default = 4 }
        HP = integer { description = "Current hit points. At 0 the character dies." reference = ["bfrpg", 62] default = 'Max HP'  editable = live }
        'Day of rest' = button { description = "A full day of rest heals 1d3 hit points: roll it and add them to HP. Spellcasters memorise their spells again after a night's sleep."  editable = live  onClick = updates
            {
                (root.'Spell Slots'.'Level 1'.Used) = 0
                (root.'Spell Slots'.'Level 2'.Used) = 0
                (root.'Spell Slots'.'Level 3'.Used) = 0
                (root.'Spell Slots'.'Level 4'.Used) = 0
                (root.'Spell Slots'.'Level 5'.Used) = 0
                (root.'Spell Slots'.'Level 6'.Used) = 0
            }
        }
        Down = string { value = if HP < 1 then "Dead" else ""  visible = none  indicator = "#d64545" }
        Initiative = modifier { description = "Roll d6 plus the DEX initiative modifier (-2 to +2) for individual initiative." reference = ["bfrpg", 55] value = dexInitiative (Abilities.DEX.Score)  valuedice = 1d6  editable = none }
        Movement = string { description = "Movement per turn, with the rate per round in brackets." reference = ["bfrpg", 46] default = "120' (40')" }
        'Encounter Movement' = string { description = "Movement per round in an encounter." reference = ["bfrpg", 46] default = "40'" }
    }

    'Saving Throws' = table
    {
        description = "Roll d20 at or above the number to save. Lower numbers are better." reference = ["bfrpg", 64]
        tableLayout = layout { columns = 5  size = wide }
        'Death or Poison' = integer { description = "Save against death rays and poison." reference = ["bfrpg", 65] default = 12  valuedice = oseSave }
        Wands = integer { description = "Save against magic wands." reference = ["bfrpg", 65] default = 13  valuedice = oseSave }
        'Paralysis or Petrify' = integer { description = "Save against paralysis and turning to stone." reference = ["bfrpg", 65] default = 14  valuedice = oseSave }
        Breath = integer { description = "Save against breath attacks." reference = ["bfrpg", 65] default = 15  valuedice = oseSave }
        'Spells or Rods or Staves' = integer { description = "Save against spells, rods and staves." reference = ["bfrpg", 65] default = 16  valuedice = oseSave }
        'Magic Save Modifier' = modifier { description = "WIS modifier, added to saves against magic." value = Abilities.WIS.Modifier  editable = none }
    }

    'Class Abilities' = table
    {
        description = "Chances out of six for common adventuring tasks."
        tableLayout = layout { columns = 4  size = wide }
        'Open Doors' = integer { description = "Chance in six to force open a stuck door." reference = ["bfrpg", 47] default = 2  valuedice = xInSix }
        'Find Secret Doors' = integer { description = "Chance in six to find a secret door when searching." reference = ["bfrpg", 48] default = 1  valuedice = xInSix }
        'Find Room Traps' = integer { description = "Chance in six to find a trap in a room when searching." reference = ["bfrpg", 47] default = 1  valuedice = xInSix }
        Listen = integer { description = "Chance in six to hear noises behind a door." reference = ["bfrpg", 47] default = 1  valuedice = xInSix }
        Languages = string { default = "Alignment, Common" }
        'Other Abilities' = string { multiline = true }
    }

    'Thief Skills' = table
    {
        description = "Thief skills as percentages, except hear noise out of six." reference = ["bfrpg", 13]
        tableLayout = layout { columns = 4  size = wide }
        visible = shownIf (Character.Class == "Thief")
        'Climb Sheer Surfaces' = integer { description = "Chance to climb sheer walls." reference = ["bfrpg", 13] default = 87  valuedice = percentCheck }
        'Find or Remove Traps' = integer { description = "Chance to find or remove a small trap." reference = ["bfrpg", 13] default = 10  valuedice = percentCheck }
        'Hear Noise' = integer { description = "Chance in six to hear noises." reference = ["bfrpg", 13] default = 2  valuedice = xInSix }
        'Hide in Shadows' = integer { description = "Chance to hide unseen in shadows." reference = ["bfrpg", 13] default = 10  valuedice = percentCheck }
        'Move Silently' = integer { description = "Chance to move without a sound." reference = ["bfrpg", 13] default = 20  valuedice = percentCheck }
        'Open Locks' = integer { description = "Chance to pick a lock." reference = ["bfrpg", 13] default = 15  valuedice = percentCheck }
        'Pick Pockets' = integer { description = "Chance to pick a pocket unnoticed." reference = ["bfrpg", 13] default = 20  valuedice = percentCheck }
    }

    Weapons = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        source = concat (map ((weapon)->attackFor (characterTable, weapon), characterTable.Weapons), map ((weapon)->thrownAttack (characterTable, weapon), filter ((weapon)->hasRange (weapon) and not (isLauncher (weapon)), characterTable.Weapons)))
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }

    Armour = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Armour
        singular = "Armour"
        editable = character
    }

    'Spell Slots' = table
    {
        description = "Spell slots per spell level." reference = [["bfrpg", 11], ["bfrpg", 12]]
        tableLayout = layout { columns = 5  size = wide }
        visible = shownIf (Character.Class == "Cleric" or Character.Class == "Elf" or Character.Class == "Magic-User")
        'Level 1' = spellSlots (1)
        'Level 2' = spellSlots (2)
        'Level 3' = spellSlots (3)
        'Level 4' = spellSlots (4)
        'Level 5' = spellSlots (5)
        'Level 6' = spellSlots (6)
    }

    Spells = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Spells
        singular = "Spell"
        editable = character
    }

    Equipment = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Equipment
        singular = "Item"
        editable = character
    }

    Treasure = table
    {
        tableLayout = layout { columns = 5 }
        PP = integer { description = "Platinum pieces, worth 5 gold each." reference = ["bfrpg", 14] default = 0  editable = live }
        GP = integer { description = "Gold pieces." reference = ["bfrpg", 14] default = 0  editable = live }
        EP = integer { description = "Electrum pieces, worth half a gold each." reference = ["bfrpg", 14] default = 0  editable = live }
        SP = integer { description = "Silver pieces, ten to a gold." reference = ["bfrpg", 14] default = 0  editable = live }
        CP = integer { description = "Copper pieces, a hundred to a gold." reference = ["bfrpg", 14] default = 0  editable = live }
        'Encumbrance in coins' = integer { description = "Weight carried, measured in coins." reference = ["bfrpg", 46] default = 0 }
        'Gems and Jewellery' = string { multiline = true }
    }

    Retainers = list
    {
        description = "Hirelings who adventure with the character." reference = ["bfrpg", 50]
        tableLayout = layout { size = wide }
        singular = "Retainer"
        editable = character
        valueType = custom
        {
            Name = string {}
            Class = string {}
            Level = integer { default = 1 }
            Loyalty = integer { description = "Roll 2d6 under loyalty when the retainer is in danger or asked too much." reference = ["bfrpg", 50] default = 7 }
        }
    }
}

creatureTable = ruleset
{
    rulesetConfiguration =
    {
        important = [Stats, Attacks]
        defaultImage = "/systems/adnd2e/monster.svg"
        sortedBy = sort { prefix = "HD" sort = Stats.'Hit Dice' }
    }
    Stats = table
    {
        tableLayout = layout { columns = 3  size = wide }
        'Armour Class' = integer { description = "Descending armour class: lower is better." reference = ["bfrpg", 66] default = 7 }
        'Hit Dice' = string { description = "Hit dice, each d8 hit points." reference = ["bfrpg", 66] default = "1" }
        Attacks = string {}
        'Max HP' = integer { description = "Hit points when unhurt." default = 4 }
        HP = integer { description = "Current hit points." default = 'Max HP'  editable = live }
        THAC0 = integer { description = "To hit armour class 0, roll this or higher on d20." default = 19 }
        Movement = string { default = "120' (40')" }
        'Saves As' = string { description = "The class and level the monster saves as." reference = ["bfrpg", 66] default = "F1" }
        Morale = integer { description = "Roll 2d6. Above morale and the monster flees or surrenders." reference = ["bfrpg", 61] default = 7  valuedice = ([2d6], ((baseline, throws)->if sum (first (throws).rolls) > baseline then { Text = toString (sum (first (throws).rolls)) + ": flees or surrenders"  Outcome = "Failure" } else { Text = toString (sum (first (throws).rolls)) + ": fights on"  Outcome = "Success" })) }
        Alignment = string { keys = ["Lawful", "Neutral", "Chaotic"] }
        XP = integer { description = "Experience awarded for defeating the monster." reference = ["bfrpg", 53] default = 10 }
        'Number Appearing' = string {}
        'Treasure Type' = string {}
        Initiative = modifier { default = 0  valuedice = 1d6 }
        Down = string { value = if HP < 1 then "Dead" else ""  visible = none  indicator = "#d64545" }
    }
    Attacks = list
    {
        tableLayout = layout { size = wide }
        singular = "Attack"
        editable = character
        valueType = custom
        {
            Name = string {}
            Attack = modifier { default = 0  valuedice = oseAttack (Stats.THAC0)  action = melee  reach = 5 }
            Damage = string {}
        }
    }
    'Saving Throws' = table
    {
        description = "Saving throws: death, wands, paralysis, breath and spells." reference = ["bfrpg", 65]
        tableLayout = layout { columns = 5  size = wide }
        D = integer { default = 12  valuedice = oseSave }
        W = integer { default = 13  valuedice = oseSave }
        P = integer { default = 14  valuedice = oseSave }
        B = integer { default = 15  valuedice = oseSave }
        S = integer { default = 16  valuedice = oseSave }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        'Special Abilities' = string { multiline = true }
    }
}

weaponStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Damage = string {}
        'Attack Bonus' = string {}
        Qualities = string {}
        'Short Range' = string {}
        'Medium Range' = string {}
        'Long Range' = string {}
        Weight = string {}
        Cost = string {}
    }
}

armourStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        AC = string {}
        Weight = string {}
        Cost = string {}
    }
}

equipmentStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Weight = string {}
        Cost = string {}
    }
}

spellStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        sortedBy = sort { prefix = "Level" sort = Stats.Level }
        filters = [filter { name = "Class" prefix = "" filter = Stats.Class }, filter { name = "Level" prefix = "Level" filter = Stats.Level }]
    }
    Stats = table
    {
        Class = string { keys = ["Cleric", "Magic-User"] }
        Level = integer { default = 1 }
        Duration = string {}
        Range = string {}
        Reversible = bool { default = false }
    }
}

classStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Requirements = string {}
        'Prime Requisite' = string {}
        'Hit Dice' = string {}
        'Maximum Level' = string {}
        Armour = string {}
        Weapons = string {}
        Languages = string {}
    }
}

OldSchoolEssentials = system
{
    hints = [
        hint
        {
            title = "Rulings"
            topic = "Getting started"
            text = ["Rules are short; the referee makes rulings. Describe, ask what the players do, and roll only when it matters."]
        },
        hint
        {
            title = "Exploration"
            topic = "Play"
            text = ["Time passes in 10-minute turns. Track light, rest and wandering monsters."]
        },
        hint
        {
            title = "Initiative by side"
            topic = "Initiative"
            text = ["Each side rolls a d6 each round, and the higher side acts first. The optional rule lets each character roll the Initiative field instead."]
        },
        hint
        {
            title = "Saves and morale"
            topic = "Combat"
            text = ["Saving throws are d20 at or above the save value. Monsters check morale on 2d6 and flee when they fail."]
        }
    ]
    distanceUnit = "ft"
    squareSize = 10
    characters = characterTable
    creatures = creatureTable
    entityTypeNames = [entityTypeName ("Creature", "Monster", "Monsters")]
    Weapons = weaponStats
    Armour = armourStats
    Equipment = equipmentStats
    Spells = spellStats
    Classes = classStats
    secondaryTypes = ["Weapons", "Armour", "Equipment", "Spells"]
    otherLibararyTypes = ["Classes"]
    description = "Old-School Essentials: classic Basic/Expert fantasy adventure"
    initiativeCompare (item1, item2) = compare (toInt (item1), toInt (item2))
    quickdice = [1d20, 1d6, 1d8, 1d4, 1d10, 1d12, 1d100]
    cssFiles = ["/systems/ose/ose.css"]
    libraries = ["/systems/ose/bfrpg.json", "/systems/names/fantasy.json", "/systems/names/barbarian.json", "/systems/names/arthurian.json", "/systems/tables/fantasy.json"]
    nameSettings = [fantasyNameSetting, swordAndSorceryNameSetting, arthurianNameSetting]
}
