#include "/systems/common.frules"
bonus(points,difficulty)=
     (if points < 1 then -4
      else
      if points < 2 then   0
      else
      if points < 3 then   1
      else
       if points < 5 then  2
      else
       if points < 9 then 3
      else
      if points < 13 then   4
      else
      if points < 17 then   5
      else
        6
      ) -
      (switch difficulty
        case "Easy" then 0
        case "Average" then 1
        case "Hard" then 2
        else 3
      )
fromAttribute(attribute) =
    switch attribute
      case "ST" then characterTable.Attributes.ST/10+10
      case "DX" then characterTable.Attributes.DX/20+10
      case "IQ" then characterTable.Attributes.IQ/20+10
      case "Per" then characterTable.Attributes.IQ/20+10
      case "Will" then characterTable.Attributes.IQ/20+10
      else characterTable.Attributes.HT/10+10
    
    
    

divideWithPrecision(x,divisor,precision) =
  toString(x/divisor) + "." +toString(precision/divisor*(x-x/divisor*divisor))
  
skillvalue(points,attribute,difficulty) =fromAttribute(attribute)+bonus(points,difficulty)

skillLevel(name, level, points) = custom
{
    Name = name
    Level = integer {
        value = level
        valuedice = 3d6
    }
    Points = points
}

skillLevelFor(skill) =
    skillLevel(
        skill.Name,
        skillvalue(
            valueOr (skill.data.skillStats, "Points", 1),
            valueOr (skill.data.skillStats.Stats, "Attribute", "IQ"),
            valueOr (skill.data.skillStats.Stats, "Difficulty", "Average")),
        valueOr (skill.data.skillStats, "Points", 1))

characterTable = ruleset
{
    Attributes = table
        {
            ST = integer {
                valuedice=3d6
                render=toString(ST/10+10)
                step=10
            }
            DX=integer{
                valuedice=3d6
                render=toString(DX/20+10)
                step=20
            }
            IQ=integer{
                valuedice=3d6
                render=toString(IQ/20+10)
                step=20
            }
            HT=integer{
                valuedice=3d6
                render=toString(HT/10+10)
                step=10
            }
        }
    'Secondary characteristics' = table
    {
        HP = table
        {
            Current=integer
                    {
                        editable=live
                        maxvalue=Max
                        default=Max
                    }
            Max=integer
                    {
                        value=fromAttribute("ST")
                        editable=none
                    }
        }
            Will=integer
                    {
                        value=fromAttribute("IQ")
                        editable=none
                    }
            Perception=integer
                    {
                        value=fromAttribute("IQ")
                        editable=none
                    }
        'Fatigue Points' = table
        {
            Current=integer
                    {
                        editable=live
                        maxvalue=Max
                        default=Max
                    }
            Max=integer
                    {
                        value=fromAttribute("HT")
                        editable=none
                    }
        }
            'Basic speed'=divideWithPrecision(fromAttribute("HT")+fromAttribute("DX"),4,100)
            'Move'=(fromAttribute("HT")+fromAttribute("DX")) /4
    }
    Skills = keyvalues
        {
        tableLayout = layout
        {
          size = wide
        }
            singular = "Skill"
            editablekeys = character
            valueType = custom {
                Name=string{}
                Value=integer {
                 value=skillvalue(Details.Points, Details.'Based on',Details.'Difficulty')
                valuedice=3d6

                }
                Details=table{
                    visible=editor
                Points=integer{}
                'Based on'=string {
                    keys = ["ST","DX","IQ","HT","Per","Will"]
                    }
                'Difficulty'=string {
                    keys = ["Easy","Average","Hard","Very Hard"]
                }}
            }
        }
    'Learned skills' = list
    {
        tableLayout = layout
        {
          size = wide
        }
        source = secondary.Skills
        singular = "Skill"
        editable = character
        visible = editor
    }
    'Skill levels' = list
    {
        tableLayout = layout
        {
          size = wide
        }
        source = map ((skill)->skillLevelFor (skill), characterTable.'Learned skills')
        singular = "Skill"
        editable = none
        valueType = skillLevel
    }
    Advantages = list
    {
        tableLayout = layout
        {
          size = wide
        }
        singular = "Advantage"
        editable = character
        source=secondary.'Advantage'
    }
    Disadvantages = list
    {
        tableLayout = layout
        {
          size = wide
        }
        singular = "Disadvantage"
        editable = character
        source=secondary.'Disadvantage'
    }
    'Melee weapons' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Melee weapons'
        singular = "Melee weapon"
        editable = character
    }
    'Ranged weapons' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Ranged weapons'
        singular = "Ranged weapon"
        editable = character
    }
    'Armour' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.Armour
        singular = "Armour"
        editable = character
    }
    'Other items' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Other items'
        singular = "Item"
        editable = character
    }
}
meleeWeaponStats = ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
                filters = [
                    filter { name = "Skill" prefix = "" filter = Stats.Skill }
                ]
            }
            Stats = table
            {
                Damage = string {}
                Reach = string {}
                Parry = string {}
                ST = string {}
                Skill = string {}
                Cost = string {}
                Weight = string {}
                Notes = string { multiline = true }
            }
        }
rangedWeaponStats = ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
                filters = [
                    filter { name = "Skill" prefix = "" filter = Stats.Skill }
                ]
            }
            Stats = table
            {
                Damage = string {}
                Acc = string {}
                Range = string {}
                RoF = string {}
                Shots = string {}
                ST = string {}
                Bulk = string {}
                Rcl = string {}
                Skill = string {}
                Cost = string {}
                Weight = string {}
                Notes = string { multiline = true }
            }
        }
armourStats = ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
                filters = [
                    filter { name = "Location" prefix = "" filter = Stats.Location }
                ]
            }
            Stats = table
            {
                DR = string {}
                DB = integer {}
                Location = string {}
                Cost = string {}
                Weight = string {}
                Notes = string { multiline = true }
            }
        }
itemStats = ruleset
        {
            rulesetConfiguration =
            {
            }
            Stats = table
            {
                Cost = string {}
                Weight = string {}
            }
        }
traitTypes = ["Mental", "Physical", "Social", "Mundane", "Supernatural"]
advantageStats = ruleset
        {
            rulesetConfiguration =
            {
                sortedBy = sort { prefix = "Points" sort = Stats.Points }
                filters = [
                    filter { name = "Type" prefix = "" filter = Stats.Type }
                ]
            }
            Stats = table
            {
                Points = integer {}
                'Per level' = bool {}
                Type = string { keys = traitTypes }
            }
        }
disadvantageStats = ruleset
        {
            rulesetConfiguration =
            {
                sortedBy = sort { prefix = "Points" sort = Stats.Points }
                filters = [
                    filter { name = "Type" prefix = "" filter = Stats.Type }
                ]
            }
            Stats = table
            {
                Points = integer {}
                'Per level' = bool {}
                'Self control' = bool {}
                Type = string { keys = traitTypes }
            }
        }
skillStats = ruleset
        {
            rulesetConfiguration =
            {
                filters = [
                    filter { name = "Attribute" prefix = "" filter = Stats.Attribute },
                    filter { name = "Difficulty" prefix = "" filter = Stats.Difficulty }
                ]
            }
            Points = integer { default = 1 }
            Stats = table
            {
                Attribute = string { keys = ["ST","DX","IQ","HT","Per","Will"] }
                Difficulty = string { keys = ["Easy","Average","Hard","Very Hard"] }
                Defaults = string {}
            }
        }
GURPSLite = system
{
    characters = characterTable
    creatures = characterTable
    'Ranged weapons' = rangedWeaponStats
    'Melee weapons' = meleeWeaponStats
    Advantage = advantageStats
    Disadvantage = disadvantageStats
    Armour = armourStats
    'Other items' = itemStats
    Skills = skillStats
    description = "Gurps lite"
    secondaryTypes = ["Ranged weapons","Melee weapons","Armour","Other items","Advantage","Disadvantage","Skills"]
    libraries = ["/systems/Gurps/gurpslite.json"]
    quickdice = [3d6]
}
