#include "/systems/common.frules"
#include "/systems/names/settings.frules"

ladder (n) =
    if n > 8 then "Beyond Legendary +" + toString (n)
    else if n < -2 then "Terrible " + toString (n)
    else switch n
        case 8 then "Legendary +8"
        case 7 then "Epic +7"
        case 6 then "Fantastic +6"
        case 5 then "Superb +5"
        case 4 then "Great +4"
        case 3 then "Good +3"
        case 2 then "Fair +2"
        case 1 then "Average +1"
        case 0 then "Mediocre +0"
        case -1 then "Poor -1"
        else "Terrible -2"

shiftsOutcome (shifts) =
    if shifts > 2 then "Success with style"
    else if shifts > 0 then "Success"
    else if shifts == 0 then "Tie"
    else "Failure"

fateResult (skill, dice, opposition, opposed) =
{
    Text = ladder (skill + dice) + (if opposed then " vs " + ladder (opposition) + ": " + shiftsOutcome (skill + dice - opposition) + ", " + toString (skill + dice - opposition) + " shifts" else "")
    Value = skill + dice
    Outcome = if opposed then shiftsOutcome (skill + dice - opposition) else ""
}

fateRoll (opposition, opposed) = ([4df], ((baseline, throws)->fateResult (baseline + first (throws).bonus, sum (first (throws).rolls), opposition, opposed)))

fateAskedRoll = ([4df], ((baseline, throws)->fateResult (baseline + first (throws).bonus, sum (first (throws).rolls), asked, answered)))

fateLevels = ["Terrible -2", "Poor -1", "Mediocre +0", "Average +1", "Fair +2", "Good +3", "Great +4", "Superb +5", "Fantastic +6", "Epic +7", "Legendary +8"]

fateDice (char) = ask ("Opposition", fateLevels, -2, fateAskedRoll)

plainFate = fateRoll (0, false)

characterTable = ruleset
{
    rulesetConfiguration = { important = [Character.'Fate Points', Aspects, Stress, Consequences] }
    Character = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Refresh = integer { description = "Fate points you start each session with." reference = ["core", 43] default = 3 }
        'Fate Points' = integer { description = "Spend one to invoke an aspect for +2 or a reroll. Gain one when an aspect is compelled." reference = ["core", 6] default = 3  minvalue = 0  editable = live }
        Description = string { multiline = true }
    }

    Aspects = table
    {
        description = "Short phrases that are true about the character, invoked for bonuses or compelled for trouble." reference = ["core", 30]
        tableLayout = layout { columns = 1  size = wide }
        'High Concept' = string { description = "The core of who the character is, in one phrase." reference = ["core", 17] }
        Trouble = string { description = "What keeps complicating the character's life." reference = ["core", 18] }
        'Relationship' = string { description = "A tie to another player character." reference = ["core", 22] }
        'Other Aspect' = string {}
        'Another Aspect' = string {}
    }

    Skills = table
    {
        description = "Skills on the ladder. Roll 4dF and add the rating." reference = ["core", 51]
        tableLayout = layout { columns = 3  size = wide }
        Athletics = modifier { description = "Running, climbing, jumping and dodging." reference = ["core", 52] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Athletics) }
        Burglary = modifier { description = "Breaking in, picking locks and casing places." reference = ["core", 53] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Burglary) }
        Contacts = modifier { description = "Knowing people and finding the right person to ask." reference = ["core", 54] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Contacts) }
        Crafts = modifier { description = "Making, fixing and breaking machinery." reference = ["core", 54] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Crafts) }
        Deceive = modifier { description = "Lying, bluffing and disguise." reference = ["core", 56] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Deceive) }
        Drive = modifier { description = "Handling vehicles under pressure." reference = ["core", 57] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Drive) }
        Empathy = modifier { description = "Reading people and helping them recover from mental harm." reference = ["core", 58] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Empathy) }
        Fight = modifier { description = "Hand-to-hand fighting, armed or not." reference = ["core", 58] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  action = melee  reach = 2  render = ladder (Fight) }
        Investigate = modifier { description = "Searching for clues and piecing them together." reference = ["core", 59] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Investigate) }
        Lore = modifier { description = "Book learning, history and the occult." reference = ["core", 60] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Lore) }
        Notice = modifier { description = "Spotting things and reacting quickly." reference = ["core", 61] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Notice) }
        Physique = modifier { description = "Strength, toughness and endurance. High Physique adds stress boxes." reference = ["core", 62] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Physique) }
        Provoke = modifier { description = "Frightening, angering or intimidating people." reference = ["core", 62] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Provoke) }
        Rapport = modifier { description = "Making friends and earning trust." reference = ["core", 63] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Rapport) }
        Resources = modifier { description = "Money and possessions, used to buy help or influence." reference = ["core", 64] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Resources) }
        Shoot = modifier { description = "Shooting and throwing at range." reference = ["core", 65] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  action = ranged  render = ladder (Shoot) }
        Stealth = modifier { description = "Staying hidden and moving quietly." reference = ["core", 65] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Stealth) }
        Will = modifier { description = "Mental strength and resolve. High Will adds stress boxes." reference = ["core", 66] default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Will) }
        Initiative = modifier { description = "Turn order in physical conflicts, from Notice." reference = ["core", 83] value = Notice  valuedice = ([1d1], ((baseline, throws)->baseline))  editable = none  render = ladder (Initiative) }
    }

    'Other Skills' = keyvalues
    {
        description = "Skills for this setting beyond the standard list."
        singular = "Skill"
        editablekeys = campaign
        keys = []
        valueType = custom
        {
            Rating = modifier { default = 0  minvalue = -2  maxvalue = 8  valuedice = fateDice (characterTable)  render = ladder (Rating) }
        }
    }

    Stunts = list
    {
        description = "Special tricks that bend the rules for a skill." reference = ["core", 46]
        tableLayout = layout { size = wide }
        source = secondary.Stunts
        singular = "Stunt"
        editable = character
    }

    'Own Stunts' = list
    {
        tableLayout = layout { size = wide }
        singular = "Stunt"
        editable = character
        valueType = nameAndDescription
    }

    Stress = table
    {
        description = "Stress absorbs hits for a scene. Check a box worth at least the shifts taken." reference = ["core", 84]
        tableLayout = layout { columns = 2  size = wide }
        Physical = slots { description = "Physical stress boxes. Physique adds more." reference = ["core", 26] number = if Skills.Physique > 2 then 4 else if Skills.Physique > 0 then 3 else 2  editable = live  labels = ["1", "2", "3", "4"]  indicator = "#d64545" }
        Mental = slots { description = "Mental stress boxes. Will adds more." reference = ["core", 26] number = if Skills.Will > 2 then 4 else if Skills.Will > 0 then 3 else 2  editable = live  labels = ["1", "2", "3", "4"]  indicator = "#8e5cc4" }
    }

    Consequences = table
    {
        description = "Lasting harm that soaks shifts and becomes an aspect others can invoke." reference = ["core", 85]
        tableLayout = layout { columns = 1  size = wide }
        'Mild 2' = string { description = "Soaks 2 shifts. Clears after a scene of rest." reference = ["core", 87] editable = live  indicator = "#d64545"  indicatorLabel = "Mild consequence" }
        'Moderate 4' = string { description = "Soaks 4 shifts. Clears after a session." reference = ["core", 87] editable = live  indicator = "#d64545"  indicatorLabel = "Moderate consequence" }
        'Severe 6' = string { description = "Soaks 6 shifts. Clears after a scenario." reference = ["core", 87] editable = live  indicator = "#d64545"  indicatorLabel = "Severe consequence" }
        'Extra Mild 2' = string { description = "An extra mild consequence for Superb Physique or Will." editable = live  visible = if Skills.Physique > 4 or Skills.Will > 4 then visible else none }
        Taken = bool { description = "The character has been taken out of the conflict." reference = ["core", 89] default = false  editable = live  indicator = "#555555"  indicatorLabel = "Taken out" }
    }

    'Situation Aspects' = list
    {
        description = "Aspects on the scene, often created by advantages." reference = ["core", 81]
        tableLayout = layout { size = wide }
        singular = "Aspect"
        editable = live
        valueType = custom
        {
            Aspect = string {}
            'Free Invokes' = integer { description = "Free invokes left on the aspect." reference = ["core", 37] default = 1  minvalue = 0  editable = live }
        }
    }

    Extras = list
    {
        description = "Gear, powers and other special things with their own rules."
        tableLayout = layout { size = wide }
        source = secondary.Extras
        singular = "Extra"
        editable = character
    }
}

creatureTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg"  important = [Aspects, Stress] }
    Aspects = table
    {
        tableLayout = layout { size = wide }
        'High Concept' = string {}
        Trouble = string {}
        Other = string {}
    }
    Skills = keyvalues
    {
        description = "Ratings for the creature's skills on the ladder."
        singular = "Skill"
        editablekeys = character
        keys = ["Fight", "Notice", "Physique"]
        valueType = custom
        {
            Rating = modifier { default = 1  minvalue = -2  maxvalue = 8  valuedice = plainFate  action = melee  reach = 2  render = ladder (Rating) }
        }
    }
    Stress = table
    {
        tableLayout = layout { columns = 2  size = wide }
        Boxes = slots { description = "Stress boxes that soak hits for a scene." reference = ["core", 84] number = 2  editable = live  indicator = "#d64545" }
        Consequence = string { description = "A consequence the creature has taken." reference = ["core", 85] editable = live  indicator = "#d64545" }
        'Taken Out' = bool { default = false  editable = live  indicator = "#555555" }
        Initiative = modifier { default = 0  valuedice = ([1d1], ((baseline, throws)->baseline)) }
    }
    Stunts = table
    {
        tableLayout = layout { size = wide }
        Stunts = string { multiline = true }
    }
}

stuntStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Skill = string {}
        Cost = string { default = "1 refresh" }
    }
}

extraStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Aspects = string {}
        Skills = string {}
        Stunts = string {}
        Cost = string {}
    }
}

FateCore = system
{
    hints = [
        hint
        {
            title = "Aspects first"
            topic = "Getting started"
            text = ["Make the setting together, then write each character's High Concept and Trouble. Aspects drive the game."]
        },
        hint
        {
            title = "Rolling"
            topic = "Play"
            text = ["4dF + skill against the opposition, which each roll asks for. Read the result on the ladder: fail, tie, succeed or succeed with style. Leave it at Not set when only the GM knows it."]
        },
        hint
        {
            title = "Fate points"
            topic = "Play"
            text = ["Invoke an aspect for +2 or a reroll; accept a compel to earn a fate point."]
        },
        hint
        {
            title = "Notice order"
            topic = "Initiative"
            text = ["Turn order follows Notice. Roll the Initiative field to join the list."]
        }
    ]
    distanceUnit = "m"
    characters = characterTable
    creatures = creatureTable
    Stunts = stuntStats
    Extras = extraStats
    secondaryTypes = ["Stunts", "Extras"]
    description = "Fate Core: proactive, competent characters driven by their aspects"
    initiativeCompare (item1, item2) = compare (toInt (item1), toInt (item2))
    quickdice = [4df, 1d6]
    cssFiles = ["/systems/fate/fate.css"]
    libraries = ["/systems/fate/fatecore.json", "/systems/names/fantasy.json", "/systems/names/scifi.json", "/systems/names/cyberpunk.json", "/systems/names/heroes.json", "/systems/names/spies.json", "/systems/names/weirdwest.json", "/systems/names/victorian.json", "/systems/names/pirates.json", "/systems/names/samurai.json"]
    nameSettings = [fantasyNameSetting, spaceNameSetting, neonStreetsNameSetting, superheroesNameSetting, spyThrillerNameSetting, weirdWestNameSetting, gaslightNameSetting, highSeasNameSetting, feudalJapanNameSetting]
}
