#include "/systems/common.frules"
#include "/systems/names/settings.frules"

fudgevalues= ["Terrible","Poor","Mediocre","Fair","Good","Great","Superb" ]

ladderWord (level) =
    if level < 0 then "Terrible - " + toString (0 - level)
    else if level > 6 then "Superb + " + toString (level - 6)
    else item (level, fudgevalues)

fudgeOutcome (shifts) =
    if shifts > 0 then "Success by " + toString (shifts)
    else if shifts == 0 then "Success"
    else "Failure by " + toString (0 - shifts)

fudgeResult (level, difficulty, known) =
    if known then { Text = ladderWord (level) + " vs " + ladderWord (difficulty + 3) + ": " + fudgeOutcome (level - difficulty - 3)  Value = level  Outcome = if level >= difficulty + 3 then "Success" else "Failure" }
    else level

fudgeRoll = ask ("Difficulty", fudgevalues, -3, ([4df], ((baseline, throws)->fudgeResult (baseline + sum (first (throws).rolls), asked, answered))))

characterTable = ruleset
{
    rulesetConfiguration = { important = [Damage, 'Important stuff'.Fudgepoints, 'Melee weapons', 'Ranged weapons'] }
    Attributes = keyvalues
        {
            description = "Broad natural abilities such as strength and wits, rated on the Fudge ladder from Terrible to Superb." reference = ["srd", 13]
            singular = "Attribute"
            editablekeys = campaign
            keys = ["Str","Dex","Con","Int" ]
            valueType = enum
            {
                default = "Fair"
                possiblevalues = fudgevalues
                valuedice=fudgeRoll
            }
        }
    Skills = keyvalues
        {
            description = "Trained abilities, rated on the ladder. Roll 4dF and add the result to the level." reference = ["srd", 13]
            singular = "Skill"
            editablekeys = character
            keys = []
            valueType = enum
            {
                default = "Fair"
                possiblevalues = fudgevalues
                valuedice=fudgeRoll
            }
        }
    Gifts = list
    {
        description = "Special talents or advantages beyond the normal attributes and skills." reference = ["srd", 14]
        singular = "Gift"
        editable = character
        valueType = nameAndDescription
    }
    Faults = list
    {
        description = "Flaws, quirks and disadvantages that make the character interesting." reference = ["srd", 15]
        singular = "Fault"
        editable = character
        valueType = nameAndDescription
    }
    'Important stuff'= table
    {
        Fudgepoints = integer
        {
            description = "Points to spend on luck: change a roll, avoid a wound or bend the story." reference = ["srd", 16]
            default=0
            minvalue=0
        }
        Experiencepoints = integer
        {
            description = "Points earned in play and spent to improve attributes and skills." reference = ["srd", 71]
            default=0
            minvalue=0
        }
    }
    Damage = table
    {
        Scratch = slots
        {
            description = "Minor wounds. When the boxes are full, further damage moves to Hurt." reference = ["srd", 51]
            number = 3
            allowedchange = increase
            editable = live
            overflow=  allow
            overflowValue = max(0, Scratch.realvalue - Scratch.number)
            }
        Hurt = slots
        {
            description = "A real wound that gives -1 to actions until healed." reference = ["srd", 51]
            number = 1
            value = Hurt.realvalue + Scratch.overflowValue
            allowedchange = increase
            editable = live
            overflow=  allow
            overflowValue = max(0, Hurt.value - Hurt.number)
        }
        'Very hurt' = slots
            {number = 1
            description = "A serious wound that gives -2 to actions until healed." reference = ["srd", 51]
            value = 'Very hurt'.realvalue + Hurt.overflowValue
            allowedchange = increase
            editable = live
            overflow=  allow
            overflowValue = max(0, 'Very hurt'.value - 'Very hurt'.number)
            }
        Incapacitated = slots
            {number = 1
            description = "So badly wounded the character can do almost nothing but crawl." reference = ["srd", 51]
            value = Incapacitated.realvalue + 'Very hurt'.overflowValue
            allowedchange = increase
            editable = live
            overflow=  allow
            overflowValue = max(0, Incapacitated.value - Incapacitated.number)
            }
        'Near death' = slots
            {number = 1
            description = "Dying. The character needs help soon or will die." reference = ["srd", 51]
            value ='Near death'.realvalue + Incapacitated.overflowValue
            allowedchange = increase
            editable = live}
        'Wound level' = string
            {
            value = if 'Near death'.value > 0 then "Near death" else if Incapacitated.value > 0 then "Incapacitated" else if 'Very hurt'.value > 0 then "Very hurt" else if Hurt.value > 0 then "Hurt" else ""
            visible = none
            indicator = "#d64545"
            }
        Heal = button
            {editable = live
            description = "Moves every wound one step down the track, as after healing." reference = ["srd", 70]
            onClick = updates
                {(Scratch.realvalue) = Hurt.realvalue
                (Hurt.realvalue) = 'Very hurt'.realvalue
                ('Very hurt'.realvalue) = Incapacitated.realvalue
                (Incapacitated.realvalue) = 'Near death'.realvalue
                ('Near death'.realvalue) = 0}}
    }

       'Injury Levels' = table
        {
            Scratch ="1 - 3"
            Hurt="4 - 6"
            'Very hurt'="7 - 9"
            Incapacitated ="10 - 12"
            'Near death' ="13 +"
        }
    'Melee weapons' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Melee weapons'
        singular = "Melee weapon"
        editable = character
    }
    'Ranged weapons' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Ranged weapons'
        singular = "Ranged weapon"
        editable = character
    }
    'Armour' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.Armour
        singular = "Armour"
        editable = character
    }
    'Other items' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Other items'
        singular = "Item"
        editable = character
    }
}
weaponStats =ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
            }
            Stats= table
            {
                Damage=modifier
                {minvalue = -6
                maxvalue = +6}
            }
        }
armourStats= ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
            }
            Stats= table
            {
                'Damage Capacity'=modifier
                {minvalue = -6
                maxvalue = +6}
            }
        }
Fudge = system
{
    hints = [
        hint
        {
            title = "Agree on the ladder"
            topic = "Getting started"
            text = ["Traits are words on a ladder from Terrible to Superb. Fair is an ordinary trained adult, so most starting skills sit at Fair or Good.", "Agree with the players on how many Good and Great traits a starting character may have."]
        },
        hint
        {
            title = "Gifts and faults"
            topic = "Characters"
            text = ["Ask each player for two or three Gifts and Faults in plain words. A gift may give +1 or make something possible, and a fault should bring trouble now and then."]
        },
        hint
        {
            title = "Choose who rolls initiative"
            topic = "Initiative"
            text = ["Set Initiative in the campaign settings to the traits that roll initiative, such as Dex or Alertness. By default the first one a character has is used.", "Call initiative in a session and everyone rolls 4dF on that trait."]
        },
        hint
        {
            title = "Opposed fighting rolls"
            topic = "Combat"
            text = ["Both sides roll their fighting skill. The winner hits by the relative degree, plus offensive factors, minus defensive factors. The sheet marks the wound level."]
        },
        hint
        {
            title = "Movement without a grid"
            topic = "Maps"
            text = ["Fudge has no fixed distances. About 5 metres of walking or 15 metres of running a round works well on a battlemap."]
        },
        hint
        {
            title = "Spells extension"
            topic = "Settings"
            text = ["Turn on the Spells extension if the campaign has magic. It adds simple rule-less spells that characters can list and use."]
        },
        hint
        {
            title = "Fudge points"
            topic = "Play"
            text = ["Give each player a few Fudge points per session. They change a result, avoid a wound or bring in a lucky break."]
        }
    ]
    distanceUnit = "m"
    squareSize = 1
    libraries = ["/systems/Fudge/fudge.json", "/systems/names/norwegian.json", "/systems/names/viking.json", "/systems/names/chinese.json", "/systems/names/fantasy.json", "/systems/names/scifi.json", "/systems/names/cyberpunk.json", "/systems/names/gothic.json", "/systems/names/cosmic.json", "/systems/names/grimdark.json", "/systems/names/oldworld.json", "/systems/names/nightworld.json", "/systems/names/desert.json", "/systems/names/barbarian.json", "/systems/names/wasteland.json", "/systems/names/weirdwest.json", "/systems/names/pirates.json", "/systems/names/samurai.json", "/systems/names/victorian.json", "/systems/names/bluecollar.json", "/systems/names/mythicgreece.json", "/systems/names/arthurian.json", "/systems/names/egypt.json", "/systems/names/heroes.json", "/systems/names/spies.json", "/systems/names/faerie.json"]
    nameSettings = [fantasyNameSetting, norseNameSetting, modernNorwayNameSetting, easternNameSetting, spaceNameSetting, neonStreetsNameSetting, gothicHorrorNameSetting, cosmicHorrorNameSetting, grimdarkNameSetting, oldWorldNameSetting, nightWorldNameSetting, desertRealmsNameSetting, swordAndSorceryNameSetting, wastelandNameSetting, weirdWestNameSetting, highSeasNameSetting, feudalJapanNameSetting, gaslightNameSetting, blueCollarSpaceNameSetting, mythicGreeceNameSetting, arthurianNameSetting, ancientEgyptNameSetting, superheroesNameSetting, spyThrillerNameSetting, faerieCourtsNameSetting]
    characters = characterTable
    creatures = characterTable
    'Ranged weapons'= weaponStats
    'Melee weapons'= weaponStats
    Armour= armourStats
    cssFiles = ["/systems/Fudge/fudge.css"]
    description="Simple Fudge rules"
    secondaryTypes = ["Ranged weapons","Melee weapons","Armour","Other items"]
    initiativeRolls = ["Dex"]
    initiativeCompare(item1,item2) = compare (intValueFromEnumString (fudgevalues,item1), intValueFromEnumString (fudgevalues,item2))
    quickdice =[4df]
}

