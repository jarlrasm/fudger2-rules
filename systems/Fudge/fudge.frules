#include "/systems/common.frules"
#include "/systems/names/settings.frules"

fudgevalues= ["Terrible","Poor","Mediocre","Fair","Good","Great","Superb" ]

characterTable = ruleset
{
    Attributes = keyvalues
        {
            singular = "Attribute"
            editablekeys = campaign
            keys = ["Str","Dex","Con","Int" ]
            valueType = enum
            {
                default = "Fair"
                possiblevalues = fudgevalues
                valuedice=4df
            }
        }
    Skills = keyvalues
        {
            singular = "Skill"
            editablekeys = character
            keys = []
            valueType = enum
            {
                default = "Fair"
                possiblevalues = fudgevalues
                valuedice=4df
            }
        }
    Gifts = list
    {
        singular = "Gift"
        editable = character
        valueType = nameAndDescription
    }
    Faults = list
    {
        singular = "Fault"
        editable = character
        valueType = nameAndDescription
    }
    'Important stuff'= table
    {
        Fudgepoints = integer
        {
            default=0
            minvalue=0
        }
        Experiencepoints = integer
        {
            default=0
            minvalue=0
        }
    }
    Damage = table
    {
        Scratch = slots
        {
            number = 3
            allowedchange = increase
            editable = live
            overflow=  allow
            overflowValue = max(0, Scratch.realvalue - Scratch.number)
            }
        Hurt = slots
        {
            number = 1
            value = Hurt.realvalue + Scratch.overflowValue
            allowedchange = increase
            editable = live
            overflow=  allow
            overflowValue = max(0, Hurt.value - Hurt.number)
        }
        'Very hurt' = slots
            {number = 1
            value = 'Very hurt'.realvalue + Hurt.overflowValue
            allowedchange = increase
            editable = live
            overflow=  allow
            overflowValue = max(0, 'Very hurt'.value - 'Very hurt'.number)
            }
        Incapacitated = slots
            {number = 1
            value = Incapacitated.realvalue + 'Very hurt'.overflowValue
            allowedchange = increase
            editable = live
            overflow=  allow
            overflowValue = max(0, Incapacitated.value - Incapacitated.number)
            }
        'Near death' = slots
            {number = 1
            value ='Near death'.realvalue + Incapacitated.overflowValue
            allowedchange = increase
            editable = live}
        Heal = button
            {editable = live
            onClick = updates
                {(Scratch.realvalue) = Hurt.realvalue
                (Hurt.realvalue) = 'Very hurt'.realvalue
                ('Very hurt'.realvalue) = Incapacitated.realvalue
                (Incapacitated.realvalue) = 'Near death'.realvalue
                ('Near death'.realvalue) = 0}}
    }

       'Injury Levels' = table
        {
            Scratch ="1 - 3"
            Hurt="4 - 6"
            'Very hurt'="7 - 9"
            Incapacitated ="10 - 12"
            'Near death' ="13 +"
        }
    'Melee weapons' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Melee weapons'
        singular = "Melee weapon"
        editable = character
    }
    'Ranged weapons' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Ranged weapons'
        singular = "Ranged weapon"
        editable = character
    }
    'Armour' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.Armour
        singular = "Armour"
        editable = character
    }
    'Other items' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Other items'
        singular = "Item"
        editable = character
    }
}
weaponStats =ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
            }
            Stats= table
            {
                Damage=modifier
                {minvalue = -6
                maxvalue = +6}
            }
        }
armourStats= ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
            }
            Stats= table
            {
                'Damage Capacity'=modifier
                {minvalue = -6
                maxvalue = +6}
            }
        }
Fudge = system
{
    libraries = ["/systems/Fudge/fudge.json", "/systems/names/norwegian.json", "/systems/names/viking.json", "/systems/names/chinese.json", "/systems/names/fantasy.json", "/systems/names/scifi.json", "/systems/names/cyberpunk.json", "/systems/names/gothic.json", "/systems/names/cosmic.json", "/systems/names/grimdark.json", "/systems/names/oldworld.json", "/systems/names/nightworld.json", "/systems/names/desert.json", "/systems/names/barbarian.json", "/systems/names/wasteland.json", "/systems/names/weirdwest.json", "/systems/names/pirates.json", "/systems/names/samurai.json", "/systems/names/victorian.json", "/systems/names/bluecollar.json", "/systems/names/mythicgreece.json", "/systems/names/arthurian.json", "/systems/names/egypt.json", "/systems/names/heroes.json", "/systems/names/spies.json", "/systems/names/faerie.json"]
    nameSettings = [fantasyNameSetting, norseNameSetting, modernNorwayNameSetting, easternNameSetting, spaceNameSetting, neonStreetsNameSetting, gothicHorrorNameSetting, cosmicHorrorNameSetting, grimdarkNameSetting, oldWorldNameSetting, nightWorldNameSetting, desertRealmsNameSetting, swordAndSorceryNameSetting, wastelandNameSetting, weirdWestNameSetting, highSeasNameSetting, feudalJapanNameSetting, gaslightNameSetting, blueCollarSpaceNameSetting, mythicGreeceNameSetting, arthurianNameSetting, ancientEgyptNameSetting, superheroesNameSetting, spyThrillerNameSetting, faerieCourtsNameSetting]
    characters = characterTable
    creatures = characterTable
    'Ranged weapons'= weaponStats
    'Melee weapons'= weaponStats
    Armour= armourStats
    cssFiles = ["/systems/Fudge/fudge.css"]
    description="Simple Fudge rules"
    secondaryTypes = ["Ranged weapons","Melee weapons","Armour","Other items"]
    initiativeRolls = ["Dex"]
    initiativeCompare(item1,item2) = compare (intValueFromEnumString (fudgevalues,item1), intValueFromEnumString (fudgevalues,item2))
    quickdice =[4df]
}

