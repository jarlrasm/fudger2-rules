#include "/systems/common.frules"
#include "/systems/names/settings.frules"

degreesOf (total, dc) = if total >= dc then 1 + (total - dc) / 5 else 0 - (1 + (dc - total - 1) / 5)

degreeText (n) =
    if n > 0 then "success, " + toString (n) + (if n == 1 then " degree" else " degrees")
    else "failure, " + toString (0 - n) + (if n == -1 then " degree" else " degrees")

critDegrees (natural, total, dc) = if natural == 20 then degreesOf (total, dc) + 1 else degreesOf (total, dc)

mmResult (natural, total, dc) =
{
    Text = toString (total) + (if dc > 0 then " vs DC " + toString (dc) + ": " + degreeText (critDegrees (natural, total, dc)) else "") + (if natural == 20 then ", natural 20" else "")
    Value = total
    Outcome = if dc < 1 then (if natural == 20 then "Critical" else "") else if critDegrees (natural, total, dc) > 0 then "Success" else "Failure"
}

mmCheck (dc) = ([1d20], ((baseline, throws)->mmResult (first (first (throws).rolls), baseline + first (first (throws).rolls), if dc > 0 then dc else asked)))

mmDice = ask ("DC", mmCheck (0))

attackResult (natural, total, defence) =
{
    Text = toString (total) + (if defence > 0 then " vs " + toString (10 + defence) + (if natural == 20 then ": critical hit" else if natural == 1 then ": miss" else if total >= 10 + defence then ": hit" else ": miss") else (if natural == 20 then ", natural 20" else ""))
    Value = total
    Outcome = if natural == 20 then "Critical hit" else if natural == 1 then "Miss" else if defence < 1 then "" else if total >= 10 + defence then "Hit" else "Miss"
}

attackAsked = ([1d20], ((baseline, throws)->attackResult (first (first (throws).rolls), baseline + first (first (throws).rolls), asked)))

attackDice = ask ("Dodge or Parry", attackAsked)

damageCondition (degrees) =
    if degrees > 0 then "no effect"
    else if degrees == -1 then "bruised, -1 Toughness"
    else if degrees == -2 then "bruised and dazed"
    else if degrees == -3 then "bruised and staggered"
    else "incapacitated"

toughnessResult (natural, total, rank) =
{
    Text = toString (total) + " vs DC " + toString (15 + rank) + ": " + damageCondition (if natural == 20 then 1 else degreesOf (total, 15 + rank))
    Value = total
    Outcome = if natural == 20 or total >= 15 + rank then "Success" else "Failure"
}

toughnessCheck (rank) = ([1d20], ((baseline, throws)->toughnessResult (first (first (throws).rolls), baseline + first (first (throws).rolls), rank)))

toughnessDice = ask ("Damage rank", ([1d20], ((baseline, throws)->toughnessResult (first (first (throws).rolls), baseline + first (first (throws).rolls), asked))))

ability = custom
{
    Rank = integer { description = "Ability rank, from -5 to 20. Each rank costs 2 power points." default = 0  minvalue = -5  maxvalue = 20 }
    Check = modifier { description = "Roll d20 plus the rank for an ability check." value = Rank  valuedice = mmDice  editable = none }
}

skill (abilityRank) = custom
{
    Ranks = integer { description = "Skill ranks bought, added to the linked ability." default = 0  minvalue = 0  maxvalue = 20 }
    Bonus = modifier { description = "Skill bonus: ability rank plus skill ranks, added to d20." value = abilityRank + Ranks  valuedice = mmDice  editable = none }
}

defence (abilityRank) = custom
{
    Ranks = integer { description = "Ranks bought in this defense, added to the linked ability." default = 0  minvalue = 0  maxvalue = 20 }
    Total = modifier { description = "Defense total: ability rank plus ranks. Attacks aim at 10 plus this." value = abilityRank + Ranks  valuedice = mmDice  editable = none }
}

characterTable = ruleset
{
    rulesetConfiguration = { important = [Abilities, Defenses, Condition, Powers] }
    Hero = table
    {
        tableLayout = layout { columns = 4  size = wide }
        'Hero Name' = string {}
        Identity = string {}
        'Power Level' = integer { description = "Power level: the cap on attack, defense and effect ranks." default = 10  minvalue = 1  maxvalue = 20 }
        'Power Points' = integer { description = "Points to build the hero: 15 per power level." value = 'Power Level' * 15  editable = none }
        'Points Spent' = integer { description = "Points used so far on abilities, skills, powers and the rest." value = pointsSpent (characterTable)  editable = none }
        Group = string {}
        Base = string {}
        Complications = string { description = "Troubles in the hero's life that earn hero points when they come up." multiline = true }
    }

    Abilities = table
    {
        description = "The eight abilities, each bought with power points."
        tableLayout = layout { columns = 4  size = wide }
        Strength = ability { description = "Raw might: lifting, close damage and jumping." }
        Stamina = ability { description = "Health and endurance. Adds to Toughness and Fortitude." }
        Agility = ability { description = "Balance, speed and Dodge." }
        Dexterity = ability { description = "Hand-eye coordination and ranged attacks." }
        Fighting = ability { description = "Close combat skill and Parry." }
        Intellect = ability { description = "Reasoning and learning." }
        Awareness = ability { description = "Intuition and willpower. Adds to Will." }
        Presence = ability { description = "Force of personality and social influence." }
    }

    Defenses = table
    {
        description = "Defenses resist attacks and effects."
        tableLayout = layout { columns = 5  size = wide }
        Dodge = defence (Abilities.Agility.Rank)
        Parry = defence (Abilities.Fighting.Rank)
        Fortitude = defence (Abilities.Stamina.Rank)
        Toughness = modifier { description = "Resisting damage: Stamina plus protection, minus each bruise." value = Abilities.Stamina.Rank + Protection - Condition.Bruised  valuedice = toughnessDice  editable = none }
        Will = defence (Abilities.Awareness.Rank)
        Protection = integer { description = "Ranks of the Protection effect, added to Toughness." default = 0  minvalue = 0 }
        Initiative = modifier { description = "Initiative: Agility, plus 4 per rank of Improved Initiative." value = Abilities.Agility.Rank + 4 * 'Improved Initiative'  valuedice = mmCheck (0)  editable = none }
        'Improved Initiative' = integer { description = "Ranks of the Improved Initiative advantage." default = 0  minvalue = 0 }
    }

    Condition = table
    {
        description = "Hero points and damage conditions."
        tableLayout = layout { columns = 4  size = wide }
        'Hero Points' = integer { description = "Spend to reroll, recover, or pull off a heroic feat." default = 1  minvalue = 0  editable = live  indicator = "#d4b106"  indicatorLabel = "Hero Points" }
        Bruised = integer { description = "Each failed Toughness check adds a bruise: -1 to later Toughness checks." default = 0  minvalue = 0  editable = live  indicator = "#d64545" }
        Dazed = bool { description = "Dazed: you can only take a standard action or a move, not both." default = false  editable = live  indicator = "#d4b106" }
        Staggered = bool { description = "Staggered: dazed and hindered at once." default = false  editable = live  indicator = "#e8913a" }
        Incapacitated = bool { description = "Incapacitated: defenseless and unaware of what goes on." default = false  editable = live  indicator = "#555555" }
        Impaired = bool { description = "Impaired: -2 on checks." default = false  editable = live  indicator = "#d4b106" }
        Hindered = bool { description = "Hindered: half speed." default = false  editable = live  indicator = "#3a7bd5" }
        Vulnerable = bool { description = "Vulnerable: your active defenses are halved." default = false  editable = live  indicator = "#e8913a" }
        Other = string { editable = live  indicator = "#8e5cc4" }
        'Rest a minute' = button
        {
            description = "Each minute of rest removes the worst damage condition: incapacitated, then staggered, then dazed, then one bruise."
            editable = live
            onClick = updates
            {
                (root.Condition.Incapacitated) = false
                (root.Condition.Staggered) = Staggered and Incapacitated
                (root.Condition.Dazed) = Dazed and (Incapacitated or Staggered)
                (root.Condition.Bruised) = if Incapacitated or Staggered or Dazed then Bruised else max (0, Bruised - 1)
            }
        }
        'New session' = button { description = "Each game session starts with 1 hero point."  editable = live  onClick = updates { (root.Condition.'Hero Points') = 1 } }
    }

    Skills = table
    {
        description = "Skills, each linked to an ability."
        tableLayout = layout { columns = 4  size = wide }
        Acrobatics = skill (Abilities.Agility.Rank)
        Athletics = skill (Abilities.Strength.Rank)
        'Close Combat' = skill (Abilities.Fighting.Rank)
        Deception = skill (Abilities.Presence.Rank)
        Expertise = skill (Abilities.Intellect.Rank)
        Insight = skill (Abilities.Awareness.Rank)
        Intimidation = skill (Abilities.Presence.Rank)
        Investigation = skill (Abilities.Intellect.Rank)
        Perception = skill (Abilities.Awareness.Rank)
        Persuasion = skill (Abilities.Presence.Rank)
        'Ranged Combat' = skill (Abilities.Dexterity.Rank)
        'Sleight of Hand' = skill (Abilities.Dexterity.Rank)
        Stealth = skill (Abilities.Agility.Rank)
        Technology = skill (Abilities.Intellect.Rank)
        Treatment = skill (Abilities.Intellect.Rank)
        Vehicles = skill (Abilities.Dexterity.Rank)
    }

    Offense = list
    {
        description = "Attacks the hero can make, with their effect rank."
        tableLayout = layout { size = wide }
        singular = "Attack"
        editable = character
        valueType = custom
        {
            Name = string {}
            Ranged = bool { default = false }
            Attack = modifier { default = 0  valuedice = attackDice  action = if Ranged then "ranged" else "melee"  reach = 5  range = if Ranged then Rank * 100 else 0 }
            Effect = string { default = "Damage" }
            Rank = integer { default = 0 }
        }
    }

    Powers = list
    {
        description = "Powers built from effects, with ranks and point cost."
        tableLayout = layout { size = wide }
        singular = "Power"
        editable = character
        valueType = custom
        {
            Name = string {}
            Effect = string {}
            Rank = integer { default = 1  minvalue = 0 }
            Cost = integer { default = 1  minvalue = 0 }
            Notes = string {}
        }
    }

    Advantages = list
    {
        description = "Special feats and talents bought with points."
        tableLayout = layout { size = wide }
        source = secondary.Advantages
        singular = "Advantage"
        editable = character
    }

    'Advantage Ranks' = table
    {
        tableLayout = layout { columns = 2 }
        'Advantage Points' = integer { description = "Power points spent on advantages." default = 0  minvalue = 0 }
        'Equipment Points' = integer { description = "Power points spent on equipment." default = 0  minvalue = 0 }
    }
}

skillRanks (s) = s.Acrobatics.Ranks + s.Athletics.Ranks + s.'Close Combat'.Ranks + s.Deception.Ranks + s.Expertise.Ranks + s.Insight.Ranks + s.Intimidation.Ranks + s.Investigation.Ranks
    + s.Perception.Ranks + s.Persuasion.Ranks + s.'Ranged Combat'.Ranks + s.'Sleight of Hand'.Ranks + s.Stealth.Ranks + s.Technology.Ranks + s.Treatment.Ranks + s.Vehicles.Ranks

abilityRanks (a) = a.Strength.Rank + a.Stamina.Rank + a.Agility.Rank + a.Dexterity.Rank + a.Fighting.Rank + a.Intellect.Rank + a.Awareness.Rank + a.Presence.Rank

pointsSpent (char) =
    2 * abilityRanks (char.Abilities)
    + char.Defenses.Dodge.Ranks + char.Defenses.Parry.Ranks + char.Defenses.Fortitude.Ranks + char.Defenses.Will.Ranks
    + (skillRanks (char.Skills) + 1) / 2
    + char.'Advantage Ranks'.'Advantage Points'
    + char.'Advantage Ranks'.'Equipment Points'
    + sum (map ((p)->p.Cost, char.Powers))

creatureTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg"  important = [Stats, Attacks] }
    Stats = table
    {
        tableLayout = layout { columns = 4  size = wide }
        'Power Level' = integer { description = "Power level of the threat." default = 8 }
        Minion = bool { description = "Minions are out with any failed Toughness check." default = false }
        Dodge = integer { description = "Defense against ranged and area attacks." default = 6 }
        Parry = integer { description = "Defense against close attacks." default = 6 }
        Toughness = modifier { description = "Damage resistance." default = 6  valuedice = toughnessDice }
        Fortitude = modifier { description = "Resistance to poison, disease and fatigue." default = 6  valuedice = mmDice }
        Will = modifier { description = "Resistance to mental attacks." default = 6  valuedice = mmDice }
        Initiative = modifier { default = 2  valuedice = mmCheck (0) }
        Bruised = integer { description = "Bruises: -1 to later Toughness checks each." default = 0  minvalue = 0  editable = live  indicator = "#d64545" }
        Dazed = bool { default = false  editable = live  indicator = "#d4b106" }
        Staggered = bool { default = false  editable = live  indicator = "#e8913a" }
        Incapacitated = bool { default = false  editable = live  indicator = "#555555" }
    }
    Attacks = list
    {
        tableLayout = layout { size = wide }
        singular = "Attack"
        editable = character
        valueType = custom
        {
            Name = string {}
            Attack = modifier { default = 8  valuedice = attackDice  action = melee  reach = 5 }
            Effect = string { default = "Damage" }
            Rank = integer { default = 8 }
        }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        Abilities = string {}
        Powers = string { multiline = true }
        Skills = string {}
        Advantages = string {}
        Description = string { multiline = true }
    }
}

effectStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        filters = [filter { name = "Type" prefix = "" filter = Stats.Type }]
    }
    Stats = table
    {
        Type = string { keys = ["Attack", "Control", "Defense", "General", "Movement", "Sensory"] }
        Action = string {}
        Range = string {}
        Duration = string {}
        Cost = string {}
    }
}

advantageStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        filters = [filter { name = "Type" prefix = "" filter = Stats.Type }]
    }
    Stats = table
    {
        Type = string { keys = ["Combat", "Fortune", "General", "Skill"] }
        Ranked = string {}
    }
}

MutantsAndMasterminds = system
{
    hints = [
        hint
        {
            title = "Checks"
            topic = "Play"
            text = ["Roll d20 + bonus against a DC. Every 5 over the DC is another degree of success, every 5 under another degree of failure."]
        },
        hint
        {
            title = "Damage"
            topic = "Combat"
            text = ["An attack hits on d20 + attack against 10 + Dodge or Parry. The target rolls Toughness against 15 + damage rank: one degree of failure bruises, two dazes, three staggers, four incapacitates."]
        },
        hint
        {
            title = "Initiative"
            topic = "Initiative"
            text = ["Roll d20 + Initiative at the start of a conflict and act from highest to lowest."]
        },
        hint
        {
            title = "Power points"
            topic = "Getting started"
            text = ["Heroes get 15 power points per power level. Abilities cost 2 a rank, defences 1, skills 1 per 2 ranks, advantages 1, and powers by effect."]
        }
    ]
    distanceUnit = "ft"
    squareSize = 5
    characters = characterTable
    creatures = creatureTable
    Effects = effectStats
    Advantages = advantageStats
    secondaryTypes = ["Advantages"]
    otherLibararyTypes = ["Effects"]
    description = "Mutants and Masterminds 3rd edition: superheroes built point by point on d20 and degrees"
    initiativeCompare (item1, item2) = compare (toInt (item1), toInt (item2))
    quickdice = [1d20]
    cssFiles = ["/systems/mutants/mutants.css"]
    libraries = ["/systems/mutants/mutants.json", "/systems/names/heroes.json", "/systems/names/spies.json", "/systems/tables/modern.json"]
    nameSettings = [superheroesNameSetting, spyThrillerNameSetting]
}
