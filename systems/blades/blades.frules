#include "/systems/common.frules"
#include "/systems/names/settings.frules"

bladesBest (pool, rolls) = if pool < 1 then min (rolls) else max (rolls)

bladesSixes (pool, rolls) = if pool < 1 then 0 else count (filter ((x)->x == 6, rolls))

bladesOutcome (pool, rolls) =
    if bladesSixes (pool, rolls) > 1 then "Critical"
    else if bladesBest (pool, rolls) == 6 then "Full success"
    else if bladesBest (pool, rolls) > 3 then "Partial success"
    else "Bad outcome"

actionMeaning (outcome, position) =
    switch outcome
        case "Critical" then "critical, you do it with increased effect"
        case "Full success" then "you do it"
        case "Partial success" then (if position == "Controlled" then "you hesitate, or do it with a minor complication" else if position == "Desperate" then "you do it, but suffer severe harm or a serious complication" else "you do it, but there is a consequence")
        else (if position == "Controlled" then "you falter; press on from a risky position or withdraw" else if position == "Desperate" then "it's the worst outcome" else "things go badly")

bladesResult (pool, rolls, position, effect) =
{
    Text = toString (bladesBest (pool, rolls)) + ": " + actionMeaning (bladesOutcome (pool, rolls), position) + " (" + position + ", " + effect + " effect)"
    Value = bladesBest (pool, rolls)
    Outcome = bladesOutcome (pool, rolls)
}

bladesRoll (pool, position, effect) = ([dice { number = if pool < 1 then 2 else pool  sides = 6  color = if position == "Desperate" then "red" else if position == "Controlled" then "green" else "" }],
    ((baseline, throws)->bladesResult (pool, first (throws).rolls, position, effect)))

harmPenalty (char) = if char.Harm.'Level 2 A' != "" or char.Harm.'Level 2 B' != "" then 1 else 0

bladesDice (char, rating) = bladesRoll (rating + char.Scoundrel.'Bonus Dice' - harmPenalty (char), char.Scoundrel.Position, char.Scoundrel.Effect)

resistanceResult (pool, rolls) =
{
    Text = if bladesSixes (pool, rolls) > 1 then "Critical: clear 1 stress" else "Take " + toString (6 - bladesBest (pool, rolls)) + " stress"
    Value = bladesBest (pool, rolls)
    Outcome = if bladesSixes (pool, rolls) > 1 then "Critical" else ""
}

resistanceRoll (pool) = ([dice { number = if pool < 1 then 2 else pool  sides = 6  label = "Resist" }],
    ((baseline, throws)->resistanceResult (pool, first (throws).rolls)))

fortuneResult (pool, rolls) =
{
    Text = toString (bladesBest (pool, rolls)) + ": " + (if bladesSixes (pool, rolls) > 1 then "exceptional result" else if bladesBest (pool, rolls) == 6 then "good result" else if bladesBest (pool, rolls) > 3 then "mixed result" else "bad result")
    Value = bladesBest (pool, rolls)
    Outcome = bladesOutcome (pool, rolls)
}

fortuneRoll (pool) = ([dice { number = if pool < 1 then 2 else pool  sides = 6 }], ((baseline, throws)->fortuneResult (pool, first (throws).rolls)))

dotted (n) = if n > 0 then 1 else 0

characterTable = ruleset
{
    rulesetConfiguration = { important = [Stress, Harm, Prowess] }
    Scoundrel = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Alias = string {}
        Playbook = string { keys = ["Cutter", "Hound", "Leech", "Lurk", "Slide", "Spider", "Whisper", "Ghost", "Hull", "Vampire"] }
        Crew = string {}
        Look = string { multiline = true }
        Heritage = string { keys = ["Akoros", "The Dagger Isles", "Iruvia", "Severos", "Skovlan", "Tycheros"] }
        Background = string { keys = ["Academic", "Labor", "Law", "Trade", "Military", "Noble", "Underworld"] }
        Vice = string { description = "What the scoundrel indulges in to clear stress between scores." keys = ["Faith", "Gambling", "Luxury", "Obligation", "Pleasure", "Stupor", "Weird"] }
        'Vice Purveyor' = string { description = "The person or place where the vice is indulged." }
        Position = selector
        {
            description = "How dangerous the action is: controlled, risky or desperate."
            options = ["Controlled", "Risky", "Desperate"]
            labels = ["Controlled", "Risky", "Desperate"]
            colors = ["green", "white", "red"]
            default = "Risky"
            editable = live
            save = nosave
        }
        Effect = selector
        {
            description = "How much the action can achieve if it works: limited, standard or great."
            options = ["Limited", "Standard", "Great"]
            labels = ["Limited", "Standard", "Great"]
            colors = ["red", "white", "green"]
            default = "Standard"
            editable = live
            save = nosave
        }
        'Bonus Dice' = integer { description = "Extra dice from help, a push or a devil's bargain, or dice lost to penalties." default = 0  minvalue = -3  maxvalue = 3  editable = live }
    }

    Stress = table
    {
        tableLayout = layout { columns = 2  size = wide }
        Stress = slots { description = "Spent to push yourself, help others and resist consequences. Full stress means trauma." number = 9  editable = live  indicator = "#8e5cc4" }
        Trauma = slots { description = "Each trauma is a lasting mark from too much stress. Four and the scoundrel retires." number = 4  editable = live  allowedchange = increase  indicator = "#d64545" }
        Traumas = string { keys = ["", "Cold", "Haunted", "Obsessed", "Paranoid", "Reckless", "Soft", "Unstable", "Vicious"] }
        'Other Traumas' = string {}
    }

    Harm = table
    {
        tableLayout = layout { columns = 2  size = wide }
        'Level 3' = string { description = "Severe harm. You can't act unless someone helps you." editable = live  indicator = "#d64545"  indicatorLabel = "Harm 3: need help" }
        'Level 2 A' = string { description = "Moderate harm. Action rolls take -1d, which the sheet takes off for you." editable = live  indicator = "#e8913a"  indicatorLabel = "Harm 2: -1d"  default = "" }
        'Level 2 B' = string { default = ""  editable = live }
        'Level 1 A' = string { description = "Lesser harm. Your actions have reduced effect." editable = live  indicator = "#d4b106"  indicatorLabel = "Harm 1: less effect" }
        'Level 1 B' = string { editable = live }
        Healing = clock { description = "Healing progress. Fill it during downtime to reduce harm by one level." segments = 4  editable = live }
        Armor = bool { description = "Armor that can be used once to reduce or avoid harm." default = false  editable = live }
        'Heavy Armor' = bool { default = false  editable = live }
        'Special Armor' = bool { default = false  editable = live }
        Healed = button
        {
            description = "When the healing clock fills, every harm moves one level down and level 1 harm goes away. The clock starts again."
            editable = live
            onClick = updates
            {
                (root.Harm.'Level 3') = ""
                (root.Harm.'Level 2 A') = 'Level 3'
                (root.Harm.'Level 2 B') = ""
                (root.Harm.'Level 1 A') = 'Level 2 A'
                (root.Harm.'Level 1 B') = 'Level 2 B'
                (root.Harm.Healing.realvalue) = 0
            }
        }
        'Next score' = button { description = "Armor used on the last score is ready again."  editable = live  onClick = updates
            {
                (root.Harm.Armor) = false
                (root.Harm.'Heavy Armor') = false
                (root.Harm.'Special Armor') = false
            }
        }
    }

    Insight = table
    {
        description = "Insight actions: noticing, learning and working things out."
        tableLayout = layout { columns = 1 }
        Resistance = integer { description = "Dice for resisting with Insight: one per action with a rating." value = dotted (Hunt) + dotted (Study) + dotted (Survey) + dotted (Tinker)  valuedice = resistanceRoll (dotted (Hunt) + dotted (Study) + dotted (Survey) + dotted (Tinker))  editable = none }
        XP = slots { description = "Attribute XP. Mark when you roll a desperate action with this attribute." number = 6  editable = live  allowedchange = increaseAndClear }
        Hunt = integer { description = "Track, find and shoot at range." default = 0  minvalue = 0  maxvalue = 4  valuedice = bladesDice (characterTable, Hunt) }
        Study = integer { description = "Read, research and examine closely." default = 0  minvalue = 0  maxvalue = 4  valuedice = bladesDice (characterTable, Study) }
        Survey = integer { description = "Look over a place or situation to spot what is coming." default = 0  minvalue = 0  maxvalue = 4  valuedice = bladesDice (characterTable, Survey) }
        Tinker = integer { description = "Build, repair and tamper with devices and locks." default = 0  minvalue = 0  maxvalue = 4  valuedice = bladesDice (characterTable, Tinker) }
    }

    Prowess = table
    {
        description = "Prowess actions: physical skill and force."
        tableLayout = layout { columns = 1 }
        Resistance = integer { description = "Dice for resisting with Prowess: one per action with a rating." value = dotted (Finesse) + dotted (Prowl) + dotted (Skirmish) + dotted (Wreck)  valuedice = resistanceRoll (dotted (Finesse) + dotted (Prowl) + dotted (Skirmish) + dotted (Wreck))  editable = none }
        XP = slots { description = "Attribute XP. Mark when you roll a desperate action with this attribute." number = 6  editable = live  allowedchange = increaseAndClear }
        Finesse = integer { description = "Act with fine control: sleight of hand, agile moves, careful driving." default = 0  minvalue = 0  maxvalue = 4  valuedice = bladesDice (characterTable, Finesse) }
        Prowl = integer { description = "Sneak, hide and move unseen." default = 0  minvalue = 0  maxvalue = 4  valuedice = bladesDice (characterTable, Prowl) }
        Skirmish = integer { description = "Fight at close range." default = 0  minvalue = 0  maxvalue = 4  valuedice = bladesDice (characterTable, Skirmish)  action = melee  reach = 2 }
        Wreck = integer { description = "Smash, break and destroy with brute force or sabotage." default = 0  minvalue = 0  maxvalue = 4  valuedice = bladesDice (characterTable, Wreck) }
    }

    Resolve = table
    {
        description = "Resolve actions: will, presence and social force."
        tableLayout = layout { columns = 1 }
        Resistance = integer { description = "Dice for resisting with Resolve: one per action with a rating." value = dotted (Attune) + dotted (Command) + dotted (Consort) + dotted (Sway)  valuedice = resistanceRoll (dotted (Attune) + dotted (Command) + dotted (Consort) + dotted (Sway))  editable = none }
        XP = slots { description = "Attribute XP. Mark when you roll a desperate action with this attribute." number = 6  editable = live  allowedchange = increaseAndClear }
        Attune = integer { description = "Sense and channel the ghost field and arcane powers." default = 0  minvalue = 0  maxvalue = 4  valuedice = bladesDice (characterTable, Attune) }
        Command = integer { description = "Compel people with authority, threats or orders." default = 0  minvalue = 0  maxvalue = 4  valuedice = bladesDice (characterTable, Command) }
        Consort = integer { description = "Use your connections and socialize with people as an equal." default = 0  minvalue = 0  maxvalue = 4  valuedice = bladesDice (characterTable, Consort) }
        Sway = integer { description = "Influence by charm, lies or argument." default = 0  minvalue = 0  maxvalue = 4  valuedice = bladesDice (characterTable, Sway) }
    }

    'Playbook XP' = table
    {
        tableLayout = layout { columns = 2  size = wide }
        XP = slots { description = "Playbook XP, marked for the playbook's triggers. Full means a new ability." number = 8  editable = live  allowedchange = increaseAndClear }
        'XP Triggers' = string { multiline = true }
    }

    'Special Abilities' = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Abilities
        singular = "Ability"
        editable = character
    }

    Friends = list
    {
        tableLayout = layout { size = wide }
        singular = "Friend or Rival"
        editable = character
        valueType = custom
        {
            Name = string {}
            Friend = bool { default = true }
        }
    }

    Load = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Load = string { description = "How much gear you plan to carry on a score. Heavier is slower and louder." default = "Normal"  keys = ["Light", "Normal", "Heavy"]  editable = live }
        Coin = integer { description = "Coin carried on you." default = 0  minvalue = 0  maxvalue = 4  editable = live }
        Stash = integer { description = "Coin saved away. Enough of it lets you retire." default = 0  minvalue = 0  maxvalue = 40  editable = live }
        Fortune = integer { description = "Dice for a fortune roll when chance decides the outcome." default = 1  minvalue = 0  valuedice = fortuneRoll (Fortune) }
    }

    Items = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Items
        singular = "Item"
        editable = character
    }

    Clocks = list
    {
        tableLayout = layout { size = wide }
        singular = "Clock"
        editable = live
        valueType = custom
        {
            Name = string {}
            Size = integer { default = 4  minvalue = 1  maxvalue = 12 }
            Progress = clock { segments = Size  editable = live }
        }
    }

    Notes = table
    {
        tableLayout = layout { size = wide }
        Notes = string { multiline = true }
    }
}

crewTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Crew = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Type = string { keys = ["Assassins", "Bravos", "Cult", "Hawkers", "Shadows", "Smugglers"] }
        Reputation = string {}
        Lair = string {}
        Tier = integer { description = "Crew strength in the underworld, used for its rolls and quality." default = 0  minvalue = 0  maxvalue = 5 }
        Hold = string { description = "How firmly the crew holds its tier." default = "Strong"  keys = ["Weak", "Strong"] }
        Rep = slots { description = "Reputation gained from scores. Fill it to advance." number = 12  editable = live  allowedchange = increaseAndClear }
        Heat = slots { description = "How much attention the crew draws from the law. Full means more wanted level." number = 9  editable = live  allowedchange = increaseAndClear }
        'Wanted Level' = slots { description = "Wanted level. Higher brings more trouble and harsher entanglements." number = 4  editable = live }
        Coin = integer { description = "Coin in the crew's shared purse." default = 2  minvalue = 0  editable = live }
        Vault = integer { description = "How much coin the crew can store." default = 4 }
        'Crew XP' = slots { description = "Crew XP, marked at the end of each session." number = 8  editable = live  allowedchange = increaseAndClear }
        'Engagement Roll' = integer { description = "Dice for the engagement roll that starts each score." default = 1  minvalue = 0  valuedice = fortuneRoll ('Engagement Roll') }
    }
    'Crew Abilities' = list
    {
        tableLayout = layout { size = wide }
        singular = "Ability"
        editable = character
        valueType = nameAndDescription
    }
    Upgrades = list
    {
        tableLayout = layout { size = wide }
        singular = "Upgrade"
        editable = character
        valueType = string
    }
    Claims = list
    {
        tableLayout = layout { size = wide }
        singular = "Claim"
        editable = character
        valueType = nameAndDescription
    }
    Cohorts = list
    {
        tableLayout = layout { size = wide }
        singular = "Cohort"
        editable = character
        valueType = custom
        {
            Name = string {}
            Kind = string { keys = ["Gang", "Expert"] }
            Quality = integer { description = "Quality of the cohort, its dice for actions." default = 1  valuedice = fortuneRoll (Quality) }
            Harm = string { editable = live }
        }
    }
    Clocks = list
    {
        tableLayout = layout { size = wide }
        singular = "Clock"
        editable = live
        valueType = custom
        {
            Name = string {}
            Size = integer { default = 6  minvalue = 1  maxvalue = 12 }
            Progress = clock { segments = Size  editable = live }
        }
    }
}

creatureTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg"  important = [Threat] }
    Threat = table
    {
        tableLayout = layout { columns = 3  size = wide }
        Tier = integer { description = "How powerful the threat is compared to the crew." default = 1 }
        Kind = string { keys = ["Person", "Gang", "Faction", "Spirit", "Horror"] }
        Quality = integer { description = "Dice the threat rolls for its actions." default = 1  valuedice = fortuneRoll (Quality) }
        Harm = string { editable = live  indicator = "#d64545" }
        Defeat = clock { description = "Fill this to defeat or drive off the threat." segments = 4  editable = live }
        Notes = string { multiline = true }
    }
}

abilityStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        filters = [filter { name = "Playbook" prefix = "" filter = Stats.Playbook }]
    }
    Stats = table
    {
        Playbook = string {}
    }
}

itemStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Load = integer { default = 1  minvalue = 0  maxvalue = 3 }
        Playbook = string {}
    }
}

factionStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Tier = integer { default = 1 }
        Hold = string { keys = ["Weak", "Strong"] }
        Status = integer { default = 0  minvalue = -3  maxvalue = 3 }
        Turf = string {}
        Assets = string { multiline = true }
    }
}

BladesInTheDark = system
{
    hints = [
        hint
        {
            title = "The crew"
            topic = "Getting started"
            text = ["Make the crew first: its type, lair and hunting grounds. Then the scoundrels."]
        },
        hint
        {
            title = "Action rolls"
            topic = "Play"
            text = ["Set position and effect, roll a d6 per dot and read the highest: 6 full success, 4-5 partial, 1-3 bad."]
        },
        hint
        {
            title = "Clocks"
            topic = "Play"
            text = ["Track threats and projects as clocks in the Clocks lists."]
        },
        hint
        {
            title = "No initiative"
            topic = "Initiative"
            text = ["There is no initiative; the spotlight moves with the fiction. Flashbacks replace planning."]
        }
    ]
    distanceUnit = "m"
    characters = characterTable
    creatures = creatureTable
    entityTypeNames = [entityTypeName ("Character", "Scoundrel", "Scoundrels")]
    Crews = crewTable
    Abilities = abilityStats
    Items = itemStats
    Factions = factionStats
    secondaryTypes = ["Abilities", "Items"]
    otherLibararyTypes = ["Factions"]
    extraEntityTypes = [entityTypeDescription ("Crews", "crew", false, "/systems/blades/crew-entity.svg", [])]
    description = "Blades in the Dark: daring scoundrels, heists and clocks in a haunted industrial city"
    quickdice = [1d6, 2d6, 3d6, 4d6]
    cssFiles = ["/systems/blades/blades.css"]
    libraries = ["/systems/blades/blades.json", "/systems/names/victorian.json", "/systems/names/gothic.json", "/systems/names/oldworld.json"]
    nameSettings = [gaslightNameSetting, gothicHorrorNameSetting, oldWorldNameSetting]
}
