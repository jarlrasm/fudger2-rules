#include "/systems/common.frules"
#include "/systems/names/settings.frules"

d100Value (units, tens) =
    if mod (tens, 10) == 0 and mod (units, 10) == 0 then 100
    else mod (tens, 10) * 10 + mod (units, 10)

isDouble (roll) = roll < 100 and mod (roll, 10) == roll / 10

passes (target, roll) = roll < 6 or (roll < 96 and roll <= target)

successLevel (target, roll) =
    if passes (target, roll) then max (0, target / 10 - roll / 10)
    else min (0, target / 10 - roll / 10)

slText (sl) = if sl < 0 then toString (sl) else "+" + toString (sl)

wfrpLevel (target, roll) =
    if passes (target, roll) and isDouble (roll) then "Critical"
    else if passes (target, roll) then "Success"
    else if isDouble (roll) or roll == 100 then "Fumble"
    else "Failure"

wfrpResult (target, roll) =
{
    Text = toString (roll) + " vs " + toString (target) + ": " + wfrpLevel (target, roll) + ", SL " + slText (successLevel (target, roll))
    Value = successLevel (target, roll)
    Outcome = wfrpLevel (target, roll)
}

wfrpRoll (modifier) = ([dice { number = 1  sides = 10  label = "Units" }, dice { number = 1  sides = 10  label = "Tens" }],
    ((baseline, throws)->wfrpResult (max (0, baseline + modifier), d100Value (first (first (throws).rolls), first (item (1, throws).rolls)))))

autoText (roll) = if roll < 6 then ", automatic success" else if roll > 95 then ", automatic failure" else ""

wfrpUnset (base, roll) =
{
    Text = toString (roll) + " vs " + toString (base) + " before difficulty, SL " + slText (base / 10 - roll / 10) + autoText (roll)
    Value = base / 10 - roll / 10
    Outcome = if roll < 6 then "Success" else if roll > 95 then (if isDouble (roll) or roll == 100 then "Fumble" else "Failure") else ""
}

wfrpAskedRoll = ([dice { number = 1  sides = 10  label = "Units" }, dice { number = 1  sides = 10  label = "Tens" }],
    ((baseline, throws)->if answered then wfrpResult (max (0, baseline + asked), d100Value (first (first (throws).rolls), first (item (1, throws).rolls))) else wfrpUnset (baseline, d100Value (first (first (throws).rolls), first (item (1, throws).rolls)))))

wfrpDice (char) = ask ("Difficulty modifier", wfrpAskedRoll)

plainD100 = wfrpRoll (0)

characteristicValue (char, name) =
    switch name
        case "WS" then char.Characteristics.WS.Current
        case "BS" then char.Characteristics.BS.Current
        case "S" then char.Characteristics.S.Current
        case "T" then char.Characteristics.T.Current
        case "I" then char.Characteristics.I.Current
        case "Ag" then char.Characteristics.Ag.Current
        case "Dex" then char.Characteristics.Dex.Current
        case "WP" then char.Characteristics.WP.Current
        case "Fel" then char.Characteristics.Fel.Current
        case "Int" then char.Characteristics.Int.Current
        else 0

characteristic = custom
{
    Initial = integer { description = "Starting value from species and dice, usually 20 to 50." default = 30 }
    Advances = integer { description = "Advances bought with experience, each +1." default = 0 }
    Current = integer { description = "Current value: initial plus advances. Roll d100 at or under it." value = Initial + Advances  valuedice = wfrpDice (characterTable)  editable = none }
    Bonus = integer { description = "The tens digit of the characteristic, used for damage, wounds and more." value = Current / 10  editable = none }
}

skill (base) = custom
{
    Characteristic = base
    Advances = integer { description = "Advances in the skill, added to the characteristic." default = 0 }
    Skill = integer { description = "Skill value. Roll d100 at or under it; each 10 under is a success level." value = base + Advances  valuedice = wfrpDice (characterTable)  editable = none }
}

advancedValue (entry, fallback) =
    if entry == 0 then fallback
    else if valueOr (entry, "Characteristic", "") == "" then fallback + valueOr (entry, "Advances", 0)
    else valueOr (entry, "Skill", fallback)

skillValue (char, name, fallback) =
    if valueOr (char.'Basic Skills', name, 0) == 0 then advancedValue (valueOr (char.'Advanced Skills', name, 0), fallback)
    else valueOr (valueOr (char.'Basic Skills', name, 0), "Skill", fallback)

weaponAttack (name, target, damage, kind, distance) = custom
{
    Name = name
    Test = integer { value = target  valuedice = wfrpDice (characterTable)  action = kind  reach = 2  range = distance }
    Damage = damage
}

weaponStat (weapon, field) = valueOr (weapon.data.weaponStats.Stats, field, "")

strengthBonus (char) = char.Characteristics.S.Bonus

meleeDamage (char, weapon) =
    if contains (weaponStat (weapon, "Damage"), "SB") then
        "+" + toString (strengthBonus (char) + toInt (replace ("SB", "", replace ("+", "", weaponStat (weapon, "Damage")))))
    else weaponStat (weapon, "Damage")

firstNumber (text) = bonusWithValue ([[text]], "^[^0-9]*([0-9]+)")

rangedGroups = ["Blackpowder", "Bow", "Crossbow", "Engineering", "Entangling", "Explosives", "Sling", "Throwing"]

isRanged (weapon) = count (filter ((group)->group == weaponStat (weapon, "Group"), rangedGroups)) > 0 or firstNumber (weaponStat (weapon, "Range")) > 0

rangeYards (char, text) = if contains (text, "SB") then strengthBonus (char) * max (1, firstNumber (text)) else firstNumber (text)

attackFor (char, weapon) =
    if isRanged (weapon) then
        weaponAttack (weapon.Name, skillValue (char, "Ranged " + weaponStat (weapon, "Group"), char.Characteristics.BS.Current), meleeDamage (char, weapon), "ranged", rangeYards (char, weaponStat (weapon, "Range")))
    else
        weaponAttack (weapon.Name, skillValue (char, "Melee " + weaponStat (weapon, "Group"), char.Characteristics.WS.Current), meleeDamage (char, weapon), "melee", 2)

characterTable = ruleset
{
    rulesetConfiguration = { important = [Characteristics, Wounds, Conditions, 'Fate and Fortune', Attacks] }
    Character = table
    {
        tableLayout = layout { columns = 3  size = wide }
        Species = string { keys = ["Human", "Dwarf", "Halfling", "High Elf", "Wood Elf"] }
        Class = string {}
        Career = string {}
        'Career Level' = string {}
        'Career Path' = string { description = "The careers the character has followed." }
        Status = string { description = "Social standing, which sets income and how people treat you." }
        Age = string {}
        Height = string {}
        Hair = string {}
        Eyes = string {}
    }

    Characteristics = table
    {
        description = "The ten characteristics, each rolled with d100."
        tableLayout = layout { columns = 5  size = wide }
        WS = characteristic { description = "Weapon Skill: fighting in melee." }
        BS = characteristic { description = "Ballistic Skill: shooting and throwing." }
        S = characteristic { description = "Strength: muscle and melee damage." }
        T = characteristic { description = "Toughness: resisting harm. Its bonus reduces damage." }
        I = characteristic { description = "Initiative: reactions, perception and acting first." }
        Ag = characteristic { description = "Agility: speed, dodging and moving." }
        Dex = characteristic { description = "Dexterity: fine work and crafts." }
        Int = characteristic { description = "Intelligence: reasoning and learning." }
        WP = characteristic { description = "Willpower: courage, focus and resisting fear." }
        Fel = characteristic { description = "Fellowship: charm and dealing with people." }
    }

    'Fate and Fortune' = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Fate = integer { description = "Fate points: spend one to avoid death for good." default = 2 }
        Fortune = integer { description = "Fortune points: spend for a reroll or extra success level. Refills each session." default = 2  editable = live }
        Resilience = integer { description = "Resilience points: spend one to avoid a mutation or shrug off a critical." default = 1 }
        Resolve = integer { description = "Resolve points: spend to ignore conditions or fear for a while." default = 1  editable = live }
        Motivation = string { description = "What drives the character. Acting on it restores resolve." }
        Advantage = integer { description = "Advantage gained in combat. Each point gives +10 to combat tests." default = 0  minvalue = 0  editable = live  indicator = "#3a7bd5" }
        Initiative = integer { description = "Highest Initiative acts first." value = Characteristics.I.Current  valuedice = ([1d1], ((baseline, throws)->baseline))  editable = none }
        Movement = integer { description = "Movement: yards moved per step." default = 4 }
        Walk = integer { description = "Walking speed: twice Movement." value = Movement * 2  editable = none }
        Run = integer { description = "Running speed: four times Movement." value = Movement * 4  editable = none }
    }

    Experience = table
    {
        tableLayout = layout { columns = 3 }
        Current = integer { description = "Experience left to spend." default = 0  editable = live }
        Spent = integer { description = "Experience already spent." default = 0 }
        Total = Current + Spent
    }

    Wounds = table
    {
        description = "Wounds: how much damage you can take before critical wounds."
        tableLayout = layout { columns = 3 }
        'Hardy Talent' = integer { description = "Ranks in the Hardy talent, each adding your Toughness Bonus to wounds." default = 0 }
        Maximum = integer { description = "Wounds: Strength Bonus, twice Toughness Bonus and Willpower Bonus." value = Characteristics.S.Bonus + 2 * Characteristics.T.Bonus + Characteristics.WP.Bonus + 'Hardy Talent' * Characteristics.T.Bonus  editable = none }
        Current = integer { description = "Current wounds. At 0 every hit gives a critical wound." default = Maximum  editable = live }
        Down = string { value = if Current < 1 then "Wounds 0" else ""  visible = none  indicator = "#d64545" }
        'Critical Wounds' = string { description = "Critical wounds taken, with their effects." multiline = true  editable = live }
    }

    Conditions = table
    {
        description = "Conditions, most stacking in levels. Each level usually gives -10 to tests."
        tableLayout = layout { columns = 4  size = wide }
        Bleeding = integer { description = "Bleeding: lose wounds each round, and risk dying at 0." default = 0  minvalue = 0  editable = live  indicator = "#d64545" }
        Blinded = integer { description = "Blinded: -10 per level to tests that need sight." default = 0  minvalue = 0  editable = live  indicator = "#555555" }
        Broken = integer { description = "Broken: you flee or cower, -10 per level to most tests." default = 0  minvalue = 0  editable = live  indicator = "#8e5cc4" }
        Deafened = integer { description = "Deafened: -10 per level to tests that need hearing." default = 0  minvalue = 0  editable = live  indicator = "#555555" }
        Entangled = integer { description = "Entangled: you can't move, -10 per level to physical tests." default = 0  minvalue = 0  editable = live  indicator = "#e8913a" }
        Fatigued = integer { description = "Fatigued: -10 per level to all tests." default = 0  minvalue = 0  editable = live  indicator = "#d4b106" }
        Poisoned = integer { description = "Poisoned: lose wounds each round, -10 per level to tests." default = 0  minvalue = 0  editable = live  indicator = "#3fa34d" }
        Stunned = integer { description = "Stunned: no actions, -10 per level to tests." default = 0  minvalue = 0  editable = live  indicator = "#d4b106" }
        Ablaze = integer { description = "Ablaze: take damage each round until put out." default = 0  minvalue = 0  editable = live  indicator = "#d64545" }
        Prone = bool { description = "Prone: on the ground; easy to hit in melee." default = false  editable = live  indicator = "#e8913a" }
        Surprised = bool { description = "Surprised: no action this round and easy to hit." default = false  editable = live  indicator = "#d4b106" }
        Unconscious = bool { description = "Unconscious: helpless and out of action." default = false  editable = live  indicator = "#555555" }
    }

    'Basic Skills' = table
    {
        description = "Basic skills anyone can use, based on a characteristic."
        tableLayout = layout { columns = 2  size = wide }
        Art = skill (Characteristics.Dex.Current)
        Athletics = skill (Characteristics.Ag.Current)
        Bribery = skill (Characteristics.Fel.Current)
        Charm = skill (Characteristics.Fel.Current)
        'Charm Animal' = skill (Characteristics.WP.Current)
        Climb = skill (Characteristics.S.Current)
        Cool = skill (Characteristics.WP.Current)
        'Consume Alcohol' = skill (Characteristics.T.Current)
        Dodge = skill (Characteristics.Ag.Current)
        Drive = skill (Characteristics.Ag.Current)
        Endurance = skill (Characteristics.T.Current)
        Entertain = skill (Characteristics.Fel.Current)
        Gamble = skill (Characteristics.Int.Current)
        Gossip = skill (Characteristics.Fel.Current)
        Haggle = skill (Characteristics.Fel.Current)
        Intimidate = skill (Characteristics.S.Current)
        Intuition = skill (Characteristics.I.Current)
        Leadership = skill (Characteristics.Fel.Current)
        'Melee Basic' = skill (Characteristics.WS.Current)
        Navigation = skill (Characteristics.I.Current)
        'Outdoor Survival' = skill (Characteristics.Int.Current)
        Perception = skill (Characteristics.I.Current)
        Ride = skill (Characteristics.Ag.Current)
        Row = skill (Characteristics.S.Current)
        Stealth = skill (Characteristics.Ag.Current)
    }

    'Advanced Skills' = keyvalues
    {
        description = "Advanced skills that need training, such as Language or Lore."
        singular = "Skill"
        editablekeys = character
        keys = []
        tableLayout = layout { size = wide }
        valueType = custom
        {
            Characteristic = string { description = "The characteristic this skill is based on." default = "Int"  keys = ["WS", "BS", "S", "T", "I", "Ag", "Dex", "Int", "WP", "Fel"] }
            Advances = integer { description = "Advances in the skill." default = 0 }
            Skill = integer { description = "Skill value: characteristic plus advances." value = characteristicValue (characterTable, Characteristic) + Advances  valuedice = wfrpDice (characterTable)  editable = none }
        }
    }

    Talents = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Talents
        singular = "Talent"
        editable = character
    }

    Weapons = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        source = concat ([weaponAttack ("Unarmed", skillValue (characterTable, "Melee Brawling", Characteristics.WS.Current), "+" + toString (Characteristics.S.Bonus), "melee", 2)], map ((weapon)->attackFor (characterTable, weapon), characterTable.Weapons))
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }

    Armour = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Armour
        singular = "Armour"
        editable = character
    }

    Trappings = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Trappings
        singular = "Trapping"
        editable = character
    }

    Spells = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Spells
        singular = "Spell"
        editable = character
    }

    Wealth = table
    {
        tableLayout = layout { columns = 4 }
        'Gold Crowns' = integer { description = "Gold crowns: twenty shillings each." default = 0  editable = live }
        Shillings = integer { description = "Silver shillings: twelve brass pennies each." default = 0  editable = live }
        Brass = integer { description = "Brass pennies." default = 0  editable = live }
        'Corruption Points' = integer { description = "Corruption from Chaos. Too much brings mutation." default = 0  editable = live  indicator = "#8e5cc4" }
        Mutations = string { description = "Mutations from Chaos corruption." multiline = true }
    }
}

creatureTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg"  important = [Characteristics, State, Attacks] }
    Characteristics = table
    {
        tableLayout = layout { columns = 5  size = wide }
        M = integer { description = "Movement: yards moved per step." default = 4 }
        WS = integer { default = 30  valuedice = plainD100 }
        BS = integer { default = 30  valuedice = plainD100 }
        S = integer { default = 30  valuedice = plainD100 }
        T = integer { default = 30  valuedice = plainD100 }
        I = integer { default = 30  valuedice = plainD100 }
        Ag = integer { default = 30  valuedice = plainD100 }
        Dex = integer { default = 30  valuedice = plainD100 }
        Int = integer { default = 30  valuedice = plainD100 }
        WP = integer { default = 30  valuedice = plainD100 }
        Fel = integer { default = 30  valuedice = plainD100 }
        W = integer { description = "Wounds the creature can take." default = 10 }
    }
    State = table
    {
        tableLayout = layout { columns = 3  size = wide }
        'Current Wounds' = integer { description = "Wounds left." default = 10  editable = live }
        Advantage = integer { description = "Advantage gained in combat." default = 0  minvalue = 0  editable = live  indicator = "#3a7bd5" }
        Initiative = integer { value = Characteristics.I  valuedice = ([1d1], ((baseline, throws)->baseline))  editable = none }
        Prone = bool { default = false  editable = live  indicator = "#e8913a" }
        Stunned = integer { default = 0  minvalue = 0  editable = live  indicator = "#d4b106" }
        Bleeding = integer { default = 0  minvalue = 0  editable = live  indicator = "#d64545" }
    }
    Attacks = list
    {
        tableLayout = layout { size = wide }
        singular = "Attack"
        editable = character
        valueType = custom
        {
            Name = string {}
            Test = integer { default = 30  valuedice = plainD100  action = melee  reach = 2 }
            Damage = string {}
        }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        Traits = string { multiline = true }
        Skills = string { multiline = true }
        Description = string { multiline = true }
    }
}

weaponStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Group = string { keys = ["Basic", "Brawling", "Cavalry", "Fencing", "Flail", "Parry", "Polearm", "Two-Handed", "Blackpowder", "Bow", "Crossbow", "Engineering", "Entangling", "Explosives", "Sling", "Throwing"] }
        'Reach or Range' = string {}
        Range = string {}
        Damage = string {}
        Qualities = string {}
        Encumbrance = string {}
        Price = string {}
        Availability = string {}
    }
}

armourStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Locations = string {}
        'Armour Points' = string {}
        Qualities = string {}
        Penalty = string {}
        Encumbrance = string {}
        Price = string {}
    }
}

trappingStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Encumbrance = string {}
        Price = string {}
        Availability = string {}
    }
}

talentStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Max = string {}
        Tests = string {}
        Taken = integer { default = 1 }
    }
}

spellStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Lore = string {}
        CN = string {}
        Range = string {}
        Target = string {}
        Duration = string {}
    }
}

careerStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Class = string {}
        Levels = string { multiline = true }
        Skills = string { multiline = true }
        Talents = string { multiline = true }
        Trappings = string { multiline = true }
    }
}

WarhammerFantasy = system
{
    hints = [
        hint
        {
            title = "Careers"
            topic = "Getting started"
            text = ["Characters start in humble careers. Let them be ordinary people swept up in events."]
        },
        hint
        {
            title = "Success Levels"
            topic = "Play"
            text = ["Roll d100 at or under the skill. Success Levels (tens of the target minus tens of the roll) decide how well it went.", "Each test asks for the difficulty modifier, such as 20 for Average or -10 for Difficult. Leave it blank when only the GM knows it."]
        },
        hint
        {
            title = "Advantage"
            topic = "Combat"
            text = ["Winning opposed tests in combat gives Advantage, +10 per point. Losing or being wounded clears it."]
        },
        hint
        {
            title = "Initiative order"
            topic = "Initiative"
            text = ["Act in order of the I characteristic. Roll the Initiative field to join the list."]
        }
    ]
    distanceUnit = "yd"
    characters = characterTable
    creatures = creatureTable
    Weapons = weaponStats
    Armour = armourStats
    Trappings = trappingStats
    Talents = talentStats
    Spells = spellStats
    Careers = careerStats
    secondaryTypes = ["Weapons", "Armour", "Trappings", "Talents", "Spells"]
    otherLibararyTypes = ["Careers"]
    description = "Warhammer Fantasy Roleplay 4th edition: grim and perilous adventure in the Old World"
    initiativeCompare (item1, item2) = compare (toInt (item1), toInt (item2))
    quickdice = [1d100, 1d10]
    cssFiles = ["/systems/wfrp/wfrp.css"]
    libraries = ["/systems/names/oldworld.json", "/systems/names/gothic.json", "/systems/names/fantasy.json"]
    nameSettings = [oldWorldNameSetting, gothicHorrorNameSetting, fantasyNameSetting]
}
