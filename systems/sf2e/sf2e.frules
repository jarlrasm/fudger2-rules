#include "/systems/common.frules"
#include "/systems/names/settings.frules"
#include "/systems/pf2e/core.frules"
#include "/systems/pf2e/encounters.frules"

shipRange (text) = bonusWithValue ([[text]], "^[^0-9]*([0-9]+)")

characterTable = ruleset
{
    rulesetConfiguration = { important = [Defenses, Saves, Conditions, Strikes]  encounterStats = { Level = Character.Level } }
    Character = pf2Character {}

    Attributes = pf2Attributes {}

    Defenses = pf2Defenses {}

    Saves = table
    {
        description = "Saving throws, Perception and initiative, each with a proficiency rank."
        tableLayout = layout { columns = 4  size = wide }
        Fortitude = proficiency (Attributes.CON, "CON")
        Reflex = proficiency (Attributes.DEX, "DEX")
        Will = proficiency (Attributes.WIS, "WIS")
        Perception = proficiency (Attributes.WIS, "WIS")
        Initiative = modifier { description = "Initiative usually rolls Perception." value = Perception.Modifier  valuedice = 1d20  editable = none }
    }

    Skills = table
    {
        description = "Skills, each tied to an attribute and a proficiency rank."
        tableLayout = layout { columns = 2  size = wide }
        Acrobatics = proficiency (Attributes.DEX, "DEX")
        Arcana = proficiency (Attributes.INT, "INT")
        Athletics = proficiency (Attributes.STR, "STR")
        Computers = proficiency (Attributes.INT, "INT")
        Crafting = proficiency (Attributes.INT, "INT")
        Deception = proficiency (Attributes.CHA, "CHA")
        Diplomacy = proficiency (Attributes.CHA, "CHA")
        Intimidation = proficiency (Attributes.CHA, "CHA")
        Medicine = proficiency (Attributes.WIS, "WIS")
        Nature = proficiency (Attributes.WIS, "WIS")
        Occultism = proficiency (Attributes.INT, "INT")
        Performance = proficiency (Attributes.CHA, "CHA")
        Piloting = proficiency (Attributes.DEX, "DEX")
        Religion = proficiency (Attributes.WIS, "WIS")
        Society = proficiency (Attributes.INT, "INT")
        Stealth = proficiency (Attributes.DEX, "DEX")
        Survival = proficiency (Attributes.WIS, "WIS")
        Thievery = proficiency (Attributes.DEX, "DEX")
    }

    Lore = keyvalues
    {
        description = "Lore skills for narrow subjects, based on INT."
        singular = "Lore"
        editablekeys = character
        keys = []
        tableLayout = layout { size = wide }
        valueType = custom
        {
            Rank = string { description = "Proficiency rank in this lore." default = "Trained"  keys = ["Untrained", "Trained", "Expert", "Master", "Legendary"] }
            Item = integer { default = 0 }
            Modifier = modifier { description = "Total: INT plus proficiency plus item bonus." value = Attributes.INT + proficiencyBonus (Rank, Character.Level) + Item - penaltyFor (characterTable, "INT")  valuedice = pf2Dice (characterTable)  editable = none }
        }
    }

    Proficiencies = pf2Proficiencies {}

    Conditions = pf2Conditions {}

    Weapons = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
    }

    Strikes = list
    {
        tableLayout = layout { size = wide }
        source = concat (concat ([strike ("Unarmed", Attributes.STR + proficiencyBonus (Proficiencies.Unarmed, Character.Level) + mapPenalty (characterTable, true) - penaltyFor (characterTable, "STR"), "1d4" + strengthDamage (characterTable) + " B", "melee", 5, 0)], map ((weapon)->strikeFor (characterTable, weapon), characterTable.Weapons)), map ((weapon)->thrownStrikeFor (characterTable, weapon), filter ((weapon)->isThrownMelee (weapon), characterTable.Weapons)))
        singular = "Strike"
        editable = none
        valueType = strike
    }

    Ammunition = list
    {
        description = "Rounds left in each weapon's magazine."
        tableLayout = layout { size = wide }
        singular = "Magazine"
        editable = live
        valueType = custom
        {
            Weapon = string {}
            Rounds = integer { description = "Rounds left. Reload to fill back to capacity." default = 10  minvalue = 0  editable = live }
            Capacity = integer { description = "How many rounds a full magazine holds." default = 10 }
        }
    }

    Armor = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Armor
        singular = "Armor"
        editable = character
    }

    Augmentations = list
    {
        description = "Cybernetic and biotech augmentations installed in the body."
        tableLayout = layout { size = wide }
        source = secondary.Augmentations
        singular = "Augmentation"
        editable = character
    }

    Feats = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Feats
        singular = "Feat"
        editable = character
    }

    'Class Features' = list
    {
        tableLayout = layout { size = wide }
        singular = "Feature"
        editable = character
        valueType = nameAndDescription
    }

    Spellcasting = pf2Spellcasting {}

    Spells = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Spells
        singular = "Spell"
        editable = character
    }

    Inventory = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Equipment
        singular = "Item"
        editable = character
    }

    Wealth = table
    {
        tableLayout = layout { columns = 2 }
        Credits = integer { description = "Credits, the money of the galaxy." default = 150  editable = live }
        UPB = integer { description = "Universal polymer base, the raw material for building gear." default = 0  editable = live }
    }

    Notes = table
    {
        tableLayout = layout { columns = 2  size = wide }
        Homeworld = string {}
        Faction = string {}
        Appearance = string { multiline = true }
        Notes = string { multiline = true }
    }
}

sf2Weapon = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/armour.svg"
        filters = [filter { name = "Category" prefix = "" filter = Stats.Category }]
    }
    Stats = table
    {
        Category = string { keys = ["Unarmed", "Simple", "Martial", "Advanced"] }
        Damage = string {}
        'Damage Type' = string { keys = ["B", "P", "S", "fire", "electricity", "cold", "sonic", "acid", "force"] }
        Range = string {}
        Magazine = string {}
        Usage = string {}
        Hands = string {}
        Bulk = string {}
        Traits = string {}
        'Item Bonus' = string {}
        Group = string {}
        Level = string {}
        Price = string {}
    }
}

augmentationStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Level = integer { default = 1 }
        System = string { keys = ["Arm", "Brain", "Ears", "Eyes", "Foot", "Hand", "Heart", "Legs", "Lungs", "Skin", "Spinal Column", "Throat"] }
        Traits = string {}
        Price = string {}
    }
}

shipStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/systems/starwars/spaceship-entity.svg" }
    Ship = table
    {
        tableLayout = layout { columns = 3  size = wide }
        Tier = integer { description = "Ship tier: how advanced and powerful the ship is." default = 1 }
        Frame = string {}
        Size = string {}
        Speed = string {}
        Maneuverability = string {}
        AC = integer { description = "Armor Class of the ship." default = 15 }
        'Hull Points' = integer { description = "Hull points when undamaged." default = 50 }
        'Current Hull' = integer { description = "Hull points left. At 0 the ship is disabled." default = 50  editable = live  indicator = "#d64545" }
        Shields = integer { description = "Shield points that absorb damage before the hull." default = 0  editable = live }
        Sensors = string {}
        Crew = string { multiline = true }
    }
    Weapons = list
    {
        tableLayout = layout { size = wide }
        singular = "Weapon"
        editable = character
        valueType = custom
        {
            Name = string {}
            Attack = modifier { default = 0  valuedice = ask ("Target AC", pf2AskedRoll ("Normal"))  action = ranged  range = shipRange (Range) }
            Damage = string {}
            Range = string { description = "Range of the weapon. The first number is used as the range on the map." }
        }
    }
}

Starfinder2e = system
{
    hints = [
        hint
        {
            title = "Same core as Pathfinder"
            topic = "Getting started"
            text = ["Starfinder 2e uses the Pathfinder 2e rules; checks, degrees of success and conditions work the same."]
        },
        hint
        {
            title = "Guns and magazines"
            topic = "Combat"
            text = ["Track rounds in the Ammunition list and reload with an action. Strikes ask for the target's AC; leave it blank when only the GM knows it."]
        },
        hint
        {
            title = "Starships"
            topic = "Getting started"
            text = ["Ships are their own entity type. In ship combat each crew member takes a role."]
        },
        hint
        {
            title = "Perception"
            topic = "Initiative"
            text = ["Roll the Initiative field (Perception) to join the list."]
        }
    ]
    distanceUnit = "ft"
    squareSize = 5
    characters = characterTable
    creatures = pf2Creature
    Weapons = sf2Weapon
    Armor = pf2Armor
    Equipment = pf2Item
    Augmentations = augmentationStats
    Spells = pf2Spell
    Feats = pf2Feat
    'Character Options' = pf2Option
    Spaceships = shipStats
    secondaryTypes = ["Weapons", "Armor", "Equipment", "Augmentations", "Spells", "Feats"]
    otherLibararyTypes = ["Character Options"]
    extraEntityTypes = [entityTypeDescription ("Spaceships", "starship", true, "/systems/starwars/spaceship-entity.svg", [])]
    description = "Starfinder 2nd edition: Pathfinder's rules among the stars"
    initiativeCompare (item1, item2) = compare (toInt (item1), toInt (item2))
    encounterDifficulty (party, foes) = pf2EncounterDifficulty (party, foes)
    quickdice = [1d20, 1d4, 1d6, 1d8, 1d10, 1d12]
    cssFiles = ["/systems/sf2e/sf2e.css"]
    libraries = ["/systems/sf2e/sf2e.json", "/systems/names/scifi.json", "/systems/names/bluecollar.json", "/systems/names/cyberpunk.json", "/systems/tables/scifi.json", "/systems/tables/modern.json"]
    nameSettings = [spaceNameSetting, blueCollarSpaceNameSetting, neonStreetsNameSetting]
}
