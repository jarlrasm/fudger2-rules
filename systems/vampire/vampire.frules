#include "/systems/common.frules"
#include "/systems/names/settings.frules"

tensIn (rolls) = count (filter ((x)->x == 10, rolls))

successesIn (normal, hunger) =
    count (filter ((x)->x > 5, concat (normal, hunger))) + 2 * ((tensIn (normal) + tensIn (hunger)) / 2)

isCritical (normal, hunger) = tensIn (normal) + tensIn (hunger) > 1

v5Outcome (normal, hunger, difficulty) =
    if difficulty == 0 and successesIn (normal, hunger) > 0 then
        (if isCritical (normal, hunger) and tensIn (hunger) > 0 then "Messy critical" else if isCritical (normal, hunger) then "Critical" else "")
    else if successesIn (normal, hunger) < max (1, difficulty) then
        (if count (filter ((x)->x == 1, hunger)) > 0 then "Bestial failure" else if successesIn (normal, hunger) == 0 then "Total failure" else "Failure")
    else if isCritical (normal, hunger) and tensIn (hunger) > 0 then "Messy critical"
    else if isCritical (normal, hunger) then "Critical win"
    else "Win"

plural (n, word) = toString (n) + " " + word + (if n == 1 then "" else "es")

v5Text (normal, hunger, difficulty) =
    plural (successesIn (normal, hunger), "success")
    + (if difficulty > 0 then " vs " + toString (difficulty) else "")
    + (if v5Outcome (normal, hunger, difficulty) == "" then "" else ": " + v5Outcome (normal, hunger, difficulty))
    + (if successesIn (normal, hunger) >= max (1, difficulty) and difficulty > 0 then ", margin " + toString (successesIn (normal, hunger) - difficulty) else "")

failedNormal (normal) = count (filter ((x)->x < 6, normal))

v5Result (normal, hunger, difficulty, canReroll, spend) =
{
    Text = v5Text (normal, hunger, difficulty)
    Value = successesIn (normal, hunger)
    Outcome = v5Outcome (normal, hunger, difficulty)
    Color = if v5Outcome (normal, hunger, difficulty) == "Messy critical" then "orange" else ""
    Push = if canReroll and failedNormal (normal) > 0 then v5Reroll (filter ((x)->x > 5, normal), hunger, min (3, failedNormal (normal)), difficulty) else 0
    PushLabel = "Reroll with Willpower"
    PushSets = spend
}

v5Reroll (kept, hunger, rerolls, difficulty) = ([dice { number = rerolls  sides = 10  label = "Reroll" }],
    ((baseline, throws)->v5Result (concat (kept, first (throws).rolls), hunger, difficulty, false, [])))

v5Pool (pool, hunger, difficulty) = ([dice { number = max (0, pool - hunger)  sides = 10 }, dice { number = min (pool, hunger)  sides = 10  color = "red"  label = "Hunger" }],
    ((baseline, throws)->v5Result (first (throws).rolls, item (1, throws).rolls, difficulty, true, [])))

v5AskedPool (pool, hunger, spend) = ([dice { number = max (0, pool - hunger)  sides = 10 }, dice { number = min (pool, hunger)  sides = 10  color = "red"  label = "Hunger" }],
    ((baseline, throws)->v5Result (first (throws).rolls, item (1, throws).rolls, asked, true, spend)))

willpowerSpend (char) = [{ Field = "characterTable.Trackers.Willpower Superficial.realvalue"  Value = char.Trackers.'Willpower Superficial'.realvalue + 1 }]

v5Dice (char, pool) = ask ("Difficulty", v5AskedPool (pool + char.Character.Modifier, char.Character.Hunger, willpowerSpend (char)))

rouseCheck = ([1d10], ((baseline, throws)->if first (first (throws).rolls) > 5 then { Text = toString (first (first (throws).rolls)) + ": no Hunger"  Outcome = "Success" } else { Text = toString (first (first (throws).rolls)) + ": Hunger rises"  Outcome = "Failure" }))

attributeValue (char, name) =
    switch name
        case "Strength" then char.Attributes.Strength
        case "Dexterity" then char.Attributes.Dexterity
        case "Stamina" then char.Attributes.Stamina
        case "Charisma" then char.Attributes.Charisma
        case "Manipulation" then char.Attributes.Manipulation
        case "Composure" then char.Attributes.Composure
        case "Intelligence" then char.Attributes.Intelligence
        case "Wits" then char.Attributes.Wits
        else char.Attributes.Resolve

attributeNames = ["Strength", "Dexterity", "Stamina", "Charisma", "Manipulation", "Composure", "Intelligence", "Wits", "Resolve"]

skill (usual) = custom
{
    Dots = integer { description = "Skill dots from 0 to 5." default = 0  minvalue = 0  maxvalue = 5 }
    With = string { description = "The attribute this skill rolls with, picked to suit the task." default = usual  keys = attributeNames  editable = live }
    Pool = integer { description = "Dice pool: attribute plus skill. Each 6 or higher is a success, two 10s a critical." value = Dots + attributeValue (characterTable, With)  valuedice = v5Dice (characterTable, Dots + attributeValue (characterTable, With))  editable = none }
    Specialty = string { description = "A specialty adds a die when it applies." }
}

noSkill = { Pool = 0 }

poolOf (char, name) = valueOr (valueOr (char.Skills, name, noSkill), "Pool", 0)

weaponStat (weapon, field) = valueOr (weapon.data.weaponStats.Stats, field, "")

weaponAttack (name, pool, damage, kind, distance) = custom
{
    Name = name
    Pool = integer { value = pool  valuedice = v5Dice (characterTable, pool)  action = kind  reach = 2  range = distance }
    Damage = damage
}

attackFor (char, weapon) =
    if toInt (weaponStat (weapon, "Range")) > 0 then
        weaponAttack (weapon.Name, char.Attributes.Composure + valueOr (valueOr (char.Skills, "Firearms", noSkill), "Dots", 0), weaponStat (weapon, "Damage"), "ranged", toInt (weaponStat (weapon, "Range")))
    else
        weaponAttack (weapon.Name, char.Attributes.Strength + valueOr (valueOr (char.Skills, "Melee", noSkill), "Dots", 0), weaponStat (weapon, "Damage"), "melee", 2)

characterTable = ruleset
{
    rulesetConfiguration = { important = [Character.Hunger, Trackers, Attacks] }
    Character = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Concept = string {}
        Chronicle = string {}
        Ambition = string { description = "What the character wants to achieve over the chronicle." }
        Desire = string { description = "What the character wants right now, this session." }
        Predator = string { description = "How the vampire hunts for blood." keys = ["Alleycat", "Bagger", "Blood Leech", "Cleaver", "Consensualist", "Farmer", "Osiris", "Sandman", "Scene Queen", "Siren"] }
        Clan = string { keys = ["Banu Haqim", "Brujah", "Caitiff", "Gangrel", "Hecata", "Lasombra", "Malkavian", "Ministry", "Nosferatu", "Ravnos", "Salubri", "Thin-blood", "Toreador", "Tremere", "Tzimisce", "Ventrue"] }
        Generation = integer { description = "Distance from Caine. Lower generations have stronger blood." default = 13 }
        Sire = string { description = "The vampire who made this one." }
        Hunger = integer { description = "Hunger dice replace normal dice in pools. Messy criticals and bestial failures come from them." default = 1  minvalue = 0  maxvalue = 5  editable = live  indicator = "#d64545" }
        Modifier = modifier { description = "Extra dice added to or taken from the next pool." default = 0  editable = live }
        'Rouse Check' = integer { description = "Roll a d10 to use the blood. Below 6 and Hunger rises by one." default = 0  valuedice = rouseCheck  editable = none }
    }

    Attributes = table
    {
        description = "The nine attributes: physical, social and mental, for power, finesse and resistance."
        tableLayout = layout { columns = 3  size = wide }
        Strength = integer { description = "Physical power: lifting, hitting hard." default = 1  minvalue = 1  maxvalue = 5  valuedice = v5Dice (characterTable, Strength) }
        Charisma = integer { description = "Social power: charm and presence." default = 1  minvalue = 1  maxvalue = 5  valuedice = v5Dice (characterTable, Charisma) }
        Intelligence = integer { description = "Mental power: reasoning and knowledge." default = 1  minvalue = 1  maxvalue = 5  valuedice = v5Dice (characterTable, Intelligence) }
        Dexterity = integer { description = "Physical finesse: agility and aim." default = 1  minvalue = 1  maxvalue = 5  valuedice = v5Dice (characterTable, Dexterity) }
        Manipulation = integer { description = "Social finesse: getting others to do what you want." default = 1  minvalue = 1  maxvalue = 5  valuedice = v5Dice (characterTable, Manipulation) }
        Wits = integer { description = "Mental finesse: quick thinking and perception." default = 1  minvalue = 1  maxvalue = 5  valuedice = v5Dice (characterTable, Wits) }
        Stamina = integer { description = "Physical resistance: toughness. Sets health." default = 1  minvalue = 1  maxvalue = 5  valuedice = v5Dice (characterTable, Stamina) }
        Composure = integer { description = "Social resistance: keeping calm. Adds to willpower." default = 1  minvalue = 1  maxvalue = 5  valuedice = v5Dice (characterTable, Composure) }
        Resolve = integer { description = "Mental resistance: focus and determination. Adds to willpower." default = 1  minvalue = 1  maxvalue = 5  valuedice = v5Dice (characterTable, Resolve) }
    }

    Trackers = table
    {
        description = "Health, willpower and humanity."
        tableLayout = layout { columns = 2  size = wide }
        'Health Superficial' = slots { description = "Superficial health damage, halved and healed with blood." number = Attributes.Stamina + 3  editable = live  indicator = "#e8913a"  indicatorLabel = "Superficial" }
        'Health Aggravated' = slots { description = "Aggravated health damage, from fire, sunlight and claws." number = Attributes.Stamina + 3  editable = live  indicator = "#d64545"  indicatorLabel = "Aggravated" }
        'Willpower Superficial' = slots { description = "Superficial willpower damage, from stress and pressure." number = Attributes.Composure + Attributes.Resolve  editable = live }
        'Willpower Aggravated' = slots { description = "Aggravated willpower damage." number = Attributes.Composure + Attributes.Resolve  editable = live }
        Impaired = string { value = if 'Health Superficial'.realvalue + 'Health Aggravated'.realvalue > Attributes.Stamina + 2 then "Impaired" else ""  visible = none  indicator = "#d64545" }
        Humanity = integer { description = "How human the vampire still is. Lower humanity means a stronger beast." default = 7  minvalue = 0  maxvalue = 10  editable = live }
        Stains = integer { description = "Stains from breaking your convictions. At the end of the session they may cost humanity." default = 0  minvalue = 0  maxvalue = 10  editable = live  indicator = "#8e5cc4" }
        'Blood Potency' = integer { description = "Strength of the vampire's blood. Raises discipline power and blood surges." default = 1  minvalue = 0  maxvalue = 10 }
        'Remorse' = integer { description = "Roll one die per empty humanity box. No success and humanity drops." value = 10 - Humanity - Stains  valuedice = ([dice { number = max (1, 10 - Humanity - Stains)  sides = 10 }], ((baseline, throws)->if count (filter ((x)->x > 5, first (throws).rolls)) > 0 then { Text = "Humanity holds"  Outcome = "Success" } else { Text = "Lose 1 Humanity"  Outcome = "Failure" }))  editable = none }
        'New session' = button { description = "Each session, superficial willpower damage heals by the higher of Composure or Resolve."  editable = live  onClick = updates { (root.Trackers.'Willpower Superficial'.realvalue) = max (0, 'Willpower Superficial'.realvalue - max (Attributes.Composure, Attributes.Resolve)) } }
        'Remorse done' = button { description = "After the remorse roll at the end of the session, stains are cleared. Lower humanity by hand if the roll failed."  editable = live  onClick = updates { (root.Trackers.Stains) = 0 } }
    }

    Skills = table
    {
        description = "Skills, each rolled with a fitting attribute."
        tableLayout = layout { columns = 3  size = wide }
        Athletics = skill ("Dexterity")
        'Animal Ken' = skill ("Charisma")
        Academics = skill ("Intelligence")
        Brawl = skill ("Strength")
        Etiquette = skill ("Charisma")
        Awareness = skill ("Wits")
        Craft = skill ("Dexterity")
        Insight = skill ("Wits")
        Finance = skill ("Intelligence")
        Drive = skill ("Dexterity")
        Intimidation = skill ("Charisma")
        Investigation = skill ("Intelligence")
        Firearms = skill ("Composure")
        Leadership = skill ("Charisma")
        Medicine = skill ("Intelligence")
        Larceny = skill ("Dexterity")
        Performance = skill ("Charisma")
        Occult = skill ("Resolve")
        Melee = skill ("Strength")
        Persuasion = skill ("Charisma")
        Politics = skill ("Intelligence")
        Stealth = skill ("Dexterity")
        Streetwise = skill ("Charisma")
        Science = skill ("Intelligence")
        Survival = skill ("Wits")
        Subterfuge = skill ("Manipulation")
        Technology = skill ("Intelligence")
    }

    Disciplines = list
    {
        description = "Vampiric powers, each rated in dots."
        tableLayout = layout { size = wide }
        singular = "Discipline"
        editable = character
        valueType = custom
        {
            Discipline = string { keys = ["Animalism", "Auspex", "Blood Sorcery", "Celerity", "Dominate", "Fortitude", "Obfuscate", "Oblivion", "Potence", "Presence", "Protean", "Thin-blood Alchemy"] }
            Dots = integer { description = "Dots in this discipline." default = 1  minvalue = 0  maxvalue = 5 }
        }
    }

    Powers = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Powers
        singular = "Power"
        editable = character
    }

    Weapons = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        source = concat ([weaponAttack ("Bite or Brawl", Attributes.Strength + valueOr (valueOr (Skills, "Brawl", noSkill), "Dots", 0), "Superficial", "melee", 2)], map ((weapon)->attackFor (characterTable, weapon), characterTable.Weapons))
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }

    'Advantages and Flaws' = list
    {
        description = "Merits, backgrounds and flaws, each rated in dots."
        tableLayout = layout { size = wide }
        singular = "Advantage"
        editable = character
        valueType = custom
        {
            Name = string {}
            Dots = integer { default = 1 }
            Flaw = bool { default = false }
        }
    }

    Convictions = list
    {
        description = "Convictions and the touchstones, the mortals, who embody them."
        tableLayout = layout { size = wide }
        singular = "Conviction"
        editable = character
        valueType = custom
        {
            Conviction = string {}
            Touchstone = string {}
        }
    }

    Background = table
    {
        tableLayout = layout { columns = 2  size = wide }
        'Chronicle Tenets' = string { multiline = true }
        'Clan Bane' = string { description = "The weakness every member of the clan carries." multiline = true }
        'Clan Compulsion' = string { description = "What the clan's blood makes you do on a messy critical." multiline = true }
        History = string { multiline = true }
        'True Age' = string {}
        'Apparent Age' = string {}
        'Total Experience' = integer { default = 0 }
        'Spent Experience' = integer { default = 0  editable = live }
    }
}

creatureTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg"  important = [Stats] }
    Stats = table
    {
        tableLayout = layout { columns = 3  size = wide }
        Kind = string { keys = ["Mortal", "Ghoul", "Vampire", "Werewolf", "Hunter", "Other"] }
        Physical = integer { description = "Pool for physical actions." default = 3  valuedice = v5Pool (Physical, 0, 0) }
        Social = integer { description = "Pool for social actions." default = 3  valuedice = v5Pool (Social, 0, 0) }
        Mental = integer { description = "Pool for mental actions." default = 3  valuedice = v5Pool (Mental, 0, 0) }
        Health = slots { description = "Health boxes." number = 5  editable = live  indicator = "#d64545" }
        Willpower = slots { description = "Willpower boxes." number = 3  editable = live }
        Humanity = integer { default = 7 }
        'Blood Potency' = integer { default = 0 }
    }
    'Exceptional Pools' = keyvalues
    {
        description = "Dice pools the NPC is especially good at."
        singular = "Pool"
        editablekeys = character
        keys = ["Brawl", "Firearms"]
        valueType = custom
        {
            Dice = integer { default = 5  valuedice = v5Pool (Dice, 0, 0)  action = if Key == "Firearms" then "ranged" else "melee"  reach = 2 }
        }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        Disciplines = string { multiline = true }
        Description = string { multiline = true }
    }
}

weaponStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Damage = string {}
        Range = string {}
        Clips = string {}
        Concealability = string {}
    }
}

powerStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        filters = [filter { name = "Discipline" prefix = "" filter = Stats.Discipline }]
    }
    Stats = table
    {
        Discipline = string {}
        Level = integer { default = 1 }
        Cost = string {}
        'Dice Pool' = string {}
        Duration = string {}
        Amalgam = string {}
    }
}

Vampire = system
{
    hints = [
        hint
        {
            title = "Chronicle tenets"
            topic = "Getting started"
            text = ["Agree on the chronicle's tenets and each character's Touchstones and Convictions before play."]
        },
        hint
        {
            title = "Pools and hunger"
            topic = "Play"
            text = ["Roll Attribute + Skill d10s; 6+ succeeds. Each roll asks for the Difficulty; leave it blank when only the GM knows it. Hunger dice are red and bring messy criticals and bestial failures."]
        },
        hint
        {
            title = "Willpower"
            topic = "Play"
            text = ["After a roll, reroll up to three normal dice with Willpower; the sheet marks the superficial damage."]
        },
        hint
        {
            title = "No initiative"
            topic = "Initiative"
            text = ["Conflicts go by who is ready; drag tokens into order in the initiative list."]
        }
    ]
    distanceUnit = "m"
    characters = characterTable
    creatures = creatureTable
    Weapons = weaponStats
    Powers = powerStats
    secondaryTypes = ["Weapons", "Powers"]
    description = "Vampire: the Masquerade 5th edition: the Beast within and the Masquerade without"
    quickdice = [1d10]
    cssFiles = ["/systems/vampire/vampire.css"]
    libraries = ["/systems/names/nightworld.json", "/systems/names/gothic.json", "/systems/names/cyberpunk.json", "/systems/names/norwegian.json"]
    nameSettings = [nightWorldNameSetting, gothicHorrorNameSetting, neonStreetsNameSetting, modernNorwayNameSetting]
}
