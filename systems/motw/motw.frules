#include "/systems/common.frules"
#include "/systems/names/settings.frules"

moveOutcome (total) =
    if total > 9 then "Strong hit"
    else if total > 6 then "Weak hit"
    else "Miss"

moveText (total) =
    if total > 11 then "12+: you do it, and with an advanced move something extra"
    else if total > 9 then "10+: you do it"
    else if total > 6 then "7-9: you do it, but with a cost, a complication or a hard choice"
    else "6-: miss, mark experience, and the Keeper makes a move"

moveResult (total) =
{
    Text = toString (total) + ", " + moveText (total)
    Value = total
    Outcome = moveOutcome (total)
}

motwRoll (extra) = ([2d6], ((baseline, throws)->moveResult (baseline + extra + sum (first (throws).rolls))))

motwDice (char) = motwRoll (char.Status.Forward)

harmState (harm) =
    if harm > 7 then "Dead"
    else if harm > 3 then "Unstable"
    else ""

weaponStat (weapon, field) = valueOr (weapon.data.weaponStats.Stats, field, "")

rangeOf (tags) =
    if contains (tags, "far") then 50
    else if contains (tags, "close") then 15
    else 0

weaponAttack (name, rating, harm, kind, distance) = custom
{
    Name = name
    Roll = modifier { value = rating  valuedice = motwDice (characterTable)  action = kind  reach = 2  range = distance }
    Harm = harm
}

attackFor (char, weapon) =
    if rangeOf (toLower (weaponStat (weapon, "Tags"))) > 0 then
        weaponAttack (weapon.Name, char.Ratings.Tough, weaponStat (weapon, "Harm"), "ranged", rangeOf (toLower (weaponStat (weapon, "Tags"))))
    else
        weaponAttack (weapon.Name, char.Ratings.Tough, weaponStat (weapon, "Harm"), "melee", 2)

characterTable = ruleset
{
    rulesetConfiguration = { important = [Ratings, Status, Attacks] }
    Hunter = table
    {
        tableLayout = layout { columns = 3  size = wide }
        Playbook = string { keys = ["The Chosen", "The Crooked", "The Divine", "The Expert", "The Flake", "The Initiate", "The Monstrous", "The Mundane", "The Professional", "The Spell-Slinger", "The Spooky", "The Wronged"] }
        Look = string {}
        Experience = slots { description = "Experience, marked on misses. Five marks give an improvement." number = 5  editable = live  allowedchange = increaseAndClear }
        History = string { multiline = true }
    }

    Ratings = table
    {
        description = "Ratings, added to 2d6 for moves. 10+ is a full success, 7-9 a mixed one."
        tableLayout = layout { columns = 5  size = wide }
        Charm = modifier { description = "Charm: manipulating and talking people round." default = 0  minvalue = -1  maxvalue = 3  valuedice = motwDice (characterTable) }
        Cool = modifier { description = "Cool: staying calm and acting under pressure." default = 0  minvalue = -1  maxvalue = 3  valuedice = motwDice (characterTable) }
        Sharp = modifier { description = "Sharp: noticing things and working them out." default = 0  minvalue = -1  maxvalue = 3  valuedice = motwDice (characterTable) }
        Tough = modifier { description = "Tough: fighting and protecting people." default = 0  minvalue = -1  maxvalue = 3  valuedice = motwDice (characterTable) }
        Weird = modifier { description = "Weird: magic and the supernatural." default = 0  minvalue = -1  maxvalue = 3  valuedice = motwDice (characterTable) }
    }

    Status = table
    {
        tableLayout = layout { columns = 2 }
        Luck = slots { description = "Spend luck to turn any roll into a 12 or avoid harm. Seven spent and you are doomed." number = 7  editable = live  labels = ["", "", "", "", "", "", "Doomed"] }
        Harm = slots { description = "Harm taken. At 4 or more you are unstable and get worse; at 8 you die." number = 8  editable = live  labels = ["", "", "", "Unstable", "", "", "", "Dead"]  indicator = "#d64545" }
        Down = string { value = harmState (Harm.realvalue)  visible = none  indicator = "#d64545" }
        Forward = modifier { description = "Bonus for your next roll only." default = 0  editable = live  indicator = "#3a7bd5"  indicatorLabel = "Forward" }
        Armour = integer { description = "Armour reduces harm from each hit." default = 0 }
    }

    'Basic Moves' = table
    {
        description = "The moves every hunter has, with the rating they roll."
        tableLayout = layout { columns = 2 }
        'Act Under Pressure' = modifier { description = "Do something under pressure or in danger. Roll +Cool." value = Ratings.Cool  valuedice = motwDice (characterTable)  editable = none }
        'Help Out' = modifier { description = "Help another hunter. Roll +Cool." value = Ratings.Cool  valuedice = motwDice (characterTable)  editable = none }
        'Investigate a Mystery' = modifier { description = "Learn things about the mystery. Roll +Sharp." value = Ratings.Sharp  valuedice = motwDice (characterTable)  editable = none }
        'Kick Some Ass' = modifier { description = "Fight a monster or minion. Roll +Tough." value = Ratings.Tough  valuedice = motwDice (characterTable)  editable = none  action = melee  reach = 2 }
        'Manipulate Someone' = modifier { description = "Get someone to do what you want. Roll +Charm." value = Ratings.Charm  valuedice = motwDice (characterTable)  editable = none }
        'Protect Someone' = modifier { description = "Take harm meant for someone else. Roll +Tough." value = Ratings.Tough  valuedice = motwDice (characterTable)  editable = none }
        'Read a Bad Situation' = modifier { description = "Size up a dangerous place or situation. Roll +Sharp." value = Ratings.Sharp  valuedice = motwDice (characterTable)  editable = none }
        'Use Magic' = modifier { description = "Cast a spell or use supernatural forces. Roll +Weird." value = Ratings.Weird  valuedice = motwDice (characterTable)  editable = none }
    }

    Moves = list
    {
        tableLayout = layout { size = wide }
        singular = "Move"
        editable = character
        valueType = nameAndDescription
    }

    Weapons = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        source = map ((weapon)->attackFor (characterTable, weapon), characterTable.Weapons)
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }

    Gear = table
    {
        tableLayout = layout { columns = 2  size = wide }
        Gear = string { multiline = true }
        Improvements = string { description = "Upgrades to the hunter's gear, base or abilities." multiline = true }
    }
}

creatureTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg"  important = [Monster, Attacks] }
    Monster = table
    {
        tableLayout = layout { columns = 3  size = wide }
        Type = string { keys = ["Monster", "Minion", "Bystander"] }
        Motivation = string { description = "What the monster wants, which guides how it acts." keys = ["Beast (to run wild)", "Breeder (to give birth)", "Collector (to steal)", "Destroyer (to cause chaos)", "Devourer (to consume)", "Executioner (to punish)", "Parasite (to infest)", "Queen (to possess and control)", "Sorcerer (to usurp power)", "Tempter (to tempt)", "Torturer (to hurt)", "Trickster (to create mayhem)"] }
        'Harm Capacity' = integer { description = "Harm the monster can take before it dies." default = 8 }
        Harm = integer { description = "Harm taken so far." default = 0  minvalue = 0  editable = live  indicator = "#d64545" }
        Armour = integer { description = "Armour reduces harm from each hit." default = 0 }
        Down = string { value = if Harm >= 'Harm Capacity' then "Dead" else ""  visible = none  indicator = "#d64545" }
        Weakness = string { description = "The only thing that can kill this monster, or that hurts it most." }
    }
    Attacks = list
    {
        tableLayout = layout { size = wide }
        singular = "Attack"
        editable = character
        valueType = custom
        {
            Name = string {}
            Harm = integer { default = 2  action = melee  reach = 2 }
            Tags = string {}
        }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        Powers = string { multiline = true }
        Description = string { multiline = true }
    }
}

weaponStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Harm = string {}
        Tags = string {}
    }
}

MonsterOfTheWeek = system
{
    hints = [
        hint
        {
            title = "Mysteries"
            topic = "Getting started"
            text = ["Plan the mystery: a monster, its minions, the bystanders and locations, and a countdown of what happens if the hunters do nothing."]
        },
        hint
        {
            title = "Moves"
            topic = "Play"
            text = ["Roll 2d6 + rating: 10+ success, 7-9 success with a cost, 6- a miss, mark experience and the Keeper makes a move."]
        },
        hint
        {
            title = "No initiative"
            topic = "Initiative"
            text = ["There is no initiative. Move the spotlight between hunters as the fiction asks."]
        },
        hint
        {
            title = "Harm and Luck"
            topic = "Combat"
            text = ["Attacks deal their harm minus armour. At 4 harm a hunter is unstable, at 8 dying. Spending Luck turns a roll into a 12 or makes a harm 0."]
        }
    ]
    distanceUnit = "m"
    characters = characterTable
    creatures = creatureTable
    entityTypeNames = [entityTypeName ("Character", "Hunter", "Hunters")]
    Weapons = weaponStats
    secondaryTypes = ["Weapons"]
    description = "Monster of the Week: Powered by the Apocalypse hunters against the monster of the week"
    quickdice = [2d6]
    cssFiles = ["/systems/motw/motw.css"]
    libraries = ["/systems/names/nightworld.json", "/systems/names/gothic.json", "/systems/names/cosmic.json"]
    nameSettings = [nightWorldNameSetting, gothicHorrorNameSetting, cosmicHorrorNameSetting]
}
