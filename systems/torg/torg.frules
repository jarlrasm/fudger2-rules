          {
            description = "Weakened: -2 on your rolls, or -4 when very weakened."
            number = 2
            allowedchange = increaseAndClear
            editable = live
            indicator = "#8e5cc4"
          }
          'Smack that' = integer
          {
            value = 0
            valuedice = 1d6
          }
      }

  'Possibilities' = table
  {
    description = "Possibilities, spent to reroll and add, soak damage or bend reality."
    Possibilities = integer
    {
      description = "Possibilities left. Spend one to roll again and add, or to soak a wound."
      default = 3
      editable=live
      }
    'Cosm Possibilities' = integer
    {
      description = "Possibilities from your home cosm, only usable there."
      editable=live
    }
  }

  Adds = table
  {
    visible = none
    editable = character

    'Energy Weapons' = integer { default = 0}
  }
  
  'Combat Skills' = table
    {
      description = "Combat skills: attribute plus adds, rolled to attack."
            
