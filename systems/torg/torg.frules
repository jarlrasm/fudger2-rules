characterTable = ruleset
{
    rulesetConfiguration = { important = ['Damage', 'Possibilities', 'Combat Skills', Attacks] }
    Basics = table
  {
    Race = string {}
    'Total XP'  = integer
        {
              description = "All experience earned so far."
              editable=live
        }
    'Unspent'=integer
              {
                description = "Experience left to spend."
                editable=live
              }
    'Clearance Level' = string
    {
      description = "Clearance in the Delphi Council: how much the Storm Knight is trusted."
      default = "Alpha"
    }
  }

  Axioms = table
  {
    description = "Reality axioms: how much magic, social order, spirit and technology a reality allows."
    Cosm = string { description = "The cosm, the reality the Storm Knight comes from." }
    Magic = integer { description = "Magic axiom: how much magic works." }
    Social = integer { description = "Social axiom: how organised society can be." }
    Spirit = integer { description = "Spirit axiom: how much the divine and spirits affect the world." }
    Tech = integer { description = "Tech axiom: how advanced technology can be." }
  }
  'Attributes' = keyvalues
      {
          description = "The five attributes. Roll d20 on the bonus chart and add it to the value."
          singular = "Attribute"
          keys = ["Charisma","Dexterity","Mind","Spirit","Strength"]
          valueType = custom
          {
            Score=integer
            {
              description = "Attribute value, usually from 5 to 13."
              default=8
              valuedice=D20Roll
            }
          }
      }
  'Damage' = table
      {
          Shock = integer
          { description = "Shock taken. When it reaches your Spirit, you are knocked out."  editable=live  indicator = "#d4b106" }
          Wounds = slots
          {
            description = "Wounds taken. Each gives -1 to actions; more than three and you are defeated."
            number = 6
            allowedchange = increaseAndClear
            editable = live
            indicator = "#d64545"
           }
          Toughness = string
          { description = "Damage needed to hurt you: Strength plus armor." }
          Stymied = slots
          {
            description = "Stymied: -2 on your next action, or -4 when very stymied."
