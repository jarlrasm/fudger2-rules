#include "/systems/common.frules"
#include "/systems/names/settings.frules"

D20Roll  = ask ("DN", D20RollImpl (0))

torgLevel (total, dn) =
    if total < dn then "Failure"
    else if total < dn + 5 then "Standard success"
    else if total < dn + 10 then "Good success"
    else "Outstanding success"

torgResult (total, dn) =
    if dn > 0 then { Text = toString (total) + " vs DN " + toString (dn) + ": " + torgLevel (total, dn)  Value = total  Outcome = if total < dn then "Failure" else "Success" }
    else total

D20RollImpl (extra) = ([1d20],((baseline,throws)->
  switch first(first (throws).rolls)
    case 10 then D20RollImpl (extra + 10)
    case 20 then D20RollImpl (extra + 20)
    else if extra + first(first (throws).rolls) == 1 then "Mishap"
    else torgResult (baseline + calculate (extra + first(first (throws).rolls)), asked)
          ))
          
          
calculate(n)=
 if n == 1 then "Mishap" else
 if n < 3 then -8 else
 if n < 5 then -6 else
 if n < 7 then -4 else
 if n < 9 then -2 else
 if n < 11 then -1 else
 if n < 13 then 0 else
 if n < 15 then 1 else
 if n < 16 then 2 else
 if n < 17 then 3 else
 if n < 18 then 4 else
 if n < 19 then 5 else
 if n < 20 then 6 else
 if n < 21 then 7 else
 if n < 26 then 8 else
 if n < 31 then 9 else
 if n < 36 then 10 else
 if n < 41 then 11 else
 if n < 46 then 12 else
 if n < 51 then 13 else
  14 + (n - 51)/5
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 


flatten (lists) = fold ([], (acc, x)->concat (acc, x), lists)

weaponAttack (name, skill, damage, kind, distance) = custom
{
    Name = name
    Attack = integer
    {
        value = skill
        valuedice = D20Roll
        action = kind
        range = distance
    }
    Damage = string
    {
        value = damage
    }
}

noSkill = { Modifier = 0 }

creatureSkill (creature, skill) =
    valueOr (valueOr (creature.'Combat skills', skill, noSkill), "Modifier", 0)

creatureAttack (creature, skill, kind) =
    if creatureSkill (creature, skill) > 0 then
        [weaponAttack (skill, creatureSkill (creature, skill), "", kind, 0)]
    else
        []

creatureAttacksFor (creature) =
    flatten ([
        creatureAttack (creature, "Melee Weapons", "melee"),
        creatureAttack (creature, "Unarmed Combat", "melee"),
        creatureAttack (creature, "Fire Combat", "ranged"),
        creatureAttack (creature, "Energy Weapons", "ranged"),
        creatureAttack (creature, "Heavy Weapons", "ranged"),
        creatureAttack (creature, "Missile Weapons", "ranged")])

rangedSkill (weapon) =
    if contains (toLower (weapon.Name), "laser") then
        "Energy Weapons"
    else
        if contains (toLower (weapon.Name), "bow") then
            "Missile Weapons"
        else
            if contains (toLower (valueOr (weapon.data.rangedStats.Stats, "Notes", "")), "thrown") then
                "Missile Weapons"
            else
                "Fire Combat"

rangedSkillValue (char, skill) =
    if skill == "Energy Weapons" then
        char.'Combat Skills'.'Energy Weapons'.'Skill value'
    else
        if skill == "Missile Weapons" then
            char.'Combat Skills'.'Missile Weapons'.'Skill value'
        else
            char.'Combat Skills'.'Fire Combat'.'Skill value'

longRange (text) = toInt (first (reverse (split ("/", text))))

spellSkillName (spell) = valueOr (spell.data.spellStats.Stats, "Skill", "")

spellSkillValue (char, spell) =
    if contains (toLower (spellSkillName (spell)), "alteration") then char.Skills.'Alteration'.'Skill value' else
    if contains (toLower (spellSkillName (spell)), "apportation") then char.Skills.'Apportation'.'Skill value' else
    if contains (toLower (spellSkillName (spell)), "conjuration") then char.Skills.'Conjuration'.'Skill value' else
    if contains (toLower (spellSkillName (spell)), "divination") then char.Skills.'Divination'.'Skill value' else
    if contains (toLower (spellSkillName (spell)), "faith") then char.Skills.'Faith'.'Skill value' else
    if contains (toLower (spellSkillName (spell)), "kinesis") then char.Skills.'Kinesis'.'Skill value' else
    if contains (toLower (spellSkillName (spell)), "precognition") then char.Skills.'Precognition'.'Skill value' else
    if contains (toLower (spellSkillName (spell)), "telepathy") then char.Skills.'Telepathy'.'Skill value' else
    if contains (toLower (spellSkillName (spell)), "willpower") then char.Skills.'Willpower'.'Skill value' else
    char.Attributes.'Spirit'.'Score'

spellRangeText (spell) = valueOr (spell.data.spellStats.Stats, "Range", "")

spellKind (spell) = if toLower (spellRangeText (spell)) == "touch" then "melee" else "ranged"

spellMetres (spell) = toInt (first (split (" ", replace ("m", " ", spellRangeText (spell)))))

spellUse (name, skill, dn, kind, distance, rangeText) = custom
{
    Name = name
    Roll = integer
    {
        value = skill
        valuedice = D20Roll
        action = kind
        range = distance
    }
    DN = dn
    Range = rangeText
}

listVisible (items) = if count (items) > 0 then visible else none

spellUsesFor (char) =
    map ((spell)->spellUse (spell.Name, spellSkillValue (char, spell), valueOr (spell.data.spellStats.Stats, "DN", ""), spellKind (spell), spellMetres (spell), spellRangeText (spell)), char.'Magic Miracles Psionics')

attacksFor (char) =
    flatten ([
        [weaponAttack ("Unarmed", char.'Combat Skills'.'Unarmed Combat'.'Skill value', "STR", "melee", 0)],
        map ((weapon)->weaponAttack (weapon.Name, char.'Combat Skills'.'Melee Weapons'.'Skill value', valueOr (weapon.data.meleeStats.Stats, "Damage", ""), "melee", 0), char.'Melee Weapons'),
        map ((weapon)->weaponAttack (weapon.Name, rangedSkillValue (char, rangedSkill (weapon)), valueOr (weapon.data.rangedStats.Stats, "Damage", ""), "ranged", longRange (valueOr (weapon.data.rangedStats.Stats, "Range", ""))), char.'Ranged Weapons')])

creatureTable = ruleset
{
  rulesetConfiguration = { important = [Basics, 'Combat skills', 'Attack rolls'] }
  'Attributes' = keyvalues
  {
    description = "The five attributes. Roll d20 on the bonus chart and add it to the value."
    singular = "Attribute"
    keys = ["Charisma","Dexterity","Mind","Spirit","Strength"]
    valueType = custom
    {
      Score=integer
      {
        description = "Attribute value, usually from 5 to 13."
        default=8
        valuedice=D20Roll
      }
    }
  }
  Basics = table
  {
    Move = integer { description = "Spaces moved per turn." }
    Tough = string { description = "Toughness: the damage needed to hurt the creature, and its armor." }
    Shock = integer { description = "Shock the creature can take before it is knocked out." }
    'Shocks taken' = integer { description = "Shock taken." editable = live  indicator = "#d4b106"  indicatorLabel = "Shock" }
    Wounds = integer { description = "Wounds the creature can take before it is defeated." }
    'Wounds taken' = slots
    {
      number = 8
      allowedchange = increaseAndClear
      editable = live
      indicator = "#d64545"
      indicatorLabel = "Wounds"
    }
    Stymied = slots
    {
      description = "Stymied: -2 on its next action, or -4 when very stymied."
      number = 2
      allowedchange = increaseAndClear
      editable = live
      indicator = "#e8913a"
    }
    Weakened = slots
    {
      description = "Weakened: -2 on its rolls, or -4 when very weakened."
      number = 2
      allowedchange = increaseAndClear
      editable = live
      indicator = "#8e5cc4"
    }
  }
  Other = table
  {
    Equipment = string {}
    Perks = string {}
    Possibilities = string {}
  }
  'Combat skills' = table
  {
    description = "Combat skills, rolled to attack."
    'Energy Weapons' = custom
    {
      description = "Firing lasers, blasters and other energy guns."
      Modifier=modifier
      {
        valuedice=D20Roll
      }
    }
    'Fire Combat' = custom
