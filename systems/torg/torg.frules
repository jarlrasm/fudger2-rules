      {
        valuedice=D20Roll
      }
    }
  }
  'Interaction skills' = table
  {
    description = "Interaction skills, used to attack a foe's mind and nerve."
    Intimidation = custom
    {
      description = "Scaring someone into backing down. An interaction attack against Spirit."
      Modifier = modifier
      {
        valuedice=D20Roll
      }
    }
    Maneuver = custom
    {
      description = "Outmoving a foe to leave them off balance. An interaction attack against Dexterity."
      Modifier = modifier
      {
        valuedice=D20Roll
      }
    }
    Taunt = custom
    {
      description = "Goading a foe into a mistake. An interaction attack against Charisma."
      Modifier = modifier
      {
        valuedice=D20Roll
      }
    }
    Trick = custom
    {
      description = "Fooling a foe with a ruse. An interaction attack against Mind."
      Modifier = modifier
      {
        valuedice=D20Roll
      }
    }
  }
  Skills = table
  {
   description = "General skills: attribute plus adds."
   tableLayout = layout
    {
      columns = 4
