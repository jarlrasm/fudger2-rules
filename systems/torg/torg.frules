        {
          description = "Fooling a foe with a ruse. An interaction attack against Mind."
          Adds = integer
          { default = 0 }
          'Skill value' = integer
            { value = 'Attributes'.'Mind'.'Score' + Adds
            valuedice = D20Roll}
        }
      
    }
  
  Skills = table
