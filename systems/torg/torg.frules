    'Melee Weapons' = list
    {
        tableLayout = layout
        {
          size = wide
        }
        source=secondary.'Melee weapons'
        singular = "Melee weapon"
        editable = character
    }
    'Ranged Weapons' = list
    {
        tableLayout = layout
        {
          size = wide
        }
        source=secondary.'Ranged weapons'
        singular = "Ranged weapon"
        editable = character
    }
    Attacks = list
    {
        tableLayout = layout
        {
          size = wide
        }
        source = attacksFor (characterTable)
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }
    'Perks' = list
    {
        description = "Perks: special abilities the Storm Knight has bought."
        tableLayout = layout
        {
          size = wide
        }
        source=secondary.Perks
        singular = "Perk"
        editable = character
    }
    
  

  'Magic Miracles Psionics' = list
    {
        tableLayout = layout
        {
          size = wide
        }
        source=secondary.Spells
        singular = "Spell"
        editable = character
    }
    'Spell uses' = list
    {
        visible = listVisible (spellUsesFor (characterTable))
        tableLayout = layout
        {
          size = wide
        }
        source = spellUsesFor (characterTable)
        singular = "Spell use"
        editable = none
        valueType = spellUse
    }
    'Features and Traits' = list
    {
        tableLayout = layout
        {
          size = wide
        }
        singular = "Feature"
        editable = character
        valueType = nameAndDescription
    }
    'Armour' = list
    {
        tableLayout = layout
        {
          size = wide
        }
        source=secondary.Armour
        singular = "Armour"
        editable = character
    }
    'Other items' = list
    {
        tableLayout = layout
        {
          size =wide
        }
        source=secondary.'Other items'
        singular = "Item"
        editable = character
    }

    'Bonus Chart' = table
  {
      description = "Roll d20 and look up the bonus to add to the skill or attribute."
      tableLayout = layout
      {
        size = wide
        columns = 4
      }
      
    'Die roll' = string { value = "Bonus"
    editable = none}
    '1' = string { value = "Mishap"
    editable = none}
    '2' = string { value = "-8" editable = none}
    '3 4' = string { value = "-6" editable = none}
    '5 6' = string { value = "-4" editable = none}
    '7 8' = string { value = "-2" editable = none}
    '9 10' = string { value = "-1" editable = none}
    '11 12' = string { value = "0" editable = none}
    '13 14' = string { value = "1" editable = none}
    '15' = string { value = "2" editable = none}
    '16' = string { value = "3" editable = none}
    '17' = string { value = "4" editable = none}
    '18' = string { value = "5" editable = none}
    '19' = string { value = "6" editable = none}
    '20' = string { value = "7" editable = none}
    '21 25' = string { value = "8" editable = none}
    '26 30' = string { value = "9" editable = none}
    '31 35' = string { value = "10" editable = none}
    '36 40' = string { value = "11" editable = none}
    '41 45' = string { value = "12" editable = none}
    '46 50' = string { value = "13" editable = none}
    'every 5' = string { value = "add 1" editable = none}
  }
  
}




  

rangedStats =ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
            }
            Stats= table
            {
                Tech=integer
                {}
                Damage=string
                {}
                Ammo=integer
                {}
                Range=string
                {}
                Price=string
                {}
                Notes=string
                {}
            }
        }
meleeStats =ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
            }
            Stats= table
            {
                Tech=integer
                {}
                Damage=string
                {}
                Price=string
                {}
                Notes=string
                {}
            }
        }
armourStats= ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
            }
            Stats= table
            {
                Tech=integer
                {}
                Bonus=string
                {}
                Price=string
                {}
                Notes=string
                {}
            }
        }
spellStats =ruleset
{
  rulesetConfiguration =
  {
      defaultImage = "/images/spell.svg"
      sortedBy = sort
      {
          prefix="Axiom Level"
          sort=Stats.'Axiom Level'
      }
      filters= [
          filter {
              name="Lists"
              prefix=""
              filter=split (",", Stats.Lists)},
          filter {
              name="Type"
              prefix=""
              filter=Stats.Type}
              ]
  }
  Stats= table
  {
      'Axiom Level'=integer
      {}
      'Type'=string
      {}
      'Skill'=string
      {}
      'Casting Time'=string
      {}
      'DN'=string
      {}
      'Range'=string
      {}
      'Duration'=string
      {}
      'Lists'=string
      {}
      'Source'=string
      {}
      
  }
}
perkStats =ruleset
{
  rulesetConfiguration =
  {
      sortedBy = sort
      {
          prefix=""
          sort=Stats.Type
      }
      filters= [
          filter {
              name="Type"
              prefix=""
              filter=Stats.Type},
          filter {
              name="Cosm"
              prefix=""
              filter=split (",", Stats.Cosm)}
          ]
      defaultImage = "/images/spell.svg"
  }
  Stats= table
  {
      'Cosm'=string
      {}
      'Prereq'=string
      {}
      'Type'=string
      {}
      'Source'=string
      {}
  }
}
TORG = system
{
    hints = [
        hint
        {
            title = "The cosms"
            topic = "Getting started"
            text = ["Agree on which cosm or realm the campaign starts in. It decides which axioms and world laws apply, and which skills and gear work without contradiction."]
        },
        hint
        {
            title = "Initiative with the Drama deck"
            topic = "Initiative"
            text = ["There is no initiative roll. Each round, flip a Drama card: it says which side acts first, and its conditions and approved actions apply to the round.", "Within a side the players choose their order. Drag tokens into that order in the initiative list.", "Add the Drama deck to the campaign so you can flip it in sessions."]
            deck = "Drama deck"
        },
        hint
        {
            title = "Deal Destiny cards"
            topic = "Cards"
            text = ["Every hero holds Destiny cards. Deal each player a hand at the start of an act and let them play cards for bonuses and effects.", "Add the Destiny deck to the campaign so you can deal it in sessions."]
            deck = "Destiny deck"
        },
        hint
        {
            title = "Archetypes"
            topic = "Characters"
            text = ["Let new players start from one of the archetypes in the core book and adjust it, rather than building from scratch."]
        },
        hint
        {
            title = "Shock and wounds"
            topic = "Combat"
            text = ["Damage is compared with Toughness: equal or more gives Shock, 5 or more over gives a wound. Track Shock and Wounds on the sheet."]
        },
        hint
        {
            title = "Metres and squares"
            topic = "Maps"
            text = ["Move on the sheet is in metres per round. Set the battlemap square size to 1 or 2 metres."]
        },
        hint
        {
            title = "Possibilities"
            topic = "Play"
            text = ["Heroes spend Possibilities to reroll and add, or to soak damage. Give them chances to be bold."]
        }
    ]
    distanceUnit = "m"
    squareSize = 1
    characters = characterTable
    creatures = creatureTable
    'Ranged weapons'= rangedStats
    'Melee weapons'= meleeStats
    Armour= armourStats
    Spells = spellStats
    Perks = perkStats
    secondaryTypes = ["Ranged weapons","Melee weapons","Armour","Spells","Perks", "Other items"]
    description="TORG Eternity"
    libraries = ["/systems/torg/torg.json", "/systems/torg/decks.json", "/systems/names/norwegian.json", "/systems/names/viking.json", "/systems/names/chinese.json", "/systems/names/fantasy.json", "/systems/names/scifi.json", "/systems/names/cyberpunk.json", "/systems/names/gothic.json", "/systems/names/cosmic.json", "/systems/names/grimdark.json", "/systems/names/oldworld.json", "/systems/names/nightworld.json", "/systems/names/desert.json", "/systems/names/barbarian.json", "/systems/names/wasteland.json", "/systems/names/weirdwest.json", "/systems/names/pirates.json", "/systems/names/samurai.json", "/systems/names/victorian.json", "/systems/names/bluecollar.json", "/systems/names/mythicgreece.json", "/systems/names/arthurian.json", "/systems/names/egypt.json", "/systems/names/heroes.json", "/systems/names/spies.json", "/systems/names/faerie.json"]
    nameSettings = [spyThrillerNameSetting, fantasyNameSetting, ancientEgyptNameSetting, gothicHorrorNameSetting, gaslightNameSetting, neonStreetsNameSetting, easternNameSetting, wastelandNameSetting, superheroesNameSetting]
    cssFiles = ["/systems/torg/torg.css"]
    quickdice =[D20Roll,1d6]
}
