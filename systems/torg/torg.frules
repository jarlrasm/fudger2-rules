          description = "Goading a foe into a mistake. An interaction attack against Charisma."
          Adds = integer
          { default = 0 }
          'Skill value' = integer
            { value = 'Attributes'.'Charisma'.'Score' + Adds
            valuedice = D20Roll}
        }
