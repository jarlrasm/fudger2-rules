#include "/systems/common.frules"
#include "/systems/names/settings.frules"

pointsToSkill(points)=
 if points-points/3*3 > 0 then
                         toString(points/3)+"D+"+toString(points-points/3*3)
                         
                        else toString(points/3)+"D"
                        
withActions(points, actions)=
  max(min(points, 3), points - 3 * max(0, toInt(actions) - 1))

starResult (total, difficulty) = starResultWith (total, difficulty, 0)

starResultWith (total, difficulty, cp) = {
    Text = toString (total) + (if difficulty > 0 then " vs " + toString (difficulty) + ": " + (if total >= difficulty then "Success" else "Failure") else "")
    Value = total
    Outcome = if difficulty > 0 then (if total >= difficulty then "Success" else "Failure") else ""
    Push = if cp > 0 then characterPointDie (total, cp) else 0
    PushLabel = "Spend a Character Point"
    PushSets = [{ Field = "characterTable.General.Character Points"  Value = cp - 1 }]
}

characterPointDie (total, cp) = ([dice { number = 1  sides = 6  explode = 6  label = "Character Point" }],((baseline,throws)->
    starResultWith (total + sum (first (throws).rolls), asked, cp - 1)))

rethrow (extra) = rethrowWith (extra, 0)

rethrowWith (extra, cp) = ([dice { number = 1  sides = 6  color = "red"  label = "Wild" }],((baseline,throws)->
  if first (first (throws).rolls) == 6 then
    rethrowWith (extra + 6, cp)
  else
    starResultWith (extra + sum (first (throws).rolls), asked, cp)
  ))

oneOnWild (rolls) =
  if count (rolls) == 0 then
    0
  else
    sum (rolls) - max (rolls)

starDice (points) = starDiceWith (points, 0)

starDiceWith (points, cp) = ([dice { number = max (0, points / 3 - 1)  sides = 6  bonus = points - points / 3 * 3 }, dice { number = min (1, points / 3)  sides = 6  color = "red"  label = "Wild" }],((baseline,throws)->
  if count (item (1, throws).rolls) == 0 then
    starResultWith (first (throws).bonus, asked, cp)
  else
    switch first (item (1, throws).rolls)
      case 6 then rethrowWith (sum (first (throws).rolls) + 6 + first (throws).bonus, cp)
      case 1 then starResultWith (oneOnWild (first (throws).rolls) + first (throws).bonus, asked, cp)
      else starResultWith (sum (first (throws).rolls) + sum (item (1, throws).rolls) + first (throws).bonus, asked, cp)
  ))

starCheck (points) = ask ("Difficulty", starDice (points))

charCheck (char, points) = ask ("Difficulty", starDiceWith (points, char.General.'Character Points'))

injuryPips (char) = if char.Injuries.'Wounded twice' then 6 else if char.Injuries.'Wounded' or char.Injuries.'Stunned' then 3 else 0

injured (char, points) = max (0, points - injuryPips (char))

noSkill = { Points = 0 }

dexterityPoints (char, skill) =
    valueOr (valueOr (char.'Dexterity Skills', skill, noSkill), "Points", 0) + valueOr (valueOr (char.Attributes, "Dexterity", noSkill), "Points", 9)

meleeSkill (weapon) =
    if contains (toLower (weapon.Name), "lightsaber") then
        "Lightsaber"
    else
        "Melee"

rangedSkill (weapon) =
    if contains (toLower (weapon.Name), "grenade") then
        "Grenade"
    else
        if contains (toLower (weapon.Name), "detonator") then
            "Grenade"
        else
            "Blaster"

longRange (text) = toInt (first (reverse (split ("/", text))))

weaponAttack (name, points, damage, kind, distance, cp) = custom
{
    Name = name
    Attack = integer
    {
        value = points
        valuedice = ask ("Difficulty", starDiceWith (points, cp))
        render = pointsToSkill (points)
        action = kind
        range = distance
    }
    Damage = string
    {
        value = damage
    }
}

attackPoints (char, skill) =
    withActions (injured (char, dexterityPoints (char, skill)), valueOr (char.General, "Actions", "1"))

notUsed = { Used = false  Difficulty = "" }

noPoints = { Points = 0 }

forcePowerSkill (power, skill) = valueOr (power.data.forcePowerStats.Power, skill, notUsed)

jediPoints (char, skill) =
    withActions (injured (char, valueOr (valueOr (char.'Jedi skills', skill, noPoints), "Points", 0)), valueOr (char.General, "Actions", "1"))

forcePowerUse (name, points, difficulty, cp) = custom
{
    Name = name
    Roll = integer
    {
        value = points
        valuedice = ask ("Difficulty", starDiceWith (points, cp))
        render = pointsToSkill (points)
        action = "ranged"
    }
    Difficulty = difficulty
}

forceUsesWith (char, skill) =
    map ((power)->forcePowerUse (power.Name + " (" + skill + ")", jediPoints (char, skill), valueOr (forcePowerSkill (power, skill), "Difficulty", ""), valueOr (char.General, "Character Points", 0)),
        filter ((power)->valueOr (forcePowerSkill (power, skill), "Used", false), char.'Force powers'))

forceUsesFor (char) =
    concat (forceUsesWith (char, "Control"), concat (forceUsesWith (char, "Sense"), forceUsesWith (char, "Alter")))

attacksFor (char) =
    concat (
        map ((weapon)->weaponAttack (weapon.Name, attackPoints (char, meleeSkill (weapon)), valueOr (weapon.data.meleeWeaponStats.Stats, "Damage", ""), "melee", 0, valueOr (char.General, "Character Points", 0)), char.'Melee weapons'),
        map ((weapon)->weaponAttack (weapon.Name, attackPoints (char, rangedSkill (weapon)), valueOr (weapon.data.rangedWeaponStats.Stats, "Damage", ""), "ranged", longRange (valueOr (weapon.data.rangedWeaponStats.Stats, "Range", "")), valueOr (char.General, "Character Points", 0)), char.'Ranged weapons'))

characterTable = ruleset
{
    rulesetConfiguration = { important = [General, Injuries, Attacks] }
    Profile = table
    {
      tableLayout = layout { columns = 4  size = wide }
      Type = string {}
      Species = string {}
      Gender = string {}
      Age = string {}
      Height = string {}
      Weight = string {}
      Move = integer
      {
        description = "Move: metres covered in a round at normal speed."
        default = 10
        minvalue = 0
      }
    }
  'Attributes' = keyvalues
      {
          description = "The six attributes, in dice and pips such as 3D+1."
          tableLayout = layout { columns = 3  size = wide }
          singular = "Attribute"
          keys = ["Dexterity","Knowledge","Mechanical","Perception","Strength","Technical" ]
          valueType = custom
          {
              Points=integer
              {
                description = "Attribute in pips, shown as dice. Three pips make one die."
                default=9
                minvalue=1
                maxvalue=25
                valuedice=charCheck (characterTable, withActions(injured (characterTable, Points), General.Actions))
                render=pointsToSkill(withActions(injured (characterTable, Points), General.Actions))
              }

          }
      }
    'Dexterity Skills' = keyvalues
        {
            description = "Skills for agility, aim and fighting."
            singular = "Dex Skill"
            editablekeys = character
            keys = ["Blaster", "Dodge", "Grenade", "Lightsaber","Melee", "Pick pocket"]
            valueType = custom
          {
              Points=integer
              {
                description = "Skill in pips, shown as dice. Untrained skills use the attribute."
                valuedice=charCheck (characterTable, withActions(injured (characterTable, Points + Attributes.'Dexterity'.Points), General.Actions))
                render=pointsToSkill(withActions(injured (characterTable, Points + Attributes.'Dexterity'.Points), General.Actions))
                default=0
                minvalue=0
                maxvalue=25
              }

          }
        }
    'Knowledge Skills' = keyvalues
        {
            description = "Skills for learning, lore and street smarts."
            singular = "Knowledge Skill"
            editablekeys = character
            keys = ["Alien species", "Bureaucracy", "Cultures", "Languages","Planetary systems", "Streetwise", "Survival"]
            valueType = custom
          {
              Points=integer
              {
                description = "Skill in pips, shown as dice. Untrained skills use the attribute."
                valuedice=charCheck (characterTable, withActions(injured (characterTable, Points + Attributes.'Knowledge'.Points), General.Actions))
                render=pointsToSkill(withActions(injured (characterTable, Points + Attributes.'Knowledge'.Points), General.Actions))
                
                default=0
                minvalue=0
                maxvalue=25
              }

          }
        }
    'Mechanical Skills' = keyvalues
        {
            description = "Skills for piloting, riding and operating ship systems."
            singular = "Mechanical Skill"
            editablekeys = character
            keys = ["Astrogation", "Beast riding", "Com scan", "Gunnery","Repulsorlift operation", "Shields", "Spaceship piloting"]
            valueType = custom
          {
              Points=integer
              {
                description = "Skill in pips, shown as dice. Untrained skills use the attribute."
                valuedice=charCheck (characterTable, withActions(injured (characterTable, Points + Attributes.'Mechanical'.Points), General.Actions))
                render=pointsToSkill(withActions(injured (characterTable, Points + Attributes.'Mechanical'.Points), General.Actions))
                
                default=0
                minvalue=0
                maxvalue=25
              }

          }
        }
    'Perception Skills' = keyvalues
        {
            description = "Skills for noticing, persuading and sneaking."
            singular = "Perception Skill"
            editablekeys = character
            keys = ["Bargain", "Con", "Gambling","Search", "Sneak"]
            valueType = custom
          {
              Points=integer
              {
                description = "Skill in pips, shown as dice. Untrained skills use the attribute."
                valuedice=charCheck (characterTable, withActions(injured (characterTable, Points + Attributes.'Perception'.Points), General.Actions))
                render=pointsToSkill(withActions(injured (characterTable, Points + Attributes.'Perception'.Points), General.Actions))
                
                default=0
                minvalue=0
                maxvalue=25
              }
          }
        }
    'Strength Skills' = keyvalues
        {
            description = "Skills for brawn and athletics."
            singular = "Strength Skill"
            editablekeys = character
            keys = ["Brawling", "Climbing jumping", "Lifting", "Swimming"]
            valueType = custom
          {
              Points=integer
              {
                description = "Skill in pips, shown as dice. Untrained skills use the attribute."
                valuedice=charCheck (characterTable, withActions(injured (characterTable, Points + Attributes.'Strength'.Points), General.Actions))
                render=pointsToSkill(withActions(injured (characterTable, Points + Attributes.'Strength'.Points), General.Actions))
                
                default=0
                minvalue=0
                maxvalue=25
              }

          }
        }
    'Technical Skills' = keyvalues
        {
            description = "Skills for repairing, programming and building."
            singular = "Technical Skill"
            editablekeys = character
            keys = ["Computer programming and repair", "Demolitions", "Droid programming and repair", "First aid", "Repulsorlift repair","Security","Spaceship repair"]
            valueType = custom
          {
              Points=integer
              {
                description = "Skill in pips, shown as dice. Untrained skills use the attribute."
                valuedice=charCheck (characterTable, withActions(injured (characterTable, Points + Attributes.'Technical'.Points), General.Actions))
                render=pointsToSkill(withActions(injured (characterTable, Points + Attributes.'Technical'.Points), General.Actions))
                
                default=0
                minvalue=0
                maxvalue=25
              }

          }
        }
     General = table{
              tableLayout = layout { columns = 4  size = wide }
              'Force Points'=integer
              {
                description = "Spend a Force Point to double all your dice for one round."
                default=0
                minvalue=0
                editable=live
              }
              'Dark Side Points'=integer
              {
                description = "Gained for using the Force in anger. Enough of them turn you to the dark side."
                default=0
                minvalue=0
                editable=live
              }
              'Character Points'=integer
              {
                description = "Spend after a roll to add a die that rerolls on a 6, or save them to improve skills."
                default=0
                minvalue=0
                editable=live
              }
              'Force sensitive' = bool
              {
                description = "Tick if the character can learn Jedi skills and Force powers."

              }
              Initiative=integer
              {
                description = "Initiative: roll Perception."
                value=Attributes.'Perception'.Points
                valuedice=starDice (injured (characterTable, Attributes.'Perception'.Points))
                render=pointsToSkill(injured (characterTable, Attributes.'Perception'.Points))
                editable=none
              }
              Actions = selector
              {
                description = "Actions this round. Each extra action takes 1D from every roll."
                options = ["1", "2", "3", "4", "5"]
                colors = ["white", "red", "red", "red", "red"]
                default = "1"
                editable=live
                save = nosave
              }
     }
    Injuries= table{
      description = "The character's current injury level."
      'None'= bool
          {
                  editable=live
                  radiogroup="injury"
                  default=false
          }
      'Stunned'= bool
          {
                  description = "Stunned: -1D on rolls for the rest of this round and the next."
                  editable=live
                  radiogroup="injury"
                  default=false
                  indicator="#d4b106"
          }
      'Wounded'= bool
          {
                  description = "Wounded: -1D on all rolls until healed."
                  editable=live
                  radiogroup="injury"
                  default=false
                  indicator="#e8913a"
          }
      'Wounded twice'= bool
          {
                  description = "Wounded twice: -2D on all rolls until healed."
                  editable=live
                  radiogroup="injury"
                  default=false
                  indicator="#e8913a"
          }
      'Incapacitated'= bool
          {
                  description = "Incapacitated: unconscious for some time."
                  editable=live
                  radiogroup="injury"
                  default=false
                  indicator="#555555"
          }
      'Mortally wounded'= bool
          {
                  description = "Mortally wounded: dying unless helped quickly."
                  editable=live
                  radiogroup="injury"
                  default=false
                  indicator="#d64545"
          }
      Heal = button
          {
                  description = "Moves the injury one level down, as after a successful healing roll or treatment."
                  editable=live
                  onClick = updates
                      {
                          (root.Injuries.'None') = not ('Wounded twice' or 'Incapacitated' or 'Mortally wounded')
                          (root.Injuries.'Stunned') = false
                          (root.Injuries.'Wounded') = 'Wounded twice'
                          (root.Injuries.'Wounded twice') = 'Incapacitated'
                          (root.Injuries.'Incapacitated') = 'Mortally wounded'
                          (root.Injuries.'Mortally wounded') = false
                          (root.Injuries.injury) = if 'Mortally wounded' then "Incapacitated" else if 'Incapacitated' then "Wounded twice" else if 'Wounded twice' then "Wounded" else "None"
                      }
          }
    }
       'Injury Levels'= table
        {
          description = "Damage roll minus Strength roll, and the injury it causes."
          'Stunned'="0 - 3"
          'Wounded'="4 - 8"
          'Incapacitated'="9 - 12"
          'Mortally wounded'="13 - 15"
          'Killed'="16+"
        }
    Difficulty=table{
      description = "Typical difficulty numbers to beat."
      'Very Easy' = "1 - 5"
      Easy = "6 - 10"
      Moderate = "11 - 15"
      Difficult = "16 - 20"
      'Very Difficult' = "21 - 30"
      Heroic = "31+"
    }

    'Jedi skills' = keyvalues
        {
          description = "Jedi skills for using the Force."
          visible=boolToVisible (General.'Force sensitive')
          singular = "Jedi skill"
          keys = ["Control","Sense","Alter"]
          valueType = custom
          {
              Points=integer
              {
                description = "Jedi skill in pips, shown as dice."
                valuedice=charCheck (characterTable, withActions(injured (characterTable, Points), General.Actions))
                render=pointsToSkill(withActions(injured (characterTable, Points), General.Actions))
                default=0
                minvalue=0
                maxvalue=25
              }

          }
        }
    'Force powers' = list
        {
          visible=boolToVisible (General.'Force sensitive')
          singular = "Force Power"
          source=secondary.'Force powers'
          editable = character
        }
    'Force power uses' = list
        {
          visible=boolToVisible (General.'Force sensitive')
          singular = "Force power use"
          source=forceUsesFor (characterTable)
          editable = none
          valueType = forcePowerUse
        }

    'Melee weapons' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Melee weapons'
        singular = "Melee weapon"
        editable = character
    }
    'Ranged weapons' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Ranged weapons'
        singular = "Ranged weapon"
        editable = character
    }
    Attacks = list
    {
        source = attacksFor (characterTable)
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }
    'Armour' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.Armour
        singular = "Armour"
        editable = character
    }
    'Other items' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Other items'
        singular = "Item"
        editable = character
    }
    Story = table
    {
      tableLayout = layout { size = wide }
      'Physical description' = string { multiline = true }
      Background = string { multiline = true }
      Personality = string { multiline = true }
      Objectives = string { multiline = true }
      'A quote' = string {}
      Connections = string { multiline = true }
    }
    'Spaceships' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.Spaceships
        singular = "Spaceship"
        editable = character
    }
}

meleeWeaponStats =ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
            }
            Stats= table
            {
                Damage=string
                {}
            }
        }
rangedWeaponStats =ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
            }
            Stats= table
            {
                Damage=string
                {}
                Ammo=string
                {}
                Range=string
                {}
            }
        }
armourStats= ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
            }
            Stats= table
            {
                'Armor Value'=string{}
            }
        }
otherStats= ruleset
        {
            Stats= table
            {
            }
        }

boolToVisible (flag)=
  if flag
    then visible
   else
      none

spaceshipTable= ruleset
        {
          Basics = table {
            Type =string{}
            Scale =string{}
            Length =string{}
            Skill =string{}
            crew =integer{}
            Maneuverability = string{}
            Space=integer{}
            Atmosphere= string{}
            Hull= string{}
            Shields= string{}
            Hyperdrive= string{}
          }
          Sensors =
            table
            {
              Passive = table {
                  Range=integer
                  {
                  }
                  Value=string
                  {
                  }}
              Scan = table {
                  Range=integer
                  {
                  }
                  Value=string
                  {
                  }}
              Search = table {
                  Range=integer
                  {
                  }
                  Value=string
                  {
                  }}
              Focus = table {
                  Range=integer
                  {
                  }
                  Value=string
                  {
                  }}
            }
          Weapons =
            list
            {
              singular = "Weapon"
              editable = character
              source=secondary.ShipWeapons
                  }
              }
      shipWeaponStats =ruleset
              {
            Stats= table
            {
                Skill= string{}
                'Fire Control'= string{}
                'Space Range'= string{}
                'Atmosphere Range'= string{}
                Damage= string{}
            }
        }

forcePowerStats= ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/spell.svg"
            }
                'Power'=keyvalues{
                  keys=["Sense","Control", "Alter"]
                  valueType = custom
                  {
                    Used = bool
                    {
                      default = false
                    }
                    Difficulty = string
                    {
                      visible=boolToVisible (Used)
                      keys=["Very Easy","Easy", "Moderate","Difficult","Very Difficult","Heroic"]
                    }
                  }
                }
                Details = table
                {
                  Effect=string{
                    multiline = true}
                  'Required Powers' = string
                  {
                  }
                  'Time to Use' = string{}
                  'Keep Up' = bool{}
                }

        }

Starwars = system
{
    hints = [
        hint
        {
            title = "Templates"
            topic = "Getting started"
            text = ["Let players start from a template idea such as smuggler, young Jedi or bounty hunter, then spend their attribute and skill dice to fit it."]
        },
        hint
        {
            title = "Initiative"
            topic = "Initiative"
            text = ["Call initiative and everyone rolls Perception. Highest goes first, and the Actions penalty does not apply."]
        },
        hint
        {
            title = "Multiple actions"
            topic = "Combat"
            text = ["Each extra action in a round costs 1D on every roll. Set Actions under General to how many actions a character takes this round."]
        },
        hint
        {
            title = "Damage against Strength"
            topic = "Combat"
            text = ["Damage rolls against Strength plus armour. The difference gives Stunned, Wounded, Incapacitated, Mortally wounded or Killed."]
        },
        hint
        {
            title = "Spaceships"
            topic = "Vehicles"
            text = ["Spaceships are their own entity type with ship weapons. Create the party's ship early so it can be placed on maps."]
        },
        hint
        {
            title = "Force points"
            topic = "Play"
            text = ["Force points double every die code for a round. Save them for heroic moments, and use the dark side when a character uses them in anger."]
        }
    ]
    distanceUnit = "m"
    squareSize = 2
    libraries = ["/systems/starwars/sw.json", "/systems/names/scifi.json", "/systems/tables/scifi.json"]
    nameSettings = [spaceNameSetting]
    characters = characterTable
    creatures = characterTable
    Spaceships = spaceshipTable
    ShipWeapons = shipWeaponStats
    'Ranged weapons'= rangedWeaponStats
    'Melee weapons'= meleeWeaponStats
    'Force powers' = forcePowerStats
    Armour= armourStats
    'Other items'= otherStats
    description="Starwars d6"
    secondaryTypes = ["Ranged weapons","Melee weapons","Armour","Spaceships","Other items","Force powers"]
    extraEntityTypes = [
      entityTypeDescription("Spaceships","spaceship",true, "/systems/starwars/spaceship-entity.svg", ["ShipWeapons"])
      ]
    cssFiles = ["/systems/starwars/starwars.css"]
    initiativeCompare(item1,item2) = compare (item1,item2)
    quickdice =[1d6]
}

