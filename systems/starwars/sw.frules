#include "/systems/common.frules"
#include "/systems/names/settings.frules"

pointsToSkill(points)=
 if points-points/3*3 > 0 then
                         toString(points/3)+"D+"+toString(points-points/3*3)
                         
                        else toString(points/3)+"D"
                        
withActions(points, actions)=
  max(min(points, 3), points - 3 * max(0, toInt(actions) - 1))

starResult (total, difficulty) =
    if difficulty > 0 then { Text = toString (total) + " vs " + toString (difficulty) + ": " + (if total >= difficulty then "Success" else "Failure")  Value = total  Outcome = if total >= difficulty then "Success" else "Failure" }
    else total

rethrow (extra) = ([dice { number = 1  sides = 6  color = "red"  label = "Wild" }],((baseline,throws)->
  if first (first (throws).rolls) == 6 then
    rethrow (extra + 6)
  else
    starResult (extra + sum (first (throws).rolls), asked)
  ))

oneOnWild (rolls) =
  if count (rolls) == 0 then
    0
  else
    sum (rolls) - max (rolls)

starDice (points) = ([dice { number = max (0, points / 3 - 1)  sides = 6  bonus = points - points / 3 * 3 }, dice { number = min (1, points / 3)  sides = 6  color = "red"  label = "Wild" }],((baseline,throws)->
  if count (item (1, throws).rolls) == 0 then
    starResult (first (throws).bonus, asked)
  else
    switch first (item (1, throws).rolls)
      case 6 then rethrow (sum (first (throws).rolls) + 6 + first (throws).bonus)
      case 1 then starResult (oneOnWild (first (throws).rolls) + first (throws).bonus, asked)
      else starResult (sum (first (throws).rolls) + sum (item (1, throws).rolls) + first (throws).bonus, asked)
  ))

starCheck (points) = ask ("Difficulty", starDice (points))

noSkill = { Points = 0 }

dexterityPoints (char, skill) =
    valueOr (valueOr (char.'Dexterity Skills', skill, noSkill), "Points", 0) + valueOr (valueOr (char.Attributes, "Dexterity", noSkill), "Points", 9)

meleeSkill (weapon) =
    if contains (toLower (weapon.Name), "lightsaber") then
        "Lightsaber"
    else
        "Melee"

rangedSkill (weapon) =
    if contains (toLower (weapon.Name), "grenade") then
        "Grenade"
    else
        if contains (toLower (weapon.Name), "detonator") then
            "Grenade"
        else
            "Blaster"

longRange (text) = toInt (first (reverse (split ("/", text))))

weaponAttack (name, points, damage, kind, distance) = custom
{
    Name = name
    Attack = integer
    {
        value = points
        valuedice = starCheck (points)
        render = pointsToSkill (points)
        action = kind
        range = distance
    }
    Damage = string
    {
        value = damage
    }
}

attackPoints (char, skill) =
    withActions (dexterityPoints (char, skill), valueOr (char.General, "Actions", "1"))

notUsed = { Used = false  Difficulty = "" }

noPoints = { Points = 0 }

forcePowerSkill (power, skill) = valueOr (power.data.forcePowerStats.Power, skill, notUsed)

jediPoints (char, skill) =
    withActions (valueOr (valueOr (char.'Jedi skills', skill, noPoints), "Points", 0), valueOr (char.General, "Actions", "1"))

forcePowerUse (name, points, difficulty) = custom
{
    Name = name
    Roll = integer
    {
        value = points
        valuedice = starCheck (points)
        render = pointsToSkill (points)
        action = "ranged"
    }
    Difficulty = difficulty
}

forceUsesWith (char, skill) =
    map ((power)->forcePowerUse (power.Name + " (" + skill + ")", jediPoints (char, skill), valueOr (forcePowerSkill (power, skill), "Difficulty", "")),
        filter ((power)->valueOr (forcePowerSkill (power, skill), "Used", false), char.'Force powers'))

forceUsesFor (char) =
    concat (forceUsesWith (char, "Control"), concat (forceUsesWith (char, "Sense"), forceUsesWith (char, "Alter")))

attacksFor (char) =
    concat (
        map ((weapon)->weaponAttack (weapon.Name, attackPoints (char, meleeSkill (weapon)), valueOr (weapon.data.meleeWeaponStats.Stats, "Damage", ""), "melee", 0), char.'Melee weapons'),
        map ((weapon)->weaponAttack (weapon.Name, attackPoints (char, rangedSkill (weapon)), valueOr (weapon.data.rangedWeaponStats.Stats, "Damage", ""), "ranged", longRange (valueOr (weapon.data.rangedWeaponStats.Stats, "Range", ""))), char.'Ranged weapons'))

characterTable = ruleset
{
    Profile = table
    {
      tableLayout = layout { columns = 4  size = wide }
      Type = string {}
      Species = string {}
      Gender = string {}
      Age = string {}
      Height = string {}
      Weight = string {}
      Move = integer
      {
        default = 10
        minvalue = 0
      }
    }
  'Attributes' = keyvalues
      {
          tableLayout = layout { columns = 3  size = wide }
          singular = "Attribute"
          keys = ["Dexterity","Knowledge","Mechanical","Perception","Strength","Technical" ]
          valueType = custom
          {
              Points=integer
              {
                default=9
                minvalue=1
                maxvalue=25
                valuedice=starCheck (withActions(Points, General.Actions))
                render=pointsToSkill(withActions(Points, General.Actions))
              }

          }
      }
    'Dexterity Skills' = keyvalues
        {
            singular = "Dex Skill"
            editablekeys = character
            keys = ["Blaster", "Dodge", "Grenade", "Lightsaber","Melee", "Pick pocket"]
            valueType = custom
          {
              Points=integer
              {
                valuedice=starCheck (withActions(Points + Attributes.'Dexterity'.Points, General.Actions))
                render=pointsToSkill(withActions(Points + Attributes.'Dexterity'.Points, General.Actions))
                default=0
                minvalue=0
                maxvalue=25
              }

          }
        }
    'Knowledge Skills' = keyvalues
        {
            singular = "Knowledge Skill"
            editablekeys = character
            keys = ["Alien species", "Bureaucracy", "Cultures", "Languages","Planetary systems", "Streetwise", "Survival"]
            valueType = custom
          {
              Points=integer
              {
                valuedice=starCheck (withActions(Points + Attributes.'Knowledge'.Points, General.Actions))
                render=pointsToSkill(withActions(Points + Attributes.'Knowledge'.Points, General.Actions))
                
                default=0
                minvalue=0
                maxvalue=25
              }

          }
        }
    'Mechanical Skills' = keyvalues
        {
            singular = "Mechanical Skill"
            editablekeys = character
            keys = ["Astrogation", "Beast riding", "Com scan", "Gunnery","Repulsorlift operation", "Shields", "Spaceship piloting"]
            valueType = custom
          {
              Points=integer
              {
                valuedice=starCheck (withActions(Points + Attributes.'Mechanical'.Points, General.Actions))
                render=pointsToSkill(withActions(Points + Attributes.'Mechanical'.Points, General.Actions))
                
                default=0
                minvalue=0
                maxvalue=25
              }

          }
        }
    'Perception Skills' = keyvalues
        {
            singular = "Perception Skill"
            editablekeys = character
            keys = ["Bargain", "Con", "Gambling","Search", "Sneak"]
            valueType = custom
          {
              Points=integer
              {
                valuedice=starCheck (withActions(Points + Attributes.'Perception'.Points, General.Actions))
                render=pointsToSkill(withActions(Points + Attributes.'Perception'.Points, General.Actions))
                
                default=0
                minvalue=0
                maxvalue=25
              }
          }
        }
    'Strength Skills' = keyvalues
        {
            singular = "Strength Skill"
            editablekeys = character
            keys = ["Brawling", "Climbing jumping", "Lifting", "Swimming"]
            valueType = custom
          {
              Points=integer
              {
                valuedice=starCheck (withActions(Points + Attributes.'Strength'.Points, General.Actions))
                render=pointsToSkill(withActions(Points + Attributes.'Strength'.Points, General.Actions))
                
                default=0
                minvalue=0
                maxvalue=25
              }

          }
        }
    'Technical Skills' = keyvalues
        {
            singular = "Technical Skill"
            editablekeys = character
            keys = ["Computer programming and repair", "Demolitions", "Droid programming and repair", "First aid", "Repulsorlift repair","Security","Spaceship repair"]
            valueType = custom
          {
              Points=integer
              {
                valuedice=starCheck (withActions(Points + Attributes.'Technical'.Points, General.Actions))
                render=pointsToSkill(withActions(Points + Attributes.'Technical'.Points, General.Actions))
                
                default=0
                minvalue=0
                maxvalue=25
              }

          }
        }
     General = table{
              tableLayout = layout { columns = 4  size = wide }
              'Force Points'=integer
              {
                default=0
                minvalue=0
              }
              'Dark Side Points'=integer
              {
                default=0
                minvalue=0
              }
              'Character Points'=integer
              {
                default=0
                minvalue=0
              }
              'Force sensitive' = bool
              {

              }
              Initiative=integer
              {
                value=Attributes.'Perception'.Points
                valuedice=starDice (Attributes.'Perception'.Points)
                render=pointsToSkill(Attributes.'Perception'.Points)
                editable=none
              }
              Actions = selector
              {
                options = ["1", "2", "3", "4", "5"]
                colors = ["white", "red", "red", "red", "red"]
                default = "1"
                editable=live
                save = nosave
              }
     }
    Injuries= table{
      'None'= bool
          {
                  editable=live
                  radiogroup="injury"
          }
      'Stunned'= bool
          {
                  editable=live
                  radiogroup="injury"
                  indicator="#d4b106"
          }
      'Wounded'= bool
          {
                  editable=live
                  radiogroup="injury"
                  indicator="#e8913a"
          }
      'Wounded twice'= bool
          {
                  editable=live
                  radiogroup="injury"
                  indicator="#e8913a"
          }
      'Incapacitated'= bool
          {
                  editable=live
                  radiogroup="injury"
                  indicator="#555555"
          }
      'Mortally wounded'= bool
          {
                  editable=live
                  radiogroup="injury"
                  indicator="#d64545"
          }
    }
       'Injury Levels'= table
        {
          'Stunned'="0 - 3"
          'Wounded'="4 - 8"
          'Incapacitated'="9 - 12"
          'Mortally wounded'="13 - 15"
          'Killed'="16+"
        }
    Difficulty=table{
      'Very Easy' = "1 - 5"
      Easy = "6 - 10"
      Moderate = "11 - 15"
      Difficult = "16 - 20"
      'Very Difficult' = "21 - 30"
      Heroic = "31+"
    }

    'Jedi skills' = keyvalues
        {
          visible=boolToVisible (General.'Force sensitive')
          singular = "Jedi skill"
          keys = ["Control","Sense","Alter"]
          valueType = custom
          {
              Points=integer
              {
                valuedice=starCheck (withActions(Points, General.Actions))
                render=pointsToSkill(withActions(Points, General.Actions))
                default=0
                minvalue=0
                maxvalue=25
              }

          }
        }
    'Force powers' = list
        {
          visible=boolToVisible (General.'Force sensitive')
          singular = "Force Power"
          source=secondary.'Force powers'
          editable = character
        }
    'Force power uses' = list
        {
          visible=boolToVisible (General.'Force sensitive')
          singular = "Force power use"
          source=forceUsesFor (characterTable)
          editable = none
          valueType = forcePowerUse
        }

    'Melee weapons' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Melee weapons'
        singular = "Melee weapon"
        editable = character
    }
    'Ranged weapons' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Ranged weapons'
        singular = "Ranged weapon"
        editable = character
    }
    Attacks = list
    {
        source = attacksFor (characterTable)
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }
    'Armour' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.Armour
        singular = "Armour"
        editable = character
    }
    'Other items' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.'Other items'
        singular = "Item"
        editable = character
    }
    Story = table
    {
      tableLayout = layout { size = wide }
      'Physical description' = string { multiline = true }
      Background = string { multiline = true }
      Personality = string { multiline = true }
      Objectives = string { multiline = true }
      'A quote' = string {}
      Connections = string { multiline = true }
    }
    'Spaceships' = list
    {
        tableLayout = layout
        {
        }
        source=secondary.Spaceships
        singular = "Spaceship"
        editable = character
    }
}

meleeWeaponStats =ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
            }
            Stats= table
            {
                Damage=string
                {}
            }
        }
rangedWeaponStats =ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
            }
            Stats= table
            {
                Damage=string
                {}
                Ammo=string
                {}
                Range=string
                {}
            }
        }
armourStats= ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/armour.svg"
            }
            Stats= table
            {
                'Armor Value'=string{}
            }
        }
otherStats= ruleset
        {
            Stats= table
            {
            }
        }

boolToVisible (flag)=
  if flag
    then visible
   else
      none

spaceshipTable= ruleset
        {
          Basics = table {
            Type =string{}
            Scale =string{}
            Length =string{}
            Skill =string{}
            crew =integer{}
            Maneuverability = string{}
            Space=integer{}
            Atmosphere= string{}
            Hull= string{}
            Shields= string{}
            Hyperdrive= string{}
          }
          Sensors =
            table
            {
              Passive = table {
                  Range=integer
                  {
                  }
                  Value=string
                  {
                  }}
              Scan = table {
                  Range=integer
                  {
                  }
                  Value=string
                  {
                  }}
              Search = table {
                  Range=integer
                  {
                  }
                  Value=string
                  {
                  }}
              Focus = table {
                  Range=integer
                  {
                  }
                  Value=string
                  {
                  }}
            }
          Weapons =
            list
            {
              singular = "Weapon"
              editable = character
              source=secondary.ShipWeapons
                  }
              }
      shipWeaponStats =ruleset
              {
            Stats= table
            {
                Skill= string{}
                'Fire Control'= string{}
                'Space Range'= string{}
                'Atmosphere Range'= string{}
                Damage= string{}
            }
        }

forcePowerStats= ruleset
        {
            rulesetConfiguration =
            {
                defaultImage = "/images/spell.svg"
            }
                'Power'=keyvalues{
                  keys=["Sense","Control", "Alter"]
                  valueType = custom
                  {
                    Used = bool
                    {
                      default = false
                    }
                    Difficulty = string
                    {
                      visible=boolToVisible (Used)
                      keys=["Very Easy","Easy", "Moderate","Difficult","Very Difficult","Heroic"]
                    }
                  }
                }
                Details = table
                {
                  Effect=string{
                    multiline = true}
                  'Required Powers' = string
                  {
                  }
                  'Time to Use' = string{}
                  'Keep Up' = bool{}
                }

        }

Starwars = system
{
    hints = [
        hint
        {
            title = "Templates"
            topic = "Getting started"
            text = ["Let players start from a template idea such as smuggler, young Jedi or bounty hunter, then spend their attribute and skill dice to fit it."]
        },
        hint
        {
            title = "Initiative"
            topic = "Initiative"
            text = ["Call initiative and everyone rolls Perception. Highest goes first, and the Actions penalty does not apply."]
        },
        hint
        {
            title = "Multiple actions"
            topic = "Combat"
            text = ["Each extra action in a round costs 1D on every roll. Set Actions under General to how many actions a character takes this round."]
        },
        hint
        {
            title = "Damage against Strength"
            topic = "Combat"
            text = ["Damage rolls against Strength plus armour. The difference gives Stunned, Wounded, Incapacitated, Mortally wounded or Killed."]
        },
        hint
        {
            title = "Spaceships"
            topic = "Vehicles"
            text = ["Spaceships are their own entity type with ship weapons. Create the party's ship early so it can be placed on maps."]
        },
        hint
        {
            title = "Force points"
            topic = "Play"
            text = ["Force points double every die code for a round. Save them for heroic moments, and use the dark side when a character uses them in anger."]
        }
    ]
    distanceUnit = "m"
    squareSize = 2
    libraries = ["/systems/starwars/sw.json", "/systems/names/scifi.json"]
    nameSettings = [spaceNameSetting]
    characters = characterTable
    creatures = characterTable
    Spaceships = spaceshipTable
    ShipWeapons = shipWeaponStats
    'Ranged weapons'= rangedWeaponStats
    'Melee weapons'= meleeWeaponStats
    'Force powers' = forcePowerStats
    Armour= armourStats
    'Other items'= otherStats
    description="Starwars d6"
    secondaryTypes = ["Ranged weapons","Melee weapons","Armour","Spaceships","Other items","Force powers"]
    extraEntityTypes = [
      entityTypeDescription("Spaceships","spaceship",true, "/systems/starwars/spaceship-entity.svg", ["ShipWeapons"])
      ]
    cssFiles = ["/systems/starwars/starwars.css"]
    initiativeCompare(item1,item2) = compare (item1,item2)
    quickdice =[1d6]
}

