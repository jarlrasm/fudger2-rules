#include "/systems/common.frules"
#include "/systems/names/settings.frules"
#include "/systems/genesys/dice.frules"

checkPool (char, characteristic, ranks) =
    genesysPool (
        upgradedPool (min (characteristic, ranks), max (characteristic, ranks) - min (characteristic, ranks), char.Check.Upgrades).Yellow,
        upgradedPool (min (characteristic, ranks), max (characteristic, ranks) - min (characteristic, ranks), char.Check.Upgrades).Green,
        char.Check.Boost,
        char.Check.Challenge,
        char.Check.Difficulty,
        char.Check.Setback)

characteristicValue (char, name) =
    switch name
        case "Brawn" then char.Characteristics.Brawn
        case "Agility" then char.Characteristics.Agility
        case "Intellect" then char.Characteristics.Intellect
        case "Cunning" then char.Characteristics.Cunning
        case "Willpower" then char.Characteristics.Willpower
        else char.Characteristics.Presence

characteristicNames = ["Brawn", "Agility", "Intellect", "Cunning", "Willpower", "Presence"]

skill (usual) = custom
{
    Career = bool { description = "Career skills cost less experience to raise." default = false }
    Rank = integer { description = "Skill ranks from 0 to 5. Ranks upgrade green ability dice to yellow proficiency dice." default = 0  minvalue = 0  maxvalue = 5 }
    Characteristic = string { description = "The characteristic used for this check, normally the usual one." default = usual  keys = characteristicNames  editable = live }
    Pool = integer { description = "Dice pool: the higher of rank and characteristic in dice, the lower of them upgraded." value = max (Rank, characteristicValue (characterTable, Characteristic))  valuedice = checkPool (characterTable, characteristicValue (characterTable, Characteristic), Rank)  editable = none  render = toString (min (Rank, characteristicValue (characterTable, Characteristic))) + "Y " + toString (max (Rank, characteristicValue (characterTable, Characteristic)) - min (Rank, characteristicValue (characterTable, Characteristic))) + "G" }
}

noSkill = { Rank = 0 }

rankOf (char, name) = valueOr (valueOr (char.Skills, name, noSkill), "Rank", 0)

weaponStat (weapon, field) = valueOr (weapon.data.weaponStats.Stats, field, "")

rangeMetres (band) =
    switch band
        case "Engaged" then 2
        case "Short" then 10
        case "Medium" then 40
        case "Long" then 100
        case "Extreme" then 1000
        else 2

weaponAttack (name, characteristic, ranks, damage, kind, distance) = custom
{
    Name = name
    Check = integer { value = max (characteristic, ranks)  valuedice = checkPool (characterTable, characteristic, ranks)  action = kind  reach = 2  range = distance }
    Damage = damage
    Critical = string {}
}

weaponSkillCharacteristic (skillName) =
    if skillName == "Ranged" or skillName == "Gunnery" then "Agility"
    else "Brawn"

attackFor (char, weapon) =
    weaponAttack (weapon.Name,
        characteristicValue (char, weaponSkillCharacteristic (weaponStat (weapon, "Skill"))),
        rankOf (char, weaponStat (weapon, "Skill")),
        weaponStat (weapon, "Damage") + " (Crit " + weaponStat (weapon, "Critical") + ")",
        if weaponStat (weapon, "Range") == "Engaged" or weaponStat (weapon, "Range") == "" then "melee" else "ranged",
        rangeMetres (weaponStat (weapon, "Range")))

characterTable = ruleset
{
    rulesetConfiguration = { important = [Characteristics, Status, Attacks] }
    Character = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Archetype = string { description = "The character's species or background type, which sets starting characteristics." }
        Career = string {}
        Setting = string { keys = ["Fantasy", "Steampunk", "Weird War", "Modern", "Science Fiction", "Space Opera"] }
        Motivation = string { description = "What drives the character: a desire, a fear, a strength or a flaw." multiline = true }
        'Total XP' = integer { description = "All experience earned so far." default = 0 }
        'Available XP' = integer { description = "Experience left to spend." default = 0  editable = live }
        Money = integer { default = 0  editable = live }
        'Story Points' = integer { description = "Spend one to upgrade a die in your pool, or pass it to the GM for later." default = 0  editable = live  indicator = "#3a7bd5" }
    }

    Check = table
    {
        description = "Extra dice for the next check: purple difficulty, red challenge, black setback, blue boost."
        tableLayout = layout { columns = 5  size = wide }
        Difficulty = integer { description = "Purple difficulty dice, from 1 for easy to 5 for formidable." default = 2  minvalue = 0  maxvalue = 5  editable = live }
        Challenge = integer { description = "Red challenge dice: difficulty dice upgraded by the GM." default = 0  minvalue = 0  maxvalue = 5  editable = live }
        Setback = integer { description = "Black setback dice from bad conditions." default = 0  minvalue = 0  maxvalue = 5  editable = live }
        Boost = integer { description = "Blue boost dice from good conditions." default = 0  minvalue = 0  maxvalue = 5  editable = live }
        Upgrades = integer { description = "How many dice in your pool to upgrade." default = 0  minvalue = 0  maxvalue = 5  editable = live }
    }

    Characteristics = table
    {
        tableLayout = layout { columns = 6  size = wide }
        Brawn = integer { description = "Physical strength and toughness." default = 2  minvalue = 1  maxvalue = 6  valuedice = checkPool (characterTable, Brawn, 0) }
        Agility = integer { description = "Speed, coordination and aim." default = 2  minvalue = 1  maxvalue = 6  valuedice = checkPool (characterTable, Agility, 0) }
        Intellect = integer { description = "Intelligence and learning." default = 2  minvalue = 1  maxvalue = 6  valuedice = checkPool (characterTable, Intellect, 0) }
        Cunning = integer { description = "Cleverness, street smarts and guile." default = 2  minvalue = 1  maxvalue = 6  valuedice = checkPool (characterTable, Cunning, 0) }
        Willpower = integer { description = "Discipline and self-control." default = 2  minvalue = 1  maxvalue = 6  valuedice = checkPool (characterTable, Willpower, 0) }
        Presence = integer { description = "Charisma and leadership." default = 2  minvalue = 1  maxvalue = 6  valuedice = checkPool (characterTable, Presence, 0) }
    }

    Status = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Soak = integer { description = "Damage stopped from each hit: Brawn plus armor." value = Characteristics.Brawn + Armor  editable = none }
        Armor = integer { default = 0 }
        'Wound Threshold' = integer { description = "Wounds beyond this incapacitate the character." default = 10 + Characteristics.Brawn }
        Wounds = integer { description = "Wounds taken. Beyond the threshold you are out and suffer a critical injury." default = 0  minvalue = 0  editable = live }
        'Strain Threshold' = integer { description = "Strain beyond this knocks the character out." default = 10 + Characteristics.Willpower }
        Strain = integer { description = "Strain taken from stress, effort and talents." default = 0  minvalue = 0  editable = live }
        'Night of rest' = button { description = "A full night's rest heals one wound and all strain. Critical injuries need medical care."  editable = live  onClick = updates
            {
                (root.Status.Wounds) = max (0, Wounds - 1)
                (root.Status.Strain) = 0
            }
        }
        'Melee Defense' = integer { description = "Upgrades the difficulty of melee attacks against you." default = 0 }
        'Ranged Defense' = integer { description = "Upgrades the difficulty of ranged attacks against you." default = 0 }
        Incapacitated = string { value = if Wounds > 'Wound Threshold' then "Incapacitated" else if Strain > 'Strain Threshold' then "Incapacitated by strain" else ""  visible = none  indicator = "#d64545" }
        'Critical Injuries' = string { description = "Lasting injuries from critical hits, with their effects." multiline = true  editable = live }
        'Initiative Cool' = integer { description = "Initiative check when you are ready for a fight: Cool plus Presence." value = rankOf (characterTable, "Cool")  valuedice = initiativePool (Characteristics.Presence, rankOf (characterTable, "Cool"))  editable = none }
        Initiative = integer { description = "Initiative check when you are caught by surprise: Vigilance plus Willpower." value = rankOf (characterTable, "Vigilance")  valuedice = initiativePool (Characteristics.Willpower, rankOf (characterTable, "Vigilance"))  editable = none }
    }

    Skills = table
    {
        description = "Skills, each linked to a characteristic. Roll a pool built from both."
        tableLayout = layout { columns = 2  size = wide }
        Alchemy = skill ("Intellect")
        Astrocartography = skill ("Intellect")
        Athletics = skill ("Brawn")
        Computers = skill ("Intellect")
        Cool = skill ("Presence")
        Coordination = skill ("Agility")
        Discipline = skill ("Willpower")
        Driving = skill ("Agility")
        Mechanics = skill ("Intellect")
        Medicine = skill ("Intellect")
        Operating = skill ("Intellect")
        Perception = skill ("Cunning")
        Piloting = skill ("Agility")
        Resilience = skill ("Brawn")
        Riding = skill ("Agility")
        Skulduggery = skill ("Cunning")
        Stealth = skill ("Agility")
        Streetwise = skill ("Cunning")
        Survival = skill ("Cunning")
        Vigilance = skill ("Willpower")
        Brawl = skill ("Brawn")
        Gunnery = skill ("Agility")
        Melee = skill ("Brawn")
        Ranged = skill ("Agility")
        Charm = skill ("Presence")
        Coercion = skill ("Willpower")
        Deception = skill ("Cunning")
        Leadership = skill ("Presence")
        Negotiation = skill ("Presence")
        Knowledge = skill ("Intellect")
        Arcana = skill ("Intellect")
        Divine = skill ("Willpower")
        Primal = skill ("Cunning")
    }

    Talents = list
    {
        description = "Special abilities bought with experience."
        tableLayout = layout { size = wide }
        source = secondary.Talents
        singular = "Talent"
        editable = character
    }

    Weapons = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        source = concat ([weaponAttack ("Unarmed", Characteristics.Brawn, rankOf (characterTable, "Brawl"), toString (Characteristics.Brawn) + " (Crit 5)", "melee", 2)], map ((weapon)->attackFor (characterTable, weapon), characterTable.Weapons))
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }

    Gear = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Gear
        singular = "Item"
        editable = character
    }

    Description = table
    {
        tableLayout = layout { columns = 2  size = wide }
        Appearance = string { multiline = true }
        Notes = string { multiline = true }
    }
}

creatureTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg"  important = [Stats] }
    Stats = table
    {
        tableLayout = layout { columns = 3  size = wide }
        Kind = string { description = "Minions die fast, rivals hold out, nemeses match the heroes." default = "Rival"  keys = ["Minion", "Rival", "Nemesis"] }
        Brawn = integer { default = 2 }
        Agility = integer { default = 2 }
        Intellect = integer { default = 2 }
        Cunning = integer { default = 2 }
        Willpower = integer { default = 2 }
        Presence = integer { default = 2 }
        Soak = integer { description = "Damage stopped from each hit." default = 3 }
        'Wound Threshold' = integer { description = "Wounds beyond this defeat the adversary." default = 12 }
        Wounds = integer { description = "Wounds taken." default = 0  editable = live  indicator = "#d64545" }
        'Melee Defense' = integer { default = 0 }
        'Ranged Defense' = integer { default = 0 }
        Initiative = integer { default = 0  valuedice = initiativePool (2, 1) }
    }
    'Skill Pools' = keyvalues
    {
        singular = "Skill"
        editablekeys = character
        keys = ["Melee", "Ranged", "Vigilance"]
        valueType = custom
        {
            Yellow = integer { default = 1  minvalue = 0 }
            Green = integer { default = 1  minvalue = 0 }
            Roll = integer { value = Yellow + Green  valuedice = genesysPool (Yellow, Green, 0, 0, 2, 0)  editable = none  action = if Key == "Ranged" then "ranged" else if Key == "Vigilance" then "" else "melee"  reach = 2 }
        }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        Abilities = string { multiline = true }
        Equipment = string { multiline = true }
    }
}

weaponStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Skill = string { keys = ["Brawl", "Melee", "Ranged", "Gunnery"] }
        Damage = string {}
        Critical = string {}
        Range = string { keys = ["Engaged", "Short", "Medium", "Long", "Extreme"] }
        Encumbrance = string {}
        Price = string {}
        Rarity = string {}
        Special = string {}
    }
}

gearStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Defense = string {}
        Soak = string {}
        Encumbrance = string {}
        Price = string {}
        Rarity = string {}
    }
}

talentStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        sortedBy = sort { prefix = "Tier" sort = Stats.Tier }
    }
    Stats = table
    {
        Tier = integer { default = 1  minvalue = 1  maxvalue = 5 }
        Activation = string { keys = ["Passive", "Active (Incidental)", "Active (Maneuver)", "Active (Action)", "Active (Incidental, Out of Turn)"] }
        Ranked = bool { default = false }
    }
}

Genesys = system
{
    hints = [
        hint
        {
            title = "Setting"
            topic = "Getting started"
            text = ["Genesys fits any setting. Choose one, then the skills, talents and gear that suit it."]
        },
        hint
        {
            title = "Narrative dice"
            topic = "Play"
            text = ["Set Difficulty, Challenge, Setback, Boost and Upgrades in the Check row, then roll. Successes cancel failures and advantages cancel threats."]
        },
        hint
        {
            title = "Story points"
            topic = "Play"
            text = ["Players and the GM share a pool of Story Points to upgrade dice or add details."]
        },
        hint
        {
            title = "Initiative"
            topic = "Initiative"
            text = ["Roll Initiative (Vigilance) or Initiative Cool to join the list; successes, then advantages, set the order."]
        }
    ]
    distanceUnit = "m"
    characters = characterTable
    creatures = creatureTable
    Weapons = weaponStats
    Gear = gearStats
    Talents = talentStats
    secondaryTypes = ["Weapons", "Gear", "Talents"]
    description = "Genesys: narrative dice for any setting, with successes, advantages and triumphs"
    initiativeCompare (item1, item2) = compare (initiativeOrder (item1), initiativeOrder (item2))
    quickdice = [1d8, 1d12, 1d6, 1d100]
    cssFiles = ["/systems/genesys/genesys.css"]
    libraries = ["/systems/names/fantasy.json", "/systems/names/scifi.json", "/systems/names/victorian.json", "/systems/names/cyberpunk.json", "/systems/names/spies.json"]
    nameSettings = [fantasyNameSetting, spaceNameSetting, gaslightNameSetting, neonStreetsNameSetting, spyThrillerNameSetting]
}
