#include "/systems/common.frules"
#include "/systems/names/settings.frules"

iconsIn (rolls) = sum (map ((x)->if x == 6 then 2 else if x > 3 then 1 else 0, rolls))

sixesIn (rolls) = count (filter ((x)->x == 6, rolls))

wrathNote (wrath) =
    if count (wrath) == 0 then ""
    else if first (wrath) == 6 then ", Wrath Critical: gain Glory"
    else if first (wrath) == 1 then ", Complication"
    else ""

shiftsOf (icons, sixes, dn) = max (0, min (sixes, (icons - dn) / 2))

wgText (icons, sixes, dn, wrath) =
    toString (icons) + (if icons == 1 then " icon" else " icons")
    + (if dn > 0 then " vs DN " + toString (dn) + (if icons >= dn then ": success" + (if shiftsOf (icons, sixes, dn) > 0 then ", " + toString (shiftsOf (icons, sixes, dn)) + " to shift" else "") else ": failure") else "")
    + wrathNote (wrath)

wgOutcome (icons, dn, wrath) =
    if count (wrath) > 0 and first (wrath) == 6 and (dn < 1 or icons >= dn) then "Critical"
    else if dn < 1 then (if count (wrath) > 0 and first (wrath) == 1 then "Complication" else "")
    else if icons >= dn then "Success"
    else "Failure"

failedIn (rolls) = count (filter ((x)->x < 4, rolls))

wgResult (normal, wrath, dn, canReroll, spend) =
{
    Text = wgText (iconsIn (normal) + iconsIn (wrath), sixesIn (normal) + sixesIn (wrath), dn, wrath)
    Value = iconsIn (normal) + iconsIn (wrath)
    Outcome = wgOutcome (iconsIn (normal) + iconsIn (wrath), dn, wrath)
    Push = if canReroll and failedIn (normal) + failedIn (wrath) > 0 then wgReroll (filter ((x)->x > 3, normal), filter ((x)->x > 3, wrath), failedIn (normal), failedIn (wrath), dn) else 0
    PushLabel = "Spend Wrath to reroll failures"
    PushSets = spend
}

wgReroll (keptNormal, keptWrath, normalRerolls, wrathRerolls, dn) = ([dice { number = normalRerolls  sides = 6  label = "Reroll" }, dice { number = wrathRerolls  sides = 6  color = "red"  label = if wrathRerolls > 0 then "Wrath" else "" }],
    ((baseline, throws)->wgResult (concat (keptNormal, first (throws).rolls), concat (keptWrath, item (1, throws).rolls), dn, false, [])))

wgPool (pool, dn) = ([dice { number = max (0, pool - 1)  sides = 6 }, dice { number = min (1, max (0, pool))  sides = 6  color = "red"  label = "Wrath" }],
    ((baseline, throws)->wgResult (first (throws).rolls, item (1, throws).rolls, dn, false, [])))

wgAsked (pool, canReroll, spend) = ([dice { number = max (0, pool - 1)  sides = 6 }, dice { number = min (1, max (0, pool))  sides = 6  color = "red"  label = "Wrath" }],
    ((baseline, throws)->wgResult (first (throws).rolls, item (1, throws).rolls, asked, canReroll, spend)))

wgDice (pool) = ask ("DN", wgAsked (pool, false, []))

wrathSpend (char) = [{ Field = "characterTable.Traits.Wrath"  Value = char.Traits.Wrath - 1 }]

wgHeroDice (char, pool) = ask ("DN", wgAsked (pool, char.Traits.Wrath > 0, wrathSpend (char)))

edDamage (rolls) = sum (map ((x)->if x == 6 then 2 else if x > 3 then 1 else 0, rolls))

edRoll (base, extra) = ([dice { number = max (0, extra)  sides = 6  label = "ED" }],
    ((baseline, throws)->{
        Text = toString (base + edDamage (first (throws).rolls)) + " damage"
        Value = base + edDamage (first (throws).rolls)
    }))

skill (attr) = custom
{
    Rating = integer { description = "Skill rating from 0 to 8, added to the attribute for the dice pool." default = 0  minvalue = 0  maxvalue = 8 }
    Pool = integer { description = "Dice pool: attribute plus skill. Each 4 or 5 is one icon, each 6 two." value = attr + Rating  valuedice = wgHeroDice (characterTable, attr + Rating)  editable = none }
}

poolOf (char, name) = valueOr (valueOr (char.Skills, name, noSkill), "Pool", 0)

noSkill = { Pool = 0 }

weaponStat (weapon, field) = valueOr (weapon.data.weaponStats.Stats, field, "")

firstNumber (text) = bonusWithValue ([[text]], "^[^0-9]*([0-9]+)")

weaponAttack (name, pool, damage, extra, kind, distance) = custom
{
    Name = name
    Pool = integer { value = pool  valuedice = wgHeroDice (characterTable, pool)  action = kind  reach = 2  range = distance }
    Damage = integer { description = "The weapon's damage plus its extra damage dice: 4 or 5 adds 1, 6 adds 2." value = damage  valuedice = edRoll (damage, extra)  render = toString (damage) + " ED " + toString (extra)  editable = none }
}

attackFor (char, weapon) =
    if weaponStat (weapon, "Kind") == "Ranged" then
        weaponAttack (weapon.Name, poolOf (char, "Ballistic Skill"), toInt (weaponStat (weapon, "Damage")), toInt (weaponStat (weapon, "ED")), "ranged", firstNumber (weaponStat (weapon, "Range")))
    else
        weaponAttack (weapon.Name, poolOf (char, "Weapon Skill"), toInt (weaponStat (weapon, "Damage")) + char.Attributes.Strength, toInt (weaponStat (weapon, "ED")), "melee", 2)

characterTable = ruleset
{
    rulesetConfiguration = { important = [Attributes, Traits, Attacks] }
    Character = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Species = string { keys = ["Human", "Adeptus Astartes", "Primaris Astartes", "Aeldari", "Ork", "Squat", "Ratling", "Ogryn"] }
        Archetype = string {}
        Faction = string {}
        Tier = integer { description = "Tier of play: how powerful the campaign's heroes are." default = 1  minvalue = 1  maxvalue = 5 }
        Rank = integer { description = "Rank within the tier, gained from experience." default = 1  minvalue = 1  maxvalue = 5 }
        Keywords = string { description = "Keywords that tie the character to factions, faiths and gear." }
        Background = string { multiline = true }
    }

    Attributes = table
    {
        description = "The seven attributes, rolled as dice pools."
        tableLayout = layout { columns = 7  size = wide }
        Strength = integer { description = "Muscle, lifting and melee damage." default = 2  minvalue = 1  maxvalue = 12  valuedice = wgHeroDice (characterTable, Strength) }
        Toughness = integer { description = "Endurance and resisting harm. Sets resilience and wounds." default = 2  minvalue = 1  maxvalue = 12  valuedice = wgHeroDice (characterTable, Toughness) }
        Agility = integer { description = "Speed, coordination and shooting." default = 2  minvalue = 1  maxvalue = 12  valuedice = wgHeroDice (characterTable, Agility) }
        Initiative = integer { description = "Reflexes and close combat. Sets defence." default = 2  minvalue = 1  maxvalue = 12 }
        Willpower = integer { description = "Mental strength and faith. Sets shock and resolve." default = 2  minvalue = 1  maxvalue = 12  valuedice = wgHeroDice (characterTable, Willpower) }
        Intellect = integer { description = "Reasoning, knowledge and technical skill." default = 2  minvalue = 1  maxvalue = 12  valuedice = wgHeroDice (characterTable, Intellect) }
        Fellowship = integer { description = "Charisma and dealing with people. Sets influence." default = 2  minvalue = 1  maxvalue = 12  valuedice = wgHeroDice (characterTable, Fellowship) }
    }

    Traits = table
    {
        description = "Defence, resilience, wounds, shock and other traits."
        tableLayout = layout { columns = 4  size = wide }
        Defence = integer { description = "What attackers must reach to hit you: Initiative minus 1." value = Attributes.Initiative - 1  editable = none }
        Resilience = integer { description = "What damage must beat to wound you: Toughness plus 1 plus armour." value = Attributes.Toughness + 1 + Armour.Rating  editable = none }
        'Max Wounds' = integer { description = "Wounds you can take: twice the tier plus Toughness." value = Character.Tier * 2 + Attributes.Toughness  editable = none }
        Wounds = integer { description = "Wounds taken. At the maximum you are dying." default = 0  minvalue = 0  editable = live  indicator = "#d64545" }
        'Max Shock' = integer { description = "Shock you can take: Willpower plus tier." value = Attributes.Willpower + Character.Tier  editable = none }
        Shock = integer { description = "Shock taken. At the maximum you are exhausted." default = 0  minvalue = 0  editable = live  indicator = "#d4b106" }
        Down = string { value = if Wounds >= 'Max Wounds' then "Dying" else if Shock >= 'Max Shock' then "Exhausted" else ""  visible = none  indicator = "#d64545" }
        Respite = button { description = "A respite of an hour or so recovers all shock. Wounds need medical care or a long rest."  editable = live  onClick = updates { (root.Traits.Shock) = 0 } }
        Determination = integer { description = "Roll Toughness to turn wounds into shock." value = Attributes.Toughness  valuedice = wgPool (Attributes.Toughness, 0)  editable = none }
        Conviction = integer { description = "Resistance to corruption and the warp, from Willpower." value = Attributes.Willpower  editable = none }
        Resolve = integer { description = "Resistance to fear and terror: Willpower minus 1." value = Attributes.Willpower - 1  editable = none }
        Influence = integer { description = "Social weight and reach: Fellowship minus 1." value = Attributes.Fellowship - 1  editable = none }
        'Passive Awareness' = integer { description = "Your awareness when not looking: half the Awareness pool, rounded up." value = (poolOf (characterTable, "Awareness") + 1) / 2  editable = none }
        Speed = integer { description = "Metres moved in a turn." default = 6 }
        Wealth = integer { description = "Wealth, set by tier." value = Character.Tier  editable = none }
        Wrath = integer { description = "Wrath points: spend to reroll failures or resist death. Earned from wrath dice." default = 2  minvalue = 0  editable = live }
        'New session' = button { description = "Each session starts with 2 wrath."  editable = live  onClick = updates { (root.Traits.Wrath) = 2 } }
        Faith = integer { description = "Faith points, spent on faith-based talents." default = 0  minvalue = 0  editable = live }
        Corruption = integer { description = "Corruption from Chaos. Too much and you fall." default = 0  minvalue = 0  editable = live  indicator = "#8e5cc4" }
    }

    Skills = table
    {
        description = "Skills, each tied to an attribute."
        tableLayout = layout { columns = 3  size = wide }
        Athletics = skill (Attributes.Strength)
        Awareness = skill (Attributes.Intellect)
        'Ballistic Skill' = skill (Attributes.Agility)
        Cunning = skill (Attributes.Fellowship)
        Deception = skill (Attributes.Fellowship)
        Insight = skill (Attributes.Fellowship)
        Intimidation = skill (Attributes.Willpower)
        Investigation = skill (Attributes.Intellect)
        Leadership = skill (Attributes.Willpower)
        Medicae = skill (Attributes.Intellect)
        Persuasion = skill (Attributes.Fellowship)
        Pilot = skill (Attributes.Agility)
        'Psychic Mastery' = skill (Attributes.Willpower)
        Scholar = skill (Attributes.Intellect)
        Stealth = skill (Attributes.Agility)
        Survival = skill (Attributes.Willpower)
        Tech = skill (Attributes.Intellect)
        'Weapon Skill' = skill (Attributes.Initiative)
    }

    Armour = table
    {
        description = "Armour rating, added to resilience."
        tableLayout = layout { columns = 2 }
        Name = string {}
        Rating = integer { description = "Armour rating, added to resilience." default = 0  minvalue = 0 }
        Traits = string {}
    }

    Weapons = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        source = map ((weapon)->attackFor (characterTable, weapon), characterTable.Weapons)
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }

    Talents = list
    {
        description = "Talents bought with experience."
        tableLayout = layout { size = wide }
        source = secondary.Talents
        singular = "Talent"
        editable = character
    }

    Gear = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Gear
        singular = "Item"
        editable = character
    }

    'Psychic Powers' = list
    {
        description = "Psychic powers the character can manifest."
        tableLayout = layout { size = wide }
        source = secondary.'Psychic Powers'
        singular = "Power"
        editable = character
    }
}

creatureTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg"  important = [Threat, Attacks] }
    Threat = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Class = string { keys = ["Troops", "Elite", "Adversary", "Monstrous Creature"] }
        Defence = integer { description = "What attackers must reach to hit the threat." default = 3 }
        Resilience = integer { description = "What damage must beat to wound the threat." default = 4 }
        'Max Wounds' = integer { description = "Wounds the threat can take." default = 1 }
        Wounds = integer { description = "Wounds taken." default = 0  minvalue = 0  editable = live  indicator = "#d64545" }
        Down = string { value = if Wounds >= 'Max Wounds' then "Dead" else ""  visible = none  indicator = "#d64545" }
        Shock = integer { description = "Shock taken." default = 0  minvalue = 0  editable = live }
        Speed = integer { default = 6 }
        Determination = integer { description = "Roll to turn wounds into shock." default = 3  valuedice = wgPool (Determination, 0) }
        Conviction = integer { default = 2 }
        Resolve = integer { default = 2 }
        Skills = integer { description = "The threat's general skill pool." default = 4  valuedice = wgDice (Skills) }
    }
    Attacks = list
    {
        tableLayout = layout { size = wide }
        singular = "Attack"
        editable = character
        valueType = custom
        {
            Name = string {}
            Pool = integer { default = 6  valuedice = wgDice (Pool)  action = melee  reach = 2 }
            Damage = integer { description = "Damage before extra damage dice." default = 10  valuedice = edRoll (Damage, ED) }
            ED = integer { description = "Extra damage dice: 4 or 5 adds 1, 6 adds 2." default = 1  minvalue = 0 }
            Traits = string {}
        }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        Abilities = string { multiline = true }
        Keywords = string {}
        Description = string { multiline = true }
    }
}

weaponStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Kind = string { keys = ["Melee", "Ranged"] }
        Damage = string {}
        ED = string {}
        AP = string {}
        Range = string {}
        Salvo = string {}
        Traits = string {}
        Value = string {}
        Rarity = string {}
        Keywords = string {}
    }
}

gearStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Value = string {}
        Rarity = string {}
        Keywords = string {}
    }
}

talentStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Requirements = string {}
        Cost = string {}
    }
}

powerStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Discipline = string {}
        DN = string {}
        Activation = string {}
        Duration = string {}
        Range = string {}
        'Multi Target' = string {}
    }
}

WrathAndGlory = system
{
    hints = [
        hint
        {
            title = "Dice pools"
            topic = "Play"
            text = ["Roll attribute + skill in d6s, one of them the red Wrath die. 4-5 is an icon, 6 is two. Match the DN to succeed, and shift spare 6s for extra effect."]
        },
        hint
        {
            title = "Wrath die"
            topic = "Play"
            text = ["A 6 on the Wrath die is a Wrath Critical and gains Glory. A 1 is a complication, even on a success.", "Spend a Wrath point from the result to reroll every die that scored no icon."]
        },
        hint
        {
            title = "Initiative"
            topic = "Initiative"
            text = ["Players and enemies take turns: a player acts, then the GM picks an enemy, and so on. Spend Ruin to seize the initiative."]
        },
        hint
        {
            title = "Damage"
            topic = "Combat"
            text = ["Attack DN is the target's Defence. Roll Damage for the weapon's value plus extra damage dice; above Resilience it deals wounds, and Determination can soak them as Shock."]
        }
    ]
    distanceUnit = "m"
    characters = characterTable
    creatures = creatureTable
    Weapons = weaponStats
    Gear = gearStats
    Talents = talentStats
    'Psychic Powers' = powerStats
    secondaryTypes = ["Weapons", "Gear", "Talents", "Psychic Powers"]
    description = "Warhammer 40,000 Wrath and Glory: heroes of the Gilead System against the darkness"
    quickdice = [1d6, 2d6, 1d3]
    cssFiles = ["/systems/wrathglory/wrathglory.css"]
    libraries = ["/systems/names/grimdark.json"]
    nameSettings = [grimdarkNameSetting]
}
