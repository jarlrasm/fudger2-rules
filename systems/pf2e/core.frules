proficiencyBonus (rank, level) =
    switch rank
        case "Trained" then 2 + level
        case "Expert" then 4 + level
        case "Master" then 6 + level
        case "Legendary" then 8 + level
        else 0

degreeIndex (total, dc) =
    if total >= dc + 10 then 3
    else if total >= dc then 2
    else if total > dc - 10 then 1
    else 0

adjustedDegree (natural, total, dc) =
    if natural == 20 then min (3, degreeIndex (total, dc) + 1)
    else if natural == 1 then max (0, degreeIndex (total, dc) - 1)
    else degreeIndex (total, dc)

degreeName (degree) =
    switch degree
        case 3 then "Critical success"
        case 2 then "Success"
        case 1 then "Failure"
        else "Critical failure"

pf2Result (bonus, natural, dc) =
{
    Text = toString (natural + bonus) + (if dc > 0 then " vs DC " + toString (dc) + ": " + degreeName (adjustedDegree (natural, natural + bonus, dc)) else if natural == 20 then " (natural 20)" else if natural == 1 then " (natural 1)" else "")
    Value = natural + bonus
    Outcome = if dc > 0 then degreeName (adjustedDegree (natural, natural + bonus, dc)) else ""
}

pf2Roll (dc, fortune) = ([dice { number = if fortune == "Normal" then 1 else 2  sides = 20  color = if fortune == "Fortune" then "green" else if fortune == "Misfortune" then "red" else "" }],
    ((baseline, throws)->pf2Result (baseline, if fortune == "Fortune" then max (first (throws).rolls) else if fortune == "Misfortune" then min (first (throws).rolls) else first (first (throws).rolls), dc)))

keyAttribute (char) =
    switch char.Character.'Key Attribute'
        case "STR" then char.Attributes.STR
        case "DEX" then char.Attributes.DEX
        case "CON" then char.Attributes.CON
        case "INT" then char.Attributes.INT
        case "WIS" then char.Attributes.WIS
        case "CHA" then char.Attributes.CHA
        else max (char.Attributes.STR, char.Attributes.DEX, char.Attributes.CON, char.Attributes.INT, char.Attributes.WIS, char.Attributes.CHA)

signedText (n) = if n > 0 then "+" + toString (n) else if n < 0 then toString (n) else ""

statusPenalty (char) = max (char.Conditions.Frightened, char.Conditions.Sickened)

pf2AskedRoll (fortune) = ([dice { number = if fortune == "Normal" then 1 else 2  sides = 20  color = if fortune == "Fortune" then "green" else if fortune == "Misfortune" then "red" else "" }],
    ((baseline, throws)->pf2Result (baseline, if fortune == "Fortune" then max (first (throws).rolls) else if fortune == "Misfortune" then min (first (throws).rolls) else first (first (throws).rolls), asked)))

pf2Dice (char) = ask ("DC", pf2AskedRoll (char.Character.Roll))

pf2StrikeDice (char) = ask ("Target AC", pf2AskedRoll (char.Character.Roll))

plainPf2 = pf2Roll (0, "Normal")

mapPenalty (char, agile) =
    switch char.Character.Attack
        case "Second" then if agile then -4 else -5
        case "Third" then if agile then -8 else -10
        else 0

proficiency (attribute) = custom
{
    Attribute = attribute
    Rank = string { description = "Proficiency rank. Trained and above add level plus 2, 4, 6 or 8." default = "Untrained"  keys = ["Untrained", "Trained", "Expert", "Master", "Legendary"] }
    Item = integer { description = "Item bonus from gear, from 0 to 4." default = 0  minvalue = 0  maxvalue = 4 }
    Modifier = modifier { description = "Total: attribute plus proficiency plus item bonus, minus status penalties." value = attribute + proficiencyBonus (Rank, Character.Level) + Item - statusPenalty (characterTable)  valuedice = pf2Dice (characterTable)  editable = none }
}

noStats = { Stats = { Damage = "" } }

weaponStat (weapon, field) = valueOr (valueOr (valueOr (weapon.data, "sf2Weapon", valueOr (weapon.data, "pf2Weapon", noStats)), "Stats", noStats.Stats), field, "")

weaponRank (char, weapon) =
    switch weaponStat (weapon, "Category")
        case "Unarmed" then char.Proficiencies.Unarmed
        case "Martial" then char.Proficiencies.Martial
        case "Advanced" then char.Proficiencies.Advanced
        else char.Proficiencies.Simple

isRanged (weapon) = toInt (weaponStat (weapon, "Range")) > 0

isAgile (weapon) = contains (toLower (weaponStat (weapon, "Traits")), "agile")

attackAttribute (char, weapon) =
    if isRanged (weapon) then char.Attributes.DEX
    else if contains (toLower (weaponStat (weapon, "Traits")), "finesse") then max (char.Attributes.STR, char.Attributes.DEX)
    else char.Attributes.STR

strikeBonus (char, weapon) =
    attackAttribute (char, weapon) + proficiencyBonus (weaponRank (char, weapon), char.Character.Level) + toInt (weaponStat (weapon, "Item Bonus")) + mapPenalty (char, isAgile (weapon)) - statusPenalty (char)

strikeDamage (char, weapon) =
    weaponStat (weapon, "Damage") + (if isRanged (weapon) and not (contains (toLower (weaponStat (weapon, "Traits")), "thrown")) then "" else signedText (char.Attributes.STR)) + " " + weaponStat (weapon, "Damage Type")

strike (name, bonus, damage, kind, reachFeet, distance) = custom
{
    Name = name
    Strike = modifier { value = bonus  valuedice = pf2StrikeDice (characterTable)  action = kind  reach = reachFeet  range = distance }
    Damage = damage
}

strikeFor (char, weapon) =
    if isRanged (weapon) then
        strike (weapon.Name, strikeBonus (char, weapon), strikeDamage (char, weapon), "ranged", 5, toInt (weaponStat (weapon, "Range")) * 6)
    else
        strike (weapon.Name, strikeBonus (char, weapon), strikeDamage (char, weapon), "melee", if contains (toLower (weaponStat (weapon, "Traits")), "reach") then 10 else 5, 0)

conditionValue (colour) = integer { description = "Condition value. Most give a penalty equal to the value, or worse at higher values." default = 0  minvalue = 0  maxvalue = 4  editable = live  indicator = colour }

conditionFlag (colour) = bool { description = "Mark while the condition lasts." default = false  editable = live  indicator = colour }

pf2Conditions = table
{
    description = "Conditions with values and flags. The sheet applies their penalties."
    tableLayout = layout { columns = 5  size = wide }
    Clumsy = conditionValue ("#e8913a")
    Drained = conditionValue ("#d64545")
    Enfeebled = conditionValue ("#e8913a")
    Frightened = conditionValue ("#8e5cc4")
    Sickened = conditionValue ("#3fa34d")
    Slowed = conditionValue ("#d4b106")
    Stunned = conditionValue ("#d4b106")
    Stupefied = conditionValue ("#8e5cc4")
    Wounded = conditionValue ("#d64545")
    Dying = conditionValue ("#d64545")
    Doomed = conditionValue ("#555555")
    'Off Guard' = conditionFlag ("#e8913a")
    Prone = conditionFlag ("#e8913a")
    Grabbed = conditionFlag ("#e8913a")
    Restrained = conditionFlag ("#e8913a")
    Blinded = conditionFlag ("#555555")
    Concealed = conditionFlag ("#3a7bd5")
    Hidden = conditionFlag ("#3a7bd5")
    Invisible = conditionFlag ("#3a7bd5")
    Fatigued = conditionFlag ("#d4b106")
    Quickened = conditionFlag ("#3a7bd5")
    Unconscious = conditionFlag ("#555555")
    Persistent = string { description = "Persistent damage taken at the end of each turn until it ends." editable = live  indicator = "#d64545"  indicatorLabel = "Persistent damage" }
}

pf2Character = table
{
    tableLayout = layout { columns = 4  size = wide }
    Ancestry = string {}
    Heritage = string {}
    Background = string {}
    Class = string {}
    Level = integer { description = "Character level, from 1 to 20." default = 1  minvalue = 1  maxvalue = 20 }
    XP = integer { default = 0  editable = live }
    'Hero Points' = slots { description = "Spend one to reroll a check, or all to avoid dying." number = 3  editable = live }
    'Key Attribute' = string { description = "Your class's main attribute. Sets the class DC." keys = ["STR", "DEX", "CON", "INT", "WIS", "CHA"] }
    Size = string { default = "Medium"  keys = ["Tiny", "Small", "Medium", "Large"] }
    Speed = integer { description = "Speed in feet per stride." default = 25 }
    Languages = string {}
    Roll = selector
    {
        description = "Fortune rolls twice and keeps the better, misfortune the worse."
        options = ["Misfortune", "Normal", "Fortune"]
        labels = ["Misfortune", "Normal", "Fortune"]
        colors = ["red", "white", "green"]
        hold = ["Ctrl", "", "Shift"]
        default = "Normal"
        editable = live
        save = nosave
    }
    Attack = selector
    {
        description = "Multiple attack penalty: -5 for the second strike and -10 for the third, less with agile weapons."
        options = ["First", "Second", "Third"]
        labels = ["1st", "2nd MAP", "3rd MAP"]
        colors = ["white", "yellow", "red"]
        default = "First"
        editable = live
        save = nosave
    }
}

pf2Attributes = table
{
    description = "Attribute modifiers, from -5 to +7."
    tableLayout = layout { columns = 6  size = wide }
    STR = modifier { description = "Strength: melee damage, Athletics and carrying." default = 0  minvalue = -5  maxvalue = 7 }
    DEX = modifier { description = "Dexterity: AC, Reflex, ranged attacks and finesse weapons." default = 0  minvalue = -5  maxvalue = 7 }
    CON = modifier { description = "Constitution: hit points and Fortitude." default = 0  minvalue = -5  maxvalue = 7 }
    INT = modifier { description = "Intelligence: skills, languages and arcane spells." default = 0  minvalue = -5  maxvalue = 7 }
    WIS = modifier { description = "Wisdom: Perception, Will and divine or primal spells." default = 0  minvalue = -5  maxvalue = 7 }
    CHA = modifier { description = "Charisma: social skills and occult spells." default = 0  minvalue = -5  maxvalue = 7 }
}

pf2Defenses = table
{
    description = "Hit points, armor class and class DC."
    tableLayout = layout { columns = 4  size = wide }
    'Ancestry HP' = integer { description = "Hit points from your ancestry, gained once." default = 8 }
    'Class HP' = integer { description = "Hit points from your class, gained every level." default = 8 }
    'Max HP' = integer { description = "Max HP: ancestry HP plus (class HP plus CON) per level." value = 'Ancestry HP' + ('Class HP' + Attributes.CON) * Character.Level  editable = none }
    HP = integer { description = "Current hit points. At 0 you are dying." default = 'Max HP'  editable = live }
    'Temp HP' = integer { description = "Temporary hit points, lost before real HP." default = 0  editable = live }
    Down = string { value = if HP < 1 then "Dying" else ""  visible = none  indicator = "#d64545" }
    'Armor Rank' = string { description = "Armor proficiency rank for the armor you wear." default = "Trained"  keys = ["Untrained", "Trained", "Expert", "Master", "Legendary"] }
    'Armor Item Bonus' = integer { default = 0 }
    'Dex Cap' = integer { description = "Highest Dex modifier the armor lets you add to AC." default = 5 }
    'Shield Bonus' = integer { default = 2  minvalue = 0 }
    AC = integer { description = "Armor Class: 10 plus Dex, proficiency, armor and shield." value = 10 + min (Attributes.DEX, 'Dex Cap') + proficiencyBonus ('Armor Rank', Character.Level) + 'Armor Item Bonus' + (if 'Shield Raised' then 'Shield Bonus' else 0) - (if Conditions.'Off Guard' then 2 else 0) - statusPenalty (characterTable)  editable = none }
    'Shield Raised' = bool { description = "Raise a shield to add its bonus to AC until your next turn." default = false  editable = live  indicator = "#3a7bd5" }
    'Class DC' = integer { description = "DC for enemies to resist your class abilities." value = 10 + keyAttribute (characterTable) + proficiencyBonus (Proficiencies.'Class DC', Character.Level) - statusPenalty (characterTable)  editable = none }
    Resistances = string {}
    Weaknesses = string {}
}

pf2Proficiencies = table
{
    description = "Weapon and class DC proficiency ranks."
    tableLayout = layout { columns = 5  size = wide }
    Unarmed = string { default = "Trained"  keys = ["Untrained", "Trained", "Expert", "Master", "Legendary"] }
    Simple = string { default = "Trained"  keys = ["Untrained", "Trained", "Expert", "Master", "Legendary"] }
    Martial = string { default = "Untrained"  keys = ["Untrained", "Trained", "Expert", "Master", "Legendary"] }
    Advanced = string { default = "Untrained"  keys = ["Untrained", "Trained", "Expert", "Master", "Legendary"] }
    'Class DC' = string { default = "Trained"  keys = ["Untrained", "Trained", "Expert", "Master", "Legendary"] }
}

pf2Spellcasting = table
{
    description = "Tradition, spell attack, spell DC and slots."
    tableLayout = layout { columns = 4  size = wide }
    Tradition = string { description = "The magical tradition your spells come from." keys = ["", "Arcane", "Divine", "Occult", "Primal"] }
    'Spell Attribute' = string { default = "INT"  keys = ["INT", "WIS", "CHA"] }
    'Spell Rank' = string { default = "Untrained"  keys = ["Untrained", "Trained", "Expert", "Master", "Legendary"] }
    'Spell Attack' = modifier { description = "Spell attack roll: casting attribute plus proficiency." value = (switch 'Spell Attribute' case "WIS" then Attributes.WIS case "CHA" then Attributes.CHA else Attributes.INT) + proficiencyBonus ('Spell Rank', Character.Level) - statusPenalty (characterTable)  valuedice = pf2StrikeDice (characterTable)  editable = none  action = ranged  range = 120 }
    'Spell DC' = integer { description = "DC for targets to resist your spells." value = 10 + (switch 'Spell Attribute' case "WIS" then Attributes.WIS case "CHA" then Attributes.CHA else Attributes.INT) + proficiencyBonus ('Spell Rank', Character.Level) - statusPenalty (characterTable)  editable = none }
    'Focus Points' = slots { description = "Focus points for focus spells. Refocus to regain them." number = 3  editable = live }
    'Slots Rank 1' = slots { number = 0  editable = live }
    'Slots Rank 2' = slots { number = 0  editable = live }
    'Slots Rank 3' = slots { number = 0  editable = live }
    'Slots Rank 4' = slots { number = 0  editable = live }
    'Slots Rank 5' = slots { number = 0  editable = live }
}

pf2Creature = ruleset
{
    rulesetConfiguration =
    {
        important = [Stats, Conditions, Strikes]
        defaultImage = "/images/armour.svg"
        sortedBy = sort { prefix = "Level" sort = Stats.Level }
    }
    Stats = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Level = integer { default = 1  minvalue = -1  maxvalue = 25 }
        Traits = string {}
        Perception = modifier { description = "Perception bonus, also used for initiative." default = 5  valuedice = plainPf2 }
        Initiative = modifier { value = Perception  valuedice = 1d20  editable = none }
        AC = integer { description = "Armor Class." default = 15 }
        Fortitude = modifier { description = "Fortitude save bonus." default = 5  valuedice = plainPf2 }
        Reflex = modifier { description = "Reflex save bonus." default = 5  valuedice = plainPf2 }
        Will = modifier { description = "Will save bonus." default = 5  valuedice = plainPf2 }
        'Max HP' = integer { default = 20 }
        HP = integer { description = "Current hit points." default = 'Max HP'  editable = live }
        Speed = integer { default = 25 }
        Immunities = string {}
        Resistances = string {}
        Weaknesses = string {}
        Down = string { value = if HP < 1 then "Defeated" else ""  visible = none  indicator = "#d64545" }
    }
    Conditions = table
    {
        tableLayout = layout { columns = 5  size = wide }
        Frightened = conditionValue ("#8e5cc4")
        Sickened = conditionValue ("#3fa34d")
        Slowed = conditionValue ("#d4b106")
        Stunned = conditionValue ("#d4b106")
        'Off Guard' = conditionFlag ("#e8913a")
        Prone = conditionFlag ("#e8913a")
        Grabbed = conditionFlag ("#e8913a")
        Persistent = string { editable = live  indicator = "#d64545"  indicatorLabel = "Persistent damage" }
    }
    Strikes = list
    {
        tableLayout = layout { size = wide }
        singular = "Strike"
        editable = character
        valueType = custom
        {
            Name = string {}
            Strike = modifier { default = 7  valuedice = plainPf2  action = melee  reach = 5 }
            Damage = string {}
        }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        Skills = string { multiline = true }
        Abilities = string { multiline = true }
        Spells = string { multiline = true }
    }
}

pf2Weapon = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/armour.svg"
        filters = [filter { name = "Category" prefix = "" filter = Stats.Category }]
    }
    Stats = table
    {
        Category = string { keys = ["Unarmed", "Simple", "Martial", "Advanced"] }
        Damage = string {}
        'Damage Type' = string { keys = ["B", "P", "S", "fire", "electricity", "cold", "sonic", "acid"] }
        Range = string {}
        Reload = string {}
        Hands = string {}
        Bulk = string {}
        Traits = string {}
        'Item Bonus' = string {}
        Group = string {}
        Level = string {}
        Price = string {}
    }
}

pf2Armor = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Category = string { keys = ["Unarmored", "Light", "Medium", "Heavy", "Shield"] }
        'AC Bonus' = string {}
        'Dex Cap' = string {}
        Strength = string {}
        'Check Penalty' = string {}
        'Speed Penalty' = string {}
        Bulk = string {}
        Traits = string {}
        Level = string {}
        Price = string {}
    }
}

pf2Item = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/armour.svg"
        sortedBy = sort { prefix = "Level" sort = Stats.Level }
    }
    Stats = table
    {
        Level = integer { default = 0 }
        Bulk = string {}
        Traits = string {}
        Usage = string {}
        Price = string {}
    }
}

pf2Spell = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        sortedBy = sort { prefix = "Rank" sort = Stats.Rank }
        filters = [filter { name = "Rank" prefix = "Rank" filter = Stats.Rank }, filter { name = "Tradition" prefix = "" filter = split (", ", Stats.Traditions) }]
    }
    Stats = table
    {
        Rank = integer { default = 1 }
        Traditions = string {}
        Traits = string {}
        Cast = string {}
        Range = string {}
        Area = string {}
        Targets = string {}
        Defense = string {}
        Duration = string {}
        Heightened = string { multiline = true }
    }
}

pf2Feat = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        sortedBy = sort { prefix = "Level" sort = Stats.Level }
        filters = [filter { name = "Type" prefix = "" filter = Stats.Type }]
    }
    Stats = table
    {
        Type = string { keys = ["Ancestry", "Class", "General", "Skill", "Archetype"] }
        Level = integer { default = 1 }
        Traits = string {}
        Prerequisites = string {}
        Actions = string {}
    }
}

pf2Option = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Kind = string { keys = ["Ancestry", "Heritage", "Background", "Class"] }
        HP = string {}
        'Key Attribute' = string {}
        Boosts = string {}
        Traits = string {}
    }
}
