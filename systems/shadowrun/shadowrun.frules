#include "/systems/common.frules"
#include "/systems/names/settings.frules"

hits (rolls) = count (filter ((x)->x > 4, rolls))

isGlitch (rolls) = count (rolls) > 0 and count (filter ((x)->x == 1, rolls)) * 2 > count (rolls)

srOutcome (rolls, threshold) =
    if isGlitch (rolls) and hits (rolls) == 0 then "Critical glitch"
    else if isGlitch (rolls) then "Glitch"
    else if threshold > 0 and hits (rolls) >= threshold then "Success"
    else if threshold > 0 then "Failure"
    else if hits (rolls) > 0 then "Hit"
    else "Miss"

srText (rolls, threshold) =
    toString (hits (rolls)) + (if hits (rolls) == 1 then " hit" else " hits")
    + (if threshold > 0 then " vs " + toString (threshold) + (if hits (rolls) >= threshold then ", net " + toString (hits (rolls) - threshold) else "") else "")
    + (if isGlitch (rolls) and hits (rolls) == 0 then ", critical glitch" else if isGlitch (rolls) then ", glitch" else "")

srResult (rolls, threshold, canReroll, spend) =
{
    Text = srText (rolls, threshold)
    Value = hits (rolls)
    Outcome = srOutcome (rolls, threshold)
    Push = if canReroll and count (spend) > 0 and count (filter ((x)->x < 5, rolls)) > 0 then srReroll (filter ((x)->x > 4, rolls), count (filter ((x)->x < 5, rolls)), threshold) else 0
    PushLabel = "Reroll misses (4 Edge)"
    PushSets = spend
}

srReroll (kept, misses, threshold) = ([dice { number = misses  sides = 6  label = "Edge reroll" }],
    ((baseline, throws)->srResult (concat (kept, first (throws).rolls), threshold, false, [])))

srRoll (pool, threshold, ruleOfSix) = ([dice { number = max (0, pool)  sides = 6  explode = if ruleOfSix then 6 else 7 }],
    ((baseline, throws)->srResult (first (throws).rolls, threshold, true, [])))

srAskedRoll (pool, ruleOfSix, spend) = ([dice { number = max (0, pool)  sides = 6  explode = if ruleOfSix then 6 else 7 }],
    ((baseline, throws)->srResult (first (throws).rolls, asked, true, spend)))

edgeSpend (char) = if char.Attributes.'Current Edge' > 3 then [{ Field = "characterTable.Attributes.Current Edge"  Value = char.Attributes.'Current Edge' - 4 }] else []

srDice (char, pool) =
    ask ("Threshold", srAskedRoll (pool + char.Runner.Modifier - char.'Condition Monitors'.'Wound Modifier', false, edgeSpend (char)))

attributeValue (char, name) =
    switch name
        case "Body" then char.Attributes.Body
        case "Agility" then char.Attributes.Agility
        case "Reaction" then char.Attributes.Reaction
        case "Strength" then char.Attributes.Strength
        case "Willpower" then char.Attributes.Willpower
        case "Logic" then char.Attributes.Logic
        case "Intuition" then char.Attributes.Intuition
        case "Charisma" then char.Attributes.Charisma
        case "Magic" then char.Attributes.Magic
        case "Resonance" then char.Attributes.Resonance
        else 0

attributeNames = ["Body", "Agility", "Reaction", "Strength", "Willpower", "Logic", "Intuition", "Charisma", "Magic", "Resonance"]

skill (usual) = custom
{
    Rank = integer { description = "Skill rank from 0 to 12, added to the attribute for the dice pool." default = 0  minvalue = 0  maxvalue = 12 }
    Attribute = string { description = "The attribute this skill rolls with, normally the usual one." default = usual  keys = attributeNames  editable = live }
    Specialization = string { description = "A specialization adds 2 dice when it applies." }
    Pool = integer { description = "Dice pool: rank plus attribute. Each 5 or 6 is a hit." value = skillPool (Rank, attributeValue (characterTable, Attribute))  valuedice = srDice (characterTable, skillPool (Rank, attributeValue (characterTable, Attribute)))  editable = none }
}

noSkill = { Rank = 0 }

skillPool (rank, attribute) = if rank == 0 then attribute - 1 else rank + attribute

poolOf (char, name) = valueOr (valueOr (char.Skills, name, noSkill), "Pool", skillPool (0, char.Attributes.Agility))

weaponStat (weapon, field) = valueOr (weapon.data.weaponStats.Stats, field, "")

weaponAttack (name, pool, damage, kind, distance) = custom
{
    Name = name
    Pool = integer { value = pool  valuedice = srDice (characterTable, pool)  action = kind  reach = 2  range = distance }
    Damage = damage
    'Attack Rating' = string {}
}

attackFor (char, weapon) =
    if weaponStat (weapon, "Skill") == "Close Combat" then
        weaponAttack (weapon.Name, poolOf (char, "Close Combat"), weaponStat (weapon, "Damage"), "melee", 2)
    else
        weaponAttack (weapon.Name, poolOf (char, if weaponStat (weapon, "Skill") == "" then "Firearms" else weaponStat (weapon, "Skill")), weaponStat (weapon, "Damage"), "ranged", max (50, toInt (weaponStat (weapon, "Range"))))

characterTable = ruleset
{
    rulesetConfiguration = { important = ['Derived Ratings', 'Condition Monitors', Attacks] }
    Runner = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Metatype = string { keys = ["Human", "Elf", "Dwarf", "Ork", "Troll"] }
        Role = string {}
        Ethnicity = string {}
        Age = integer { default = 25 }
        Reputation = integer { description = "Street reputation, good or bad." default = 0 }
        Heat = integer { description = "How much attention the runner draws from the law and the corps." default = 0  editable = live }
        Karma = integer { description = "Karma earned in play, spent to improve the runner." default = 0  editable = live }
        Nuyen = integer { description = "Money, in nuyen." default = 0  editable = live }
        Lifestyle = string { description = "How and where the runner lives, and what it costs each month." }
        Modifier = modifier { description = "Extra dice added to or taken from the next pool." default = 0  editable = live }
    }

    Attributes = table
    {
        description = "Attributes, from 1 to about 6 for most metatypes. Add them to skills for dice pools."
        tableLayout = layout { columns = 4  size = wide }
        Body = integer { description = "Toughness, health and resisting damage." default = 3  minvalue = 1  maxvalue = 10 }
        Agility = integer { description = "Coordination and fine control. Used for most weapons." default = 3  minvalue = 1  maxvalue = 10 }
        Reaction = integer { description = "Reflexes and response time. Adds to initiative and defense." default = 3  minvalue = 1  maxvalue = 10 }
        Strength = integer { description = "Raw muscle and melee damage." default = 3  minvalue = 1  maxvalue = 10 }
        Willpower = integer { description = "Mental strength and stamina. Sets the stun monitor." default = 3  minvalue = 1  maxvalue = 10 }
        Logic = integer { description = "Reasoning and memory." default = 3  minvalue = 1  maxvalue = 10 }
        Intuition = integer { description = "Gut feeling and awareness. Adds to initiative." default = 3  minvalue = 1  maxvalue = 10 }
        Charisma = integer { description = "Force of personality and social skill." default = 3  minvalue = 1  maxvalue = 10 }
        Edge = integer { description = "Edge: luck and the knack for coming out on top. Caps how much edge you hold." default = 2  minvalue = 1  maxvalue = 7 }
        'Current Edge' = integer { description = "Edge points held right now, gained in play and spent on edge actions." default = Edge  minvalue = 0  maxvalue = 7  editable = live  indicator = "#8e5cc4"  indicatorLabel = "Edge" }
        'Refresh Edge' = button { description = "Edge points back to your Edge rating, for when the game refreshes them."  editable = live  onClick = updates { (root.Attributes.'Current Edge') = Edge } }
        Magic = integer { description = "Magical potential. 0 means mundane." default = 0  minvalue = 0  maxvalue = 10 }
        Resonance = integer { description = "Technomancer potential for using the Matrix without a deck." default = 0  minvalue = 0  maxvalue = 10 }
        Essence = string { description = "Essence, worn down by cyberware. Losing it hurts Magic and Resonance." default = "6.0" }
    }

    'Derived Ratings' = table
    {
        description = "Initiative, defense and other rolls built from two attributes."
        tableLayout = layout { columns = 4  size = wide }
        'Initiative Dice' = integer { description = "Extra initiative dice from wired reflexes, magic or the Matrix." default = 1  minvalue = 1  maxvalue = 5 }
        Initiative = integer { description = "Initiative score: Reaction plus Intuition plus initiative dice." value = Attributes.Reaction + Attributes.Intuition - 'Condition Monitors'.'Wound Modifier'  valuedice = ([dice { number = 'Initiative Dice'  sides = 6 }], ((baseline, throws)->baseline + sum (first (throws).rolls)))  editable = none }
        'Defense Rating' = integer { description = "Rating compared to the attacker's attack rating to decide edge." default = Attributes.Body }
        Composure = integer { description = "Pool to keep cool under pressure: Willpower plus Charisma." value = Attributes.Willpower + Attributes.Charisma  valuedice = srDice (characterTable, Attributes.Willpower + Attributes.Charisma)  editable = none }
        'Judge Intentions' = integer { description = "Pool to read someone's motives: Willpower plus Intuition." value = Attributes.Willpower + Attributes.Intuition  valuedice = srDice (characterTable, Attributes.Willpower + Attributes.Intuition)  editable = none }
        Memory = integer { description = "Pool to recall something: Logic plus Intuition." value = Attributes.Logic + Attributes.Intuition  valuedice = srDice (characterTable, Attributes.Logic + Attributes.Intuition)  editable = none }
        'Lift and Carry' = integer { description = "Pool to lift and carry heavy things: Body plus Willpower." value = Attributes.Body + Attributes.Willpower  valuedice = srDice (characterTable, Attributes.Body + Attributes.Willpower)  editable = none }
        Defense = integer { description = "Pool to avoid attacks: Reaction plus Intuition." value = Attributes.Reaction + Attributes.Intuition  valuedice = srDice (characterTable, Attributes.Reaction + Attributes.Intuition)  editable = none }
        'Damage Resistance' = integer { description = "Pool to soak damage: Body, plus armor where it applies." value = Attributes.Body  valuedice = srDice (characterTable, Attributes.Body)  editable = none }
        Movement = string { description = "Walking and running speed in metres." default = "10/15" }
    }

    'Condition Monitors' = table
    {
        description = "Physical and stun damage boxes."
        tableLayout = layout { columns = 2  size = wide }
        Physical = slots { description = "Physical damage boxes: 8 plus half Body. Overflow past them means dying." number = 8 + (Attributes.Body + 1) / 2  editable = live  overflow = allow  indicator = "#d64545" }
        Stun = slots { description = "Stun damage boxes: 8 plus half Willpower. Filling them knocks you out." number = 8 + (Attributes.Willpower + 1) / 2  editable = live  indicator = "#d4b106" }
        'Wound Modifier' = integer { description = "Every 3 boxes filled gives -1 to all pools." value = Physical.realvalue / 3 + Stun.realvalue / 3  editable = none }
        Overflow = integer { description = "Physical damage past the monitor. Too much and the runner dies." value = max (0, Physical.realvalue - (8 + (Attributes.Body + 1) / 2))  editable = none }
        Down = string { value = if Physical.realvalue >= 8 + (Attributes.Body + 1) / 2 then "Dying" else if Stun.realvalue >= 8 + (Attributes.Willpower + 1) / 2 then "Unconscious" else ""  visible = none  indicator = "#555555" }
        'Stun healed' = button { description = "Clears the stun track, once rest has healed it. Physical damage needs longer rest or medical care."  editable = live  onClick = updates { (root.'Condition Monitors'.Stun.realvalue) = 0 } }
        'Fully healed' = button { description = "Clears both tracks, once rest and medical care have healed them. Enter partial healing by hand."  editable = live  onClick = updates
            {
                (root.'Condition Monitors'.Physical.realvalue) = 0
                (root.'Condition Monitors'.Stun.realvalue) = 0
            }
        }
    }

    Skills = table
    {
        description = "Skills, each tied to an attribute. Roll rank plus attribute."
        tableLayout = layout { columns = 2  size = wide }
        Astral = skill ("Intuition")
        Athletics = skill ("Agility")
        Biotech = skill ("Logic")
        'Close Combat' = skill ("Agility")
        Con = skill ("Charisma")
        Conjuring = skill ("Magic")
        Cracking = skill ("Logic")
        Electronics = skill ("Logic")
        Enchanting = skill ("Magic")
        Engineering = skill ("Logic")
        'Exotic Weapons' = skill ("Agility")
        Firearms = skill ("Agility")
        Influence = skill ("Charisma")
        Outdoors = skill ("Intuition")
        Perception = skill ("Intuition")
        Piloting = skill ("Reaction")
        Sorcery = skill ("Magic")
        Stealth = skill ("Agility")
        Tasking = skill ("Resonance")
    }

    Qualities = list
    {
        description = "Positive and negative qualities that shape the runner."
        tableLayout = layout { size = wide }
        source = secondary.Qualities
        singular = "Quality"
        editable = character
    }

    Weapons = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        source = concat ([weaponAttack ("Unarmed", poolOf (characterTable, "Close Combat"), "2S", "melee", 2)], map ((weapon)->attackFor (characterTable, weapon), characterTable.Weapons))
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }

    Armor = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Armor
        singular = "Armor"
        editable = character
    }

    Augmentations = list
    {
        description = "Cyberware and bioware installed, with their essence cost."
        tableLayout = layout { size = wide }
        source = secondary.Augmentations
        singular = "Augmentation"
        editable = character
    }

    Spells = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Spells
        singular = "Spell"
        editable = character
    }

    Gear = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Gear
        singular = "Item"
        editable = character
    }

    Contacts = list
    {
        description = "People the runner knows and can call on."
        tableLayout = layout { size = wide }
        singular = "Contact"
        editable = character
        valueType = custom
        {
            Name = string {}
            Type = string {}
            Connection = integer { description = "How much pull the contact has." default = 1 }
            Loyalty = integer { description = "How much the contact cares about the runner." default = 1 }
        }
    }

    IDs = list
    {
        description = "Fake identities and licenses."
        tableLayout = layout { size = wide }
        singular = "SIN or License"
        editable = character
        valueType = custom
        {
            Name = string {}
            Rating = integer { description = "How well the fake ID holds up to checks." default = 1 }
            Notes = string {}
        }
    }
}

creatureTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg"  important = [Stats] }
    Stats = table
    {
        tableLayout = layout { columns = 5  size = wide }
        'Professional Rating' = integer { description = "How skilled and dangerous the opposition is." default = 2 }
        B = integer { default = 3 }
        A = integer { default = 3 }
        R = integer { default = 3 }
        S = integer { default = 3 }
        W = integer { default = 3 }
        L = integer { default = 3 }
        I = integer { default = 3 }
        C = integer { default = 3 }
        Initiative = integer { value = R + I  valuedice = ([1d6], ((baseline, throws)->baseline + sum (first (throws).rolls)))  editable = none }
        'Defense Rating' = integer { description = "Rating compared to the attacker's attack rating to decide edge." default = 3 }
        'Condition Monitor' = slots { description = "Damage boxes." number = 10  editable = live  indicator = "#d64545" }
        Defense = integer { description = "Pool to avoid attacks." value = R + I  valuedice = srRoll (R + I, 0, false)  editable = none }
    }
    'Dice Pools' = keyvalues
    {
        description = "The NPC's main dice pools."
        singular = "Pool"
        editablekeys = character
        keys = ["Firearms", "Close Combat"]
        valueType = custom
        {
            Dice = integer { default = 8  valuedice = srRoll (Dice, 0, false)  action = if Key == "Close Combat" then "melee" else "ranged"  reach = 2  range = 50 }
            Damage = string {}
        }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        Gear = string { multiline = true }
        Powers = string { multiline = true }
    }
}

weaponStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Skill = string { keys = ["Firearms", "Close Combat", "Exotic Weapons", "Athletics"] }
        Damage = string {}
        Mode = string {}
        'Attack Ratings' = string {}
        Range = string {}
        Ammo = string {}
        Availability = string {}
        Cost = string {}
    }
}

armorStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        'Defense Bonus' = string {}
        Capacity = string {}
        Availability = string {}
        Cost = string {}
    }
}

augmentationStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Kind = string { keys = ["Cyberware", "Bioware", "Geneware", "Nanoware"] }
        Rating = string {}
        Essence = string {}
        Availability = string {}
        Cost = string {}
    }
}

spellStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Category = string { keys = ["Combat", "Detection", "Health", "Illusion", "Manipulation"] }
        Range = string {}
        Type = string { keys = ["Physical", "Mana"] }
        Duration = string {}
        Drain = string {}
    }
}

qualityStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Kind = string { keys = ["Positive", "Negative"] }
        Karma = string {}
    }
}

gearStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Rating = string {}
        Availability = string {}
        Cost = string {}
    }
}

Shadowrun = system
{
    hints = [
        hint
        {
            title = "The run"
            topic = "Getting started"
            text = ["A job from a Johnson, legwork, the run, and the payout. Plan for betrayal."]
        },
        hint
        {
            title = "Hits and glitches"
            topic = "Play"
            text = ["5s and 6s are hits. Each test asks for its threshold; leave it blank for none. More than half 1s is a glitch."]
        },
        hint
        {
            title = "Edge"
            topic = "Play"
            text = ["Reroll misses for four Edge (the sheet spends it). Other Edge boosts, such as rerolling one die or buying a hit, are adjusted by hand."]
        },
        hint
        {
            title = "Initiative"
            topic = "Initiative"
            text = ["Roll Initiative (Reaction + Intuition + initiative dice) to join the list."]
        }
    ]
    distanceUnit = "m"
    characters = characterTable
    creatures = creatureTable
    entityTypeNames = [entityTypeName ("Character", "Runner", "Runners")]
    Weapons = weaponStats
    Armor = armorStats
    Augmentations = augmentationStats
    Spells = spellStats
    Qualities = qualityStats
    Gear = gearStats
    secondaryTypes = ["Weapons", "Armor", "Augmentations", "Spells", "Qualities", "Gear"]
    description = "Shadowrun 6th World: magic and cyberware in the shadows of the megacorps"
    initiativeCompare (item1, item2) = compare (toInt (item1), toInt (item2))
    quickdice = [1d6, 2d6]
    cssFiles = ["/systems/shadowrun/shadowrun.css"]
    libraries = ["/systems/names/cyberpunk.json", "/systems/names/spies.json", "/systems/names/fantasy.json"]
    nameSettings = [neonStreetsNameSetting, spyThrillerNameSetting, fantasyNameSetting]
}
