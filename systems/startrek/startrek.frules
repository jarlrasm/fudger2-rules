#include "/systems/common.frules"
#include "/systems/names/settings.frules"

successesOf (rolls, target, crit) = sum (map ((x)->if x <= crit then 2 else if x <= target then 1 else 0, rolls))

complicationsOf (rolls, range) = count (filter ((x)->x > 20 - range, rolls))

plural (n, one, many) = toString (n) + " " + (if n == 1 then one else many)

staText (successes, complications, difficulty, known) =
    plural (successes, "success", "successes")
    + (if known then " vs " + toString (difficulty) + (if successes >= difficulty then ": success" + (if successes > difficulty then ", " + toString (successes - difficulty) + " Momentum" else "") else ": failure") else "")
    + (if complications > 0 then ", " + plural (complications, "complication", "complications") else "")

staResult (rolls, target, crit, range, difficulty, known) =
{
    Text = staText (successesOf (rolls, target, crit), complicationsOf (rolls, range), difficulty, known)
    Value = successesOf (rolls, target, crit)
    Outcome = if not (known) then (if complicationsOf (rolls, range) > 0 then "Complication" else "") else if successesOf (rolls, target, crit) >= difficulty then "Success" else "Failure"
}

staRoll (target, department, focus, diceCount, range) = ([dice { number = max (1, min (5, diceCount))  sides = 20 }],
    ((baseline, throws)->staResult (first (throws).rolls, target, if focus then department else 1, range, asked, answered)))

staDice (target, department, focus, diceCount, range) = ask ("Difficulty", staRoll (target, department, focus, diceCount, range))

attributeNames = ["Control", "Daring", "Fitness", "Insight", "Presence", "Reason"]

departmentNames = ["Command", "Conn", "Engineering", "Security", "Medicine", "Science"]

taskTable = table
{
    tableLayout = layout { columns = 3  size = wide }
    Attribute = string { description = "The attribute for this task." default = "Control"  keys = attributeNames  editable = live }
    Department = string { description = "The department for this task." default = "Command"  keys = departmentNames  editable = live }
    Focus = bool { description = "A matching focus makes each die at or under the department a double success." default = false  editable = live }
    Dice = integer { description = "How many d20s to roll: 2, plus any bought with momentum or threat." default = 2  minvalue = 1  maxvalue = 5  editable = live }
    'Complication Range' = integer { description = "Rolls at or above 21 minus this number cause a complication." default = 1  minvalue = 1  maxvalue = 5  editable = live }
    Target = integer { description = "Target number: attribute plus department. Each d20 at or under it is a success." value = valueOr (Attributes, Attribute, 0) + valueOr (Departments, Department, 0)  valuedice = staDice (Target, valueOr (Departments, Department, 0), Focus, Dice, 'Complication Range')  editable = none }
}

weaponStat (weapon, field) = valueOr (weapon.data.weaponStats.Stats, field, "")

weaponAttack (name, target, department, diceCount, damage, kind) = custom
{
    Name = name
    Attack = integer { value = target  valuedice = staDice (target, department, false, diceCount, 1)  action = kind  reach = 2 }
    Damage = integer { description = "Severity plus Security. Spend Momentum to raise it." value = damage  editable = none }
}

attackFor (char, weapon) =
    if weaponStat (weapon, "Kind") == "Ranged" then
        weaponAttack (weapon.Name, char.Attributes.Control + char.Departments.Security, char.Departments.Security, char.Task.Dice, toInt (weaponStat (weapon, "Severity")) + char.Departments.Security, "ranged")
    else
        weaponAttack (weapon.Name, char.Attributes.Daring + char.Departments.Security, char.Departments.Security, char.Task.Dice, toInt (weaponStat (weapon, "Severity")) + char.Departments.Security, "melee")

characterTable = ruleset
{
    rulesetConfiguration = { important = [Attributes, Departments, Status, Task] }
    Character = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Rank = string { keys = ["Ensign", "Lieutenant (jg)", "Lieutenant", "Lieutenant Commander", "Commander", "Captain"] }
        Assignment = string {}
        Species = string { keys = ["Human", "Andorian", "Bajoran", "Betazoid", "Denobulan", "Tellarite", "Trill", "Vulcan"] }
        Environment = string {}
        Upbringing = string {}
        Career = string {}
        Traits = string { description = "Species and personal traits that are true about the character." }
        Pronouns = string {}
    }

    Attributes = table
    {
        description = "The six attributes, from 7 to 12."
        tableLayout = layout { columns = 3 }
        Control = integer { description = "Precision, self-discipline and careful action." default = 8  minvalue = 7  maxvalue = 12 }
        Daring = integer { description = "Boldness, speed and decisive action." default = 8  minvalue = 7  maxvalue = 12 }
        Fitness = integer { description = "Strength, endurance and physical action." default = 8  minvalue = 7  maxvalue = 12 }
        Insight = integer { description = "Empathy, intuition and understanding others." default = 8  minvalue = 7  maxvalue = 12 }
        Presence = integer { description = "Charisma, leadership and persuasion." default = 8  minvalue = 7  maxvalue = 12 }
        Reason = integer { description = "Logic, analysis and knowledge." default = 8  minvalue = 7  maxvalue = 12 }
    }

    Departments = table
    {
        description = "The six departments, from 0 to 5: what you know and are trained in."
        tableLayout = layout { columns = 3 }
        Command = integer { description = "Leadership, tactics and diplomacy." default = 1  minvalue = 0  maxvalue = 5 }
        Conn = integer { description = "Piloting, navigation and starship operations." default = 1  minvalue = 0  maxvalue = 5 }
        Engineering = integer { description = "Building, repairing and running technology." default = 1  minvalue = 0  maxvalue = 5 }
        Security = integer { description = "Combat, security and tactical systems." default = 1  minvalue = 0  maxvalue = 5 }
        Medicine = integer { description = "Healing, biology and psychology." default = 1  minvalue = 0  maxvalue = 5 }
        Science = integer { description = "The physical and life sciences." default = 1  minvalue = 0  maxvalue = 5 }
    }

    Task = taskTable { description = "Build a task roll: pick an attribute and a department." }

    Status = table
    {
        tableLayout = layout { columns = 4  size = wide }
        'Max Stress' = integer { description = "Stress you can take: Fitness plus bonuses." value = Attributes.Fitness + 'Stress bonus'  editable = none }
        'Stress bonus' = integer { description = "Extra stress from talents such as Resolute." default = 0 }
        Stress = integer { description = "Stress taken. Run out and the next injury takes you out." default = 0  minvalue = 0  editable = live  indicator = "#d4b106" }
        Injured = bool { description = "An injury that impairs the character until treated." default = false  editable = live  indicator = "#d64545" }
        Down = string { value = if Stress >= 'Max Stress' then "Out of stress" else ""  visible = none  indicator = "#d64545" }
        Determination = integer { description = "Spend to gain a bonus die at 1, reroll, or perform a heroic act tied to a value." default = 1  minvalue = 0  maxvalue = 3  editable = live }
        'New mission' = button { description = "Each mission starts with 1 determination and no stress. Injuries stay until treated."  editable = live  onClick = updates
            {
                (root.Status.Determination) = 1
                (root.Status.Stress) = 0
            }
        }
        Reputation = integer { description = "Standing in Starfleet, used at the end of missions." default = 10 }
        'Personal Threat' = integer { description = "Threat the character can generate for the GM." default = 0  minvalue = 0  editable = live }
        'Protection' = integer { description = "Reduces stress from each hit." default = 0 }
    }

    Values = list
    {
        description = "Values: beliefs that can be challenged or used for determination."
        tableLayout = layout { size = wide }
        singular = "Value"
        editable = character
        valueType = custom { Value = string {}  Used = bool { default = false  editable = live }  Challenged = bool { default = false  editable = live } }
    }

    Focuses = list
    {
        description = "Focuses: specialities that make successes double."
        tableLayout = layout { size = wide }
        singular = "Focus"
        editable = character
        valueType = string
    }

    Talents = list
    {
        description = "Talents that bend the rules."
        tableLayout = layout { size = wide }
        source = secondary.Talents
        singular = "Talent"
        editable = character
    }

    Weapons = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        source = concat ([weaponAttack ("Unarmed Strike", Attributes.Daring + Departments.Security, Departments.Security, Task.Dice, 1 + Departments.Security, "melee")], map ((weapon)->attackFor (characterTable, weapon), characterTable.Weapons))
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }

    Equipment = table
    {
        tableLayout = layout { size = wide }
        Equipment = string { multiline = true }
        Milestones = string { description = "Milestones reached, which let the character grow." multiline = true }
    }
}

creatureTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/systems/startrek/alien.svg"  important = [NPC, Task, Attacks] }
    NPC = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Type = string { description = "Minor NPCs go down from any injury, notable and major ones last longer." keys = ["Minor", "Notable", "Major"] }
        Species = string {}
        'Max Stress' = integer { description = "Stress the NPC can take." default = 8 }
        Stress = integer { description = "Stress taken." default = 0  minvalue = 0  editable = live  indicator = "#d4b106" }
        Down = string { value = if Stress >= 'Max Stress' then "Defeated" else ""  visible = none  indicator = "#d64545" }
        Protection = integer { description = "Reduces stress from each hit." default = 0 }
        Traits = string {}
    }
    Attributes = table
    {
        tableLayout = layout { columns = 6  size = wide }
        Control = integer { default = 8 }
        Daring = integer { default = 8 }
        Fitness = integer { default = 8 }
        Insight = integer { default = 8 }
        Presence = integer { default = 8 }
        Reason = integer { default = 8 }
    }
    Departments = table
    {
        tableLayout = layout { columns = 6  size = wide }
        Command = integer { default = 1 }
        Conn = integer { default = 1 }
        Engineering = integer { default = 1 }
        Security = integer { default = 1 }
        Medicine = integer { default = 1 }
        Science = integer { default = 1 }
    }
    Task = taskTable {}
    Attacks = list
    {
        tableLayout = layout { size = wide }
        singular = "Attack"
        editable = character
        valueType = custom
        {
            Name = string {}
            Target = integer { default = 10  valuedice = staDice (Target, 1, false, 2, 1)  action = ranged }
            Damage = integer { description = "Fixed damage: Severity plus Security." default = 3 }
            Qualities = string {}
        }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        'Special Rules' = string { multiline = true }
        Description = string { multiline = true }
    }
}

shipTable = ruleset
{
    rulesetConfiguration = { defaultImage = "/systems/startrek/starship.svg"  important = [Ship, Systems, Weapons] }
    Ship = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Class = string {}
        Registry = string {}
        'Service Date' = integer { default = 2371 }
        Scale = integer { description = "Size of the ship, from 1 to 7. Sets resistance and how many breaches it can take." default = 4  minvalue = 1  maxvalue = 7 }
        'Max Shields' = integer { description = "Shield strength when full." default = 10 }
        Shields = integer { description = "Shields left. At 0 every hit causes a breach." default = 'Max Shields'  minvalue = 0  editable = live }
        Breaches = integer { description = "Hull breaches. More than the scale destroys the ship." default = 0  minvalue = 0  editable = live  indicator = "#d64545" }
        Down = string { value = if Breaches > Scale then "Destroyed" else if Shields < 1 then "Shields down" else ""  visible = none  indicator = "#d64545" }
        Power = integer { description = "Power for the ship's systems each scene." default = 8  editable = live }
        Resistance = integer { description = "Reduces damage from each hit, equal to scale." value = Scale  editable = none }
        Crew = string { description = "How skilled the ship's crew is." keys = ["Untrained", "Basic", "Proficient", "Talented", "Exceptional"] }
        Traits = string {}
    }
    Systems = table
    {
        description = "Ship systems, the ship's equivalent of attributes."
        tableLayout = layout { columns = 6  size = wide }
        Comms = integer { default = 8 }
        Computers = integer { default = 8 }
        Engines = integer { default = 8 }
        Sensors = integer { default = 8 }
        Structure = integer { default = 8 }
        Weapons = integer { default = 8 }
    }
    Departments = table
    {
        tableLayout = layout { columns = 6  size = wide }
        Command = integer { default = 1 }
        Conn = integer { default = 1 }
        Engineering = integer { default = 1 }
        Security = integer { default = 1 }
        Medicine = integer { default = 1 }
        Science = integer { default = 1 }
    }
    Weapons = list
    {
        tableLayout = layout { size = wide }
        singular = "Weapon"
        editable = character
        valueType = custom
        {
            Name = string {}
            Attack = integer { description = "Weapons system plus Security." value = shipTable.Systems.Weapons + shipTable.Departments.Security  valuedice = staDice (shipTable.Systems.Weapons + shipTable.Departments.Security, shipTable.Departments.Security, false, 2, 1)  action = ranged  editable = none }
            Damage = integer { description = "Fixed damage. Spend Momentum to raise it." default = 4 }
            Qualities = string {}
        }
    }
    Notes = table
    {
        tableLayout = layout { size = wide }
        Talents = string { multiline = true }
        'Mission Profile' = string {}
        Description = string { multiline = true }
    }
}

weaponStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/systems/icons/gun.svg" }
    Stats = table
    {
        Kind = string { keys = ["Melee", "Ranged"] }
        Severity = string {}
        Size = string { keys = ["1H", "2H"] }
        Qualities = string {}
        Cost = string {}
    }
}

talentStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Requirement = string {}
    }
}

StarTrekAdventures = system
{
    lowRollsAreLucky = [20]
    hints = [
        hint
        {
            title = "Tasks"
            topic = "Play"
            text = ["Pick an attribute and a department in the Task block. Roll 2d20 (buy up to 3 more): each die at or under the target is a success, at or under the department with a focus is two. Extra successes become Momentum."]
        },
        hint
        {
            title = "Complications"
            topic = "Play"
            text = ["Each die in the complication range, usually a 20, is a complication. The GM gains Threat to use against the crew."]
        },
        hint
        {
            title = "Initiative"
            topic = "Initiative"
            text = ["Players and NPCs take turns. A player acts first, then the side passes; spend Momentum or Threat to keep the initiative."]
        },
        hint
        {
            title = "Damage"
            topic = "Combat"
            text = ["Damage is fixed: the weapon's Severity plus Security, raised with Momentum. Damage minus Protection is Stress; damage of 5 or more, or past the last Stress, is an Injury."]
        }
    ]
    distanceUnit = "m"
    characters = characterTable
    creatures = creatureTable
    Spaceships = shipTable
    Weapons = weaponStats
    Talents = talentStats
    secondaryTypes = ["Weapons", "Talents"]
    extraEntityTypes = [entityTypeDescription ("Spaceships", "starship", true, "/systems/startrek/starship.svg", [])]
    description = "Star Trek Adventures 2nd edition: the 2d20 system for Starfleet crews"
    quickdice = [2d20, 1d20, 1d6]
    cssFiles = ["/systems/startrek/startrek.css"]
    libraries = ["/systems/names/scifi.json"]
    nameSettings = [spaceNameSetting]
}
