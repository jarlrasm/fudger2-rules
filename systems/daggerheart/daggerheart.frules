#include "/systems/common.frules"
#include "/systems/names/settings.frules"

dualityKind (hope, fear) =
    if hope == fear then "Critical success"
    else if hope > fear then "with Hope"
    else "with Fear"

advantageDie (mode, rolls) =
    if mode == "Advantage" then first (rolls)
    else if mode == "Disadvantage" then 0 - first (rolls)
    else 0

dualityTotal (modifier, hope, fear, extra) = hope + fear + modifier + extra

dualityText (total, hope, fear, difficulty) =
    toString (total)
    + (if hope == fear then ", critical success"
        else if difficulty > 0 then (if total >= difficulty then " vs " + toString (difficulty) + ": success " else " vs " + toString (difficulty) + ": failure ") + dualityKind (hope, fear)
        else " " + dualityKind (hope, fear))

dualityResult (modifier, hope, fear, extra, difficulty) =
{
    Text = dualityText (dualityTotal (modifier, hope, fear, extra), hope, fear, difficulty)
    Value = dualityTotal (modifier, hope, fear, extra)
    Outcome = if hope == fear then "Critical" else if difficulty > 0 and dualityTotal (modifier, hope, fear, extra) < difficulty then "Failure" else ""
    Color = if hope == fear then "green" else if hope > fear then "yellow" else "purple"
}

dualityRoll (mode, difficulty) = ([dice { number = 1  sides = 12  color = "yellow"  label = "Hope" }, dice { number = 1  sides = 12  color = "purple"  label = "Fear" }, dice { number = if mode == "Normal" then 0 else 1  sides = 6  color = if mode == "Advantage" then "green" else "red"  label = if mode == "Advantage" then "Advantage" else if mode == "Disadvantage" then "Disadvantage" else "" }],
    ((baseline, throws)->dualityResult (baseline, first (item (0, throws).rolls), first (item (1, throws).rolls), advantageDie (mode, item (2, throws).rolls), difficulty)))

dualityAskedRoll (mode) = ([dice { number = 1  sides = 12  color = "yellow"  label = "Hope" }, dice { number = 1  sides = 12  color = "purple"  label = "Fear" }, dice { number = if mode == "Normal" then 0 else 1  sides = 6  color = if mode == "Advantage" then "green" else "red"  label = if mode == "Advantage" then "Advantage" else if mode == "Disadvantage" then "Disadvantage" else "" }],
    ((baseline, throws)->dualityResult (baseline, first (item (0, throws).rolls), first (item (1, throws).rolls), advantageDie (mode, item (2, throws).rolls), asked)))

dualityDice (char) = ask ("Difficulty", dualityAskedRoll (char.Character.Roll))

plainDuality = dualityRoll ("Normal", 0)

adversaryText (natural, total, evasion) =
    toString (total)
    + (if evasion > 0 then " vs Evasion " + toString (evasion) + (if natural == 20 then ": critical hit" else if total >= evasion then ": hit" else ": miss")
        else if natural == 20 then ", critical" else "")

adversaryResult (natural, total, evasion) =
{
    Text = adversaryText (natural, total, evasion)
    Value = total
    Outcome = if natural == 20 then "Critical" else if evasion < 1 then "" else if total >= evasion then "Hit" else "Miss"
}

adversaryRoll (evasion) = ([1d20], ((baseline, throws)->adversaryResult (first (first (throws).rolls), baseline + first (first (throws).rolls), evasion)))

adversaryAsked = ([1d20], ((baseline, throws)->adversaryResult (first (first (throws).rolls), baseline + first (first (throws).rolls), asked)))

adversaryAttack = ask ("Evasion", adversaryAsked)

weaponStat (weapon, field) = valueOr (weapon.data.weaponStats.Stats, field, "")

rangeFeet (text) =
    switch text
        case "Melee" then 5
        case "Very Close" then 10
        case "Close" then 30
        case "Far" then 100
        case "Very Far" then 300
        else 5

traitValue (char, name) =
    switch name
        case "Agility" then char.Traits.Agility
        case "Strength" then char.Traits.Strength
        case "Finesse" then char.Traits.Finesse
        case "Instinct" then char.Traits.Instinct
        case "Presence" then char.Traits.Presence
        else char.Traits.Knowledge

weaponAttack (name, bonus, damage, kind, distance) = custom
{
    Name = name
    Attack = modifier { description = "Trait bonus plus extras, added to the Hope and Fear dice for the attack." value = bonus  valuedice = dualityDice (characterTable)  action = kind  reach = distance  range = distance }
    Damage = damage
}

damageText (char, weapon) = toString (char.Character.Proficiency) + weaponStat (weapon, "Damage") + " " + weaponStat (weapon, "Damage Type")

attackFor (char, weapon) =
    if weaponStat (weapon, "Range") == "Melee" or weaponStat (weapon, "Range") == "" then
        weaponAttack (weapon.Name, traitValue (char, weaponStat (weapon, "Trait")), damageText (char, weapon), "melee", 5)
    else
        weaponAttack (weapon.Name, traitValue (char, weaponStat (weapon, "Trait")), damageText (char, weapon), if weaponStat (weapon, "Range") == "Very Close" then "melee" else "ranged", rangeFeet (weaponStat (weapon, "Range")))

characterTable = ruleset
{
    rulesetConfiguration = { important = [Traits, Defense, 'Hope and Health', Attacks] }
    Character = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Class = string { keys = ["Bard", "Druid", "Guardian", "Ranger", "Rogue", "Seraph", "Sorcerer", "Warrior", "Wizard"] }
        Subclass = string {}
        Ancestry = string {}
        Community = string {}
        Level = integer { description = "Character level from 1 to 10." reference = ["srd", 42] default = 1  minvalue = 1  maxvalue = 10 }
        Proficiency = integer { description = "How many damage dice you roll for a weapon hit." reference = ["srd", 5] default = 1  minvalue = 1  maxvalue = 6 }
        Roll = selector
        {
            description = "Roll an extra d6 to add with advantage, or subtract with disadvantage." reference = ["srd", 38]
            options = ["Disadvantage", "Normal", "Advantage"]
            labels = ["Dis", "Normal", "Adv"]
            colors = ["red", "white", "green"]
            hold = ["Ctrl", "", "Shift"]
            default = "Normal"
            editable = live
            save = nosave
        }
    }

    Traits = table
    {
        tableLayout = layout { columns = 6  size = wide }
        Agility = modifier { description = "Sprint, leap and maneuver." reference = ["srd", 4] default = 0  minvalue = -2  maxvalue = 6  valuedice = dualityDice (characterTable) }
        Strength = modifier { description = "Lift, smash and grapple." reference = ["srd", 4] default = 0  minvalue = -2  maxvalue = 6  valuedice = dualityDice (characterTable) }
        Finesse = modifier { description = "Control, hide and tinker with precision." reference = ["srd", 4] default = 0  minvalue = -2  maxvalue = 6  valuedice = dualityDice (characterTable) }
        Instinct = modifier { description = "Perceive, sense and navigate by gut feeling." reference = ["srd", 4] default = 0  minvalue = -2  maxvalue = 6  valuedice = dualityDice (characterTable) }
        Presence = modifier { description = "Charm, perform and deceive." reference = ["srd", 4] default = 0  minvalue = -2  maxvalue = 6  valuedice = dualityDice (characterTable) }
        Knowledge = modifier { description = "Recall, analyze and comprehend." reference = ["srd", 4] default = 0  minvalue = -2  maxvalue = 6  valuedice = dualityDice (characterTable) }
    }

    Defense = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Evasion = integer { description = "What an attacker must reach to hit you." reference = ["srd", 39] default = 10 }
        'Armor Score' = integer { description = "How many armor slots your armor gives." reference = ["srd", 55] default = 0 }
        'Armor Slots' = slots { description = "Mark an armor slot to reduce the damage severity of a hit by one step." reference = ["srd", 55] number = 'Armor Score'  editable = live }
        'Major Threshold' = integer { description = "Damage at or above this marks 2 HP; below it marks 1." reference = ["srd", 39] default = 6 }
        'Severe Threshold' = integer { description = "Damage at or above this marks 3 HP." reference = ["srd", 39] default = 12 }
        'Repair All Armor' = button { description = "Long rest move: clear every armor slot."  reference = ["srd", 41]  editable = live  onClick = updates { (root.Defense.'Armor Slots'.realvalue) = 0 } }
    }

    'Hope and Health' = table
    {
        tableLayout = layout { columns = 1  size = wide }
        'HP Slots' = integer { default = 6  minvalue = 1  maxvalue = 12 }
        'Hit Points' = slots { description = "Marked hit points. Mark the last one and you must make a death move." reference = ["srd", 39] number = 'HP Slots'  editable = live  indicator = "#d64545"  indicatorLabel = "HP marked" }
        'Stress Slots' = integer { default = 6  minvalue = 1  maxvalue = 12 }
        Stress = slots { description = "Marked stress. Mark the last one and you become vulnerable." reference = ["srd", 39] number = 'Stress Slots'  editable = live  indicator = "#8e5cc4" }
        Hope = slots { description = "Hope, gained on rolls with Hope. Spend it to help allies, use experiences and features." reference = ["srd", 38] number = 6  editable = live  indicator = "#d4b106" }
        Down = string { value = if 'Hit Points'.realvalue >= 'HP Slots' then "Death move" else ""  visible = none  indicator = "#555555" }
        Vulnerable = bool { description = "Vulnerable: all rolls against you have advantage." reference = ["srd", 41] default = false  editable = live  indicator = "#e8913a" }
        Restrained = bool { description = "Restrained: you can't move, but can still act where you stand." reference = ["srd", 41] default = false  editable = live  indicator = "#e8913a" }
        Hidden = bool { description = "Hidden: out of sight, so rolls against you have disadvantage." reference = ["srd", 41] default = false  editable = live  indicator = "#3a7bd5" }
        'Tend to All Wounds' = button { description = "Long rest move: clear every hit point. Pick two moves per long rest."  reference = ["srd", 41]  editable = live  onClick = updates { (root.'Hope and Health'.'Hit Points'.realvalue) = 0 } }
        'Clear All Stress' = button { description = "Long rest move: clear every stress."  reference = ["srd", 41]  editable = live  onClick = updates { (root.'Hope and Health'.Stress.realvalue) = 0 } }
        Prepare = button { description = "Rest move: prepare for what comes next and gain a Hope."  reference = ["srd", 41]  editable = live  onClick = updates { (root.'Hope and Health'.Hope.realvalue) = min (6, Hope.realvalue + 1) } }
    }

    Experiences = list
    {
        description = "Backgrounds and skills you have. Spend a Hope to add the bonus to a fitting roll." reference = ["srd", 5]
        tableLayout = layout { size = wide }
        singular = "Experience"
        editable = character
        valueType = custom
        {
            Experience = string {}
            Bonus = modifier { description = "Bonus added when you spend a Hope to use this experience." reference = ["srd", 5] default = 2  valuedice = dualityDice (characterTable) }
        }
    }

    'Hope Feature' = table
    {
        tableLayout = layout { size = wide }
        'Hope Feature' = string { multiline = true }
        'Class Feature' = string { multiline = true }
    }

    Weapons = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Weapons
        singular = "Weapon"
        editable = character
    }

    Attacks = list
    {
        tableLayout = layout { size = wide }
        source = map ((weapon)->attackFor (characterTable, weapon), characterTable.Weapons)
        singular = "Attack"
        editable = none
        valueType = weaponAttack
    }

    Armor = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Armor
        singular = "Armor"
        editable = character
    }

    'Domain Cards' = list
    {
        tableLayout = layout { size = wide }
        source = secondary.'Domain Cards'
        singular = "Domain card"
        editable = character
    }

    Inventory = list
    {
        tableLayout = layout { size = wide }
        source = secondary.Items
        singular = "Item"
        editable = character
    }

    Gold = table
    {
        tableLayout = layout { columns = 3 }
        Handfuls = integer { description = "Gold in handfuls. Ten handfuls make a bag." reference = ["srd", 5] default = 1  minvalue = 0  maxvalue = 9  editable = live }
        Bags = integer { description = "Gold in bags. Ten bags make a chest." default = 0  minvalue = 0  maxvalue = 9  editable = live }
        Chests = integer { description = "Gold in chests." default = 0  minvalue = 0  editable = live }
    }

    Countdowns = list
    {
        tableLayout = layout { size = wide }
        singular = "Countdown"
        editable = live
        valueType = custom
        {
            Name = string {}
            Size = integer { default = 4  minvalue = 1  maxvalue = 12 }
            Progress = clock { segments = Size  editable = live }
        }
    }

    Background = table
    {
        tableLayout = layout { columns = 2  size = wide }
        Description = string { multiline = true }
        'Background Questions' = string { multiline = true }
        Connections = string { multiline = true }
    }
}

creatureTable = ruleset
{
    rulesetConfiguration =
    {
        important = [Stats]
        defaultImage = "/images/armour.svg"
        sortedBy = sort { prefix = "Tier" sort = Stats.Tier }
        filters = [filter { name = "Type" prefix = "" filter = Stats.Type }]
    }
    Stats = table
    {
        tableLayout = layout { columns = 4  size = wide }
        Tier = integer { description = "How strong the adversary is, from tier 1 to 4." default = 1  minvalue = 1  maxvalue = 4 }
        Type = string { keys = ["Bruiser", "Horde", "Leader", "Minion", "Ranged", "Skulk", "Social", "Solo", "Standard", "Support"] }
        Difficulty = integer { description = "What a player must roll to hit the adversary or beat its effects." reference = ["srd", 70] default = 12 }
        'Major Threshold' = integer { description = "Damage at or above this marks 2 HP." reference = ["srd", 70] default = 7 }
        'Severe Threshold' = integer { description = "Damage at or above this marks 3 HP." reference = ["srd", 70] default = 12 }
        'HP Slots' = integer { default = 5  minvalue = 1 }
        HP = slots { description = "Marked hit points. Fully marked means defeated." reference = ["srd", 70] number = 'HP Slots'  editable = live  indicator = "#d64545"  indicatorLabel = "HP marked" }
        'Stress Slots' = integer { default = 3  minvalue = 0 }
        Stress = slots { description = "Marked stress, spent on the adversary's features." reference = ["srd", 70] number = 'Stress Slots'  editable = live  indicator = "#8e5cc4" }
        ATK = modifier { description = "Bonus to the adversary's d20 attack roll." reference = ["srd", 70] default = 1  valuedice = adversaryAttack  action = if Range == "Melee" or Range == "Very Close" or Range == "" then "melee" else "ranged"  reach = rangeFeet (Range)  range = rangeFeet (Range) }
        Attack = string {}
        Range = string { keys = ["Melee", "Very Close", "Close", "Far", "Very Far"] }
        Damage = string {}
        Motives = string { description = "What the adversary wants and how it acts." reference = ["srd", 70] }
    }
    Features = table
    {
        tableLayout = layout { size = wide }
        Features = string { multiline = true }
        Experiences = string {}
    }
}

weaponStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Tier = integer { default = 1 }
        Slot = string { keys = ["Primary", "Secondary"] }
        Trait = string { keys = ["Agility", "Strength", "Finesse", "Instinct", "Presence", "Knowledge"] }
        Range = string { keys = ["Melee", "Very Close", "Close", "Far", "Very Far"] }
        Damage = string { default = "d8" }
        'Damage Type' = string { keys = ["phy", "mag"] }
        Burden = string { keys = ["One-Handed", "Two-Handed"] }
        Feature = string {}
    }
}

armorStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Tier = integer { default = 1 }
        'Base Thresholds' = string {}
        'Base Score' = string {}
        Feature = string {}
    }
}

domainCardStats = ruleset
{
    rulesetConfiguration =
    {
        defaultImage = "/images/spell.svg"
        sortedBy = sort { prefix = "Level" sort = Stats.Level }
        filters = [filter { name = "Domain" prefix = "" filter = Stats.Domain }]
    }
    Stats = table
    {
        Domain = string { keys = ["Arcana", "Blade", "Bone", "Codex", "Grace", "Midnight", "Sage", "Splendor", "Valor"] }
        Level = integer { default = 1 }
        Type = string { keys = ["Ability", "Spell", "Grimoire"] }
        'Recall Cost' = integer { default = 0 }
        'In Loadout' = bool { default = true  editable = live }
    }
}

itemStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Kind = string { keys = ["Item", "Consumable", "Loot"] }
        Uses = string {}
    }
}

optionStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/spell.svg" }
    Stats = table
    {
        Kind = string { keys = ["Class", "Subclass", "Ancestry", "Community"] }
        Domains = string {}
        'Starting Evasion' = string {}
        'Starting HP' = string {}
        Features = string { multiline = true }
    }
}

environmentStats = ruleset
{
    rulesetConfiguration = { defaultImage = "/images/armour.svg" }
    Stats = table
    {
        Tier = integer { default = 1 }
        Type = string { keys = ["Exploration", "Social", "Traversal", "Event"] }
        Difficulty = integer { default = 12 }
        Impulses = string {}
        'Potential Adversaries' = string {}
        Features = string { multiline = true }
    }
}

Daggerheart = system
{
    hints = [
        hint
        {
            title = "Session zero"
            topic = "Getting started"
            text = ["Ask each player questions about their character's background and connections, and build the world from the answers."]
        },
        hint
        {
            title = "Hope and Fear"
            topic = "Play"
            text = ["Roll the Hope and Fear d12s plus a trait against the Difficulty each roll asks for. Higher Hope gives the player Hope, higher Fear gives the GM Fear. Leave it blank when only the GM knows it."]
        },
        hint
        {
            title = "Spotlight"
            topic = "Initiative"
            text = ["There is no initiative. The spotlight moves to the GM on rolls with Fear or failures."]
        },
        hint
        {
            title = "Thresholds"
            topic = "Combat"
            text = ["Damage below Major marks 1 HP, Major 2, Severe 3. Armor slots reduce it."]
        }
    ]
    distanceUnit = "ft"
    squareSize = 5
    characters = characterTable
    creatures = creatureTable
    entityTypeNames = [entityTypeName ("Creature", "Adversary", "Adversaries")]
    Weapons = weaponStats
    Armor = armorStats
    'Domain Cards' = domainCardStats
    Items = itemStats
    'Character Options' = optionStats
    Environments = environmentStats
    secondaryTypes = ["Weapons", "Armor", "Domain Cards", "Items"]
    otherLibararyTypes = ["Character Options", "Environments"]
    description = "Daggerheart: heroic fantasy with Hope and Fear duality dice"
    quickdice = [2d12, 1d6, 1d8, 1d10, 1d12, 1d20]
    cssFiles = ["/systems/daggerheart/daggerheart.css"]
    libraries = ["/systems/daggerheart/daggerheart.json", "/systems/names/fantasy.json", "/systems/names/faerie.json", "/systems/names/barbarian.json", "/systems/tables/fantasy.json"]
    nameSettings = [fantasyNameSetting, faerieCourtsNameSetting, swordAndSorceryNameSetting]
}
